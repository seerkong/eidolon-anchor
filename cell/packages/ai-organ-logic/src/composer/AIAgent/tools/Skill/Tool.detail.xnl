<type_def lang="typescript" ?>
export interface SkillOuterInput {
  skill: string;
  resource?: string;
  offset?: number;
  limit?: number;
}

export type SkillOuterOutput = string;

export type Skill = (input: SkillOuterInput) => SkillOuterOutput;
</?>

