<ResourceMappings #Eidolon.Anchor.ResourceMappings.Run envelopeVersion="halfcode.resource-envelope/v1" specVersion=1 (
  <SourceRoots [
    <SourceRoot #EidolonRun { sourceRoot = "vfs://module/EidolonAnchorSystemSkills/" } [
      <CopyDirectory { from = "content/run/operations" to = "operations" }>
    ]>
  ]>
)>
