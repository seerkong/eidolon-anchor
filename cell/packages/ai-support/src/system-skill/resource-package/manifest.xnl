<ResourcePackage #Eidolon.Anchor.SystemSkills.Package envelopeVersion="halfcode.resource-envelope/v1" specVersion=1 {
  lifecycle = "Stable"
  description = "Eidolon Anchor DevOps, authoring and run system Skill resources."
} (
  <Catalogs [
    <Catalog #KindDefinitions { kind = "KindDefinition" shape = "directory" root = "vfs://./KindDefinitions/" entry = "manifest.xnl" }>
    <Catalog #SkillCapsules { kind = "SkillCapsule" shape = "directory" root = "vfs://./SkillCapsules/" entry = "manifest.xnl" }>
  ]>
)>
