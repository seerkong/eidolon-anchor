    <Contents [
        <Content id="c_00895018584b" kind="xnl" encoding="utf8" hash="sha256:00895018584bbd7559c443fd798d459d7235f082e727cd3b66573e06ca1fe392" ?><Tool #glob apiVersion="depa.flows/v1" version="1.0.0" { lifecycle = "Stable" description = "Eidolon glob execution capability" }>
