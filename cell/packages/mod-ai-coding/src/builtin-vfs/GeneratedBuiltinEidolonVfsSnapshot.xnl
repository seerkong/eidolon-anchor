        <Content id="c_a365b948730d" kind="xnl" encoding="utf8" hash="sha256:a365b948730d98177748f503a501dbf7ae9d84585010365c84cdcaa3f6e7e690" ?><KindDefinition #eidolon.coding.kind.AIAgentDefinition apiVersion="halfcode.resources/v1" version="1.0.0" {
