        <Content id="c_934def9e31be" kind="xnl" encoding="utf8" hash="sha256:934def9e31be2da9c0e337c23a02f6f24af45a473bc3fecbfa6cfea88772508a" ?><KindDefinition #Eidolon.AI.KindDefinition.HolonTaskRuntimeDefinition envelopeVersion="halfcode.resource-envelope/v1" specVersion=1 {
  lifecycle = "Stable"
  resourceKind = "HolonTaskRuntimeDefinition"
  subjectFqn = "Eidolon.AI.KindDefinition.HolonTaskRuntimeDefinition"
  sourceShapes = ["single-file"]
  documentCardinality = "one"
  description = "Binds one reusable Holon task contract to an exact frozen execution binding."
} (
  <SpecRevisions [
    <SpecRevision #v1 {
      specVersion = 1
      schemaRef = "vfs://./spec-v1.schema.json"
      schemaFingerprint = "sha256:0ab4d3d14949d8bc87e372207679c09ca0a7777c1e553c85a17118eb46ad38c6"
      contractFingerprint = "sha256:512138108cd6cefe6672593f355f27273ec2bebea863da0cbc114c570eba4acf"
