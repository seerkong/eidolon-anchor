<Behavior #ai-agent-vm-rx-data-plane apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #control-signal-stream-and-scheduler-signal (
      <Statement ?01M05F1P0E2KHBTYTNGA7EWXF7>
      系统 SHALL expose durable control-signal events as stream data and current scheduler readiness as signal/projection data without mixing the two.
      </?01M05F1P0E2KHBTYTNGA7EWXF7>
      <KnowledgeHint { target = "docs-profile" href = "vfs://docs/ai-agent-vm-rx-data-plane/control-signal-stream-and-scheduler-signal" strength = "hint" }>
      <Suites [
        <Suite #stream-signal-separation { name = "Control data-plane separation" } (
          <Cases [
            <Case #control-events-are-stream [
              <Then ?01M05F1P0E2KHBTYTNGA7EWXF8>
              The facts SHALL be represented as ordered control event stream records
              </?01M05F1P0E2KHBTYTNGA7EWXF8>
              <Then ?01M05F1P0E2KHBTYTNGA7EWXF9>
              They SHALL carry causation id, correlation id, fiber id, actor key, mailbox kind, priority, and idempotency key where applicable
              </?01M05F1P0E2KHBTYTNGA7EWXF9>
            ] (
              <Given ?01M05F1P0E2KHBTYTNGA7EWXFA>
              The runtime emits mailbox enqueue, control interrupt, async completion, resume, suspend, or cancellation facts
              </?01M05F1P0E2KHBTYTNGA7EWXFA>
              <When ?01M05F1P0E2KHBTYTNGA7EWXFB>
              These facts enter the data plane
              </?01M05F1P0E2KHBTYTNGA7EWXFB>
            )>
            <Case #readiness-is-signal [
              <Then ?01M05F1P0E2KHBTYTNGA7EWXFC>
              The current state SHALL be exposed as signal or signal projection
              </?01M05F1P0E2KHBTYTNGA7EWXFC>
              <Then ?01M05F1P0E2KHBTYTNGA7EWXFD>
              The runtime SHALL NOT encode current readiness by appending fake semantic events
              </?01M05F1P0E2KHBTYTNGA7EWXFD>
            ] (
              <Given ?01M05F1P0E2KHBTYTNGA7EWXFE>
              The scheduler derives whether a fiber is ready, running, suspended, interrupted, or blocked
              </?01M05F1P0E2KHBTYTNGA7EWXFE>
              <When ?01M05F1P0E2KHBTYTNGA7EWXFF>
              The public runtime data plane exposes current scheduler state
              </?01M05F1P0E2KHBTYTNGA7EWXFF>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
