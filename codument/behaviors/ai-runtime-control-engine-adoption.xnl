<Behavior #ai-runtime-control-engine-adoption apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #domain-wrapper (
      <Statement ?01M18JQ3H5XP2SJY345KY1P2TR>
      AI runtime SHALL 通过 AI 领域 wrapper 采用 runtime control engine，将 mailbox、conversation、snapshot、tool/effect result、ingress 和 diagnostics 映射为 vendor 层 command、effect 和 durable head，并通过 depa-actor@0.2.0 CommandDequeGroup 表达内部 command worklist。
      </?01M18JQ3H5XP2SJY345KY1P2TR>
      <Suites [
        <Suite #domain-mapping { name = "领域映射" } (
          <Cases [
            <Case #vendor-hidden-from-ai-runtime-callers (
              <Given ?01M18JQ3H5XP2SJY345KY1P2TS>
              AI runtime 需要提交 human input、tool result 或 snapshot 相关操作
              </?01M18JQ3H5XP2SJY345KY1P2TS>
              <When ?01M18JQ3H5XP2SJY345KY1P2TT>
              业务代码调用 runtime-control 能力
              </?01M18JQ3H5XP2SJY345KY1P2TT>
              <Then ?01M18JQ3H5XP2SJY345KY1P2TV>
              业务代码 SHALL 调用 AI 领域语义化 primitive，而不是直接拼装 vendor durable cohort 细节
              </?01M18JQ3H5XP2SJY345KY1P2TV>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #adopt-after-engine-validation (
      <Statement ?01M18JQ3H5XP2SJY345KY1P2TW>
      AI runtime SHALL NOT 用未独立验证的 runtime control engine 替换现有编排路径；替换前必须通过 vendor engine conformance tests 和 AI session recovery adoption tests。
      </?01M18JQ3H5XP2SJY345KY1P2TW>
      <Suites [
        <Suite #replacement-gate { name = "替换门禁" } (
          <Cases [
            <Case #test-before-runtime-replacement (
              <Given ?01M18JQ3H5XP2SJY345KY1P2TX>
              runtime control engine 设计或实现已完成
              </?01M18JQ3H5XP2SJY345KY1P2TX>
              <When ?01M18JQ3H5XP2SJY345KY1P2TY>
              准备替换 AI runtime 的 session 编排和持久化路径
              </?01M18JQ3H5XP2SJY345KY1P2TY>
              <Then ?01M18JQ3H5XP2SJY345KY1P2TZ>
              系统 SHALL 先通过 crash recovery、dirty head classification、long-running effect wait 和 cohort commit 测试
              </?01M18JQ3H5XP2SJY345KY1P2TZ>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #real-session-head-adapters (
      <Statement ?01M18JQ3H5XP2SJY345KY1P2V0>
      系统 SHALL map real AI session persistence sources into ai-runtime-control-composer durable heads before the composer can replace old runtime persistence.
      </?01M18JQ3H5XP2SJY345KY1P2V0>
      <Suites [
        <Suite #head-mapping { name = "真实 session head 映射" } (
          <Cases [
            <Case #snapshot-conversation-transcript-mailbox-logs [
              <Then ?01M18JQ3H5XP2SJY345KY1P2V1>
              The system SHALL represent each source as a named durable head with sequence and buffered state
              </?01M18JQ3H5XP2SJY345KY1P2V1>
              <Then ?01M18JQ3H5XP2SJY345KY1P2V2>
              The system SHALL commit those heads only through a cohort commit marker
              </?01M18JQ3H5XP2SJY345KY1P2V2>
            ] (
              <Given ?01M18JQ3H5XP2SJY345KY1P2V3>
              A session contains runtime snapshot, conversation files, actor transcript, mailbox state, ingress logs, and diagnostics logs
              </?01M18JQ3H5XP2SJY345KY1P2V3>
              <When ?01M18JQ3H5XP2SJY345KY1P2V4>
              The runtime control composer prepares a checkpoint cohort
              </?01M18JQ3H5XP2SJY345KY1P2V4>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #effect-lifecycle-adapters (
      <Statement ?01M18JQ3H5XP2SJY345KY1P2V5>
      系统 SHALL route real tool, MCP, bash, permission, questionnaire, and provider completion lifecycles through composer effect request/result commands before replacing old orchestration.
      </?01M18JQ3H5XP2SJY345KY1P2V5>
      <Suites [
        <Suite #effect-pairing { name = "副作用配对" } (
          <Cases [
            <Case #tool-output-paired (
              <Given ?01M18JQ3H5XP2SJY345KY1P2V6>
              A tool output, async completion, or permission result arrives
              </?01M18JQ3H5XP2SJY345KY1P2V6>
              <When ?01M18JQ3H5XP2SJY345KY1P2V7>
              The composer records the event
              </?01M18JQ3H5XP2SJY345KY1P2V7>
              <Then ?01M18JQ3H5XP2SJY345KY1P2V8>
              The system SHALL require a matching effect request or classify the result as orphaned or dirty
              </?01M18JQ3H5XP2SJY345KY1P2V8>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #recovery-classification (
      <Statement ?01M18JQ3H5XP2SJY345KY1P2V9>
      系统 SHALL classify real session directories using composer recovery rules and SHALL NOT silently resume dirty state.
      </?01M18JQ3H5XP2SJY345KY1P2V9>
      <Suites [
        <Suite #historical-incidents { name = "历史现场回归" } (
          <Cases [
            <Case #dirty-session-rejected (
              <Given ?01M18JQ3H5XP2SJY345KY1P2VA>
              A historical session has unpaired tool messages, duplicate human input, stale removed-tool calls, or inconsistent durable heads
              </?01M18JQ3H5XP2SJY345KY1P2VA>
              <When ?01M18JQ3H5XP2SJY345KY1P2VB>
              The runtime loads the session through composer recovery
              </?01M18JQ3H5XP2SJY345KY1P2VB>
              <Then ?01M18JQ3H5XP2SJY345KY1P2VC>
              The system SHALL classify the session as orphaned or dirty unless a valid repair produces a clean cohort
              </?01M18JQ3H5XP2SJY345KY1P2VC>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #gap-until-replaceable (
      <Statement ?01M18JQ3H5XP2SJY345KY1P2VD>
      系统 SHALL run repeated replacement-readiness gap scans after implementation and SHALL extend this track until no remaining blocker prevents using ai-runtime-control-composer as the runtime persistence/control engine.
      </?01M18JQ3H5XP2SJY345KY1P2VD>
      <Suites [
        <Suite #readiness-loop { name = "替换就绪扫描" } (
          <Cases [
            <Case #no-gap-before-replacement [
              <Then ?01M18JQ3H5XP2SJY345KY1P2VE>
              The track SHALL record every remaining blocker as new tasks
              </?01M18JQ3H5XP2SJY345KY1P2VE>
              <Then ?01M18JQ3H5XP2SJY345KY1P2VF>
              The track SHALL NOT be considered complete until the scan reports no replacement blocker
              </?01M18JQ3H5XP2SJY345KY1P2VF>
            ] (
              <Given ?01M18JQ3H5XP2SJY345KY1P2VG>
              The planned implementation tasks are complete
              </?01M18JQ3H5XP2SJY345KY1P2VG>
              <When ?01M18JQ3H5XP2SJY345KY1P2VH>
              A fresh gap scan compares composer adoption against old runtime responsibilities
              </?01M18JQ3H5XP2SJY345KY1P2VH>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #concrete-writer-ownership (
      <Statement ?01M18JQ3H5XP2SJY345KY1P2VJ>
      系统 SHALL drive concrete AI runtime file writes through ai-runtime-control-composer before claiming full replacement of the old runtime persistence writer path.
      </?01M18JQ3H5XP2SJY345KY1P2VJ>
      <Suites [
        <Suite #composer-concrete-checkpoint { name = "Composer concrete checkpoint 写入" } (
          <Cases [
            <Case #composer-drives-concrete-files [
              <Then ?01M18JQ3H5XP2SJY345KY1P2VK>
              The system SHALL enqueue a composer concrete checkpoint write effect instead of directly calling each concrete writer from RuntimeSnapshots
              </?01M18JQ3H5XP2SJY345KY1P2VK>
              <Then ?01M18JQ3H5XP2SJY345KY1P2VM>
              The composer SHALL execute the concrete writer support, read real session heads, buffer durable heads, and commit the checkpoint cohort in that order
              </?01M18JQ3H5XP2SJY345KY1P2VM>
            ] (
              <Given ?01M18JQ3H5XP2SJY345KY1P2VN>
              A runtime reaches a snapshot safepoint and has VM, actor, fiber, conversation, transcript, derived index, and manifest data ready to persist
              </?01M18JQ3H5XP2SJY345KY1P2VN>
              <When ?01M18JQ3H5XP2SJY345KY1P2VP>
              The runtime saves the checkpoint
              </?01M18JQ3H5XP2SJY345KY1P2VP>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #control-engine-consistency-owner (
      <Statement ?01M18JQ3H5XP2SJY345KY1P2VQ>
      系统 SHALL treat ai-runtime-control as the owner of runtime consistency boundaries, with old concrete writers invoked only as support effects or explicitly classified projection/journal sinks.
      </?01M18JQ3H5XP2SJY345KY1P2VQ>
      <Suites [
        <Suite #control-owner-boundaries { name = "Control engine 一致性边界" } (
          <Cases [
            <Case #checkpoint-has-no-pre-composer-write (
              <Given ?01M18JQ3H5XP2SJY345KY1P2VR>
              A runtime reaches a snapshot safepoint
              </?01M18JQ3H5XP2SJY345KY1P2VR>
              <When ?01M18JQ3H5XP2SJY345KY1P2VS>
              The runtime saves a checkpoint
              </?01M18JQ3H5XP2SJY345KY1P2VS>
              <Then ?01M18JQ3H5XP2SJY345KY1P2VT>
              The system SHALL NOT write conversation, transcript, snapshot, manifest, or checkpoint-owned derived files before submitting the checkpoint to ai-runtime-control-composer
              </?01M18JQ3H5XP2SJY345KY1P2VT>
            )>
            <Case #effect-evidence-through-control-facade (
              <Given ?01M18JQ3H5XP2SJY345KY1P2VV>
              A provider, tool, permission, questionnaire, or async completion lifecycle event is observed
              </?01M18JQ3H5XP2SJY345KY1P2VV>
              <When ?01M18JQ3H5XP2SJY345KY1P2VW>
              The runtime records the lifecycle event
              </?01M18JQ3H5XP2SJY345KY1P2VW>
              <Then ?01M18JQ3H5XP2SJY345KY1P2VX>
              The system SHALL submit the event through a runtime-control composer facade rather than directly writing runtime-control files from executor code
              </?01M18JQ3H5XP2SJY345KY1P2VX>
            )>
            <Case #recovery-gate-before-support-load (
              <Given ?01M18JQ3H5XP2SJY345KY1P2VY>
              A session directory exists on disk
              </?01M18JQ3H5XP2SJY345KY1P2VY>
              <When ?01M18JQ3H5XP2SJY345KY1P2VZ>
              The runtime attempts to recover the session
              </?01M18JQ3H5XP2SJY345KY1P2VZ>
              <Then ?01M18JQ3H5XP2SJY345KY1P2W0>
              The system SHALL run the runtime-control recovery gate before reading old snapshot repository data as support detail
              </?01M18JQ3H5XP2SJY345KY1P2W0>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #irreversible-session-upgrade (
      <Statement ?01M18JQ3H5XP2SJY345KY1P2W1>
      系统 SHALL provide an explicit irreversible session-file upgrade path before enabling owned-mode runtime recovery for old sessions.
      </?01M18JQ3H5XP2SJY345KY1P2W1>
      <Suites [
        <Suite #session-upgrade { name = "Session 文件升级" } (
          <Cases [
            <Case #upgrade-writes-owned-checkpoint (
              <Given ?01M18JQ3H5XP2SJY345KY1P2W2>
              An old session has valid runtime files but no runtime-control owned checkpoint
              </?01M18JQ3H5XP2SJY345KY1P2W2>
              <When ?01M18JQ3H5XP2SJY345KY1P2W3>
              The migration runs the session upgrade
              </?01M18JQ3H5XP2SJY345KY1P2W3>
              <Then ?01M18JQ3H5XP2SJY345KY1P2W4>
              The system SHALL read real session heads, buffer those heads, commit the checkpoint cohort, and write an irreversible upgrade manifest
              </?01M18JQ3H5XP2SJY345KY1P2W4>
            )>
            <Case #dirty-existing-checkpoint-rejected (
              <Given ?01M18JQ3H5XP2SJY345KY1P2W5>
              A session already has a runtime-control checkpoint marker but current heads or effect evidence classify as dirty or orphaned
              </?01M18JQ3H5XP2SJY345KY1P2W5>
              <When ?01M18JQ3H5XP2SJY345KY1P2W6>
              The migration attempts to upgrade the session
              </?01M18JQ3H5XP2SJY345KY1P2W6>
              <Then ?01M18JQ3H5XP2SJY345KY1P2W7>
              The system SHALL reject the upgrade rather than overwriting the dirty state with a new marker
              </?01M18JQ3H5XP2SJY345KY1P2W7>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #session-upgrade-cli-entry (
      <Statement ?01M18JQ3H5XP2SJY345KY1P2W8>
      系统 SHALL provide a single-session migration entry that can dry-run upgrade readiness without writes and apply an irreversible owned checkpoint only when explicitly requested.
      </?01M18JQ3H5XP2SJY345KY1P2W8>
      <Suites [
        <Suite #session-upgrade-entry { name = "Session upgrade dry-run/apply 入口" } (
          <Cases [
            <Case #dry-run-is-read-only [
              <Then ?01M18JQ3H61Q5ZW19QPKGJBX6M>
              The system SHALL read upgrade marker, checkpoint marker, real heads, and effect evidence
              </?01M18JQ3H61Q5ZW19QPKGJBX6M>
              <Then ?01M18JQ3H61Q5ZW19QPKGJBX6N>
              The system SHALL output JSON classification, blockers, canUpgrade, and plannedHeads without writing files
              </?01M18JQ3H61Q5ZW19QPKGJBX6N>
            ] (
              <Given ?01M18JQ3H61Q5ZW19QPKGJBX6P>
              An operator runs session upgrade without --apply
              </?01M18JQ3H61Q5ZW19QPKGJBX6P>
              <When ?01M18JQ3H61Q5ZW19QPKGJBX6Q>
              The CLI inspects the session directory
              </?01M18JQ3H61Q5ZW19QPKGJBX6Q>
            )>
            <Case #apply-reuses-dry-run (
              <Given ?01M18JQ3H61Q5ZW19QPKGJBX6R>
              An operator runs session upgrade with --apply
              </?01M18JQ3H61Q5ZW19QPKGJBX6R>
              <When ?01M18JQ3H61Q5ZW19QPKGJBX6S>
              The session is already upgraded, dirty, orphaned, or otherwise blocked by effect evidence
              </?01M18JQ3H61Q5ZW19QPKGJBX6S>
              <Then ?01M18JQ3H61Q5ZW19QPKGJBX6T>
              The system SHALL return already_upgraded or rejected rather than writing a replacement checkpoint marker
              </?01M18JQ3H61Q5ZW19QPKGJBX6T>
            )>
            <Case #apply-commits-clean-session (
              <Given ?01M18JQ3H61Q5ZW19QPKGJBX6V>
              An old session has no blocking evidence other than a missing checkpoint marker
              </?01M18JQ3H61Q5ZW19QPKGJBX6V>
              <When ?01M18JQ3H61Q5ZW19QPKGJBX6W>
              The operator runs session upgrade with --apply
              </?01M18JQ3H61Q5ZW19QPKGJBX6W>
              <Then ?01M18JQ3H61Q5ZW19QPKGJBX6X>
              The system SHALL commit a checkpoint cohort, write the irreversible upgrade manifest, and verify recovery classification is clean
              </?01M18JQ3H61Q5ZW19QPKGJBX6X>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #tui-session-upgrade-entry (
      <Statement ?01M18JQ3H61Q5ZW19QPKGJBX6Y>
      系统 SHALL let users upgrade an old session from the TUI session picker before recovery, using the same runtime-control session-upgrade dry-run/apply semantics as the CLI.
      </?01M18JQ3H61Q5ZW19QPKGJBX6Y>
      <Suites [
        <Suite #tui-session-upgrade { name = "TUI session upgrade 入口" } (
          <Cases [
            <Case #confirm-before-apply [
              <Then ?01M18JQ3H61Q5ZW19QPKGJBX6Z>
              The TUI SHALL ask the user to confirm the irreversible upgrade before applying it
              </?01M18JQ3H61Q5ZW19QPKGJBX6Z>
              <Then ?01M18JQ3H61Q5ZW19QPKGJBX70>
              The TUI SHALL call the same session-upgrade apply facade after confirmation
              </?01M18JQ3H61Q5ZW19QPKGJBX70>
            ] (
              <Given ?01M18JQ3H61Q5ZW19QPKGJBX71>
              A user opens the TUI session list and selects an old session that has no runtime-control checkpoint marker
              </?01M18JQ3H61Q5ZW19QPKGJBX71>
              <When ?01M18JQ3H61Q5ZW19QPKGJBX72>
              The dry-run result has canUpgrade=true
              </?01M18JQ3H61Q5ZW19QPKGJBX72>
            )>
            <Case #blocked-session-not-loaded (
              <Given ?01M18JQ3H61Q5ZW19QPKGJBX73>
              The selected session dry-run returns dirty, orphaned, or other blocking evidence
              </?01M18JQ3H61Q5ZW19QPKGJBX73>
              <When ?01M18JQ3H61Q5ZW19QPKGJBX74>
              The user attempts to load the session from TUI
              </?01M18JQ3H61Q5ZW19QPKGJBX74>
              <Then ?01M18JQ3H61Q5ZW19QPKGJBX75>
              The TUI SHALL show the blockers and SHALL NOT navigate into the session route
              </?01M18JQ3H61Q5ZW19QPKGJBX75>
            )>
            <Case #upgraded-session-loads-directly (
              <Given ?01M18JQ3H61Q5ZW19QPKGJBX76>
              The selected session is already upgraded and has a clean checkpoint
              </?01M18JQ3H61Q5ZW19QPKGJBX76>
              <When ?01M18JQ3H61Q5ZW19QPKGJBX77>
              The user loads the session from TUI
              </?01M18JQ3H61Q5ZW19QPKGJBX77>
              <Then ?01M18JQ3H61Q5ZW19QPKGJBX78>
              The TUI SHALL load the session without asking for another upgrade confirmation
              </?01M18JQ3H61Q5ZW19QPKGJBX78>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #checkpoint-head-resolution-bounded (
      <Statement ?01M18JQ3H61Q5ZW19QPKGJBX79>
      checkpoint 组合器解析 real session heads SHALL 以有界方式完成：优先从持久化 head 文件解析 ingress_log/diagnostics_log 的 count/last，SHALL NOT 每次 checkpoint 全量读取并解析整个日志文件；读取成本 SHALL 与日志体积解耦。
      </?01M18JQ3H61Q5ZW19QPKGJBX79>
      <Suites [
        <Suite #bounded-head-resolution { name = "Bounded head resolution in checkpoint" } (
          <Cases [
            <Case #checkpoint-head-from-head-file (
              <Given ?01M18JQ3H61Q5ZW19QPKGJBX7A>
              session 存在持久化 head 文件
              </?01M18JQ3H61Q5ZW19QPKGJBX7A>
              <When ?01M18JQ3H61Q5ZW19QPKGJBX7B>
              runFileStoreAiRuntimeConcreteCheckpoint 解析 real session heads
              </?01M18JQ3H61Q5ZW19QPKGJBX7B>
              <Then ?01M18JQ3H61Q5ZW19QPKGJBX7C>
              SHALL 从 head 文件取值，SHALL NOT 全量解析日志
              </?01M18JQ3H61Q5ZW19QPKGJBX7C>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
