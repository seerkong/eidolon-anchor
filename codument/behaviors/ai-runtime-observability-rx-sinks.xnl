<Behavior #ai-runtime-observability-rx-sinks apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #xnl-file-sink-record-streams (
      <Statement ?01M18JQ22M34M3H0R7VTZMV0PT>
      系统 SHALL persist observability XNL file sinks according to the same append-only versus replace-state classification used by session persistence.
      </?01M18JQ22M34M3H0R7VTZMV0PT>
      <KnowledgeHint { target = "docs-profile" href = "vfs://docs/ai-runtime-observability-rx-sinks/xnl-file-sink-record-streams" strength = "hint" }>
      <Suites [
        <Suite #trace-xnl { name = "Trace XNL sinks" } (
          <Cases [
            <Case #session-trace-xnl-append-only [
              <Then ?01M18JQ22M34M3H0R7VTZMV0PV>
              The sink SHALL append one complete top-level `TraceEntry` XNL trace record per event
              </?01M18JQ22M34M3H0R7VTZMV0PV>
              <Then ?01M18JQ22M34M3H0R7VTZMV0PW>
              The sink SHALL NOT rewrite a growing root wrapper for trace history
              </?01M18JQ22M34M3H0R7VTZMV0PW>
              <Then ?01M18JQ22M34M3H0R7VTZMV0PX>
              `TraceEntry` SHALL include `traceKind` metadata to distinguish observability trace from graph trace when both producers share the tag
              </?01M18JQ22M34M3H0R7VTZMV0PX>
              <Then ?01M18JQ22M34M3H0R7VTZMV0PY>
              Single typed children such as `Payload`, `Error`, or `Value` SHALL use `()`; multiple typed children SHALL use `[]`
              </?01M18JQ22M34M3H0R7VTZMV0PY>
            ] (
              <Given ?01M18JQ22M34M3H0R7VTZMV0PZ>
              An observability trace sink writes records to `sessions/&amp;amp;amp;lt;sessionId&amp;amp;amp;gt;/trace.xnl` or a caller-provided `trace.xnl` path
              </?01M18JQ22M34M3H0R7VTZMV0PZ>
              <When ?01M18JQ22M34M3H0R7VTZMV0Q0>
              A trace record is flushed
              </?01M18JQ22M34M3H0R7VTZMV0Q0>
            )>
          ]>
        )>
        <Suite #scene-xnl { name = "Scene XNL sinks" } (
          <Cases [
            <Case #scene-store-location [
              <Then ?01M18JQ22M34M3H0R7VTZMV0Q1>
              The files SHALL be placed under `.eidolon/scenes/&amp;amp;amp;lt;sessionId&amp;amp;amp;gt;/`
              </?01M18JQ22M34M3H0R7VTZMV0Q1>
              <Then ?01M18JQ22M34M3H0R7VTZMV0Q2>
              The store SHALL NOT create workspace-root `scenes/` data directories as normal project output
              </?01M18JQ22M34M3H0R7VTZMV0Q2>
            ] (
              <Given ?01M18JQ22M34M3H0R7VTZMV0Q3>
              A SceneStore persists replay or observability XNL files in a project workspace
              </?01M18JQ22M34M3H0R7VTZMV0Q3>
              <When ?01M18JQ22M34M3H0R7VTZMV0Q4>
              The store resolves its root directory
              </?01M18JQ22M34M3H0R7VTZMV0Q4>
            )>
            <Case #scene-events-xnl-append-only [
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCNB>
              The event SHALL be appended as one complete top-level `SceneMessage` XNL element
              </?01M18JQ22NWVB2KMZQN4Z7WCNB>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCNC>
              `SceneMessage` SHALL include `version`, `sequence`, `id`, `sessionId`, and `role` metadata
              </?01M18JQ22NWVB2KMZQN4Z7WCNC>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCND>
              Ordered `TextPart` and `ToolCall` children SHALL use `[]` even when a message currently has one text part
              </?01M18JQ22NWVB2KMZQN4Z7WCND>
            ] (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCNE>
              A scene store records turn or scene events
              </?01M18JQ22NWVB2KMZQN4Z7WCNE>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCNF>
              An event is persisted to `.eidolon/scenes/&amp;amp;amp;lt;sessionId&amp;amp;amp;gt;/events.xnl`
              </?01M18JQ22NWVB2KMZQN4Z7WCNF>
            )>
            <Case #scene-manifest-xnl-replace-state [
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCNG>
              The manifest MAY be replace-written as a `SceneManifest` because it is bounded scene state rather than event history
              </?01M18JQ22NWVB2KMZQN4Z7WCNG>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCNH>
              The manifest SHALL NOT contain the growing event log
              </?01M18JQ22NWVB2KMZQN4Z7WCNH>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCNJ>
              `SceneManifest` SHALL contain typed children such as `SystemPrompt` and `ToolDefs` using `[]`
              </?01M18JQ22NWVB2KMZQN4Z7WCNJ>
            ] (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCNK>
              A scene store persists `.eidolon/scenes/&amp;amp;amp;lt;sessionId&amp;amp;amp;gt;/manifest.xnl`
              </?01M18JQ22NWVB2KMZQN4Z7WCNK>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCNM>
              The manifest is saved
              </?01M18JQ22NWVB2KMZQN4Z7WCNM>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #provider-request-sqlite-ledger (
      <Statement ?01M18JQ22NWVB2KMZQN4Z7WCNN>
      系统 SHALL 在显式启用时，把每次真实 provider request attempt 作为独立、append-only、可查询的 SQLite 诊断事实持久化，且该 sink SHALL NOT 参与或改变 live AI loop。
      </?01M18JQ22NWVB2KMZQN4Z7WCNN>
      <Suites [
        <Suite #attempt-capture { name = "Provider request attempt capture" } (
          <Cases [
            <Case #one-row-per-real-attempt [
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCNP>
              系统 SHALL 在每个真实发送动作前持久化恰好一条 request observation
              </?01M18JQ22NWVB2KMZQN4Z7WCNP>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCNQ>
              observation SHALL 保留脱敏后的 exact request body、transport type/ordinal、source provider messages/tools 以及 session/actor/turn/provider-call/provider-attempt identity
              </?01M18JQ22NWVB2KMZQN4Z7WCNQ>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCNR>
              只执行 prompt build、估算或 preflight 而未调用 provider 时 SHALL NOT 写入 request observation
              </?01M18JQ22NWVB2KMZQN4Z7WCNR>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCNS>
              WebSocket 失败后发送不同 HTTP fallback body 时 SHALL 记录同一 provider attempt 下两个有序 transport observations
              </?01M18JQ22NWVB2KMZQN4Z7WCNS>
            ] (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCNT>
              provider runtime 即将执行一次真实 transport attempt，包括 retry 内的 WebSocket、HTTP 或 fallback attempt
              </?01M18JQ22NWVB2KMZQN4Z7WCNT>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCNV>
              最终 request body 已完成所有 adapter-specific 变换且即将执行 fetch 或 WebSocket send
              </?01M18JQ22NWVB2KMZQN4Z7WCNV>
            )>
            <Case #observation-does-not-mutate-request [
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCNW>
              原 provider request 的结构、顺序、字段和值 SHALL 保持不变
              </?01M18JQ22NWVB2KMZQN4Z7WCNW>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCNX>
              启用或关闭 observation SHALL 产生相同的 provider 调用次数和输入
              </?01M18JQ22NWVB2KMZQN4Z7WCNX>
            ] (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCNY>
              runtime 已生成将要发送的 messages、tools 和 request contract
              </?01M18JQ22NWVB2KMZQN4Z7WCNY>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCNZ>
              系统复制并持久化 observation
              </?01M18JQ22NWVB2KMZQN4Z7WCNZ>
            )>
          ]>
        )>
        <Suite #security-and-failure { name = "Security and failure isolation" } (
          <Cases [
            <Case #credential-redaction [
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCP0>
              认证字段和 connection options SHALL NOT 以明文写入数据库
              </?01M18JQ22NWVB2KMZQN4Z7WCP0>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCP1>
              数据库文件 SHALL 仅允许当前用户读写
              </?01M18JQ22NWVB2KMZQN4Z7WCP1>
            ] (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCP2>
              request 配置包含 authorization、API key、cookie、token、secret 或 connection options
              </?01M18JQ22NWVB2KMZQN4Z7WCP2>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCP3>
              系统构造 SQLite observation 副本
              </?01M18JQ22NWVB2KMZQN4Z7WCP3>
            )>
            <Case #sqlite-failure-is-fail-open [
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCP4>
              系统 SHALL 产生有界诊断并继续原 provider attempt
              </?01M18JQ22NWVB2KMZQN4Z7WCP4>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCP5>
              系统 SHALL NOT 因 observation 失败而取消、重试或改变 provider 结果
              </?01M18JQ22NWVB2KMZQN4Z7WCP5>
            ] (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCP6>
              SQLite open、schema、lock、write 或 disk 操作失败
              </?01M18JQ22NWVB2KMZQN4Z7WCP6>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCP7>
              provider attempt 到达 observation port
              </?01M18JQ22NWVB2KMZQN4Z7WCP7>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #provider-request-plan-outcome-ledger (
      <Statement ?01M18JQ22NWVB2KMZQN4Z7WCP8>
      显式启用 provider request capture 时，系统 SHALL 以同一 attempt identity 分别持久化 send-before request plan/wire observation 与 response-after terminal outcome；SQLite sink MUST 保持 app 顶层 support effect、fail-open、append-only，且 MUST NOT 参与 planning 或改变 live loop。
      </?01M18JQ22NWVB2KMZQN4Z7WCP8>
      <Suites [
        <Suite #plan-and-outcome { name = "Request plan and outcome correlation" } (
          <Cases [
            <Case #request-row-records-decision [
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCP9>
              observation SHALL 显式记录 plan kind、可空 replay source、previous-id 采用或拒绝及 reason
              </?01M18JQ22NWVB2KMZQN4Z7WCP9>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCPA>
              wire body、transport 与 attempt identity SHALL 来自同一个实际发送动作
              </?01M18JQ22NWVB2KMZQN4Z7WCPA>
            ] (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCPB>
              logic 已生成真实 transport attempt 的 request plan 与最终 wire body
              </?01M18JQ22NWVB2KMZQN4Z7WCPB>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCPC>
              send-before observation 写入 ledger
              </?01M18JQ22NWVB2KMZQN4Z7WCPC>
            )>
            <Case #outcome-row-records-actual-result [
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCPD>
              outcome SHALL 以 attempt identity 关联 request row，并记录 terminal state、实际 fallback 与 output completeness decision
              </?01M18JQ22NWVB2KMZQN4Z7WCPD>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCPE>
              `fallback_used` SHALL 表示真实发生的 fallback，而非配置意图
              </?01M18JQ22NWVB2KMZQN4Z7WCPE>
            ] (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCPF>
              一个 provider/transport attempt 完成、失败、中止或发生 WS→HTTP fallback
              </?01M18JQ22NWVB2KMZQN4Z7WCPF>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCPG>
              response-after outcome 写入 ledger
              </?01M18JQ22NWVB2KMZQN4Z7WCPG>
            )>
          ]>
        )>
        <Suite #effect-boundary { name = "SQLite effect boundary" } (
          <Cases [
            <Case #support-owned-schema-evolution [
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCPH>
              schema SHALL 非破坏迁移并保留旧 request rows
              </?01M18JQ22NWVB2KMZQN4Z7WCPH>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCPJ>
              认证字段 SHALL 继续脱敏，SQLite 失败 SHALL fail-open
              </?01M18JQ22NWVB2KMZQN4Z7WCPJ>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCPK>
              core/logic SHALL NOT 存储 SQLite，terminal/organ SHALL 只绑定 port 与 lifecycle
              </?01M18JQ22NWVB2KMZQN4Z7WCPK>
            ] (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCPM>
              旧 session 的 ledger 使用较早 schema
              </?01M18JQ22NWVB2KMZQN4Z7WCPM>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCPN>
              顶层 support sink 打开并追加新 observation
              </?01M18JQ22NWVB2KMZQN4Z7WCPN>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #bounded-provider-diagnostic-retention (
      <Statement ?01M18JQ22NWVB2KMZQN4Z7WCPP>
      AI runtime observability SHALL retain bounded structured provider, tool and domain-transition metrics by default, while raw streamed reasoning content SHALL require an explicit debug retention policy with capacity and lifetime limits.
      </?01M18JQ22NWVB2KMZQN4Z7WCPP>
      <Suites [
        <Suite #retention { name = "Bounded diagnostic retention" } (
          <Cases [
            <Case #aggregate-turn-metrics (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCPQ>
              An AI actor completes provider and tool turns
              </?01M18JQ22NWVB2KMZQN4Z7WCPQ>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCPR>
              normal session diagnostics are persisted
              </?01M18JQ22NWVB2KMZQN4Z7WCPR>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCPS>
              The sink SHALL retain actor/turn/provider identities, first-token time, generation time, token counts, tool duration and structured receipt references
              </?01M18JQ22NWVB2KMZQN4Z7WCPS>
            )>
            <Case #raw-reasoning-debug-only (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCPT>
              A provider streams think or reasoning deltas
              </?01M18JQ22NWVB2KMZQN4Z7WCPT>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCPV>
              debug retention is not explicitly enabled
              </?01M18JQ22NWVB2KMZQN4Z7WCPV>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCPW>
              The sink MUST NOT persist every raw reasoning delta into long-lived session artifacts
              </?01M18JQ22NWVB2KMZQN4Z7WCPW>
            )>
            <Case #debug-retention-bounded (
              <Given ?01M18JQ22NWVB2KMZQN4Z7WCPX>
              Debug reasoning retention is explicitly enabled
              </?01M18JQ22NWVB2KMZQN4Z7WCPX>
              <When ?01M18JQ22NWVB2KMZQN4Z7WCPY>
              raw deltas are recorded
              </?01M18JQ22NWVB2KMZQN4Z7WCPY>
              <Then ?01M18JQ22NWVB2KMZQN4Z7WCPZ>
              The policy SHALL enforce declared capacity and lifetime bounds and SHALL not change Conversation or provider-context authority
              </?01M18JQ22NWVB2KMZQN4Z7WCPZ>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
