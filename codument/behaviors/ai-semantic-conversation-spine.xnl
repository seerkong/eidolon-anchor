<Behavior #ai-semantic-conversation-spine apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #single-in-memory-truth (
      <Statement ?01M1H67CMXDZGSFCB2SEE7MA8C>
      会话运行期间，Conversation 三域（History、LLM Context、Session）SHALL 是唯一可写的内存事实真源；providerMessages SHALL 由三阶段 materialize（Session 选择、History active tail、Context 变换/overlay）从三域纯投影产出；SHALL NOT 存在与三域平行演化的 provider 消息数组真相；actor.messages SHALL 是 History 域的只读投影视图，SHALL NOT 可写。
      </?01M1H67CMXDZGSFCB2SEE7MA8C>
      <Suites [
        <Suite #truth { name = "Single in-memory truth" } (
          <Cases [
            <Case #provider-context-from-materialize-only [
              <Then ?01M1H67CMXDZGSFCB2SEE7MA8D>
              消息列表 SHALL 来自 MaterializationDerivation 对三域状态的投影
              </?01M1H67CMXDZGSFCB2SEE7MA8D>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA8E>
              SHALL NOT 从裸消息数组、文件、journal 或 snapshot 取数
              </?01M1H67CMXDZGSFCB2SEE7MA8E>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA8F>
              一轮对话需要构造 provider 请求
              </?01M1H67CMXDZGSFCB2SEE7MA8F>
              <When ?01M1H67CMXDZGSFCB2SEE7MA8G>
              系统组装消息列表
              </?01M1H67CMXDZGSFCB2SEE7MA8G>
            )>
            <Case #writes-via-semantic-events [
              <Then ?01M1H67CMXDZGSFCB2SEE7MA8H>
              输入 SHALL 以 semantic 事件进入规范事件流（语义级注入，不经 lexical/syntactic）
              </?01M1H67CMXDZGSFCB2SEE7MA8H>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA8J>
              三域写入 SHALL 只发生在消费该流的 Reducer/MessageAssembly，SHALL NOT 直接 push 任何旁路数组或绕过流直写域
              </?01M1H67CMXDZGSFCB2SEE7MA8J>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA8K>
              用户输入、工具结果或 childDone 结果需要进入对话历史
              </?01M1H67CMXDZGSFCB2SEE7MA8K>
              <When ?01M1H67CMXDZGSFCB2SEE7MA8M>
              消息进入系统
              </?01M1H67CMXDZGSFCB2SEE7MA8M>
            )>
            <Case #compaction-in-domain [
              <Then ?01M1H67CMXDZGSFCB2SEE7MA8N>
              SHALL 通过域 compaction 命令产生 compact generation 与 summary transform
              </?01M1H67CMXDZGSFCB2SEE7MA8N>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA8P>
              SHALL NOT 原地重写消息数组
              </?01M1H67CMXDZGSFCB2SEE7MA8P>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA8Q>
              上下文需要压缩
              </?01M1H67CMXDZGSFCB2SEE7MA8Q>
              <When ?01M1H67CMXDZGSFCB2SEE7MA8R>
              压缩执行
              </?01M1H67CMXDZGSFCB2SEE7MA8R>
            )>
            <Case #equivalence-gate (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA8S>
              Conversation provider context 从 legacy fixed system overlay 迁移为 canonical history 中按时间顺序追加的 typed context fact
              </?01M1H67CMXDZGSFCB2SEE7MA8S>
              <When ?01M1H67CMXDZGSFCB2SEE7MA8T>
              同一脚本化输入序列的 legacy golden 与当前 domain materialization 进入 provider equivalence gate
              </?01M1H67CMXDZGSFCB2SEE7MA8T>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA8V>
              gate SHALL 显式证明 legacy overlay 与 typed fact 的 work-context 语义等价，并对稳定 system roots、普通 history 与完整 tool pairs 保持逐消息严格等价
              </?01M1H67CMXDZGSFCB2SEE7MA8V>
              <Ands [
                <And ?01M1H67CMXDZGSFCB2SEE7MA8W>
                gate SHALL NOT 通过重录 golden、忽略任意 role 或删除普通相邻 user 检查来接受迁移
                </?01M1H67CMXDZGSFCB2SEE7MA8W>
                <And ?01M1H67CMXDZGSFCB2SEE7MA8X>
                只有一个可解析、machine-owned、version-tagged context fact MAY 与普通 user message 相邻；普通 user-user、malformed/duplicate facts、system hoisting 与 tool-pair splitting SHALL 被拒绝
                </?01M1H67CMXDZGSFCB2SEE7MA8X>
              ]>
            )>
            <Case #mirror-eliminated [
              <Then ?01M1H67CMXDZGSFCB2SEE7MA8Y>
              actor.messages SHALL 是 History 域 active tail 的只读冻结投影（facade getter）
              </?01M1H67CMXDZGSFCB2SEE7MA8Y>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA8Z>
              SHALL NOT 存在任何对该视图的写入路径；SHALL NOT 存在从该视图进入 provider 组装的路径（含 prompt-plan 系统通道）；系统提示来源 SHALL 为 actor.systemPrompts 经域命令入 Context 域
              </?01M1H67CMXDZGSFCB2SEE7MA8Z>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA90>
              真源切换与镜像收口完成后检查 actor 表面
              </?01M1H67CMXDZGSFCB2SEE7MA90>
              <When ?01M1H67CMXDZGSFCB2SEE7MA91>
              访问 actor.messages 或检查其写入与消费路径
              </?01M1H67CMXDZGSFCB2SEE7MA91>
            )>
            <Case #writes-via-eventbus-only [
              <Then ?01M1H67CMXDZGSFCB2SEE7MA92>
              appendLiveHistoryMessageToConversationDomainRuntime 的调用点 SHALL 只存在于 MessageHistoryGraph 的 onCommittedMessage 旁路
              </?01M1H67CMXDZGSFCB2SEE7MA92>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA93>
              SHALL NOT 存在 injectSemanticEventsIntoConversationDomain、deliveredViaSemanticStream、emittedOnSemanticStream、committedViaSemanticStream、conversationCommitGraphAttachCount 等旁路与 fence 符号
              </?01M1H67CMXDZGSFCB2SEE7MA93>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA94>
              任何 commit SHALL 由一个前置的 vm.eventBus emit 触发
              </?01M1H67CMXDZGSFCB2SEE7MA94>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA95>
              三域写入入口被收口（P8 single-writer pipeline）
              </?01M1H67CMXDZGSFCB2SEE7MA95>
              <When ?01M1H67CMXDZGSFCB2SEE7MA96>
              检查全仓源码与运行时
              </?01M1H67CMXDZGSFCB2SEE7MA96>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #single-writer-pipeline (
      <Statement ?01M1H67CMXDZGSFCB2SEE7MA97>
      vm.eventBus SHALL 是 semantic 事件在 vm 上的唯一传输；MessageHistoryGraph SHALL 是 vm 上唯一的 commit 入口（消费 eventBus 并写 History 域）；graph SHALL 在 conversation runtime 初始化时常驻 attach，SHALL NOT 以 actor 类型作为 attach 决策依据；非流式来源（childDone、member chat、member coordination、heartbeat、种子、effect 回放）SHALL 通过在 eventBus 上发出合法 semantic 事件序列进入域，SHALL NOT 经任何 inject 旁路直接写域。
      </?01M1H67CMXDZGSFCB2SEE7MA97>
      <Suites [
        <Suite #single-writer { name = "Single-writer pipeline" } (
          <Cases [
            <Case #graph-resident-attach [
              <Then ?01M1H67CMXDZGSFCB2SEE7MA98>
              graph SHALL 处于 attach 状态且其生命周期与 vm 一致
              </?01M1H67CMXDZGSFCB2SEE7MA98>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA99>
              SHALL NOT 以 isHistoryTrackedActor 或类似判断 gate attach 决策
              </?01M1H67CMXDZGSFCB2SEE7MA99>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA9A>
              conversation runtime 初始化完成
              </?01M1H67CMXDZGSFCB2SEE7MA9A>
              <When ?01M1H67CMXDZGSFCB2SEE7MA9B>
              检查 MessageHistoryGraph 的 attach 状态
              </?01M1H67CMXDZGSFCB2SEE7MA9B>
            )>
            <Case #non-streaming-via-eventbus [
              <Then ?01M1H67CMXDZGSFCB2SEE7MA9C>
              SHALL 以 vm.eventBus emit 出合法 semantic 事件序列
              </?01M1H67CMXDZGSFCB2SEE7MA9C>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA9D>
              SHALL NOT 直接调用 messageAssemblyDerivation 或 appendLiveHistoryMessageToConversationDomainRuntime
              </?01M1H67CMXDZGSFCB2SEE7MA9D>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA9E>
              一个非流式来源的事件（childDone / member chat / coordination / heartbeat / 种子 / effect 回放）需要进入域
              </?01M1H67CMXDZGSFCB2SEE7MA9E>
              <When ?01M1H67CMXDZGSFCB2SEE7MA9F>
              该事件被派发
              </?01M1H67CMXDZGSFCB2SEE7MA9F>
            )>
            <Case #persistence-side-effect-gate-preserved [
              <Then ?01M1H67CMXDZGSFCB2SEE7MA9G>
              commit 写域 SHALL 对所有 actor 类型一致生效
              </?01M1H67CMXDZGSFCB2SEE7MA9G>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA9H>
              history persistence 副作用（appendMessage、transcript evidence）SHALL 仍按既有 actor 类型 gate（与写域路径解耦）
              </?01M1H67CMXDZGSFCB2SEE7MA9H>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA9J>
              graph 常驻 attach 后，detached / delegate actor 的事件也经过 graph
              </?01M1H67CMXDZGSFCB2SEE7MA9J>
              <When ?01M1H67CMXDZGSFCB2SEE7MA9K>
              graph 处理这些事件
              </?01M1H67CMXDZGSFCB2SEE7MA9K>
            )>
            <Case #eventbus-required [
              <Then ?01M1H67CMXDZGSFCB2SEE7MA9M>
              SHALL 抛出显式错误并指明缺失原因
              </?01M1H67CMXDZGSFCB2SEE7MA9M>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA9N>
              SHALL NOT 静默走任何 inject 旁路
              </?01M1H67CMXDZGSFCB2SEE7MA9N>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA9P>
              conversation runtime 在缺失 vm.eventBus 的环境中尝试初始化
              </?01M1H67CMXDZGSFCB2SEE7MA9P>
              <When ?01M1H67CMXDZGSFCB2SEE7MA9Q>
              初始化执行
              </?01M1H67CMXDZGSFCB2SEE7MA9Q>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #stage-pipeline-contracts (
      <Statement ?01M1H67CMXDZGSFCB2SEE7MA9R>
      流式加工 pipeline（ingress、lexical、syntactic、semantic）SHALL 保持现有 stage 逻辑不变并获得 DataSubgraphContract；MessageAssembly SHALL 是 semantic 事件到 committed 消息的唯一提交边界；TUI 与观测 SHALL 只读订阅 semantic 流。
      </?01M1H67CMXDZGSFCB2SEE7MA9R>
      <Suites [
        <Suite #pipeline { name = "Stage pipeline contracts" } (
          <Cases [
            <Case #stage-components-declared (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA9S>
              runtime data subgraph registry 构建完成
              </?01M1H67CMXDZGSFCB2SEE7MA9S>
              <When ?01M1H67CMXDZGSFCB2SEE7MA9T>
              查询 stage 组件
              </?01M1H67CMXDZGSFCB2SEE7MA9T>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA9V>
              ingress_stage、lexical_syntactic_stage、semantic_event SHALL 各有 owner 边界与 Not Owned Here
              </?01M1H67CMXDZGSFCB2SEE7MA9V>
            )>
            <Case #message-assembly-single-commit-boundary [
              <Then ?01M1H67CMXDZGSFCB2SEE7MA9W>
              提交 SHALL 只经 MessageAssemblyDerivation 的归并产物
              </?01M1H67CMXDZGSFCB2SEE7MA9W>
              <Then ?01M1H67CMXDZGSFCB2SEE7MA9X>
              SHALL NOT 存在第二个 assistant 消息写入路径
              </?01M1H67CMXDZGSFCB2SEE7MA9X>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MA9Y>
              semantic 流产出 assistant 消息内容
              </?01M1H67CMXDZGSFCB2SEE7MA9Y>
              <When ?01M1H67CMXDZGSFCB2SEE7MA9Z>
              消息提交进入 History 域
              </?01M1H67CMXDZGSFCB2SEE7MA9Z>
            )>
            <Case #observability-two-levels [
              <Then ?01M1H67CMXDZGSFCB2SEE7MAA0>
              流式输出类关注（delta、tool 卡片、actor 消息）SHALL 从 semantic 事件流衍生
              </?01M1H67CMXDZGSFCB2SEE7MAA0>
              <Then ?01M1H67CMXDZGSFCB2SEE7MAA1>
              committed/世代级关注（正式历史、压缩、heads）SHALL 从 MessageAssembly 产物或 History 域衍生，SHALL NOT 混用层级
              </?01M1H67CMXDZGSFCB2SEE7MAA1>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MAA2>
              一个可观测性或 TUI 关注点需要取数
              </?01M1H67CMXDZGSFCB2SEE7MAA2>
              <When ?01M1H67CMXDZGSFCB2SEE7MAA3>
              选择衍生来源
              </?01M1H67CMXDZGSFCB2SEE7MAA3>
            )>
            <Case #projector-not-reads-parser-state [
              <Then ?01M1H67CMXDZGSFCB2SEE7MAA4>
              SHALL 订阅 semantic 事件流
              </?01M1H67CMXDZGSFCB2SEE7MAA4>
              <Then ?01M1H67CMXDZGSFCB2SEE7MAA5>
              SHALL NOT 直读 lexical/syntactic parser state
              </?01M1H67CMXDZGSFCB2SEE7MAA5>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MAA6>
              semantic 层之外的 projector 需要展示流式内容
              </?01M1H67CMXDZGSFCB2SEE7MAA6>
              <When ?01M1H67CMXDZGSFCB2SEE7MAA7>
              projector 取数
              </?01M1H67CMXDZGSFCB2SEE7MAA7>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #recovery-one-way-handoff (
      <Statement ?01M1H67CMXDZGSFCB2SEE7MAA8>
      恢复 SHALL 是显式阶段的单向交接：唯一恢复源为会话文件；一次性水合内存三域；到达切换点后文件 SHALL 退出 live 路径；SHALL NOT 将内存消息反灌三域，SHALL NOT 在 live 运行中回读会话文件，双源 SHALL NOT 同时生效。
      </?01M1H67CMXDZGSFCB2SEE7MAA8>
      <Suites [
        <Suite #recovery { name = "One-way recovery handoff" } (
          <Cases [
            <Case #hydrate-once-then-memory-only [
              <Then ?01M1H67CMXDZGSFCB2SEE7MAA9>
              所有读取 SHALL 来自内存三域
              </?01M1H67CMXDZGSFCB2SEE7MAA9>
              <Then ?01M1H67CMXDZGSFCB2SEE7MAAA>
              任何 live 路径读会话文件 SHALL 视为违例
              </?01M1H67CMXDZGSFCB2SEE7MAAA>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MAAB>
              session 从会话文件完成三域水合并到达切换点
              </?01M1H67CMXDZGSFCB2SEE7MAAB>
              <When ?01M1H67CMXDZGSFCB2SEE7MAAC>
              live 循环继续运行
              </?01M1H67CMXDZGSFCB2SEE7MAAC>
            )>
            <Case #no-bootstrap-backfill (
              <Given ?01M1H67CMXDZGSFCB2SEE7MAAD>
              恢复完成后内存中存在消息状态
              </?01M1H67CMXDZGSFCB2SEE7MAAD>
              <When ?01M1H67CMXDZGSFCB2SEE7MAAE>
              检查三域写入来源
              </?01M1H67CMXDZGSFCB2SEE7MAAE>
              <Then ?01M1H67CMXDZGSFCB2SEE7MAAF>
              SHALL NOT 存在从消息数组向三域的 bootstrap 反灌路径
              </?01M1H67CMXDZGSFCB2SEE7MAAF>
            )>
            <Case #single-recovery-source [
              <Then ?01M1H67CMXDZGSFCB2SEE7MAAG>
              恢复 SHALL 只读会话文件
              </?01M1H67CMXDZGSFCB2SEE7MAAG>
              <Then ?01M1H67CMXDZGSFCB2SEE7MAAH>
              SHALL NOT 存在任何 fallback 来源
              </?01M1H67CMXDZGSFCB2SEE7MAAH>
            ] (
              <Given ?01M1H67CMXDZGSFCB2SEE7MAAJ>
              会话文件与其他持久化产物同时存在
              </?01M1H67CMXDZGSFCB2SEE7MAAJ>
              <When ?01M1H67CMXDZGSFCB2SEE7MAAK>
              选择恢复来源
              </?01M1H67CMXDZGSFCB2SEE7MAAK>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #transcript-complete-removal (
      <Statement ?01M1H67CMXDZGSFCB2SEE7MAAM>
      actor transcript SHALL 被彻底删除：store、contract、写入效应、恢复 fallback、recovery report 来源字段以及 session-upgrade 内的 legacy transcript 读取；SHALL NOT 保留任何演进兼容遗留；仅含 transcript 的旧 session 在升级或恢复时 SHALL 返回显式拒绝错误。
      </?01M1H67CMXDZGSFCB2SEE7MAAM>
      <Suites [
        <Suite #removal { name = "Transcript complete removal" } (
          <Cases [
            <Case #no-transcript-symbols (
              <Given ?01M1H67CMXDZGSFCB2SEE7MAAN>
              本 track 完成后检查运行时与工具源码
              </?01M1H67CMXDZGSFCB2SEE7MAAN>
              <When ?01M1H67CMXDZGSFCB2SEE7MAAP>
              全仓搜索 transcript 符号
              </?01M1H67CMXDZGSFCB2SEE7MAAP>
              <Then ?01M1H67CMXDZGSFCB2SEE7MAAQ>
              ActorTranscript contract、LocalFileActorTranscriptStore、transcript 写入与读取调用 SHALL 不存在
              </?01M1H67CMXDZGSFCB2SEE7MAAQ>
            )>
            <Case #transcript-only-session-rejected [
              <Then ?01M1H67CMXDZGSFCB2SEE7MAAR>
              系统 SHALL 返回显式拒绝错误并说明原因
              </?01M1H67CMXDZGSFCB2SEE7MAAR>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ36>
              SHALL NOT 静默转换或部分恢复
              </?01M1H67CMYQTQMY0P7QF1KMZ36>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ37>
              一个旧 session 只有 legacy transcript 没有会话文件
              </?01M1H67CMYQTQMY0P7QF1KMZ37>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ38>
              尝试升级或恢复
              </?01M1H67CMYQTQMY0P7QF1KMZ38>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #conversation-capsule (
      <Statement ?01M1H67CMYQTQMY0P7QF1KMZ39>
      Conversation runtime SHALL 全量 capsule 化：conversationCapsule 含 coreLogic、adapterRegistry、adapters、internals；持久化实现 SHALL 作为按枚举 id 注册的 adapter；三个 derivation contract（ConversationReducer、MessageAssembly、Materialization）SHALL 在 contract 包声明并运行时断言；capsule SHALL NOT 定义 contract 同名类型。
      </?01M1H67CMYQTQMY0P7QF1KMZ39>
      <Suites [
        <Suite #capsule { name = "Conversation capsule" } (
          <Cases [
            <Case #capsule-structure-holds (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ3A>
              conversationCapsule 完成重构
              </?01M1H67CMYQTQMY0P7QF1KMZ3A>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ3B>
              运行结构 conformance
              </?01M1H67CMYQTQMY0P7QF1KMZ3B>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ3C>
              coreLogic 稳定入口、adapter 枚举布线、internals 隔离、类型留在 contract SHALL 全部成立
              </?01M1H67CMYQTQMY0P7QF1KMZ3C>
            )>
            <Case #derivations-asserted-and-pure (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ3D>
              三个 conversation derivation 实现被注入
              </?01M1H67CMYQTQMY0P7QF1KMZ3D>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ3E>
              断言与源码纯度检查
              </?01M1H67CMYQTQMY0P7QF1KMZ3E>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ3F>
              缺方法 SHALL 报方法名；实现 SHALL 无直接 IO
              </?01M1H67CMYQTQMY0P7QF1KMZ3F>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #tool-result-first-provider-delivery (
      <Statement ?01M1H67CMYQTQMY0P7QF1KMZ3G>
      系统 SHALL 把新提交的 assistant tool call 与 matching tool result 的首次 provider delivery 建模为可持久恢复的显式事实；在该 pair 实际进入一次成功 provider request 之前，任何 compaction 或 persistence SHALL NOT 把结果替换为声称模型已经收到正文的 wrapper；provider failure、abort 与 recovery SHALL 保持其 pending，而 History、ToolCallDomain 和稳定 prompt/cache 前缀 SHALL 保持各自既有所有权。
      </?01M1H67CMYQTQMY0P7QF1KMZ3G>
      <Suites [
        <Suite #tool-result-delivery-lifecycle { name = "Tool result first provider delivery lifecycle" } (
          <Cases [
            <Case #fresh-large-result-survives-preflight-compaction [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ3H>
              matching assistant tool call 与完整 tool result SHALL 保留在该 provider request
              </?01M1H67CMYQTQMY0P7QF1KMZ3H>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ3J>
              系统 SHALL NOT 生成声称该 pending 结果已被模型收到的 artifact wrapper
              </?01M1H67CMYQTQMY0P7QF1KMZ3J>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ3K>
              旧历史已超过 cheap compaction 阈值，且当前轮刚产生一个仍可装入 provider 上限的大工具结果
              </?01M1H67CMYQTQMY0P7QF1KMZ3K>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ3M>
              executor 在下一次 provider call 前应用 compaction
              </?01M1H67CMYQTQMY0P7QF1KMZ3M>
            )>
            <Case #success-confirms-only-included-pairs [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ3N>
              系统 SHALL 只确认该 request 实际包含的 pending pair 为 delivered
              </?01M1H67CMYQTQMY0P7QF1KMZ3N>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ3P>
              后续 compaction MAY 按既有预算外置这些 delivered 结果
              </?01M1H67CMYQTQMY0P7QF1KMZ3P>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ3Q>
              provider request 实际包含一个或多个 pending tool call/result pair
              </?01M1H67CMYQTQMY0P7QF1KMZ3Q>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ3R>
              provider completion 成功
              </?01M1H67CMYQTQMY0P7QF1KMZ3R>
            )>
            <Case #failure-keeps-delivery-pending (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ3S>
              包含 pending pair 的 provider call 失败、中止或未形成成功 completion
              </?01M1H67CMYQTQMY0P7QF1KMZ3S>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ3T>
              系统再次构造 provider request或从 snapshot 恢复
              </?01M1H67CMYQTQMY0P7QF1KMZ3T>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ3V>
              该 pair SHALL 仍有首次完整交付资格并继续受 compaction 保护
              </?01M1H67CMYQTQMY0P7QF1KMZ3V>
            )>
            <Case #artifact-read-converges (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ3W>
              模型读取一个已持久化的大文本 artifact，read 产生新的工具结果
              </?01M1H67CMYQTQMY0P7QF1KMZ3W>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ3X>
              下一次 provider request 构造前应用 compaction
              </?01M1H67CMYQTQMY0P7QF1KMZ3X>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ3Y>
              read 结果 SHALL 至少完整交付一次，且 SHALL NOT 在首次交付前再次外置为下一层 artifact
              </?01M1H67CMYQTQMY0P7QF1KMZ3Y>
            )>
            <Case #legacy-history-remains-compatible (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ3Z>
              恢复的 legacy Conversation 含没有 delivery fact 的旧 tool result
              </?01M1H67CMYQTQMY0P7QF1KMZ3Z>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ40>
              系统应用上下文预算
              </?01M1H67CMYQTQMY0P7QF1KMZ40>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ41>
              旧结果 MAY 按既有 compaction 语义处理，系统 SHALL NOT 强制重投全部 legacy 历史
              </?01M1H67CMYQTQMY0P7QF1KMZ41>
            )>
            <Case #cache-prefix-remains-stable [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ42>
              delivery 动态状态 SHALL 只影响 late conversation materialization 或 runtime metadata
              </?01M1H67CMYQTQMY0P7QF1KMZ42>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ43>
              系统 SHALL NOT 把该状态写入稳定 system instructions 或 provider cache key
              </?01M1H67CMYQTQMY0P7QF1KMZ43>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ44>
              不同轮次具有不同 pending/delivered tool result 集合
              </?01M1H67CMYQTQMY0P7QF1KMZ44>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ45>
              系统构造 stateless provider request
              </?01M1H67CMYQTQMY0P7QF1KMZ45>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #provider-context-state-projection (
      <Statement ?01M1H67CMYQTQMY0P7QF1KMZ46>
      系统 SHALL 让工具产生的可变上下文状态通过工具无关的 projection key、revision 与 source delivery 生命周期进入 provider view；History 与 ToolCallDomain SHALL 保留完整工具事实，而 provider materialization SHALL 在 source call/result 成功交付一次且已有当前 projection 承接后按 tool_call_id 整体消隐旧配对，并且每个 logical key SHALL 只投影当前 revision。
      </?01M1H67CMYQTQMY0P7QF1KMZ46>
      <Suites [
        <Suite #projection-lifecycle { name = "Provider context projection lifecycle" } (
          <Cases [
            <Case #first-delivery-retains-pair [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ47>
              provider messages SHALL 保留完整匹配的 assistant tool call 与 tool result
              </?01M1H67CMYQTQMY0P7QF1KMZ47>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ48>
              系统 SHALL 同时 materialize 当前 projection revision
              </?01M1H67CMYQTQMY0P7QF1KMZ48>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ49>
              一个工具结果首次产生 mutable projection 且 source tool call 尚未被成功 provider completion 消费
              </?01M1H67CMYQTQMY0P7QF1KMZ49>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ4A>
              系统构造下一次 provider request
              </?01M1H67CMYQTQMY0P7QF1KMZ4A>
            )>
            <Case #delivered-pair-elided-as-unit [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ4B>
              系统 SHALL 按 tool_call_id 同时消隐 assistant tool call 与 matching tool result
              </?01M1H67CMYQTQMY0P7QF1KMZ4B>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ4C>
              系统 SHALL NOT 修改 History、ToolCallDomain 或审计 effect
              </?01M1H67CMYQTQMY0P7QF1KMZ4C>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ4D>
              source tool call/result 已随一次成功 provider request 完成交付，且当前 projection 仍可用
              </?01M1H67CMYQTQMY0P7QF1KMZ4D>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ4E>
              系统构造后续 provider request
              </?01M1H67CMYQTQMY0P7QF1KMZ4E>
            )>
            <Case #mixed-tool-call-message-preserved [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ4F>
              系统 SHALL 保留其他 tool call、matching result 以及 assistant content/reasoning
              </?01M1H67CMYQTQMY0P7QF1KMZ4F>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ4G>
              provider messages SHALL NOT 产生孤儿 tool result 或无结果 tool call
              </?01M1H67CMYQTQMY0P7QF1KMZ4G>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ4H>
              一个 assistant message 同时包含已投影 source call 与普通 tool call
              </?01M1H67CMYQTQMY0P7QF1KMZ4H>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ4J>
              provider materializer 消隐已投影 source pair
              </?01M1H67CMYQTQMY0P7QF1KMZ4J>
            )>
            <Case #revision-replaces-current-projection [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ4K>
              系统 SHALL 只 materialize 新 revision，并 SHALL NOT 累积旧 revision state message
              </?01M1H67CMYQTQMY0P7QF1KMZ4K>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ4M>
              projection SHALL 位于 cache-friendly late dynamic insertion boundary
              </?01M1H67CMYQTQMY0P7QF1KMZ4M>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ4N>
              同一 actor 和 logical projection key 产生新 revision
              </?01M1H67CMYQTQMY0P7QF1KMZ4N>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ4P>
              系统构造 provider context
              </?01M1H67CMYQTQMY0P7QF1KMZ4P>
            )>
            <Case #provider-failure-does-not-confirm-delivery (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ4Q>
              包含 undelivered source pair 的 provider call 失败或被中止
              </?01M1H67CMYQTQMY0P7QF1KMZ4Q>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ4R>
              系统再次构造 provider request
              </?01M1H67CMYQTQMY0P7QF1KMZ4R>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ4S>
              该 source pair SHALL 仍被视为 undelivered 并再次完整交付
              </?01M1H67CMYQTQMY0P7QF1KMZ4S>
            )>
            <Case #tool-independent-materializer [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ4T>
              处理逻辑 SHALL 只依赖 projection contract、revision 和 tool_call_id
              </?01M1H67CMYQTQMY0P7QF1KMZ4T>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ4V>
              SHALL NOT 按 TaskTreeWrite、Skill、Read 或其他具体工具名分支
              </?01M1H67CMYQTQMY0P7QF1KMZ4V>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ4W>
              不同工具 producer 发布同一种 mutable projection effect
              </?01M1H67CMYQTQMY0P7QF1KMZ4W>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ4X>
              executor 和 provider materializer 处理这些 effect
              </?01M1H67CMYQTQMY0P7QF1KMZ4X>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #recovered-profile-prompt-reconciliation (
      <Statement ?01M1H67CMYQTQMY0P7QF1KMZ4Y>
      系统 SHALL 在恢复 shell control actor 时，以显式 profile-owned prompt slot/provenance 把该 slot 协调为当前 runtime profile assembly 的 system prompt，同时 SHALL 保留 actor/session/model/work/task/mailbox/History、其他 actor 以及非 profile-owned 自定义 prompt；terminal SHALL NOT 拥有提示词正文或迁移语义。
      </?01M1H67CMYQTQMY0P7QF1KMZ4Y>
      <Suites [
        <Suite #owner-aware-recovery { name = "Owner-aware recovered prompt reconciliation" } (
          <Cases [
            <Case #owned-profile-slot-refreshes [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ4Z>
              系统 SHALL 只把该 owned slot 替换为当前 profile prompt 并更新 provenance
              </?01M1H67CMYQTQMY0P7QF1KMZ4Z>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ50>
              其他 system prompts 与 actor/runtime/conversation 状态 SHALL 保持不变
              </?01M1H67CMYQTQMY0P7QF1KMZ50>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ51>
              snapshot 含 profile-owned prompt slot，且 persisted digest 与 slot 内容匹配
              </?01M1H67CMYQTQMY0P7QF1KMZ51>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ52>
              shell runtime 使用当前 profile assembly 恢复 control actor
              </?01M1H67CMYQTQMY0P7QF1KMZ52>
            )>
            <Case #legacy-empty-or-single-migrates [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ53>
              空 prompt SHALL 插入当前 profile prompt；单 prompt SHALL 被认领为 legacy profile baseline 后替换
              </?01M1H67CMYQTQMY0P7QF1KMZ53>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ54>
              迁移后 SHALL 写入明确的 profile ownership provenance
              </?01M1H67CMYQTQMY0P7QF1KMZ54>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ55>
              legacy shell control actor 没有 prompt provenance，且 system prompts 为空或恰好一条
              </?01M1H67CMYQTQMY0P7QF1KMZ55>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ56>
              系统恢复 snapshot
              </?01M1H67CMYQTQMY0P7QF1KMZ56>
            )>
            <Case #legacy-multiple-prompts-preserved [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ57>
              系统 SHALL 保留全部 prompt，不得猜测 owner 或覆盖内容
              </?01M1H67CMYQTQMY0P7QF1KMZ57>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ58>
              系统 SHALL 发出可观测诊断以提示需要显式迁移
              </?01M1H67CMYQTQMY0P7QF1KMZ58>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ59>
              legacy shell control actor 没有 provenance 且包含多条 system prompts
              </?01M1H67CMYQTQMY0P7QF1KMZ59>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ5A>
              系统恢复 snapshot
              </?01M1H67CMYQTQMY0P7QF1KMZ5A>
            )>
            <Case #workspace-session-resumes-exact-snapshot [
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ5B>
              系统 SHALL 恢复该 session 的 control actor、History、TaskTree 和 mailboxes，而不是创建新 session
              </?01M1H67CMYQTQMY0P7QF1KMZ5B>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ5C>
              当前 profile-owned prompt SHALL 按上述规则协调后进入 provider context
              </?01M1H67CMYQTQMY0P7QF1KMZ5C>
            ] (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ5D>
              CLI 指定存在的 workspace 与 session id，snapshot schema 可恢复且 fiber 位于 idle external boundary
              </?01M1H67CMYQTQMY0P7QF1KMZ5D>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ5E>
              headless exec 启动 runtime turn
              </?01M1H67CMYQTQMY0P7QF1KMZ5E>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #provider-cache-evidence-join (
      <Statement ?01M1H67CMYQTQMY0P7QF1KMZ5F>
      Provider-cache product evidence SHALL be a read-only digest projection of the canonical Conversation, ProviderEpoch, request-admission, ToolCall and final-success usage authorities and SHALL NOT create a second context or transcript authority.
      </?01M1H67CMYQTQMY0P7QF1KMZ5F>
      <Suites [
        <Suite #evidence-authority { name = "Evidence authority and recovery" } (
          <Cases [
            <Case #owner-receipts-not-report-booleans (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ5G>
              a product journey produces request, epoch, retry, tool and recovery observations
              </?01M1H67CMYQTQMY0P7QF1KMZ5G>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ5H>
              the result is admitted
              </?01M1H67CMYQTQMY0P7QF1KMZ5H>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ5J>
              the runner SHALL re-read exact owner receipts and independently derive pass/fail; report-controlled booleans, self-hashes and substituted refs SHALL NOT certify evidence
              </?01M1H67CMYQTQMY0P7QF1KMZ5J>
            )>
            <Case #cross-authority-substitution-fails (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ5K>
              a report or receipt is self-rehashed, replayed, tampered, duplicated or substituted across evidence owner, session, Actor, provider call, attempt, epoch, ToolCall or usage identity
              </?01M1H67CMYQTQMY0P7QF1KMZ5K>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ5M>
              the product verifier independently reloads canonical owners
              </?01M1H67CMYQTQMY0P7QF1KMZ5M>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ5N>
              verification SHALL fail before report admission and SHALL preserve every source authority
              </?01M1H67CMYQTQMY0P7QF1KMZ5N>
            )>
            <Case #conversation-fresh-recovery-exact (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ5P>
              a session is persisted and reconstructed in a fresh runtime
              </?01M1H67CMYQTQMY0P7QF1KMZ5P>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ5Q>
              the next provider request is serialized
              </?01M1H67CMYQTQMY0P7QF1KMZ5Q>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ5R>
              the recovered Actor, Conversation, facet, epoch, pending tool delivery and frozen resource identity SHALL be exact and unchanged same-epoch bytes SHALL retain prefix integrity `1.0`
              </?01M1H67CMYQTQMY0P7QF1KMZ5R>
            )>
            <Case #no-content-leak (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ5S>
              a journey report is persisted or printed
              </?01M1H67CMYQTQMY0P7QF1KMZ5S>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ5T>
              its complete closed shape is inspected
              </?01M1H67CMYQTQMY0P7QF1KMZ5T>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ5V>
              it SHALL contain only identities, digests, lengths, counters, statuses and reasons and SHALL NOT contain prompts, Skill bytes, tool arguments/results, API keys, history or provider transcript
              </?01M1H67CMYQTQMY0P7QF1KMZ5V>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #provider-epoch-projection (
      <Statement ?01M1H67CMYQTQMY0P7QF1KMZ5W>
      跨 provider/protocol 的会话继续 SHALL 由 canonical Conversation/ToolCall facts 派生 durable Provider Epoch 投影；History 与 ToolCallDomain 保持唯一 authority。系统 MUST NOT 直接把旧 provider-native tool framing 当作新 provider 历史，也 MUST NOT 伪造缺失 reasoning。
      </?01M1H67CMYQTQMY0P7QF1KMZ5W>
      <Suites [
        <Suite #cross-provider-switch { name = "跨 provider 会话切换" } (
          <Cases [
            <Case #codex-tool-history-to-deepseek (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ5X>
              已恢复会话含 Codex/OpenAI provider 产生的多轮完整 tool facts，但旧 assistant tool call 没有 DeepSeek reasoning_content。
              </?01M1H67CMYQTQMY0P7QF1KMZ5X>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ5Y>
              用户显式切换到 DeepSeek official 或显式 compatible profile并发送下一轮。
              </?01M1H67CMYQTQMY0P7QF1KMZ5Y>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ5Z>
              系统 SHALL 推进 provider epoch，以 provider-neutral bounded handoff承接 source frontier，并 SHALL NOT把旧 tool framing发送给DeepSeek或注入空 reasoning。
              </?01M1H67CMYQTQMY0P7QF1KMZ5Z>
            )>
            <Case #deepseek-native-round-recovery (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ60>
              DeepSeek 已返回含真实 reasoning_content 的 assistant tool call，matching tool result已提交。
              </?01M1H67CMYQTQMY0P7QF1KMZ60>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ61>
              进程恢复后构造下一次同 profile请求。
              </?01M1H67CMYQTQMY0P7QF1KMZ61>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ62>
              系统 SHALL 精确回放真实 reasoning/tool pair，保持同一epoch，并 SHALL NOT重复工具副作用。
              </?01M1H67CMYQTQMY0P7QF1KMZ62>
            )>
            <Case #epoch-is-projection-not-authority (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ63>
              provider switch 创建了 handoff 与 receipt。
              </?01M1H67CMYQTQMY0P7QF1KMZ63>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ64>
              检查持久化事实和回放来源。
              </?01M1H67CMYQTQMY0P7QF1KMZ64>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ65>
              receipt SHALL 绑定 source frontier digest与target profile；canonical History/ToolCall facts SHALL 保持不变且不存在第二 conversation store。
              </?01M1H67CMYQTQMY0P7QF1KMZ65>
            )>
            <Case #pending-first-delivery-blocks-lossy-switch (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ66>
              一个assistant tool call与matching result具有显式undelivered fact，且目标profile无法在不伪造provider-native字段时完整表达它。
              </?01M1H67CMYQTQMY0P7QF1KMZ66>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ67>
              用户请求跨protocol/provider epoch切换。
              </?01M1H67CMYQTQMY0P7QF1KMZ67>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ68>
              系统 SHALL 在网络发送前typed fail closed，保持pair undelivered，MUST NOT发送outcome summary、确认delivery或再次执行tool。
              </?01M1H67CMYQTQMY0P7QF1KMZ68>
            )>
            <Case #pending-exact-projection-confirms-after-success (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ69>
              显式undelivered pair可由目标profile从canonical facts完整无损投影。
              </?01M1H67CMYQTQMY0P7QF1KMZ69>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ6A>
              目标provider成功完成包含该pair的request。
              </?01M1H67CMYQTQMY0P7QF1KMZ6A>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ6B>
              系统 SHALL 仅在成功completion后确认delivery；admission、transport或provider失败后仍保持pending。
              </?01M1H67CMYQTQMY0P7QF1KMZ6B>
            )>
            <Case #legacy-history-handoff (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ6C>
              恢复的legacy history含旧completed tool pair但没有新式delivery fact。
              </?01M1H67CMYQTQMY0P7QF1KMZ6C>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ6D>
              跨provider epoch构造handoff。
              </?01M1H67CMYQTQMY0P7QF1KMZ6D>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ6E>
              系统 MAY 按既有legacy兼容规则承接这些完成事实，SHALL NOT强制重跑全部legacy tool或制造新的pending delivery。
              </?01M1H67CMYQTQMY0P7QF1KMZ6E>
            )>
          ]>
        )>
        <Suite #closed-provider-request { name = "Closed provider request" } (
          <Cases [
            <Case #safe-admission-diagnostic (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ6F>
              provider message含 accessor、undefined、custom prototype或其他非 JSON own-data。
              </?01M1H67CMYQTQMY0P7QF1KMZ6F>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ6G>
              request admission在网络发送前拒绝请求。
              </?01M1H67CMYQTQMY0P7QF1KMZ6G>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ6H>
              typed diagnostic SHALL 只包含 rejection code、safe JSON pointer/value kind与request digest，MUST NOT包含prompt、args、output、credential或完整body。
              </?01M1H67CMYQTQMY0P7QF1KMZ6H>
            )>
            <Case #runtime-metadata-not-on-wire (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ6J>
              runtime已解析model capabilities与cache policy。
              </?01M1H67CMYQTQMY0P7QF1KMZ6J>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ6K>
              DeepSeek request投影为wire body。
              </?01M1H67CMYQTQMY0P7QF1KMZ6K>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ6M>
              这些runtime observation SHALL NOT作为未声明的model_capabilities或cache_profile字段发送给provider。
              </?01M1H67CMYQTQMY0P7QF1KMZ6M>
            )>
            <Case #adapter-owned-protocol-profile (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ6N>
              多个provider配置都选择DeepSeek adapter，但provider id、endpoint和model不同。
              </?01M1H67CMYQTQMY0P7QF1KMZ6N>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ6P>
              driver构造provider request。
              </?01M1H67CMYQTQMY0P7QF1KMZ6P>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ6Q>
              系统 SHALL 由adapter统一选择`deepseek-chat@1`，MUST NOT要求provider配置profile或从URL、model、provider id推断协议语义；旧official/compatible id只可在恢复边界归一化。
              </?01M1H67CMYQTQMY0P7QF1KMZ6Q>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #cache-stable-dynamic-authority (
      <Statement ?01M1H67CMYQTQMY0P7QF1KMZ6R>
      Mutable runtime guidance that changes during a forward-only stable-prefix conversation MUST be represented as an append-only conversation fact or an explicit new cache epoch; it MUST NOT silently replace an earlier root prompt while claiming the same epoch.
      </?01M1H67CMYQTQMY0P7QF1KMZ6R>
      <Suites [
        <Suite #dynamic-authority-placement { name = "Dynamic authority placement" } (
          <Cases [
            <Case #workflow-stage-is-history-fact (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ6S>
              A trusted Workflow stage loader reads exact stage authority.
              </?01M1H67CMYQTQMY0P7QF1KMZ6S>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ6T>
              The stage changes during the same provider epoch.
              </?01M1H67CMYQTQMY0P7QF1KMZ6T>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ6V>
              The new authority SHALL be appended through the single-writer conversation pipeline and previous stage transitions SHALL remain historical facts.
              </?01M1H67CMYQTQMY0P7QF1KMZ6V>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #provider-context-epoch-integrity (
      <Statement ?01M1H67CMYQTQMY0P7QF1KMZ6W>
      Conversation Domain SHALL own one immutable provider-context receipt per epoch; append-only turns reuse it exactly, and every non-append prefix change SHALL advance a monotonic epoch with a persisted closed reason before provider transport.
      </?01M1H67CMYQTQMY0P7QF1KMZ6W>
      <Suites [
        <Suite #epoch-transition { name = "Provider context epoch transition" } (
          <Cases [
            <Case #same-epoch-receipt-immutable (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ6X>
              provider/model/profile, source heads and accepted frozen revisions are unchanged
              </?01M1H67CMYQTQMY0P7QF1KMZ6X>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ6Y>
              user, assistant, tool or typed context facts append
              </?01M1H67CMYQTQMY0P7QF1KMZ6Y>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ6Z>
              the epoch-baseline receipt SHALL remain byte-equivalent; each successful request SHALL append a request-admission receipt for current descendant heads/final wire, and reconciliation SHALL validate rather than rewrite source or handoff digests
              </?01M1H67CMYQTQMY0P7QF1KMZ6Z>
            )>
            <Case #non-append-requires-reason (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ70>
              compaction, rewind/fork, provider/model/profile switch or accepted frozen resource/surface revision changes retained provider bytes
              </?01M1H67CMYQTQMY0P7QF1KMZ70>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ71>
              the next request is admitted
              </?01M1H67CMYQTQMY0P7QF1KMZ71>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ72>
              one runtime-first Conversation transition SHALL create the next receipt with exact predecessor digest and one closed reason before transport
              </?01M1H67CMYQTQMY0P7QF1KMZ72>
            )>
            <Case #head-and-receipt-atomic (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ73>
              a compaction or rewind changes the history head and requires a successor epoch receipt
              </?01M1H67CMYQTQMY0P7QF1KMZ73>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ74>
              the local authority is interrupted before or after each stage、fsync、publish or head-CAS boundary
              </?01M1H67CMYQTQMY0P7QF1KMZ74>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ75>
              fresh recovery SHALL observe either the exact old head and receipt or the exact new transition batch, never a mixed authority
              </?01M1H67CMYQTQMY0P7QF1KMZ75>
            )>
            <Case #compacted-delivery-proof-recoverable (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ76>
              a delivered tool pair owns the first delivery of a retained context fact
              </?01M1H67CMYQTQMY0P7QF1KMZ76>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ77>
              an epoch-advancing compaction removes that pair
              </?01M1H67CMYQTQMY0P7QF1KMZ77>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ78>
              the atomic transition SHALL persist a proof binding source fact、pair records、successful request admission and successor fact; fresh recovery SHALL verify it before publishing the successor head
              </?01M1H67CMYQTQMY0P7QF1KMZ78>
            )>
            <Case #semantic-namespace-alias-migration (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ79>
              a retained legacy context fact has a canonical semantic namespace successor
              </?01M1H67CMYQTQMY0P7QF1KMZ79>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ7A>
              an explicit compaction creates the next epoch
              </?01M1H67CMYQTQMY0P7QF1KMZ7A>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ7B>
              a versioned proof SHALL bind source namespace、successor namespace、unchanged payload identity and exact delivery provenance; v1 same-namespace proofs SHALL remain readable and all new proofs SHALL use v2
              </?01M1H67CMYQTQMY0P7QF1KMZ7B>
            )>
            <Case #unexplained-divergence-fails (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ7C>
              current canonical source no longer matches the immutable receipt and no transition was admitted
              </?01M1H67CMYQTQMY0P7QF1KMZ7C>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ7D>
              provider projection is requested
              </?01M1H67CMYQTQMY0P7QF1KMZ7D>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ7E>
              the system SHALL fail closed without mutating the receipt, sending a request or fabricating a cache observation
              </?01M1H67CMYQTQMY0P7QF1KMZ7E>
            )>
            <Case #provider-context-fresh-recovery-exact (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ7F>
              typed context facts and the current epoch receipt were persisted
              </?01M1H67CMYQTQMY0P7QF1KMZ7F>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ7G>
              a fresh process reconstructs the Actor and Conversation
              </?01M1H67CMYQTQMY0P7QF1KMZ7G>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ7H>
              it SHALL reuse exact valid facts and receipt, or execute the explicit bounded legacy importer; it SHALL NOT infer an epoch reason from prompt text
              </?01M1H67CMYQTQMY0P7QF1KMZ7H>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #generic-actor-context-policy (
      <Statement ?01M1H67CMYQTQMY0P7QF1KMZ7J>
      Every multi-turn AI actor SHALL participate in provider-context budgeting through an actor-owned generic context policy independent of actor role, agent type, tool name or product name, while Conversation and History authorities remain unchanged.
      </?01M1H67CMYQTQMY0P7QF1KMZ7J>
      <Suites [
        <Suite #actor-policy { name = "Generic actor context policy" } (
          <Cases [
            <Case #delegate-auto-compaction (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ7K>
              A delegate or detached actor is configured for multiple provider turns
              </?01M1H67CMYQTQMY0P7QF1KMZ7K>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ7M>
              Its materialized provider context approaches the configured budget
              </?01M1H67CMYQTQMY0P7QF1KMZ7M>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ7N>
              The executor SHALL apply the same generic compaction and resource-delivery mechanisms used by other multi-turn actors
              </?01M1H67CMYQTQMY0P7QF1KMZ7N>
            )>
            <Case #short-lived-explicit-opt-out (
              <Given ?01M1H67CMYQTQMY0P7QF1KMZ7P>
              An actor is explicitly configured as a one-tool short-lived execution
              </?01M1H67CMYQTQMY0P7QF1KMZ7P>
              <When ?01M1H67CMYQTQMY0P7QF1KMZ7Q>
              context policy is resolved
              </?01M1H67CMYQTQMY0P7QF1KMZ7Q>
              <Then ?01M1H67CMYQTQMY0P7QF1KMZ7R>
              The actor MAY disable history compaction through the generic actor contract rather than an agent-name special case
              </?01M1H67CMYQTQMY0P7QF1KMZ7R>
            )>
            <Case #no-workflow-specific-compressor [
              <Then ?01M1H67CMZCWJDY9F92K525V73>
              They SHALL reuse Conversation materialization, ContextCompressor and generic delivery facts
              </?01M1H67CMZCWJDY9F92K525V73>
              <Then ?01M1H67CMZCWJDY9F92K525V74>
              The system MUST NOT create a workflow-specific history, compactor, cache or tool-name branch
              </?01M1H67CMZCWJDY9F92K525V74>
            ] (
              <Given ?01M1H67CMZCWJDY9F92K525V75>
              AI Workflow actors exercise context budgeting
              </?01M1H67CMZCWJDY9F92K525V75>
              <When ?01M1H67CMZCWJDY9F92K525V76>
              The runtime source and facts are inspected
              </?01M1H67CMZCWJDY9F92K525V76>
            )>
            <Case #first-delivery-protection-preserved (
              <Given ?01M1H67CMZCWJDY9F92K525V77>
              A large tool result has not yet completed its first successful provider delivery
              </?01M1H67CMZCWJDY9F92K525V77>
              <When ?01M1H67CMZCWJDY9F92K525V78>
              A delegate context budget is applied
              </?01M1H67CMZCWJDY9F92K525V78>
              <Then ?01M1H67CMZCWJDY9F92K525V79>
              The existing pending-first-delivery protection SHALL remain effective
              </?01M1H67CMZCWJDY9F92K525V79>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #conversation-native-session-fork (
      <Statement ?01M1H67CMZCWJDY9F92K525V7A>
      Conversation Domain SHALL own session fork as one closed child-authority transition over canonical History, Prompt, Session lineage and provider-context baseline; surfaces MUST NOT create fork truth by copying rendered messages or runtime projections.
      </?01M1H67CMZCWJDY9F92K525V7A>
      <Suites [
        <Suite #fork-authority { name = "Conversation-native session fork" } (
          <Cases [
            <Case #fork-current-head (
              <Given ?01M1H67CMZCWJDY9F92K525V7B>
              source session具有可恢复的canonical History head、Prompt head与Session binding
              </?01M1H67CMZCWJDY9F92K525V7B>
              <When ?01M1H67CMZCWJDY9F92K525V7C>
              调用domain capability从当前head创建child session
              </?01M1H67CMZCWJDY9F92K525V7C>
              <Then ?01M1H67CMZCWJDY9F92K525V7D>
              child SHALL获得语义等价且身份重绑定的History/Prompt authority、独立heads与parent lineage；source SHALL保持byte-equivalent且父子后续append相互独立
              </?01M1H67CMZCWJDY9F92K525V7D>
            )>
            <Case #fork-through-committed-message (
              <Given ?01M1H67CMZCWJDY9F92K525V7E>
              指定message id可唯一映射到canonical committed-message record，且目标History prefix、Prompt basis与完整tool-pair边界均可证明
              </?01M1H67CMZCWJDY9F92K525V7E>
              <When ?01M1H67CMZCWJDY9F92K525V7F>
              调用domain capability从该消息边界创建child session
              </?01M1H67CMZCWJDY9F92K525V7F>
              <Then ?01M1H67CMZCWJDY9F92K525V7G>
              child SHALL只包含截至该边界的canonical上下文，MUST NOT包含后续消息、拆开的tool pair或包含未来事实的Prompt transform
              </?01M1H67CMZCWJDY9F92K525V7G>
            )>
            <Case #unprovable-compaction-boundary-rejected (
              <Given ?01M1H67CMZCWJDY9F92K525V7H>
              目标消息跨越compaction边界，且准确Prompt generation或等价重建证据缺失、歧义或digest不匹配
              </?01M1H67CMZCWJDY9F92K525V7H>
              <When ?01M1H67CMZCWJDY9F92K525V7J>
              系统解析message-level fork point
              </?01M1H67CMZCWJDY9F92K525V7J>
              <Then ?01M1H67CMZCWJDY9F92K525V7K>
              系统 SHALL fail closed并返回typed rejection，MUST NOT创建、发布或导航到空白或部分child session
              </?01M1H67CMZCWJDY9F92K525V7K>
            )>
            <Case #fork-publish-is-atomic (
              <Given ?01M1H67CMZCWJDY9F92K525V7M>
              child-authority初始化在stage、append、fsync、index publish或head CAS任一边界被中断
              </?01M1H67CMZCWJDY9F92K525V7M>
              <When ?01M1H67CMZCWJDY9F92K525V7N>
              fresh process恢复source与target session
              </?01M1H67CMZCWJDY9F92K525V7N>
              <Then ?01M1H67CMZCWJDY9F92K525V7P>
              恢复结果 SHALL是source不变且target不存在，或source不变且target三域authority与child provider receipt/epoch baseline共同完整；MUST NOT出现lineage已发布但History/Prompt head为空、或Conversation可hydrate但provider epoch不可运行的混合状态
              </?01M1H67CMZCWJDY9F92K525V7P>
            )>
            <Case #fork-source-and-target-cas (
              <Given ?01M1H67CMZCWJDY9F92K525V7Q>
              fork point已规划，但source authority或target transaction ownership在提交前发生竞争变化
              </?01M1H67CMZCWJDY9F92K525V7Q>
              <When ?01M1H67CMZCWJDY9F92K525V7R>
              runtime执行提交前source重读与durable target claim
              </?01M1H67CMZCWJDY9F92K525V7R>
              <Then ?01M1H67CMZCWJDY9F92K525V7S>
              source digest不一致或不同target claim SHALL fail closed且不得发布child；相同immutable transaction SHALL可幂等恢复
              </?01M1H67CMZCWJDY9F92K525V7S>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #conversation-native-rewind (
      <Statement ?01M1H67CMZCWJDY9F92K525V7T>
      Conversation Domain SHALL own message rewind as one closed transition over canonical History、Prompt、Session heads and provider-context epoch；surface projections MUST NOT create rewind truth by truncating rendered message arrays.
      </?01M1H67CMZCWJDY9F92K525V7T>
      <Suites [
        <Suite #rewind-authority { name = "Conversation-native rewind" } (
          <Cases [
            <Case #rewind-through-canonical-message (
              <Given ?01M1H67CMZCWJDY9F92K525V7V>
              an active History message uniquely resolves and its Prompt/tool boundary is provable
              </?01M1H67CMZCWJDY9F92K525V7V>
              <When ?01M1H67CMZCWJDY9F92K525V7W>
              the session is rewound through that message
              </?01M1H67CMZCWJDY9F92K525V7W>
              <Then ?01M1H67CMZCWJDY9F92K525V7X>
              a new rollback generation and restore Prompt SHALL become the same-session heads，and all later canonical messages MUST be unreachable from the active frontier
              </?01M1H67CMZCWJDY9F92K525V7X>
            )>
            <Case #rewind-unprovable-rejected (
              <Given ?01M1H67CMZCWJDY9F92K525V7Y>
              the selector is missing、ambiguous、inside an open tool pair or behind an unproven compaction boundary
              </?01M1H67CMZCWJDY9F92K525V7Y>
              <When ?01M1H67CMZCWJDY9F92K525V7Z>
              rewind is requested
              </?01M1H67CMZCWJDY9F92K525V7Z>
              <Then ?01M1H67CMZCWJDY9F92K525V80>
              the command SHALL return a typed rejection without changing any authority or surface projection
              </?01M1H67CMZCWJDY9F92K525V80>
            )>
            <Case #rewind-publish-atomic (
              <Given ?01M1H67CMZCWJDY9F92K525V81>
              History、Prompt、Session or provider epoch publication is interrupted
              </?01M1H67CMZCWJDY9F92K525V81>
              <When ?01M1H67CMZCWJDY9F92K525V82>
              a fresh process recovers
              </?01M1H67CMZCWJDY9F92K525V82>
              <Then ?01M1H67CMZCWJDY9F92K525V83>
              it SHALL observe the complete old authority or complete rewound authority，never mixed heads
              </?01M1H67CMZCWJDY9F92K525V83>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
