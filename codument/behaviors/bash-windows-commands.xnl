<Behavior #bash-windows-commands apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #windows-safe-commands (
      <Statement ?01M05F1P1S36QM61Y5XM992E8K>
      bash 工具 SHALL 对 Windows 常用只读命令提供 workspace-safe 豁免（无 permissions.json 时不 deny），并 SHALL 在工具说明中补充 Windows 命令提示（用 dir/where/type 替代 ls/find/grep，用 cmd /c、powershell -Command 运行命令）。
      </?01M05F1P1S36QM61Y5XM992E8K>
      <Suites [
        <Suite #bash-windows-safe { name = "Bash Windows-safe commands" } (
          <Cases [
            <Case #windows-readonly-commands (
              <Given ?01M05F1P1S36QM61Y5XM992E8M>
              本地权限规则为空（无 permissions.json）
              </?01M05F1P1S36QM61Y5XM992E8M>
              <When ?01M05F1P1S36QM61Y5XM992E8N>
              执行 dir/where/type/findstr/git（只读形式）
              </?01M05F1P1S36QM61Y5XM992E8N>
              <Then ?01M05F1P1S36QM61Y5XM992E8P>
              SHALL NOT 被 local permission deny
              </?01M05F1P1S36QM61Y5XM992E8P>
            )>
            <Case #detail-prompt-windows-hint (
              <Given ?01M05F1P1S36QM61Y5XM992E8Q>
              运行平台是 win32
              </?01M05F1P1S36QM61Y5XM992E8Q>
              <When ?01M05F1P1S36QM61Y5XM992E8R>
              查看 bash 工具说明
              </?01M05F1P1S36QM61Y5XM992E8R>
              <Then ?01M05F1P1S36QM61Y5XM992E8S>
              SHALL 包含 Windows 命令替代提示
              </?01M05F1P1S36QM61Y5XM992E8S>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
