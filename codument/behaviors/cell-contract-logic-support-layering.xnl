<Behavior #cell-contract-logic-support-layering apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #cell-contract-support-logic (
      <Statement ?01M05F1P1TTZVQR6AVN5GVN31R>
      系统应当（SHALL）将 `cell` 中的数据与接口定义收敛到 `*-contract`，将环境相关副作用实现收敛到 ownership 对应的 support 宿主包，并让其他纯逻辑保留在 `*-logic`。
      </?01M05F1P1TTZVQR6AVN5GVN31R>
      <Suites [
        <Suite { name = "cell-contract-support-logic" } (
          <Cases [
            <Case #case-1 { name = "数据与接口定义不再留在逻辑层" } [
              <Then ?01M05F1P1TTZVQR6AVN5GVN31S>
              数据结构与接口定义应位于对应的 `*-contract`
              </?01M05F1P1TTZVQR6AVN5GVN31S>
              <Then ?01M05F1P1TTZVQR6AVN5GVN31T>
              不应继续把正式接口定义留在 `ai-core-logic` 或 `ai-organ-logic`
              </?01M05F1P1TTZVQR6AVN5GVN31T>
            ] (
              <Given ?01M05F1P1TTZVQR6AVN5GVN31V>
              某个 module 当前同时包含数据结构、接口定义与本地文件实现
              </?01M05F1P1TTZVQR6AVN5GVN31V>
              <When ?01M05F1P1TTZVQR6AVN5GVN31W>
              完成本次边界重构
              </?01M05F1P1TTZVQR6AVN5GVN31W>
            )>
            <Case #case-2 { name = "环境实现不再直接留在逻辑层" } [
              <Then ?01M05F1P1TTZVQR6AVN5GVN31X>
              该副作用的环境实现应位于 `ai-support` 或 `platform-support`
              </?01M05F1P1TTZVQR6AVN5GVN31X>
              <Then ?01M05F1P1TTZVQR6AVN5GVN31Y>
              `*-logic` 不应继续直接持有该环境 backend 的正式实现
              </?01M05F1P1TTZVQR6AVN5GVN31Y>
            ] (
              <Given ?01M05F1P1TTZVQR6AVN5GVN31Z>
              某个副作用当前直接依赖本地文件、home 配置目录或 session 目录布局
              </?01M05F1P1TTZVQR6AVN5GVN31Z>
              <When ?01M05F1P1TTZVQR6AVN5GVN320>
              完成本次边界重构
              </?01M05F1P1TTZVQR6AVN5GVN320>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #ai-core-logic-ai-core-contract (
      <Statement ?01M05F1P1TTZVQR6AVN5GVN321>
      系统应当（SHALL）将 `ai-core-logic` 所依赖的副作用接口先定义到 `ai-core-contract`，再由 ownership 对应的 support 宿主提供具体实现。
      </?01M05F1P1TTZVQR6AVN5GVN321>
      <Suites [
        <Suite { name = "ai-core-logic-ai-core-contract" } (
          <Cases [
            <Case #core-runtime-persistence-effects-ai-core-contract { name = "core runtime persistence effects 经由 ai-core-contract 暴露" } [
              <Then ?01M05F1P1TTZVQR6AVN5GVN322>
              这些副作用接口应先由 `ai-core-contract` 定义
              </?01M05F1P1TTZVQR6AVN5GVN322>
              <Then ?01M05F1P1TTZVQR6AVN5GVN323>
              `ai-core-logic` 应通过这些 contract 使用持久化能力，而不是直接依赖本地文件实现
              </?01M05F1P1TTZVQR6AVN5GVN323>
            ] (
              <Given ?01M05F1P1TTZVQR6AVN5GVN324>
              `ai-core-logic` 需要消息历史、编排历史、actor transcript 或 runtime snapshot 的持久化能力
              </?01M05F1P1TTZVQR6AVN5GVN324>
              <When ?01M05F1P1TTZVQR6AVN5GVN325>
              完成本次重构
              </?01M05F1P1TTZVQR6AVN5GVN325>
            )>
            <Case #core-ai-core-contract { name = "core 配置加载经由 ai-core-contract 暴露" } [
              <Then ?01M05F1P1TTZVQR6AVN5GVN326>
              相关副作用接口应位于 `ai-core-contract`
              </?01M05F1P1TTZVQR6AVN5GVN326>
              <Then ?01M05F1P1TTZVQR6AVN5GVN327>
              文件系统扫描与 home 目录读取实现应由 `ai-support` 或 `platform-support` 提供
              </?01M05F1P1TTZVQR6AVN5GVN327>
            ] (
              <Given ?01M05F1P1TTZVQR6AVN5GVN328>
              `ai-core-logic` 需要读取模型配置、skill 目录或其他环境来源配置
              </?01M05F1P1TTZVQR6AVN5GVN328>
              <When ?01M05F1P1TTZVQR6AVN5GVN329>
              完成本次重构
              </?01M05F1P1TTZVQR6AVN5GVN329>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #ai-organ-logic-ai-organ-contract (
      <Statement ?01M05F1P1TTZVQR6AVN5GVN32A>
      系统应当（SHALL）将 `ai-organ-logic` 专属的副作用接口定义到 `ai-organ-contract`，并由 `ai-support` 承载当前环境下的正式实现。
      </?01M05F1P1TTZVQR6AVN5GVN32A>
      <Suites [
        <Suite { name = "ai-organ-logic-ai-organ-contract" } (
          <Cases [
            <Case #ai-organ-contract { name = "本地权限配置读写边界进入 ai-organ-contract" } [
              <Then ?01M05F1P1TTZVQR6AVN5GVN32B>
              这些配置接口与数据定义应位于 `ai-organ-contract`
              </?01M05F1P1TTZVQR6AVN5GVN32B>
              <Then ?01M05F1P1TTZVQR6AVN5GVN32C>
              `~/.eidolon` 本地文件实现应位于 `ai-support`
              </?01M05F1P1TTZVQR6AVN5GVN32C>
            ] (
              <Given ?01M05F1P1TTZVQR6AVN5GVN32D>
              `ai-organ-logic` 需要读取和写回权限配置与 workspace access 配置
              </?01M05F1P1TTZVQR6AVN5GVN32D>
              <When ?01M05F1P1TTZVQR6AVN5GVN32E>
              完成本次重构
              </?01M05F1P1TTZVQR6AVN5GVN32E>
            )>
            <Case #agent-loader-ai-organ-contract { name = "agent loader 等组织层环境读取进入 ai-organ-contract" } [
              <Then ?01M05F1P1TTZVQR6AVN5GVN32F>
              这些读取接口应位于 `ai-organ-contract`
              </?01M05F1P1TTZVQR6AVN5GVN32F>
              <Then ?01M05F1P1TTZVQR6AVN5GVN32G>
              目录扫描与文件读取实现应位于 `ai-support`
              </?01M05F1P1TTZVQR6AVN5GVN32G>
            ] (
              <Given ?01M05F1P1TTZVQR6AVN5GVN32H>
              `ai-organ-logic` 需要从目录中加载 agent config 或其他组织层环境资源
              </?01M05F1P1TTZVQR6AVN5GVN32H>
              <When ?01M05F1P1TTZVQR6AVN5GVN32J>
              完成本次重构
              </?01M05F1P1TTZVQR6AVN5GVN32J>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #requirement-4 (
      <Statement ?01M05F1P1TTZVQR6AVN5GVN32K>
      系统应当（SHALL）只将第一批高确定性、边界清晰的副作用实现纳入本次重构，而不是一刀切处理所有带副作用的模块。
      </?01M05F1P1TTZVQR6AVN5GVN32K>
      <Suites [
        <Suite { name = "requirement-4" } (
          <Cases [
            <Case #case-7 { name = "第一批迁移项以范围文件为准" } [
              <Then ?01M05F1P1TTZVQR6AVN5GVN32M>
              消息历史、编排历史、actor transcript、runtime snapshot、权限配置、agent/skill/config loader 的副作用边界应优先纳入
              </?01M05F1P1TTZVQR6AVN5GVN32M>
              <Then ?01M05F1P1TTZVQR6AVN5GVN32N>
              范围锁定应以 `in-scope-organ-support-migrations.md` 为正式清单
              </?01M05F1P1TTZVQR6AVN5GVN32N>
            ] (
              <Given ?01M05F1P1TTZVQR6AVN5GVN32P>
              当前 track 已声明第一批高确定性迁移项
              </?01M05F1P1TTZVQR6AVN5GVN32P>
              <When ?01M05F1P1TTZVQR6AVN5GVN32Q>
              团队推进本次重构
              </?01M05F1P1TTZVQR6AVN5GVN32Q>
            )>
            <Case #mixed-module { name = "mixed module 允许按职责拆分" } [
              <Then ?01M05F1P1TTZVQR6AVN5GVN32R>
              系统可以按职责拆分 contract / support / logic
              </?01M05F1P1TTZVQR6AVN5GVN32R>
              <Then ?01M05F1P1TTZVQR6AVN5GVN32S>
              不要求整文件机械平移到某一个 support 包
              </?01M05F1P1TTZVQR6AVN5GVN32S>
            ] (
              <Given ?01M05F1P1TTZVQR6AVN5GVN32T>
              某个文件同时包含副作用实现与纯逻辑
              </?01M05F1P1TTZVQR6AVN5GVN32T>
              <When ?01M05F1P1TTZVQR6AVN5GVN32V>
              该文件被纳入第一批迁移
              </?01M05F1P1TTZVQR6AVN5GVN32V>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #requirement-5 (
      <Statement ?01M05F1P1VXD02NDRM79F7W7AF>
      系统应当（SHALL）在本次 track 中保持明确的非范围约束，避免把更大规模的环境 backend 重构混入第一批 contract/support layering 改造。
      </?01M05F1P1VXD02NDRM79F7W7AF>
      <Suites [
        <Suite { name = "requirement-5" } (
          <Cases [
            <Case #llm-http-adapter { name = "LLM HTTP adapter 不在本次改造范围" } [
              <Then ?01M05F1P1VXD02NDRM79F7W7AG>
              系统不得要求本轮同时迁移这些 adapter
              </?01M05F1P1VXD02NDRM79F7W7AG>
              <Then ?01M05F1P1VXD02NDRM79F7W7AH>
              这些模块应保持在后续独立 track 中再处理
              </?01M05F1P1VXD02NDRM79F7W7AH>
            ] (
              <Given ?01M05F1P1VXD02NDRM79F7W7AJ>
              `ai-organ-logic/src/llm/*` 中存在基于 `fetch` 的 provider adapter
              </?01M05F1P1VXD02NDRM79F7W7AJ>
              <When ?01M05F1P1VXD02NDRM79F7W7AK>
              推进本次 track
              </?01M05F1P1VXD02NDRM79F7W7AK>
            )>
            <Case #case-10 { name = "本地文件与进程工具实现不在本次改造范围" } [
              <Then ?01M05F1P1VXD02NDRM79F7W7AM>
              系统不得要求本轮同时迁移这些工具实现
              </?01M05F1P1VXD02NDRM79F7W7AM>
              <Then ?01M05F1P1VXD02NDRM79F7W7AN>
              本轮应保持范围只覆盖已锁定的高确定性副作用实现
              </?01M05F1P1VXD02NDRM79F7W7AN>
            ] (
              <Given ?01M05F1P1VXD02NDRM79F7W7AP>
              `Read`、`Write`、`Edit`、`Bash` 等工具当前直接操作 `fs` 或 `child_process`
              </?01M05F1P1VXD02NDRM79F7W7AP>
              <When ?01M05F1P1VXD02NDRM79F7W7AQ>
              推进本次 track
              </?01M05F1P1VXD02NDRM79F7W7AQ>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #runtime-entry-support (
      <Statement ?01M05F1P1VXD02NDRM79F7W7AR>
      系统应当（SHALL）让 runtime entry 通过显式装配正式 support 宿主来获得环境能力，而不是继续从逻辑层直接拿本地文件默认实现。
      </?01M05F1P1VXD02NDRM79F7W7AR>
      <Suites [
        <Suite { name = "runtime-entry-support" } (
          <Cases [
            <Case #terminal-runtime { name = "terminal runtime 不再直接依赖逻辑层本地文件实现" } [
              <Then ?01M05F1P1VXD02NDRM79F7W7AS>
              runtime entry 应显式装配来自 `ai-support` 或 `platform-support` 的实现
              </?01M05F1P1VXD02NDRM79F7W7AS>
              <Then ?01M05F1P1VXD02NDRM79F7W7AT>
              不应继续把逻辑层中的本地实现作为默认正式 backend
              </?01M05F1P1VXD02NDRM79F7W7AT>
            ] (
              <Given ?01M05F1P1VXD02NDRM79F7W7AV>
              `TerminalRuntime` 当前直接消费 `createLocalFileMessageHistoryEffects`、`createLocalFileOrchestrationHistoryEffects`、`AgentLoader` 或等价本地实现
              </?01M05F1P1VXD02NDRM79F7W7AV>
              <When ?01M05F1P1VXD02NDRM79F7W7AW>
              完成本次重构
              </?01M05F1P1VXD02NDRM79F7W7AW>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
