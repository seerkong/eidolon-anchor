<Behavior #complete-runtime-evolution-migration apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #legacy-write-path-removed (
      <Statement ?01M05F1P1XTG5GHDDD900NZ7XY>
      旧的平行 persistence/conversation/transcript/effect writer 路径 SHALL 被删除，不保留 compat shim。具体：已 no-op 的 MessageHistoryEffects 端口（LocalFileMessageHistoryEffects + 其 port hop 与 executor 调用点）SHALL 被移除。upgrade 必需的 legacy 迁移 reader 与脏数据拒绝守卫 SHALL NOT 被当作 shim 删除（它们是迁移机制，保留）。
      </?01M05F1P1XTG5GHDDD900NZ7XY>
      <Suites [
        <Suite #no-shim { name = "No compat shim retained" } (
          <Cases [
            <Case #message-history-effects-removed [
              <Then ?01M05F1P1XTG5GHDDD900NZ7XZ>
              LocalFileMessageHistoryEffects 及其 MessageHistoryEffects 端口跳板 SHALL 不再存在于 live 执行路径
              </?01M05F1P1XTG5GHDDD900NZ7XZ>
              <Then ?01M05F1P1XTG5GHDDD900NZ7Y0>
              executor SHALL NOT 再调用该 no-op 端口（appendMessage / backupHistory）
              </?01M05F1P1XTG5GHDDD900NZ7Y0>
            ] (
              <Given ?01M05F1P1XTG5GHDDD900NZ7Y1>
              历史写副作用端口已是 no-op
              </?01M05F1P1XTG5GHDDD900NZ7Y1>
              <When ?01M05F1P1XTG5GHDDD900NZ7Y2>
              检查 live 执行路径与端口接线
              </?01M05F1P1XTG5GHDDD900NZ7Y2>
            )>
            <Case #migration-readers-retained (
              <Given ?01M05F1P1XTG5GHDDD900NZ7Y3>
              session upgrade 依赖 legacy 文件 reader
              </?01M05F1P1XTG5GHDDD900NZ7Y3>
              <When ?01M05F1P1XTG5GHDDD900NZ7Y4>
              检查迁移 reader 与脏数据拒绝守卫
              </?01M05F1P1XTG5GHDDD900NZ7Y4>
              <Then ?01M05F1P1XTG5GHDDD900NZ7Y5>
              upgrade 必需的 legacy 迁移 reader 与 transcript-only 拒绝守卫 SHALL 保留（它们不是 compat shim）
              </?01M05F1P1XTG5GHDDD900NZ7Y5>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #session-upgrade-clean (
      <Statement ?01M05F1P1XTG5GHDDD900NZ7Y6>
      旧格式 session SHALL 可经 dry-run / apply 升级到新 profile / data-subgraph（owned-checkpoint / XNL）结构，且升级后校验结果 SHALL 为 clean；脏数据 SHALL NOT 被当作正常输入静默接受。
      </?01M05F1P1XTG5GHDDD900NZ7Y6>
      <Suites [
        <Suite #upgrade { name = "Session upgrade clean" } (
          <Cases [
            <Case #dry-run-then-apply-clean [
              <Then ?01M05F1P1XTG5GHDDD900NZ7Y7>
              dry-run SHALL 识别其为可升级（upgraded）
              </?01M05F1P1XTG5GHDDD900NZ7Y7>
              <Then ?01M05F1P1XTG5GHDDD900NZ7Y8>
              apply 后 checkpoint 前缀分类 SHALL 为 clean
              </?01M05F1P1XTG5GHDDD900NZ7Y8>
            ] (
              <Given ?01M05F1P1XTG5GHDDD900NZ7Y9>
              一个旧格式 session 的持久化产物（真实形态 fixture）
              </?01M05F1P1XTG5GHDDD900NZ7Y9>
              <When ?01M05F1P1XTG5GHDDD900NZ7YA>
              对其执行 session upgrade dry-run 再 apply
              </?01M05F1P1XTG5GHDDD900NZ7YA>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #incident-acceptance-harness (
      <Statement ?01M05F1P1XTG5GHDDD900NZ7YB>
      本 track SHALL 提供一个重现真实事故形态的 conformance resource（最小化/脱敏 fixture，不含原始真实 session 数据），并经一个 CLI / TUI / headless 聚焦验收 harness：升级该事故 session、恢复并继续一个 turn，断言事故根因不复现且跨表现产生等价 domain 行为。
      </?01M05F1P1XTG5GHDDD900NZ7YB>
      <Suites [
        <Suite #acceptance { name = "Incident acceptance across surfaces" } (
          <Cases [
            <Case #incident-recovers-and-continues [
              <Then ?01M05F1P1XTG5GHDDD900NZ7YC>
              恢复后下一轮 provider context SHALL 含完整配对工具结果，SHALL NOT 触发对同一文件的重复读取
              </?01M05F1P1XTG5GHDDD900NZ7YC>
              <Then ?01M05F1P1XTG5GHDDD900NZ7YD>
              同一事故 loop 在 CLI / TUI / headless 下 SHALL 产生等价 domain 真源（差异仅限表现）
              </?01M05F1P1XTG5GHDDD900NZ7YD>
            ] (
              <Given ?01M05F1P1XTG5GHDDD900NZ7YE>
              真实事故形态的 session conformance resource
              </?01M05F1P1XTG5GHDDD900NZ7YE>
              <When ?01M05F1P1XTG5GHDDD900NZ7YF>
              经 harness 升级 → 恢复 → 继续一个 turn
              </?01M05F1P1XTG5GHDDD900NZ7YF>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #migration-regression-coverage (
      <Statement ?01M05F1P1XTG5GHDDD900NZ7YG>
      事故根因的四个维度 SHALL 各有可执行回归守护：repeat-read-file、pending-effect、history-lag、TUI/CLI-divergence。已存在的覆盖 SHALL 被显式映射；缺失维度 SHALL 补命名回归。
      </?01M05F1P1XTG5GHDDD900NZ7YG>
      <Suites [
        <Suite #regression { name = "Migration regression coverage" } (
          <Cases [
            <Case #four-incident-dimensions-covered [
              <Then ?01M05F1P1XTG5GHDDD900NZ7YH>
              repeat-read-file 与 TUI/CLI-divergence SHALL 由既有测试覆盖并被显式映射
              </?01M05F1P1XTG5GHDDD900NZ7YH>
              <Then ?01M05F1P1XTG5GHDDD900NZ7YJ>
              pending-effect 与 history-lag SHALL 各有命名可执行回归（既有 conformance 映射或新增）
              </?01M05F1P1XTG5GHDDD900NZ7YJ>
            ] (
              <Given ?01M05F1P1XTG5GHDDD900NZ7YK>
              事故根因四维
              </?01M05F1P1XTG5GHDDD900NZ7YK>
              <When ?01M05F1P1XTG5GHDDD900NZ7YM>
              核对可执行回归覆盖
              </?01M05F1P1XTG5GHDDD900NZ7YM>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
