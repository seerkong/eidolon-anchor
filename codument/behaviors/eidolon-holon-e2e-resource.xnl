<Behavior #eidolon-holon-e2e-resource apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #inspectable-file-xnl-authority (
      <Statement ?01M1VSNXX46NMG51KZ3GNJT402>
      The repository SHALL provide one deterministic, human-inspectable Holon E2E resource generated by the real File-XNL capsule write, fresh reconstruction and snapshot issuance path without making that resource a product runtime authority.
      </?01M1VSNXX46NMG51KZ3GNJT402>
      <Suites [
        <Suite #resource-cases { name = "Inspectable E2E authority" } (
          <Cases [
            <Case #materialize-explicit-root (
              <Given ?01M1VSNXX46NMG51KZ3GNJT403>
              An empty explicit output root and the closed Review Team scenario.
              </?01M1VSNXX46NMG51KZ3GNJT403>
              <When ?01M1VSNXX46NMG51KZ3GNJT404>
              The runtime-first materializer runs.
              </?01M1VSNXX46NMG51KZ3GNJT404>
              <Then ?01M1VSNXX46NMG51KZ3GNJT405>
              It SHALL write the canonical authority layout and labelled issuer projections without returning or persisting the absolute root.
              </?01M1VSNXX46NMG51KZ3GNJT405>
            )>
            <Case #regeneration-exact (
              <Given ?01M1VSNXX46NMG51KZ3GNJT406>
              The committed inspection resource and unchanged Holarchy packages.
              </?01M1VSNXX46NMG51KZ3GNJT406>
              <When ?01M1VSNXX46NMG51KZ3GNJT407>
              The check regenerates the scenario in an isolated root.
              </?01M1VSNXX46NMG51KZ3GNJT407>
              <Then ?01M1VSNXX46NMG51KZ3GNJT408>
              Every generator-owned relative path and byte SHALL match, and a fresh capsule SHALL reconstruct and issue the same snapshot and receipt.
              </?01M1VSNXX46NMG51KZ3GNJT408>
            )>
            <Case #product-owner-independent (
              <Given ?01M1VSNXX46NMG51KZ3GNJT409>
              The committed inspection resource exists.
              </?01M1VSNXX46NMG51KZ3GNJT409>
              <When ?01M1VSNXX46NMG51KZ3GNJT40A>
              The Ctrl/Data product E2E runs.
              </?01M1VSNXX46NMG51KZ3GNJT40A>
              <Then ?01M1VSNXX46NMG51KZ3GNJT40B>
              It SHALL still create and commit its own temporary writable File-XNL authority before ResourcePackage admission.
              </?01M1VSNXX46NMG51KZ3GNJT40B>
            )>
            <Case #privacy-boundary (
              <Given ?01M1VSNXX46NMG51KZ3GNJT40C>
              The generated resource is reviewed or distributed with tests.
              </?01M1VSNXX46NMG51KZ3GNJT40C>
              <When ?01M1VSNXX46NMG51KZ3GNJT40D>
              Its paths and bytes are scanned.
              </?01M1VSNXX46NMG51KZ3GNJT40D>
              <Then ?01M1VSNXX46NMG51KZ3GNJT40E>
              It SHALL contain no host-local absolute path, prompt, reasoning, provider configuration, actor snapshot, mailbox or conversation history.
              </?01M1VSNXX46NMG51KZ3GNJT40E>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #os-process-recovery (
      <Statement ?01M1VSNXX46NMG51KZ3GNJT40F>
      独立 Holon runtime SHALL 仅凭持久 TaskSpace、subscription、journal 与外部幂等协议在新 OS 进程恢复任务。
      </?01M1VSNXX46NMG51KZ3GNJT40F>
      <Suites [
        <Suite #crash-windows { name = "进程中断" } (
          <Cases [
            <Case #durable-recovery (
              <Given ?01M1VSNXX46NMG51KZ3GNJT40G>
              进程 A 在 pending、intent、accepted-before-result 或 settlement-before-observation 窗口退出。
              </?01M1VSNXX46NMG51KZ3GNJT40G>
              <When ?01M1VSNXX46NMG51KZ3GNJT40H>
              不同 PID 的 B 从同一持久资源恢复并再次 replay。
              </?01M1VSNXX46NMG51KZ3GNJT40H>
              <Then ?01M1VSNXX46NMG51KZ3GNJT40J>
              任务完成、输出一致，同外部 idempotency key 仅接受一次；不共用 JS Map 或 closure。
              </?01M1VSNXX46NMG51KZ3GNJT40J>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #task-observation-repair (
      <Statement ?01M1VSNXX46NMG51KZ3GNJT40K>
      人和 AI SHALL 经同一 TaskRuntimeService 观察与修复任务，原 TaskSpace 保持唯一任务 authority。
      </?01M1VSNXX46NMG51KZ3GNJT40K>
      <Suites [
        <Suite #repair { name = "观察及后继修复" } (
          <Cases [
            <Case #terminal-successor (
              <Given ?01M1VSNXX46NMG51KZ3GNJT40M>
              任务失败且有持久失败证据。
              </?01M1VSNXX46NMG51KZ3GNJT40M>
              <When ?01M1VSNXX46NMG51KZ3GNJT40N>
              按原revision和修复request请求重试或改派，并在新进程恢复。
              </?01M1VSNXX46NMG51KZ3GNJT40N>
              <Then ?01M1VSNXX46NMG51KZ3GNJT40P>
              原失败保留，后继任务与因果证据可查询；相同请求重放不重复创建，冲突拒绝；新任务可继续执行。
              </?01M1VSNXX46NMG51KZ3GNJT40P>
            )>
            <Case #observe-resume (
              <Given ?01M1VSNXX46NMG51KZ3GNJT40Q>
              任务已持久化但停止进展。
              </?01M1VSNXX46NMG51KZ3GNJT40Q>
              <When ?01M1VSNXX46NMG51KZ3GNJT40R>
              读取诊断并请求恢复。
              </?01M1VSNXX46NMG51KZ3GNJT40R>
              <Then ?01M1VSNXX46NMG51KZ3GNJT40S>
              显示claim/member/session或明确未知、进展/错误和下一动作；通过原协调器恢复，不用另一任务状态库。
              </?01M1VSNXX46NMG51KZ3GNJT40S>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #repair-resource-product-loop (
      <Statement ?01M1VSNXX46NMG51KZ3GNJT40T>
      测试 SHALL 经独立 Holon、Ctrl、Data 的真实执行路径，以同一业务产物和独立 verifier 证明任务修复与资源演进收益，并区分合成指标和远端测量。
      </?01M1VSNXX46NMG51KZ3GNJT40T>
      <Suites [
        <Suite #product-loop { name = "产物闭环" } (
          <Cases [
            <Case #three-entry-artifact (
              <Given ?01M1VSNXX46NMG51KZ3GNJT40V>
              三入口使用同一原始需求、输入和冻结 Agent 配方。
              </?01M1VSNXX46NMG51KZ3GNJT40V>
              <When ?01M1VSNXX46NMG51KZ3GNJT40W>
              执行任务、正式观察/修复并重放。
              </?01M1VSNXX46NMG51KZ3GNJT40W>
              <Then ?01M1VSNXX46NMG51KZ3GNJT40X>
              实际文件 SHALL 通过原 verifier，保留各入口身份和 repair lineage，不重复接受同一 effect。
              </?01M1VSNXX46NMG51KZ3GNJT40X>
            )>
            <Case #feedback-improves-artifact (
              <Given ?01M1VSNXX46NMG51KZ3GNJT40Y>
              V1 产物未通过原 verifier。
              </?01M1VSNXX46NMG51KZ3GNJT40Y>
              <When ?01M1VSNXX46NMG51KZ3GNJT40Z>
              Data 控制器基于该反馈修订资源并准备下一 child Worker。
              </?01M1VSNXX46NMG51KZ3GNJT40Z>
              <Then ?01M1VSNXX46NMG51KZ3GNJT410>
              V2 产物 SHALL 通过同一 verifier，旧 prefix 保持，变化关联 native revision receipt。
              </?01M1VSNXX46NMG51KZ3GNJT410>
            )>
            <Case #cost-evidence (
              <Given ?01M1VSNXX46NMG51KZ3GNJT411>
              同配方重用与显式配方升级均发生。
              </?01M1VSNXX46NMG51KZ3GNJT411>
              <When ?01M1VSNXX46NMG51KZ3GNJT412>
              记录 provider 请求和 usage。
              </?01M1VSNXX46NMG51KZ3GNJT412>
              <Then ?01M1VSNXX46NMG51KZ3GNJT413>
              prefix/schema 稳定性 SHALL 来自实际请求；合成 usage 明确标注，未测远端命中率不得冒称实测。
              </?01M1VSNXX46NMG51KZ3GNJT413>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
