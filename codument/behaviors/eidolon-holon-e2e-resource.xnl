<Behavior #eidolon-holon-e2e-resource apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #inspectable-file-xnl-authority (
      <Statement ?01M29RZD9JY89VK2AS8NJPPG36>
      仓库 SHALL 分别保存冻结的历史File-XNL证明样例与通过真实公共capsule生成的当前原生样例；两者均可检查，均不是产品运行时authority。
      </?01M29RZD9JY89VK2AS8NJPPG36>
      <Suites [
        <Suite #resource-cases { name = "原生生成与历史证明" } (
          <Cases [
            <Case #materialize-explicit-root (
              <Given ?01M29RZD9JY89VK2AS8NJPPG37>
              一个空的显式输出根、公共合成组织fixture和实际issuer版本。
              </?01M29RZD9JY89VK2AS8NJPPG37>
              <When ?01M29RZD9JY89VK2AS8NJPPG38>
              runtime-first materializer调用公共commit、重新打开和issuer。
              </?01M29RZD9JY89VK2AS8NJPPG38>
              <Then ?01M29RZD9JY89VK2AS8NJPPG39>
              系统 SHALL 输出原生对象/数组字段、当前authority和标明版本的发行证明，不持久化宿主绝对路径。
              </?01M29RZD9JY89VK2AS8NJPPG39>
            )>
            <Case #regeneration-exact (
              <Given ?01M29RZD9JY89VK2AS8NJPPG3A>
              已保存的当前原生样例与同一公共包版本。
              </?01M29RZD9JY89VK2AS8NJPPG3A>
              <When ?01M29RZD9JY89VK2AS8NJPPG3B>
              检查命令在隔离根重新生成。
              </?01M29RZD9JY89VK2AS8NJPPG3B>
              <Then ?01M29RZD9JY89VK2AS8NJPPG3C>
              所有生成器拥有的相对路径与bytes SHALL 精确相等；历史冻结目录不参与重写。
              </?01M29RZD9JY89VK2AS8NJPPG3C>
            )>
            <Case #historic-proof-retained (
              <Given ?01M29RZD9JY89VK2AS8NJPPG3D>
              旧版本的record/tree/receipt和已发行snapshot/receipt原始bytes。
              </?01M29RZD9JY89VK2AS8NJPPG3D>
              <When ?01M29RZD9JY89VK2AS8NJPPG3E>
              新公共包读取旧样例，并生成另一份当前原生样例。
              </?01M29RZD9JY89VK2AS8NJPPG3E>
              <Then ?01M29RZD9JY89VK2AS8NJPPG3F>
              旧bytes与digest SHALL 保持不变且仍可验证；损坏证明MUST拒绝，不能重算旧证明来修复。
              </?01M29RZD9JY89VK2AS8NJPPG3F>
            )>
            <Case #product-owner-independent (
              <Given ?01M29RZD9JY89VK2AS8NJPPG3G>
              仓库中存在两类检查样例。
              </?01M29RZD9JY89VK2AS8NJPPG3G>
              <When ?01M29RZD9JY89VK2AS8NJPPG3H>
              Product/Ctrl/Data测试运行。
              </?01M29RZD9JY89VK2AS8NJPPG3H>
              <Then ?01M29RZD9JY89VK2AS8NJPPG3J>
              测试 SHALL 经公共fixture和issuer建立独立临时可写authority，再进行资源admission。
              </?01M29RZD9JY89VK2AS8NJPPG3J>
            )>
            <Case #privacy-boundary (
              <Given ?01M29RZD9JY89VK2AS8NJPPG3K>
              样例或测试证据准备进入版本控制。
              </?01M29RZD9JY89VK2AS8NJPPG3K>
              <When ?01M29RZD9JY89VK2AS8NJPPG3M>
              检查其内容与相对路径。
              </?01M29RZD9JY89VK2AS8NJPPG3M>
              <Then ?01M29RZD9JY89VK2AS8NJPPG3N>
              内容 MUST 不包含宿主绝对路径、provider凭据、会话消息或actor/mailbox快照。
              </?01M29RZD9JY89VK2AS8NJPPG3N>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #os-process-recovery (
      <Statement ?01M29RZD9JY89VK2AS8NJPPG3P>
      独立 Holon runtime SHALL 仅凭持久 TaskSpace、subscription、journal 与外部幂等协议在新 OS 进程恢复任务。
      </?01M29RZD9JY89VK2AS8NJPPG3P>
      <Suites [
        <Suite #crash-windows { name = "进程中断" } (
          <Cases [
            <Case #durable-recovery (
              <Given ?01M29RZD9JY89VK2AS8NJPPG3Q>
              进程 A 在 pending、intent、accepted-before-result 或 settlement-before-observation 窗口退出。
              </?01M29RZD9JY89VK2AS8NJPPG3Q>
              <When ?01M29RZD9JY89VK2AS8NJPPG3R>
              不同 PID 的 B 从同一持久资源恢复并再次 replay。
              </?01M29RZD9JY89VK2AS8NJPPG3R>
              <Then ?01M29RZD9JY89VK2AS8NJPPG3S>
              任务完成、输出一致，同外部 idempotency key 仅接受一次；不共用 JS Map 或 closure。
              </?01M29RZD9JY89VK2AS8NJPPG3S>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #task-observation-repair (
      <Statement ?01M29RZD9JY89VK2AS8NJPPG3T>
      人和 AI SHALL 经同一 TaskRuntimeService 观察与修复任务，原 TaskSpace 保持唯一任务 authority。
      </?01M29RZD9JY89VK2AS8NJPPG3T>
      <Suites [
        <Suite #repair { name = "观察及后继修复" } (
          <Cases [
            <Case #terminal-successor (
              <Given ?01M29RZD9JY89VK2AS8NJPPG3V>
              任务失败且有持久失败证据。
              </?01M29RZD9JY89VK2AS8NJPPG3V>
              <When ?01M29RZD9JY89VK2AS8NJPPG3W>
              按原revision和修复request请求重试或改派，并在新进程恢复。
              </?01M29RZD9JY89VK2AS8NJPPG3W>
              <Then ?01M29RZD9JY89VK2AS8NJPPG3X>
              原失败保留，后继任务与因果证据可查询；相同请求重放不重复创建，冲突拒绝；新任务可继续执行。
              </?01M29RZD9JY89VK2AS8NJPPG3X>
            )>
            <Case #observe-resume (
              <Given ?01M29RZD9JY89VK2AS8NJPPG3Y>
              任务已持久化但停止进展。
              </?01M29RZD9JY89VK2AS8NJPPG3Y>
              <When ?01M29RZD9JY89VK2AS8NJPPG3Z>
              读取诊断并请求恢复。
              </?01M29RZD9JY89VK2AS8NJPPG3Z>
              <Then ?01M29RZD9JY89VK2AS8NJPPG40>
              显示claim/member/session或明确未知、进展/错误和下一动作；通过原协调器恢复，不用另一任务状态库。
              </?01M29RZD9JY89VK2AS8NJPPG40>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #repair-resource-product-loop (
      <Statement ?01M29RZD9JY89VK2AS8NJPPG41>
      测试 SHALL 经独立 Holon、Ctrl、Data 的真实执行路径，以同一业务产物和独立 verifier 证明任务修复与资源演进收益，并区分合成指标和远端测量。
      </?01M29RZD9JY89VK2AS8NJPPG41>
      <Suites [
        <Suite #product-loop { name = "产物闭环" } (
          <Cases [
            <Case #three-entry-artifact (
              <Given ?01M29RZD9JY89VK2AS8NJPPG42>
              三入口使用同一原始需求、输入和冻结 Agent 配方。
              </?01M29RZD9JY89VK2AS8NJPPG42>
              <When ?01M29RZD9JY89VK2AS8NJPPG43>
              执行任务、正式观察/修复并重放。
              </?01M29RZD9JY89VK2AS8NJPPG43>
              <Then ?01M29RZD9JY89VK2AS8NJPPG44>
              实际文件 SHALL 通过原 verifier，保留各入口身份和 repair lineage，不重复接受同一 effect。
              </?01M29RZD9JY89VK2AS8NJPPG44>
            )>
            <Case #feedback-improves-artifact (
              <Given ?01M29RZD9JY89VK2AS8NJPPG45>
              V1 产物未通过原 verifier。
              </?01M29RZD9JY89VK2AS8NJPPG45>
              <When ?01M29RZD9JY89VK2AS8NJPPG46>
              Data 控制器基于该反馈修订资源并准备下一 child Worker。
              </?01M29RZD9JY89VK2AS8NJPPG46>
              <Then ?01M29RZD9JY89VK2AS8NJPPG47>
              V2 产物 SHALL 通过同一 verifier，旧 prefix 保持，变化关联 native revision receipt。
              </?01M29RZD9JY89VK2AS8NJPPG47>
            )>
            <Case #cost-evidence (
              <Given ?01M29RZD9JY89VK2AS8NJPPG48>
              同配方重用与显式配方升级均发生。
              </?01M29RZD9JY89VK2AS8NJPPG48>
              <When ?01M29RZD9JY89VK2AS8NJPPG49>
              记录 provider 请求和 usage。
              </?01M29RZD9JY89VK2AS8NJPPG49>
              <Then ?01M29RZD9JY89VK2AS8NJPPG4A>
              prefix/schema 稳定性 SHALL 来自实际请求；合成 usage 明确标注，未测远端命中率不得冒称实测。
              </?01M29RZD9JY89VK2AS8NJPPG4A>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #shared-native-fixture-consumption (
      <Statement ?01M29RZD9JY89VK2AS8NJPPG4B>
      Eidolon SHALL 通过holarchy-test-support公开fixture与issuer复用组织数据，公共OrganizationState/ChangeSet是唯一测试组织模型。
      </?01M29RZD9JY89VK2AS8NJPPG4B>
      <Suites [
        <Suite #public-fixture { name = "公共场景消费" } (
          <Cases [
            <Case #three-builders-use-native-data (
              <Given ?01M29RZD9JY89VK2AS8NJPPG4C>
              检查样例、产品资源包和execution binding测试各需要不同成员与角色。
              </?01M29RZD9JY89VK2AS8NJPPG4C>
              <When ?01M29RZD9JY89VK2AS8NJPPG4D>
              它们装配组织输入。
              </?01M29RZD9JY89VK2AS8NJPPG4D>
              <Then ?01M29RZD9JY89VK2AS8NJPPG4E>
              系统 SHALL 参数化调用公共fixture，使用原生数组/对象；不维护私有领域xxxJson建表、parser或规则副本。
              </?01M29RZD9JY89VK2AS8NJPPG4E>
            )>
            <Case #actual-issuer-version (
              <Given ?01M29RZD9JY89VK2AS8NJPPG4F>
              实际安装的公共issuer候选与显式authorization/clock/bounds。
              </?01M29RZD9JY89VK2AS8NJPPG4F>
              <When ?01M29RZD9JY89VK2AS8NJPPG4G>
              公共helper提交并发行组织。
              </?01M29RZD9JY89VK2AS8NJPPG4G>
              <Then ?01M29RZD9JY89VK2AS8NJPPG4H>
              provenance SHALL 等于实际解析的包版本，且canonical证明经公共parser可验证。
              </?01M29RZD9JY89VK2AS8NJPPG4H>
            )>
            <Case #canonical-envelope-preserved (
              <Given ?01M29RZD9JY89VK2AS8NJPPG4J>
              资源携带已签发组织、绑定和runtime定义的exact byte信封。
              </?01M29RZD9JY89VK2AS8NJPPG4J>
              <When ?01M29RZD9JY89VK2AS8NJPPG4K>
              Eidolon执行admission。
              </?01M29RZD9JY89VK2AS8NJPPG4K>
              <Then ?01M29RZD9JY89VK2AS8NJPPG4M>
              系统 MUST 保持canonical/Base64证明语义与digest校验，不因领域字段升级重新解释或重写信封。
              </?01M29RZD9JY89VK2AS8NJPPG4M>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #shared-reconciliation-adoption (
      <Statement ?01M29RZD9JY89VK2AS8NJPPG4N>
      公共调和结果 SHALL 经显式successor提交与重新发行进入Eidolon；Product/Ctrl/Data继续使用唯一TaskRuntimeService和TaskSpace owner。
      </?01M29RZD9JY89VK2AS8NJPPG4N>
      <Suites [
        <Suite #evolution { name = "组织演进与任务冻结" } (
          <Cases [
            <Case #conflict-selection-before-adoption (
              <Given ?01M29RZD9JY89VK2AS8NJPPG4P>
              共享场景规定远端目标停用、字段冲突和独立可接受改名。
              </?01M29RZD9JY89VK2AS8NJPPG4P>
              <When ?01M29RZD9JY89VK2AS8NJPPG4Q>
              公共调和、显式选择、CAS提交及新组织admission依次执行。
              </?01M29RZD9JY89VK2AS8NJPPG4Q>
              <Then ?01M29RZD9JY89VK2AS8NJPPG4R>
              预览 SHALL 不写authority；拒绝组不泄漏mutation；新admission仅采用实际提交并签发的后继事实，消费者证据含fixture digest与实际入口。
              </?01M29RZD9JY89VK2AS8NJPPG4R>
            )>
            <Case #three-entry-single-owner (
              <Given ?01M29RZD9JY89VK2AS8NJPPG4S>
              Product-only、Ctrl和Data加载同一组织与binding。
              </?01M29RZD9JY89VK2AS8NJPPG4S>
              <When ?01M29RZD9JY89VK2AS8NJPPG4T>
              各入口派单、观察和修复。
              </?01M29RZD9JY89VK2AS8NJPPG4T>
              <Then ?01M29RZD9JY89VK2AS8NJPPG4V>
              任务 SHALL 由同一服务与TaskSpace受理，Workflow只消费receipt；输出须通过独立artifact verifier。
              </?01M29RZD9JY89VK2AS8NJPPG4V>
            )>
            <Case #old-deployment-new-process (
              <Given ?01M29RZD9JY89VK2AS8NJPPG4W>
              旧任务已有冻结组织与binding，而新组织与Agent配方已admit。
              </?01M29RZD9JY89VK2AS8NJPPG4W>
              <When ?01M29RZD9JY89VK2AS8NJPPG4X>
              不同PID重新打开旧deployment并恢复任务。
              </?01M29RZD9JY89VK2AS8NJPPG4X>
              <Then ?01M29RZD9JY89VK2AS8NJPPG4Y>
              旧任务 SHALL 继续使用原组织、绑定和配方；新任务采用新admission，不产生隐式组织迁移。
              </?01M29RZD9JY89VK2AS8NJPPG4Y>
            )>
            <Case #two-settlement-windows (
              <Given ?01M29RZD9JY89VK2AS8NJPPG4Z>
              任务在effect已接受但settlement前，或settlement后Workflow未消费时退出。
              </?01M29RZD9JY89VK2AS8NJPPG4Z>
              <When ?01M29RZD9JY89VK2AS8NJPPG50>
              另一OS进程恢复并再次replay。
              </?01M29RZD9JY89VK2AS8NJPPG50>
              <Then ?01M29RZD9JY89VK2AS8NJPPG51>
              同一external idempotency key MUST 仅接受一次，TaskSpace receipt稳定，Workflow可继续消费且不创建第二任务owner。
              </?01M29RZD9JY89VK2AS8NJPPG51>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #remote-product-live-evidence (
      <Statement ?01M29RZD9JY89VK2AS8NJPPG52>
      真实ai-agent产品验收 SHALL 经现有远端provider执行一次有界Product-only Holon任务；模拟transport结果不得标为远端证据。
      </?01M29RZD9JY89VK2AS8NJPPG52>
      <Suites [
        <Suite #live-gate { name = "有限远端产品验收" } (
          <Cases [
            <Case #shared-request-budget (
              <Given ?01M29RZD9JY89VK2AS8NJPPG53>
              本机存在可用provider/model配置，且本地预算控制测试已通过。
              </?01M29RZD9JY89VK2AS8NJPPG53>
              <When ?01M29RZD9JY89VK2AS8NJPPG54>
              显式开启一次真实gate。
              </?01M29RZD9JY89VK2AS8NJPPG54>
              <Then ?01M29RZD9JY89VK2AS8NJPPG55>
              全部actor总计 MUST 最多2次provider请求、16384输出token每请求和180秒总时限；无自动重试、循环补跑或计费配置变更。
              </?01M29RZD9JY89VK2AS8NJPPG55>
            )>
            <Case #real-artifact-and-usage (
              <Given ?01M29RZD9JY89VK2AS8NJPPG56>
              远端响应经实际adapter/stream parser完成Holon订单任务。
              </?01M29RZD9JY89VK2AS8NJPPG56>
              <When ?01M29RZD9JY89VK2AS8NJPPG57>
              external effect保存原模型bytes并由独立verifier检查。
              </?01M29RZD9JY89VK2AS8NJPPG57>
              <Then ?01M29RZD9JY89VK2AS8NJPPG58>
              报告 SHALL 记录真实请求数、provider usage、任务receipt与verifier结果；未知usage或费用保持unknown，错误输出不被host纠正。
              </?01M29RZD9JY89VK2AS8NJPPG58>
            )>
            <Case #secret-and-evidence-boundary (
              <Given ?01M29RZD9JY89VK2AS8NJPPG59>
              凭据缺失、服务失败、超时或报告需要持久化。
              </?01M29RZD9JY89VK2AS8NJPPG59>
              <When ?01M29RZD9JY89VK2AS8NJPPG5A>
              gate输出结果。
              </?01M29RZD9JY89VK2AS8NJPPG5A>
              <Then ?01M29RZD9JY89VK2AS8NJPPG5B>
              系统 MUST 保留真实失败或未执行状态且不暴露凭据；不能退回loopback宣称PASS。
              </?01M29RZD9JY89VK2AS8NJPPG5B>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
