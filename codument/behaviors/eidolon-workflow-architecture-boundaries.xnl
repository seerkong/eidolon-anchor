<Behavior #eidolon-workflow-architecture-boundaries apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #explicit-architecture-boundaries (
      <Statement ?01M1CNG13VKNKH7J787BX67WYQ>
      Eidolon workflow integration SHALL use canonical XNL/depa-flows resources, one admitted Effective Eidolon VFS for runtime resource consumption, injected workflow-authoring roots, actor/session effect authority and native surfaces; it SHALL NOT introduce XML authoring, MCP, external agent CLI or parallel flow/runtime/resource authority.
      </?01M1CNG13VKNKH7J787BX67WYQ>
      <Suites [
        <Suite #resource-and-runtime-authority { name = "Resource and runtime authority" } (
          <Cases [
            <Case #canonical-xnl-and-depa-runtime [
              <Then ?01M1CNG13VKNKH7J787BX67WYR>
              it SHALL use canonical depa-flows XNL loaders and Ctrl/Data runtimes
              </?01M1CNG13VKNKH7J787BX67WYR>
              <Then ?01M1CNG13VKNKH7J787BX67WYS>
              it SHALL NOT parse XML or implement a parallel scheduler
              </?01M1CNG13VKNKH7J787BX67WYS>
            ] (
              <Given ?01M1CNG13VKNKH7J787BX67WYT>
              Ctrl or Data workflow production source
              </?01M1CNG13VKNKH7J787BX67WYT>
              <When ?01M1CNG13VKNKH7J787BX67WYV>
              it loads or executes a definition
              </?01M1CNG13VKNKH7J787BX67WYV>
            )>
            <Case #eidolon-roots [
              <Then ?01M1CNG13VKNKH7J787BX67WYW>
              the workflow authoring/session root SHALL remain the injected workspace `.eidolon/workflows` root
              </?01M1CNG13VKNKH7J787BX67WYW>
              <Then ?01M1CNG13VKNKH7J787BX67WYX>
              CLI, TUI and native runtime surfaces SHALL share one injected Effective Eidolon VFS read port for ResourcePackage consumption; separately injected global/workspace `.eidolon/resources` roots MAY exist only as an isolated legacy compatibility path when no Effective VFS is configured
              </?01M1CNG13VKNKH7J787BX67WYX>
              <Then ?01M1CNG13VKNKH7J787BX67WYY>
              Eidolon MUST NOT combine legacy physical ResourcePackage layers or a physical ResourcePackage publisher with an Effective VFS, scan either legacy root for child packages, or treat the workflow authoring root as a ResourcePackage by implication
              </?01M1CNG13VKNKH7J787BX67WYY>
            ] (
              <Given ?01M1CNG13VKNKH7J787BX67WYZ>
              CLI or TUI constructs the workflow component
              </?01M1CNG13VKNKH7J787BX67WYZ>
              <When ?01M1CNG13VKNKH7J787BX67WZ0>
              workspace/global roots and the Effective VFS binding are resolved
              </?01M1CNG13VKNKH7J787BX67WZ0>
            )>
          ]>
        )>
        <Suite #effect-and-surface-authority { name = "Effect and surface authority" } (
          <Cases [
            <Case #eidolon-effect-lifecycle (
              <Given ?01M1CNG13VKNKH7J787BX67WZ1>
              a workflow node invokes agent, tool, human or Material work
              </?01M1CNG13VKNKH7J787BX67WZ1>
              <When ?01M1CNG13VKNKH7J787BX67WZ2>
              the effect starts, completes or fails
              </?01M1CNG13VKNKH7J787BX67WZ2>
              <Then ?01M1CNG13VKNKH7J787BX67WZ3>
              Eidolon actor/session/runtime-control SHALL retain lifecycle authority and workflow facts SHALL only reference it
              </?01M1CNG13VKNKH7J787BX67WZ3>
            )>
            <Case #native-no-mcp-surface (
              <Given ?01M1CNG13VKNKH7J787BX67WZ4>
              conversation, TUI or CLI uses workflow capability
              </?01M1CNG13VKNKH7J787BX67WZ4>
              <When ?01M1CNG13VKNKH7J787BX67WZ5>
              it reads or mutates authoring/run facts
              </?01M1CNG13VKNKH7J787BX67WZ5>
              <Then ?01M1CNG13VKNKH7J787BX67WZ6>
              it SHALL call native component services without MCP, external agent CLI or private mutation paths
              </?01M1CNG13VKNKH7J787BX67WZ6>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #depa-instance-run-owner (
      <Statement ?01M1CNG13VKNKH7J787BX67WZ7>
      Eidolon SHALL bind depa-flows storage and runtime ports without reimplementing Definition, Instance, Run, checkpoint, Ctrl snapshot or Data RunGraph authority.
      </?01M1CNG13VKNKH7J787BX67WZ7>
      <Suites [
        <Suite #authority-boundary { name = "Persistence authority boundary" } (
          <Cases [
            <Case #host-binds-not-redefines (
              <Given ?01M1CNG13VKNKH7J787BX67WZ8>
              Eidolon constructs its workflow component
              </?01M1CNG13VKNKH7J787BX67WZ8>
              <When ?01M1CNG13VKNKH7J787BX67WZ9>
              it binds filesystem roots and generic actor/session/effect runtime
              </?01M1CNG13VKNKH7J787BX67WZ9>
              <Then ?01M1CNG13VKNKH7J787BX67WZA>
              the host SHALL consume published depa materialization and checkpoint contracts and SHALL NOT define a parallel filesystem layout, checkpoint schema, transition validator or scheduler
              </?01M1CNG13VKNKH7J787BX67WZA>
            )>
            <Case #opaque-runtime-references (
              <Given ?01M1CNG13VKNKH7J787BX67WZB>
              a workflow invokes an Agent through Eidolon generic runtime
              </?01M1CNG13VKNKH7J787BX67WZB>
              <When ?01M1CNG13VKNKH7J787BX67WZC>
              the Flow checkpoint records the durable execution binding
              </?01M1CNG13VKNKH7J787BX67WZC>
              <Then ?01M1CNG13VKNKH7J787BX67WZD>
              it SHALL contain only stable opaque actor/session/instance references and typed receipts and SHALL NOT contain conversation history, provider transcript, compaction or actor-owned mutable state
              </?01M1CNG13VKNKH7J787BX67WZD>
            )>
            <Case #closed-invalid-input (
              <Given ?01M1CNG13VKNKH7J787BX67WZE>
              a malformed descriptor, checkpoint, migration record, symlinked root or conflicting CAS candidate
              </?01M1CNG13VKNKH7J787BX67WZE>
              <When ?01M1CNG13VKNKH7J787BX67WZF>
              the host loads or commits workflow persistence
              </?01M1CNG13VKNKH7J787BX67WZF>
              <Then ?01M1CNG13VKNKH7J787BX67WZG>
              it SHALL fail closed before live mutation or runtime dispatch and SHALL preserve the last admitted instance/run authority
              </?01M1CNG13VKNKH7J787BX67WZG>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #workflow-lifecycle-actor-isolation (
      <Statement ?01M1CNG13VKNKH7J787BX67WZH>
      Workflow lifecycle stage, progress, DevOps Skill and internal-tool authority SHALL belong only to a dedicated Workflow lifecycle Actor capability; generic Actor core and AI Workflow node Agents SHALL remain stage-free.
      </?01M1CNG13VKNKH7J787BX67WZH>
      <Suites [
        <Suite #actor-boundaries { name = "Actor capability boundaries" } (
          <Cases [
            <Case #ordinary-public-gateways-only (
              <Given ?01M1CNG13VKNKH7J787BX67WZJ>
              an ordinary primary or Code Actor uses its complete admitted tool surface
              </?01M1CNG13VKNKH7J787BX67WZJ>
              <When ?01M1CNG13VKNKH7J787BX67WZK>
              provider-visible tools and executable capabilities are projected
              </?01M1CNG13VKNKH7J787BX67WZK>
              <Then ?01M1CNG13VKNKH7J787BX67WZM>
              only `WorkflowFulfill` and `WorkflowAuthor` SHALL be exposed as Workflow gateways, and lifecycle-internal tools, stages, progress and DevOps Skill content SHALL be absent
              </?01M1CNG13VKNKH7J787BX67WZM>
            )>
            <Case #node-stage-free (
              <Given ?01M1CNG13VKNKH7J787BX67WZN>
              an AI Ctrl or AI Data node Agent is created from a frozen task and AgentDefinition
              </?01M1CNG13VKNKH7J787BX67WZN>
              <When ?01M1CNG13VKNKH7J787BX67WZP>
              its context, tools and runtime facets are admitted
              </?01M1CNG13VKNKH7J787BX67WZP>
              <Then ?01M1CNG13VKNKH7J787BX67WZQ>
              it SHALL receive only its node/task/Agent authority and explicit allowed public tools, and SHALL NOT receive a Workflow lifecycle facet or internal tool by implication
              </?01M1CNG13VKNKH7J787BX67WZQ>
            )>
            <Case #lifecycle-capability-required (
              <Given ?01M1CNG13VKNKH7J787BX67WZR>
              an Actor invokes a Workflow lifecycle-internal tool or lifecycle hook
              </?01M1CNG13VKNKH7J787BX67WZR>
              <When ?01M1CNG13VKNKH7J787BX67WZS>
              the runtime authorizes visibility or execution
              </?01M1CNG13VKNKH7J787BX67WZS>
              <Then ?01M1CNG13VKNKH7J787BX67WZT>
              the Actor SHALL present the exact admitted lifecycle facet/catalog proof; Actor name, provider context class, prompt text and registry presence SHALL NOT authorize it
              </?01M1CNG13VKNKH7J787BX67WZT>
            )>
          ]>
        )>
        <Suite #generic-runtime-boundary { name = "Generic runtime boundary" } (
          <Cases [
            <Case #neutral-facet-only (
              <Given ?01M1CNG13VKNKH7J787BX67WZV>
              generic Actor contract, executor, snapshot and local-file support source is inspected
              </?01M1CNG13VKNKH7J787BX67WZV>
              <When ?01M1CNG13VKNKH7J787BX67WZW>
              domain extension state and hooks are represented
              </?01M1CNG13VKNKH7J787BX67WZW>
              <Then ?01M1CNG13VKNKH7J787BX67WZX>
              the source SHALL know only a closed neutral runtime-facet envelope and a per-VM injected codec/profile/hook registry; state replacement SHALL use exact revision CAS, and source SHALL NOT define or import Workflow stage, progress, tool or lifecycle policy
              </?01M1CNG13VKNKH7J787BX67WZX>
            )>
            <Case #legacy-one-way-migration (
              <Given ?01M1CNG13VKNKH7J787BX67WZY>
              a valid legacy dedicated Workflow Actor snapshot contains `workflowProgress`
              </?01M1CNG13VKNKH7J787BX67WZY>
              <When ?01M1CNG13VKNKH7J787BX67WZZ>
              fresh runtime recovery loads it through the registered Workflow legacy importer
              </?01M1CNG13VKNKH7J787BX67WZZ>
              <Then ?01M1CNG13VKNKH7J787BX67X00>
              only the exact schema-v3 composite migration witness SHALL create one immutable v4 generation containing one `eidolon.workflow-lifecycle/v1` facet; all generation bytes and a source/target-digest-bound receipt SHALL be durable before one CAS/atomic manifest-head switch, legacy files SHALL remain read-only, and absent, malformed, ambiguous, interrupted or conflicting states SHALL recover deterministically or fail closed
              </?01M1CNG13VKNKH7J787BX67X00>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #cache-cost-product-matrix (
      <Statement ?01M1CNG13VKNKH7J787BX67X01>
      The cache-cost product matrix SHALL independently cover ordinary Actors, dedicated Workflow lifecycle Actors and AI Ctrl/Data node Agents while preserving their exact capability boundaries.
      </?01M1CNG13VKNKH7J787BX67X01>
      <Suites [
        <Suite #actor-matrix { name = "Cross-Actor product matrix" } (
          <Cases [
            <Case #ordinary-and-node-remain-stage-free (
              <Given ?01M1CNG13VKNKH7J787BX67X02>
              ordinary Code, AI Ctrl node and AI Data node journeys execute with their admitted tools
              </?01M1CNG13VKNKH7J787BX67X02>
              <When ?01M1CNG13VKNKH7J787BX67X03>
              final context, tool schemas and runtime facets are observed
              </?01M1CNG13VKNKH7J787BX67X03>
              <Then ?01M1CNG13VKNKH7J787BX67X04>
              they SHALL contain no lifecycle facet, managed DevOps Skill, stage/progress fact or lifecycle-internal tool and SHALL report lifecycle-only overhead `0`
              </?01M1CNG13VKNKH7J787BX67X04>
            )>
            <Case #lifecycle-complete-journey (
              <Given ?01M1CNG13VKNKH7J787BX67X05>
              a dedicated lifecycle Actor uses frozen `stable-superset/v1`
              </?01M1CNG13VKNKH7J787BX67X05>
              <When ?01M1CNG13VKNKH7J787BX67X06>
              it runs authoring through planning, coding, building, testing and releasing with tools, retry and fresh recovery
              </?01M1CNG13VKNKH7J787BX67X06>
              <Then ?01M1CNG13VKNKH7J787BX67X07>
              same-stage turns SHALL remain same-epoch exact and every legitimate boundary SHALL map to one persisted reason without weakening execution authorization
              </?01M1CNG13VKNKH7J787BX67X07>
            )>
            <Case #frozen-resource-revisions (
              <Given ?01M1CNG13VKNKH7J787BX67X08>
              live Skill or Workflow resource bytes change after an Actor was admitted
              </?01M1CNG13VKNKH7J787BX67X08>
              <When ?01M1CNG13VKNKH7J787BX67X09>
              the old Actor recovers and a new Actor is created
              </?01M1CNG13VKNKH7J787BX67X09>
              <Then ?01M1CNG13VKNKH7J787BX67X0A>
              the old Actor SHALL retain its frozen revision and request identity while the new Actor SHALL receive the new revision through an explicit accepted boundary
              </?01M1CNG13VKNKH7J787BX67X0A>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #provider-surface-strategy-boundary (
      <Statement ?01M1CNG13VKNKH7J787BX67X0B>
      Workflow lifecycle provider-surface strategy SHALL be a frozen presentation policy of the dedicated lifecycle capability and SHALL NOT become execution authorization or leak lifecycle semantics into ordinary or Workflow node Actors.
      </?01M1CNG13VKNKH7J787BX67X0B>
      <Suites [
        <Suite #surface-authority { name = "Surface and execution authority separation" } (
          <Cases [
            <Case #exact-facet-authorizes-execution (
              <Given ?01M1CNG13VKNKH7J787BX67X0C>
              a lifecycle tool is visible under any accepted surface strategy
              </?01M1CNG13VKNKH7J787BX67X0C>
              <When ?01M1CNG13VKNKH7J787BX67X0D>
              the runtime attempts execution
              </?01M1CNG13VKNKH7J787BX67X0D>
              <Then ?01M1CNG13VKNKH7J787BX67X0E>
              the exact frozen lifecycle facet/catalog/profile proof SHALL independently authorize the tool; visibility, prompt content, Actor name and registry membership SHALL NOT authorize it
              </?01M1CNG13VKNKH7J787BX67X0E>
            )>
            <Case #ordinary-and-node-zero-overhead (
              <Given ?01M1CNG13VKNKH7J787BX67X0F>
              an ordinary Actor or AI Ctrl/Data Workflow node Agent prepares a provider request
              </?01M1CNG13VKNKH7J787BX67X0F>
              <When ?01M1CNG13VKNKH7J787BX67X0G>
              its exact admitted surface and control context are measured
              </?01M1CNG13VKNKH7J787BX67X0G>
              <Then ?01M1CNG13VKNKH7J787BX67X0H>
              lifecycle-only tool and control overhead SHALL be zero and no lifecycle surface strategy SHALL be installed by implication
              </?01M1CNG13VKNKH7J787BX67X0H>
            )>
            <Case #frozen-strategy-recovery (
              <Given ?01M1CNG13VKNKH7J787BX67X0J>
              a lifecycle Actor was admitted with one strategy revision and surface digest
              </?01M1CNG13VKNKH7J787BX67X0J>
              <When ?01M1CNG13VKNKH7J787BX67X0K>
              live catalogs change or a fresh process recovers the Actor
              </?01M1CNG13VKNKH7J787BX67X0K>
              <Then ?01M1CNG13VKNKH7J787BX67X0M>
              the Actor SHALL reconstruct the exact frozen strategy and surface, and missing, conflicting or newer-only strategy material SHALL fail closed before provider transport
              </?01M1CNG13VKNKH7J787BX67X0M>
            )>
            <Case #facet-v1-one-way-import (
              <Given ?01M1CNG13VKNKH7J787BX67X0N>
              a valid lifecycle facet-v1 Actor is recovered after strategy support is installed
              </?01M1CNG13VKNKH7J787BX67X0N>
              <When ?01M1CNG13VKNKH7J787BX67X0P>
              the lifecycle capability is admitted
              </?01M1CNG13VKNKH7J787BX67X0P>
              <Then ?01M1CNG13VKNKH7J787BX67X0Q>
              one exact importer SHALL create facet v2 with frozen `stable-superset/v1` strategy proof; silent defaulting, dual-write and live strategy substitution SHALL be forbidden
              </?01M1CNG13VKNKH7J787BX67X0Q>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
