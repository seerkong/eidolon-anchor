<Behavior #progressive-context-resource-loading apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #content-addressed-resource-facts (
      <Statement ?01M0QP9VAXMCG41584K608FKBZ>
      系统 SHALL 用工具无关的 canonical resource id、完整内容摘要 revision、fragment selection 与 delivery reference 表达渐进式文本加载；Skill SHALL NOT 拥有独立的 loaded 状态真源。
      </?01M0QP9VAXMCG41584K608FKBZ>
      <Suites [
        <Suite #resource-facts { name = "资源事实" } (
          <Cases [
            <Case #read-and-skill-share-resource-model [
              <Then ?01M0QP9VAXMCG41584K608FKC0>
              两者 SHALL 写入同一 context resource 数据形态
              </?01M0QP9VAXMCG41584K608FKC0>
              <Then ?01M0QP9VAXMCG41584K608FKC1>
              事实身份 SHALL 不依赖工具名称
              </?01M0QP9VAXMCG41584K608FKC1>
            ] (
              <Given ?01M0QP9VAXMCG41584K608FKC2>
              普通 read 与 Skill resolver 最终指向本地文本内容
              </?01M0QP9VAXMCG41584K608FKC2>
              <When ?01M0QP9VAXMCG41584K608FKC3>
              运行时记录加载事实
              </?01M0QP9VAXMCG41584K608FKC3>
            )>
            <Case #facts-survive-recovery (
              <Given ?01M0QP9VAXMCG41584K608FKC4>
              资源 revision、fragment 和 delivery 已随 Session context asset 持久化
              </?01M0QP9VAXMCG41584K608FKC4>
              <When ?01M0QP9VAXMCG41584K608FKC5>
              session 恢复
              </?01M0QP9VAXMCG41584K608FKC5>
              <Then ?01M0QP9VAXMCG41584K608FKC6>
              运行时 SHALL 恢复这些资源事实而不创建第二份 Skill 状态
              </?01M0QP9VAXMCG41584K608FKC6>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #revision-and-visible-coverage (
      <Statement ?01M0QP9VAXMCG41584K608FKC7>
      系统 SHALL 仅在 resource revision 未变化、requested fragment 被 visible deliveries 完全覆盖且对应结果仍完整存在于 materialized provider context 时复用已加载内容；否则 SHALL 重新交付变化或缺失的内容。已被持久化或压缩包裹替换的 tool result，若其包裹状态为 delivered_and_compacted，则该 delivery SHALL 仍按原始投递 range 贡献 visible coverage；若为 pending_first_delivery_compacted，则该 delivery SHALL NOT 贡献 visible coverage。
      </?01M0QP9VAXMCG41584K608FKC7>
      <Suites [
        <Suite #load-decision { name = "加载决策" } (
          <Cases [
            <Case #same-revision-visible-range-reused (
              <Given ?01M0QP9VAXMCG41584K608FKC8>
              同一 revision 的 delivery 覆盖 requested line range 且完整 tool result 仍在 provider context
              </?01M0QP9VAXMCG41584K608FKC8>
              <When ?01M0QP9VAXMCG41584K608FKC9>
              任一 resolver 再次请求该范围
              </?01M0QP9VAXMCG41584K608FKC9>
              <Then ?01M0QP9VAXMCG41584K608FKCA>
              系统 SHALL 返回通用 already-visible 引用而不重复正文
              </?01M0QP9VAXMCG41584K608FKCA>
            )>
            <Case #changed-resource-reloaded [
              <Then ?01M0QP9VAXMCG41584K608FKCB>
              系统 SHALL 创建新 revision 并交付新 revision 的所需内容
              </?01M0QP9VAXMCG41584K608FKCB>
              <Then ?01M0QP9VAXMCG41584K608FKCC>
              旧 revision coverage SHALL NOT 被当作新 revision coverage
              </?01M0QP9VAXMCG41584K608FKCC>
            ] (
              <Given ?01M0QP9VAXMCG41584K608FKCD>
              canonical resource id 相同但完整内容摘要已变化
              </?01M0QP9VAXMCG41584K608FKCD>
              <When ?01M0QP9VAXMCG41584K608FKCE>
              再次请求任一范围
              </?01M0QP9VAXMCG41584K608FKCE>
            )>
            <Case #compacted-delivery-reused [
              <Then ?01M0QP9VAXMCG41584K608FKCF>
              该 delivery SHALL 按原始投递 range 贡献 visible coverage
              </?01M0QP9VAXMCG41584K608FKCF>
              <Then ?01M0QP9VAXMCG41584K608FKCG>
              系统 SHALL 返回 already-visible 引用而不重复投递正文
              </?01M0QP9VAXMCG41584K608FKCG>
              <Then ?01M0QP9VAXMCG41584K608FKCH>
              引用 SHALL 携带恢复路径提示（如持久化 artifact 路径）以便模型需要原文时读取
              </?01M0QP9VAXMCG41584K608FKCH>
            ] (
              <Given ?01M0QP9VAXMCG41584K608FKCJ>
              同一 revision 的 tool result 已被 compacted 或 persisted wrapper 替换，且包裹状态为 delivered_and_compacted（正文曾完整投递）
              </?01M0QP9VAXMCG41584K608FKCJ>
              <When ?01M0QP9VAXMCG41584K608FKCK>
              再次请求该 delivery 覆盖的原始范围
              </?01M0QP9VAXMCG41584K608FKCK>
            )>
            <Case #pending-first-delivery-not-visible [
              <Then ?01M0QP9VAXMCG41584K608FKCM>
              该 delivery SHALL NOT 贡献 visible coverage
              </?01M0QP9VAXMCG41584K608FKCM>
              <Then ?01M0QP9VAXMCG41584K608FKCN>
              系统 SHALL 引导模型读取 artifact 或重新交付所需正文
              </?01M0QP9VAXMCG41584K608FKCN>
            ] (
              <Given ?01M0QP9VAXMCG41584K608FKCP>
              tool result 在首次投递前即被 spill 到 artifact，包裹状态为 pending_first_delivery_compacted（模型从未看过正文）
              </?01M0QP9VAXMCG41584K608FKCP>
              <When ?01M0QP9VAXMCG41584K608FKCQ>
              再次请求该范围
              </?01M0QP9VAXMCG41584K608FKCQ>
            )>
            <Case #progressive-range-delivery [
              <Then ?01M0QP9VAXMCG41584K608FKCR>
              系统 SHALL 仅交付未被 visible coverage 覆盖的行范围
              </?01M0QP9VAXMCG41584K608FKCR>
              <Then ?01M0QP9VAXMCG41584K608FKCS>
              输出 SHALL 保留稳定原始行号
              </?01M0QP9VAXMCG41584K608FKCS>
            ] (
              <Given ?01M0QP9VAXMCG41584K608FKCT>
              同一 revision 只有 requested range 的一部分仍可见
              </?01M0QP9VAXMCG41584K608FKCT>
              <When ?01M0QP9VAXMCG41584K608FKCV>
              请求更大的 line range
              </?01M0QP9VAXMCG41584K608FKCV>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #prompt-and-entry-ownership (
      <Statement ?01M0QP9VAXMCG41584K608FKCW>
      AI kernel SHALL 描述工具无关的资源复用与重载语义；terminal entry SHALL NOT 注入 Skill 或其他产品级资源加载提示词，实时 catalog 描述 SHALL 由对应工具 schema owner 提供。
      </?01M0QP9VAXMCG41584K608FKCW>
      <Suites [
        <Suite #prompt-ownership { name = "提示词所有权" } (
          <Cases [
            <Case #terminal-does-not-inject-skill-semantics (
              <Given ?01M0QP9VAXMCG41584K608FKCX>
              terminal 组装 ai-kernel 或 ai-coding profile
              </?01M0QP9VAXMCG41584K608FKCX>
              <When ?01M0QP9VAXMCG41584K608FKCY>
              检查 system prompt 与 assembly context
              </?01M0QP9VAXMCG41584K608FKCY>
              <Then ?01M0QP9VAXMCG41584K608FKCZ>
              terminal SHALL NOT 提供“每轮重新读取 Skill”或同类产品语义
              </?01M0QP9VAXMCG41584K608FKCZ>
            )>
            <Case #no-skill-specific-idempotence-protocol [
              <Then ?01M0QP9VAXMCG41584K608FKD0>
              规则 SHALL 基于 resource revision、fragment 与 visibility
              </?01M0QP9VAXMCG41584K608FKD0>
              <Then ?01M0QP9VAXMCG41584K608FKD1>
              规则 SHALL NOT 把 Skill 名称或 Skill call count 作为幂等事实
              </?01M0QP9VAXMCG41584K608FKD1>
            ] (
              <Given ?01M0QP9VAXMCG41584K608FKD2>
              kernel 与 tool schema 描述渐进资源加载
              </?01M0QP9VAXMCG41584K608FKD2>
              <When ?01M0QP9VAXMCG41584K608FKD3>
              检查规则文本
              </?01M0QP9VAXMCG41584K608FKD3>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #no-generic-loop-guard (
      <Statement ?01M0QP9VAXMCG41584K608FKD4>
      本能力 SHALL NOT 基于重复工具次数、迭代次数或通用无进展推断拒绝工具调用；复用决策 SHALL 仅来自资源 revision、fragment coverage 与 provider visibility 事实。
      </?01M0QP9VAXMCG41584K608FKD4>
      <Suites [
        <Suite #scope-boundary { name = "范围边界" } (
          <Cases [
            <Case #unrelated-repeated-tools-not-blocked (
              <Given ?01M0QP9VAXMCG41584K608FKD5>
              工具调用不产生可识别的文本资源事实
              </?01M0QP9VAXMCG41584K608FKD5>
              <When ?01M0QP9VAXMCG41584K608FKD6>
              同类工具被重复调用
              </?01M0QP9VAXMCG41584K608FKD6>
              <Then ?01M0QP9VAXMCG41584K608FKD7>
              本能力 SHALL NOT 对其增加循环检测或调用次数限制
              </?01M0QP9VAXMCG41584K608FKD7>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #large-file-truncation-and-total-lines (
      <Statement ?01M0QP9VAXMCG41584K608FKD8>
      系统 SHALL 对 read 工具提供统一的默认读取范围语义：文件与目录默认 limit 一致（2000），offset 1 起始；超长文本资源 SHALL 截断到前 limit 行而非整文件投递；资源投递 header SHALL 报告 total-lines 元信息（文件总行数 / 目录总条目数），文件与目录 SHALL NOT 使用不同的隐式默认。
      </?01M0QP9VAXMCG41584K608FKD8>
      <Suites [
        <Suite #truncation-and-metadata { name = "截断与元信息" } (
          <Cases [
            <Case #large-file-truncated [
              <Then ?01M0QP9VAXMCG41584K608FKD9>
              系统 SHALL 只投递请求 offset 起的至多 limit 行正文
              </?01M0QP9VAXMCG41584K608FKD9>
              <Then ?01M0QP9VAXMCG41584K608FKDA>
              header SHALL 报告 total-lines 总行数
              </?01M0QP9VAXMCG41584K608FKDA>
            ] (
              <Given ?01M0QP9VAXMCG41584K608FKDB>
              目标文本文件总行数超过默认 limit（2000 行）
              </?01M0QP9VAXMCG41584K608FKDB>
              <When ?01M0QP9VAXMCG41584K608FKDC>
              任一 resolver 请求该文件
              </?01M0QP9VAXMCG41584K608FKDC>
            )>
            <Case #directory-default-aligned [
              <Then ?01M0QP9VAXMCG41584K608FKDD>
              默认 limit SHALL 与文件读取一致
              </?01M0QP9VAXMCG41584K608FKDD>
              <Then ?01M0QP9VAXMCG41584K608FKDE>
              header SHALL 报告目录总条目数元信息
              </?01M0QP9VAXMCG41584K608FKDE>
            ] (
              <Given ?01M0QP9VAXMCG41584K608FKDF>
              read 读取目录
              </?01M0QP9VAXMCG41584K608FKDF>
              <When ?01M0QP9VAXMCG41584K608FKDG>
              返回目录条目列表
              </?01M0QP9VAXMCG41584K608FKDG>
            )>
            <Case #total-lines-in-already-visible (
              <Given ?01M0QP9VAXMCG41584K608FKDH>
              同一 revision 的资源已经可见
              </?01M0QP9VAXMCG41584K608FKDH>
              <When ?01M0QP9VAXMCG41584K608FKDJ>
              返回 already-visible 引用
              </?01M0QP9VAXMCG41584K608FKDJ>
              <Then ?01M0QP9VAXMCG41584K608FKDK>
              引用 SHALL 保留 total-lines 元信息
              </?01M0QP9VAXMCG41584K608FKDK>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #context-resource-surface-projection (
      <Statement ?01M0QP9VAXMCG41584K608FKDM>
      Runtime/tool projection SHALL 向 surface 提供 typed context resource metadata；TUI SHALL 以折叠 CONTEXT/read 卡片显示 resource id、revision、range、size 与 status，SHALL NOT 把 `&amp;lt;context-resource&amp;gt;` raw wrapper 显示为 USER，也 SHALL NOT 在 UI 以正则或模糊文本匹配恢复语义。
      </?01M0QP9VAXMCG41584K608FKDM>
      <Suites [
        <Suite #context-card { name = "上下文资源卡片" } (
          <Cases [
            <Case #loaded-resource-collapsed [
              <Then ?01M0QP9VAXMCG41584K608FKDN>
              surface SHALL 显示 workspace-relative resource、行范围、大小与 revision 摘要
              </?01M0QP9VAXMCG41584K608FKDN>
              <Then ?01M0QP9VAXMCG41584K608FKDP>
              正文 SHALL 可按需展开而非默认占满 USER 卡片
              </?01M0QP9VAXMCG41584K608FKDP>
            ] (
              <Given ?01M0QP9VAXMCG41584K608FKDQ>
              read tool 交付一个 loaded context resource
              </?01M0QP9VAXMCG41584K608FKDQ>
              <When ?01M0QP9VAXMCG41584K608FKDR>
              TUI 投影其 tool result
              </?01M0QP9VAXMCG41584K608FKDR>
            )>
            <Case #already-visible-is-weak (
              <Given ?01M0QP9VAXMCG41584K608FKDS>
              context resource status 为 already-visible
              </?01M0QP9VAXMCG41584K608FKDS>
              <When ?01M0QP9VAXMCG41584K608FKDT>
              TUI 投影结果
              </?01M0QP9VAXMCG41584K608FKDT>
              <Then ?01M0QP9VAXMCG41584K608FKDV>
              surface SHALL 弱化或隐藏重复正文提示，同时保留可检查 metadata
              </?01M0QP9VAXMCG41584K608FKDV>
            )>
            <Case #cold-hydration-preserves-context-card [
              <Then ?01M0QP9VAXMCG41584K608FKDW>
              surface SHALL 从 committed tool result 的 typed metadata 恢复 CONTEXT/read 卡片
              </?01M0QP9VAXMCG41584K608FKDW>
              <Then ?01M0QP9VAXMCG41584K608FKDX>
              surface MUST NOT 解析 raw context-resource XML 或建立第二个 persistence authority
              </?01M0QP9VAXMCG41584K608FKDX>
            ] (
              <Given ?01M0QP9VAXMCG41584K608FKDY>
              read tool result 已通过既有 conversation persistence 持久化并发生进程重启
              </?01M0QP9VAXMCG41584K608FKDY>
              <When ?01M0QP9VAXMCG41584K608FKDZ>
              TUI 通过 ConversationProjectionReadPort 冷启动 hydrate history
              </?01M0QP9VAXMCG41584K608FKDZ>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #split-skill-exact-fragments (
      <Statement ?01M0QP9VAXMCG41584K608FKE0>
      The generic Skill tool SHALL load declared exact resource fragments with bounded offsets and limits, using manifest-bound digest readback for managed Skills and containment for ordinary Skills.
      </?01M0QP9VAXMCG41584K608FKE0>
      <Suites [
        <Suite #split-fragments { name = "Exact progressive fragments" } (
          <Cases [
            <Case #split-fragment-reject-undeclared (
              <Given ?01M0QP9VAXMCG41584K608FKE1>
              an undeclared or escaping resource path
              </?01M0QP9VAXMCG41584K608FKE1>
              <When ?01M0QP9VAXMCG41584K608FKE2>
              the Skill tool resolves it
              </?01M0QP9VAXMCG41584K608FKE2>
              <Then ?01M0QP9VAXMCG41584K608FKE3>
              resolution SHALL fail closed without fuzzy search
              </?01M0QP9VAXMCG41584K608FKE3>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
