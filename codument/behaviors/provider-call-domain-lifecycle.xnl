<Behavior #provider-call-domain-lifecycle apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #provider-call-record (
      <Statement ?01M1ASG3TCYMSWKWY5XFHQF2R6>
      每次发往 provider 的请求 SHALL 在 ProviderCallDomain 落一条 ProviderCallRecord 记录：包含 actorKey、turnId、modelRef、temperature 等模型参数、tool schemas snapshot、prompt generation 引用、startedAt；该记录 SHALL 是该次 provider 请求的事实真相，runtime-control evidence 与 cooperative state.inflight 中相关字段 SHALL 退化为该记录的引用。
      </?01M1ASG3TCYMSWKWY5XFHQF2R6>
      <Suites [
        <Suite #record { name = "ProviderCallRecord" } (
          <Cases [
            <Case #record-created-on-create-stream [
              <Then ?01M1ASG3TCYMSWKWY5XFHQF2R7>
              ProviderCallDomain SHALL 已写入一条 ProviderCallRecord 含完整请求元数据
              </?01M1ASG3TCYMSWKWY5XFHQF2R7>
              <Then ?01M1ASG3TCYMSWKWY5XFHQF2R8>
              state.inflight.kind=&amp;amp;quot;llm&amp;amp;quot; 的 opId SHALL 与该 ProviderCallRecord 一一对应
              </?01M1ASG3TCYMSWKWY5XFHQF2R8>
            ] (
              <Given ?01M1ASG3TCYMSWKWY5XFHQF2R9>
              buildProviderPromptForActorTurn 完成 + LLM adapter createStream 即将调用
              </?01M1ASG3TCYMSWKWY5XFHQF2R9>
              <When ?01M1ASG3TCYMSWKWY5XFHQF2RA>
              检查运行时
              </?01M1ASG3TCYMSWKWY5XFHQF2RA>
            )>
            <Case #metadata-not-scattered [
              <Then ?01M1ASG3TCYMSWKWY5XFHQF2RB>
              SHALL 通过 ProviderCallDomain ProviderCallRecord 找到
              </?01M1ASG3TCYMSWKWY5XFHQF2RB>
              <Then ?01M1ASG3TCYMSWKWY5XFHQF2RC>
              SHALL NOT 仅靠 PromptPlanData 或 effect evidence 拼出来
              </?01M1ASG3TCYMSWKWY5XFHQF2RC>
            ] (
              <Given ?01M1ASG3TCYMSWKWY5XFHQF2RD>
              需要查询某次 provider 请求的 temperature 或 tool schemas
              </?01M1ASG3TCYMSWKWY5XFHQF2RD>
              <When ?01M1ASG3TCYMSWKWY5XFHQF2RE>
              定位事实源
              </?01M1ASG3TCYMSWKWY5XFHQF2RE>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #reasoning-vs-content (
      <Statement ?01M1ASG3TCYMSWKWY5XFHQF2RF>
      assistant message 的 reasoning_content 与 final content SHALL 在 ProviderCallDomain 中作为两个独立事实记录；下游消费者（MessageAssembly、TUI cards、observability）SHALL 通过显式字段读取，不再依赖 on-the-fly merge 进 content_parts 的隐式约定。
      </?01M1ASG3TCYMSWKWY5XFHQF2RF>
      <Suites [
        <Suite #reasoning-fact { name = "Reasoning as separate fact" } (
          <Cases [
            <Case #two-distinct-facts [
              <Then ?01M1ASG3TD56HQPMH62SSRD4S3>
              SHALL 分别记录 reasoning fact 与 content fact，各带 emittedAt
              </?01M1ASG3TD56HQPMH62SSRD4S3>
              <Then ?01M1ASG3TD56HQPMH62SSRD4S4>
              SHALL NOT 仅以合并后的 content_parts 数组形式保存
              </?01M1ASG3TD56HQPMH62SSRD4S4>
            ] (
              <Given ?01M1ASG3TD56HQPMH62SSRD4S5>
              provider 返回的 assistant message 同时含 reasoning_content 与 content
              </?01M1ASG3TD56HQPMH62SSRD4S5>
              <When ?01M1ASG3TD56HQPMH62SSRD4S6>
              ProviderCallDomain 记录响应
              </?01M1ASG3TD56HQPMH62SSRD4S6>
            )>
            <Case #downstream-explicit-access [
              <Then ?01M1ASG3TD56HQPMH62SSRD4S7>
              SHALL 通过 ProviderCallDomain reasoning fact 查询
              </?01M1ASG3TD56HQPMH62SSRD4S7>
              <Then ?01M1ASG3TD56HQPMH62SSRD4S8>
              SHALL NOT 通过 content_parts.find(type===&amp;amp;quot;reasoning&amp;amp;quot;) 隐式约定
              </?01M1ASG3TD56HQPMH62SSRD4S8>
            ] (
              <Given ?01M1ASG3TD56HQPMH62SSRD4S9>
              TUI think card 或 observability 需要 reasoning
              </?01M1ASG3TD56HQPMH62SSRD4S9>
              <When ?01M1ASG3TD56HQPMH62SSRD4SA>
              读取事实
              </?01M1ASG3TD56HQPMH62SSRD4SA>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #failure-classification (
      <Statement ?01M1ASG3TD56HQPMH62SSRD4SB>
      provider 请求失败 SHALL 在 ProviderCallDomain 显式分类为：network_error / provider_rate_limit / provider_invalid_response / aborted_by_user / timeout 等枚举类型；SHALL NOT 仅以&amp;amp;quot;Error: ...&amp;amp;quot;字符串前缀承载错误语义。
      </?01M1ASG3TD56HQPMH62SSRD4SB>
      <Suites [
        <Suite #failures { name = "Failure classification" } (
          <Cases [
            <Case #classified-failure [
              <Then ?01M1ASG3TD56HQPMH62SSRD4SC>
              SHALL 写入显式 failureKind 枚举字段
              </?01M1ASG3TD56HQPMH62SSRD4SC>
              <Then ?01M1ASG3TD56HQPMH62SSRD4SD>
              SHALL 同时保留原始 error 字符串作为 audit 字段
              </?01M1ASG3TD56HQPMH62SSRD4SD>
            ] (
              <Given ?01M1ASG3TD56HQPMH62SSRD4SE>
              provider 调用失败
              </?01M1ASG3TD56HQPMH62SSRD4SE>
              <When ?01M1ASG3TD56HQPMH62SSRD4SF>
              ProviderCallDomain 记录失败
              </?01M1ASG3TD56HQPMH62SSRD4SF>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #transient-transport-replay-safety (
      <Statement ?01M1ASG3TD56HQPMH62SSRD4SG>
      Provider transport retries SHALL replay one already-prepared request only within the existing bounded policy and only while runtime evidence proves no provider output was observed; runtime output evidence SHALL override a classifier's pre-accept hint.
      </?01M1ASG3TD56HQPMH62SSRD4SG>
      <Suites [
        <Suite #transport-replay-boundary { name = "Transport replay boundary" } (
          <Cases [
            <Case #same-request-before-accept (
              <Given ?01M1ASG3TD56HQPMH62SSRD4SH>
              a recognized transient transport close occurs before output
              </?01M1ASG3TD56HQPMH62SSRD4SH>
              <When ?01M1ASG3TD56HQPMH62SSRD4SJ>
              the provider call retries
              </?01M1ASG3TD56HQPMH62SSRD4SJ>
              <Then ?01M1ASG3TD56HQPMH62SSRD4SK>
              the same prepared request authority SHALL be reused and diagnostics SHALL identify a bounded safe pre-accept replay
              </?01M1ASG3TD56HQPMH62SSRD4SK>
            )>
            <Case #runtime-output-evidence-blocks-replay (
              <Given ?01M1ASG3TD56HQPMH62SSRD4SM>
              a visible chunk or driver output-observed fact exists before failure
              </?01M1ASG3TD56HQPMH62SSRD4SM>
              <When ?01M1ASG3TD56HQPMH62SSRD4SN>
              the retry boundary reconciles classifier hints with runtime facts
              </?01M1ASG3TD56HQPMH62SSRD4SN>
              <Then ?01M1ASG3TD56HQPMH62SSRD4SP>
              runtime evidence SHALL win, effective phase SHALL be provider_accepted, and no new attempt SHALL be created
              </?01M1ASG3TD56HQPMH62SSRD4SP>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #provider-cache-observation-epoch-authority (
      <Statement ?01M1ASG3TD56HQPMH62SSRD4SQ>
      Provider cache observation epoch SHALL be projected from the same provider-context receipt authority that admits provider-visible non-append changes; independent continuation counters MUST NOT mask a receipt transition through numeric max/merge.
      </?01M1ASG3TD56HQPMH62SSRD4SQ>
      <Suites [
        <Suite #cache-epoch-boundaries { name = "Provider cache epoch boundaries" } (
          <Cases [
            <Case #history-compaction-is-atomic-boundary (
              <Given ?01M1ASG3TD56HQPMH62SSRD4SR>
              history compaction creates a successor provider-context receipt and re-anchors durable context facts
              </?01M1ASG3TD56HQPMH62SSRD4SR>
              <When ?01M1ASG3TD56HQPMH62SSRD4SS>
              the first provider request is materialized from the compacted history
              </?01M1ASG3TD56HQPMH62SSRD4SS>
              <Then ?01M1ASG3TD56HQPMH62SSRD4ST>
              its cache observation SHALL carry the successor receipt epoch on that same request, so comparison with the predecessor is epoch_boundary
              </?01M1ASG3TD56HQPMH62SSRD4ST>
            )>
            <Case #continuation-counter-cannot-mask-boundary (
              <Given ?01M1ASG3TD56HQPMH62SSRD4SV>
              a Responses continuation baseline counter is numerically greater than both predecessor and successor provider-context receipt epochs
              </?01M1ASG3TD56HQPMH62SSRD4SV>
              <When ?01M1ASG3TD56HQPMH62SSRD4SW>
              a generic provider cache observation identity is projected
              </?01M1ASG3TD56HQPMH62SSRD4SW>
              <Then ?01M1ASG3TD56HQPMH62SSRD4SX>
              the receipt transition SHALL remain visible and MUST NOT be collapsed by taking the maximum counter
              </?01M1ASG3TD56HQPMH62SSRD4SX>
            )>
            <Case #append-keeps-comparable-epoch (
              <Given ?01M1ASG3TD56HQPMH62SSRD4SY>
              provider-visible history only grows by admitted append and the provider-context receipt is unchanged
              </?01M1ASG3TD56HQPMH62SSRD4SY>
              <When ?01M1ASG3TD56HQPMH62SSRD4SZ>
              successive cache observations are compared
              </?01M1ASG3TD56HQPMH62SSRD4SZ>
              <Then ?01M1ASG3TD56HQPMH62SSRD4T0>
              they SHALL retain one context epoch and remain eligible for exact forward-prefix comparison
              </?01M1ASG3TD56HQPMH62SSRD4T0>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
