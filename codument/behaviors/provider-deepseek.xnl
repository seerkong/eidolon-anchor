<Behavior #provider-deepseek apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #v4-flash-capabilities (
      <Statement ?01M13804PHG041S90VSYRYYH93>
      DeepSeek adapter SHALL 支持模型 id `deepseek-v4-flash` 及其官方 Chat Completions 文本、thinking、reasoning effort、stream 与 tool-call contract；截至 2026-08-02，该模型 SHALL 声明为 text-only，系统 MUST NOT 把官方不支持的 image/file content 发送后当作识图成功。
      </?01M13804PHG041S90VSYRYYH93>
      <Suites [
        <Suite #v4-flash-routing { name = "DeepSeek V4 Flash 接入" } (
          <Cases [
            <Case #uses-current-model-id-and-endpoint [
              <Then ?01M13804PHG041S90VSYRYYH94>
              请求 SHALL 使用配置的 DeepSeek base URL、`/chat/completions` endpoint 与原始模型 id
              </?01M13804PHG041S90VSYRYYH94>
              <Then ?01M13804PHG041S90VSYRYYH95>
              stream、tools、thinking 与受支持 reasoning effort SHALL 继续工作
              </?01M13804PHG041S90VSYRYYH95>
            ] (
              <Given ?01M13804PHG041S90VSYRYYH96>
              provider adapter 为 deepseek 且模型配置为 deepseek-v4-flash
              </?01M13804PHG041S90VSYRYYH96>
              <When ?01M13804PHG041S90VSYRYYH97>
              系统构造 Chat Completions 请求
              </?01M13804PHG041S90VSYRYYH97>
            )>
            <Case #official-limits-are-configurable (
              <Given ?01M13804PHG041S90VSYRYYH98>
              示例或用户配置选择 DeepSeek V4 Flash
              </?01M13804PHG041S90VSYRYYH98>
              <When ?01M13804PHG041S90VSYRYYH99>
              provider catalog 解析模型
              </?01M13804PHG041S90VSYRYYH99>
              <Then ?01M13804PHG041S90VSYRYYH9A>
              context/output limits SHALL 可按官方 1M/384K 值配置并传播到 runtime capability
              </?01M13804PHG041S90VSYRYYH9A>
            )>
            <Case #image-is-rejected-not-placeholdered [
              <Then ?01M13804PHG041S90VSYRYYH9B>
              系统 SHALL 在 I/O 前以 unsupported image modality 拒绝请求
              </?01M13804PHG041S90VSYRYYH9B>
              <Then ?01M13804PHG041S90VSYRYYH9C>
              系统 MUST NOT 发送 input_image 让服务端替换为 placeholder，也 MUST NOT 声称已识别图片
              </?01M13804PHG041S90VSYRYYH9C>
            ] (
              <Given ?01M13804PHG041S90VSYRYYH9D>
              当前模型为 deepseek-v4-flash 且 prompt 含 image part
              </?01M13804PHG041S90VSYRYYH9D>
              <When ?01M13804PHG041S90VSYRYYH9E>
              系统准备 provider 请求
              </?01M13804PHG041S90VSYRYYH9E>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #official-live-proposition-cache-evidence (
      <Statement ?01M13804PHG041S90VSYRYYH9F>
      Official DeepSeek proposition runs SHALL report final-success cache usage, exact retained-prefix integrity and absolute provider-token cost by comparable context epoch without letting compatible providers, short-context warm-up or aggregate ratios satisfy the long-running gate.
      </?01M13804PHG041S90VSYRYYH9F>
      <Suites [
        <Suite #live-proposition-evidence { name = "Official live proposition evidence" } (
          <Cases [
            <Case #official-provider-only (
              <Given ?01M13804PHG041S90VSYRYYH9G>
              a live matrix cell is required for Mission acceptance
              </?01M13804PHG041S90VSYRYYH9G>
              <When ?01M13804PHG041S90VSYRYYH9H>
              provider configuration is resolved
              </?01M13804PHG041S90VSYRYYH9H>
              <Then ?01M13804PHG041S90VSYRYYH9J>
              the receipt SHALL prove the official DeepSeek provider and exact model; a compatible gateway SHALL remain separate and cannot satisfy the cell
              </?01M13804PHG041S90VSYRYYH9J>
            )>
            <Case #long-context-scope (
              <Given ?01M13804PHG041S90VSYRYYH9K>
              forward-only final-success turns share provider, model and context epoch with at least three eligible subsequent turns and 32768 input tokens
              </?01M13804PHG041S90VSYRYYH9K>
              <When ?01M13804PHG041S90VSYRYYH9M>
              cache coverage is evaluated
              </?01M13804PHG041S90VSYRYYH9M>
              <Then ?01M13804PHG041S90VSYRYYH9N>
              the scope SHALL report hit and miss tokens, require retained-prefix integrity `1.0`, target hit ratio at least `0.995`, and localize any lower result without merging cold or explicit-epoch turns
              </?01M13804PHG041S90VSYRYYH9N>
            )>
            <Case #absolute-cost-is-visible (
              <Given ?01M13804PHG041S90VSYRYYH9P>
              ordinary, Ctrl and Data cells are verifier-equivalent
              </?01M13804PHG041S90VSYRYYH9P>
              <When ?01M13804PHG041S90VSYRYYH9Q>
              their provider cost is compared
              </?01M13804PHG041S90VSYRYYH9Q>
              <Then ?01M13804PHG041S90VSYRYYH9R>
              the report SHALL expose total input, hit, miss and output tokens plus normalized charged input and elapsed/retry facts so stable Workflow overhead cannot be hidden by a high ratio
              </?01M13804PHG041S90VSYRYYH9R>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #transient-transport-recovery (
      <Statement ?01M13804PHG041S90VSYRYYH9S>
      Official DeepSeek live execution SHALL integrate the provider-call transport recovery contract: a transient close may use bounded same-contract replay only before provider output is observed, and SHALL fail without replay once any visible output makes acceptance indeterminate.
      </?01M13804PHG041S90VSYRYYH9S>
      <Suites [
        <Suite #socket-close-recovery { name = "Premature socket-close recovery" } (
          <Cases [
            <Case #bun-close-before-output-retries (
              <Given ?01M13804PHG041S90VSYRYYH9T>
              Bun fetch closes an official DeepSeek stream with `The socket connection was closed unexpectedly` before visible text, reasoning or tool-call output
              </?01M13804PHG041S90VSYRYYH9T>
              <When ?01M13804PHG041S90VSYRYYH9V>
              the provider retry boundary classifies and handles the failure
              </?01M13804PHG041S90VSYRYYH9V>
              <Then ?01M13804PHG041S90VSYRYYH9W>
              it SHALL classify a transport pre-accept failure, replay the exact admitted request within the existing bounded policy, and emit structured retry diagnostics
              </?01M13804PHG041S90VSYRYYH9W>
            )>
            <Case #close-after-output-does-not-replay (
              <Given ?01M13804PHG041S90VSYRYYH9X>
              any visible provider output has been observed before a transport close
              </?01M13804PHG041S90VSYRYYH9X>
              <When ?01M13804PHG041S90VSYRYYH9Y>
              the stream terminates
              </?01M13804PHG041S90VSYRYYH9Y>
              <Then ?01M13804PHG041S90VSYRYYH9Z>
              it SHALL report indeterminate-after-accept and MUST NOT create another provider attempt
              </?01M13804PHG041S90VSYRYYH9Z>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
