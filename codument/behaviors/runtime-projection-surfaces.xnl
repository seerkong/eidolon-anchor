<Behavior #runtime-projection-surfaces apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #surface-readonly-projection (
      <Statement ?01M1MB3ZZEN0FGCJ1B5ZTE856N>
      runtime surfaces（TUI、actor surface、observability、derived index、CLI/headless 表现层）SHALL 只作为只读 projection / write-only sink 存在：SHALL NOT 写入、修改或销毁 domain truth（conversation/history、ToolCallDomain、ProviderCallDomain、TurnState、session 真源），SHALL NOT gate 或反向影响 live AI loop（surface 的 status/session 处理 SHALL NOT gate turn 继续；surface transcript / visible history SHALL NOT 成为 provider context 输入）。对应 gate G-surface-readonly / 005 规则五。
      </?01M1MB3ZZEN0FGCJ1B5ZTE856N>
      <Suites [
        <Suite #readonly-invariant { name = "Surface read-only invariant" } (
          <Cases [
            <Case #no-surface-domain-writes [
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE856P>
              SHALL NOT 直接构造 domain 写入器或调用 domain-truth 写 API（writeHistory/Prompt/SessionIndex、applyConversationCompaction、emit*DomainEvent、Conversation/ToolCall/ProviderCall domain 写入）
              </?01M1MB3ZZEN0FGCJ1B5ZTE856P>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE856Q>
              surface 自有 sink（tui-session.json、CLI 输出/trace、observability journal）不受此约束
              </?01M1MB3ZZEN0FGCJ1B5ZTE856Q>
            ] (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE856R>
              terminal surface 包（tui/organ/cli/organ-support）
              </?01M1MB3ZZEN0FGCJ1B5ZTE856R>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE856S>
              边界守卫扫描 surface 源（含 TuiRuntimeClient 等真正读取/重建处，不止 entry 文件）
              </?01M1MB3ZZEN0FGCJ1B5ZTE856S>
            )>
            <Case #no-surface-loop-gate [
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE856T>
              provider prompt SHALL 仅来自 vm/domain 物化（promptSource=domain_materialization），SHALL NOT 接受 surface transcript / visible history
              </?01M1MB3ZZEN0FGCJ1B5ZTE856T>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE856V>
              turn 是否继续 SHALL NOT 由 surface status/session 状态决定
              </?01M1MB3ZZEN0FGCJ1B5ZTE856V>
            ] (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE856W>
              live AI loop 的 provider prompt 构建
              </?01M1MB3ZZEN0FGCJ1B5ZTE856W>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE856X>
              检查 provider context 物化输入
              </?01M1MB3ZZEN0FGCJ1B5ZTE856X>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #conversation-projection-read-port (
      <Statement ?01M1MB3ZZEN0FGCJ1B5ZTE856Y>
      surface 的 hydration 方向读取（重建可见会话状态）SHALL 经由一个类型化、只读的 projection-read port 完成，该 port 消费单一来源真源（与 persistence backplane 的单源 read 一致），SHALL NOT 由 surface 自建 repository 直读或复制单源 loader 逻辑而绕过单源/缺源硬失败。pending-questions 等 runtime_state 读取 SHALL 同样经类型化 projection-read，SHALL NOT 直接读原始文件。
      </?01M1MB3ZZEN0FGCJ1B5ZTE856Y>
      <Suites [
        <Suite #projection-read { name = "Typed projection-read port" } (
          <Cases [
            <Case #tui-hydration-through-port [
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE856Z>
              SHALL 经 ConversationProjectionReadPort（只读，单源）获取视图，SHALL NOT 在 surface 内自建 conversation/persistence repository 绕过单源读取
              </?01M1MB3ZZEN0FGCJ1B5ZTE856Z>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE8570>
              声明的来源不可加载时 SHALL 以单源硬失败的语义呈现，SHALL NOT 降级混源
              </?01M1MB3ZZEN0FGCJ1B5ZTE8570>
            ] (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE8571>
              TUI 启动 hydration 需要重建可见会话状态
              </?01M1MB3ZZEN0FGCJ1B5ZTE8571>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE8572>
              surface 读取会话真源
              </?01M1MB3ZZEN0FGCJ1B5ZTE8572>
            )>
            <Case #pending-questions-through-port (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE8573>
              surface 需要展示 pending questionnaires
              </?01M1MB3ZZEN0FGCJ1B5ZTE8573>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE8574>
              surface 读取 pending-questions 状态
              </?01M1MB3ZZEN0FGCJ1B5ZTE8574>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE8575>
              SHALL 经类型化 projection-read 视图获取，SHALL NOT 直接读 runtime_state/questionnaires.xnl 原始文件
              </?01M1MB3ZZEN0FGCJ1B5ZTE8575>
            )>
            <Case #read-port-is-readonly (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE8576>
              ConversationProjectionReadPort 契约
              </?01M1MB3ZZEN0FGCJ1B5ZTE8576>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE8577>
              检查其能力面
              </?01M1MB3ZZEN0FGCJ1B5ZTE8577>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE8578>
              SHALL 只暴露只读视图方法，SHALL NOT 暴露任何写入/修改/销毁 domain truth 的方法
              </?01M1MB3ZZEN0FGCJ1B5ZTE8578>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #surface-destroy-via-domain-capability (
      <Statement ?01M1MB3ZZEN0FGCJ1B5ZTE8579>
      surface 发起的 session 销毁（删除）SHALL 经由 domain-owned 的删除能力中介完成，surface SHALL NOT 直接对 session 真源目录/文件执行文件系统删除（rm）。对应 005 规则五（projection 不能反写/销毁上游真源）。
      </?01M1MB3ZZEN0FGCJ1B5ZTE8579>
      <Suites [
        <Suite #destroy-mediation { name = "Destroy via domain capability" } (
          <Cases [
            <Case #session-delete-routes-through-capability [
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE857A>
              SHALL 调用 domain-owned 删除能力，由其负责销毁 session 真源
              </?01M1MB3ZZEN0FGCJ1B5ZTE857A>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE857B>
              surface SHALL NOT 直接 rm session 真源目录（含 conversation 文件）
              </?01M1MB3ZZEN0FGCJ1B5ZTE857B>
            ] (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE857C>
              用户在 surface 触发删除一个 session
              </?01M1MB3ZZEN0FGCJ1B5ZTE857C>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE857D>
              surface 处理删除
              </?01M1MB3ZZEN0FGCJ1B5ZTE857D>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #cross-surface-domain-equivalence (
      <Statement ?01M1MB3ZZEN0FGCJ1B5ZTE857E>
      同一条 live AI loop 在不同 surface（TUI / CLI / headless）下 SHALL 产生等价的 domain 行为与模型可见 history；surface 选择 SHALL NOT 改变 domain 结果。SHALL 提供同一 live loop、不同 surface 的 domain 等价测试作为分歧回归守护。
      </?01M1MB3ZZEN0FGCJ1B5ZTE857E>
      <Suites [
        <Suite #surface-equivalence { name = "Cross-surface equivalence" } (
          <Cases [
            <Case #same-loop-different-surface-equivalent [
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE857F>
              domain 真源（可见 history、tool 结果配对、turn 结果）SHALL 等价，差异仅限 surface 自有呈现
              </?01M1MB3ZZEN0FGCJ1B5ZTE857F>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE857G>
              SHALL NOT 出现某 surface 改变 domain 结果或单独触达 domain truth 的情况
              </?01M1MB3ZZEN0FGCJ1B5ZTE857G>
            ] (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE857H>
              同一 profile/同一 live loop 输入
              </?01M1MB3ZZEN0FGCJ1B5ZTE857H>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE857J>
              分别经 TUI 与 CLI/headless surface 运行
              </?01M1MB3ZZEN0FGCJ1B5ZTE857J>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #unified-turn-surface-projection (
      <Statement ?01M1MB3ZZEN0FGCJ1B5ZTE857K>
      TUI SHALL 由单一 turn surface projector 消费 typed control、chunk、history 与 completion observations；prompt、slash command 和 questionnaire continuation SHALL 复用同一投影状态机，SHALL NOT 各自维护平行的类别、buffer、tool part 或 reconciliation 逻辑。
      </?01M1MB3ZZEN0FGCJ1B5ZTE857K>
      <Suites [
        <Suite #entry-equivalence { name = "三入口投影等价" } (
          <Cases [
            <Case #same-semantic-sequence-same-cards [
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE857M>
              三条入口 SHALL 产生类别与身份等价的可见卡片
              </?01M1MB3ZZEN0FGCJ1B5ZTE857M>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE857N>
              turn/toolcall/result/done 文本 MUST NOT 出现在 assistant 卡片
              </?01M1MB3ZZEN0FGCJ1B5ZTE857N>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE857P>
              think 只 SHALL 出现在 thinking 卡片，assist 只 SHALL 出现在 assistant 卡片
              </?01M1MB3ZZEN0FGCJ1B5ZTE857P>
            ] (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE857Q>
              相同 semantic sequence 分别经 prompt、slash command 与 questionnaire continuation 到达 TUI
              </?01M1MB3ZZEN0FGCJ1B5ZTE857Q>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE857R>
              surface projector 处理这些 observations
              </?01M1MB3ZZEN0FGCJ1B5ZTE857R>
            )>
          ]>
        )>
        <Suite #identity-reconciliation { name = "稳定身份消重" } (
          <Cases [
            <Case #live-and-durable-tool-merge [
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE857S>
              surface SHALL 以 actorId+toolCallId 合并为一个 TOOL 卡片
              </?01M1MB3ZZEN0FGCJ1B5ZTE857S>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE857T>
              durable reconciliation SHALL 更新现有 identity，MUST NOT 清空并创建随机新 identity
              </?01M1MB3ZZEN0FGCJ1B5ZTE857T>
            ] (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE857V>
              同一 tool call 同时由 live history observation 和 durable conversation history 提供
              </?01M1MB3ZZEN0FGCJ1B5ZTE857V>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE857W>
              TUI 完成 continuation 或重新 hydration
              </?01M1MB3ZZEN0FGCJ1B5ZTE857W>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #exhaustive-conversation-role-projection (
      <Statement ?01M1MB3ZZEN0FGCJ1B5ZTE857X>
      TUI conversation projection SHALL exhaustive-map user、assistant、tool 与 system/internal role；仅 user SHALL 投影为 USER，tool SHALL 重建为 ToolPart/card，system/internal SHALL 隐藏或进入显式 diagnostic/context surface，MUST NOT 回退为 USER。
      </?01M1MB3ZZEN0FGCJ1B5ZTE857X>
      <Suites [
        <Suite #role-map { name = "角色投影" } (
          <Cases [
            <Case #tool-and-system-never-user [
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE857Y>
              tool 与 system 消息 MUST NOT 出现在 USER 卡片
              </?01M1MB3ZZEN0FGCJ1B5ZTE857Y>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE857Z>
              tool SHALL 保留 toolCallId 形成结构化 ToolPart
              </?01M1MB3ZZEN0FGCJ1B5ZTE857Z>
            ] (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE8580>
              durable conversation 包含 tool 与 system 消息
              </?01M1MB3ZZEN0FGCJ1B5ZTE8580>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE8581>
              TUI hydrate 或 reconcile history
              </?01M1MB3ZZEN0FGCJ1B5ZTE8581>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #session-fork-via-domain-capability (
      <Statement ?01M1MB3ZZEN0FGCJ1B5ZTE8582>
      TUI、CLI and headless surfaces SHALL request session fork through one domain-owned write capability and SHALL hydrate the result through the Conversation projection read port only after durable publication; surface-owned message arrays MUST NOT become fork input authority.
      </?01M1MB3ZZEN0FGCJ1B5ZTE8582>
      <Suites [
        <Suite #fork-mediation { name = "Fork via domain capability" } (
          <Cases [
            <Case #surface-routes-fork-command (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE8583>
              a surface offers current-session or message-level fork
              </?01M1MB3ZZEN0FGCJ1B5ZTE8583>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE8584>
              the user activates the fork action
              </?01M1MB3ZZEN0FGCJ1B5ZTE8584>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE8585>
              the surface SHALL submit source id、target id and optional message selector to the domain capability；it MUST NOT persist cloned messages、parts or session directories itself
              </?01M1MB3ZZEN0FGCJ1B5ZTE8585>
            )>
            <Case #hydrate-only-after-commit (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE8586>
              the domain fork command is in progress or returns rejection
              </?01M1MB3ZZEN0FGCJ1B5ZTE8586>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE8587>
              the surface decides whether to navigate to the child
              </?01M1MB3ZZEN0FGCJ1B5ZTE8587>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE8588>
              navigation and hydration SHALL occur only for a durable committed child receipt；rejection SHALL keep the source active and SHALL NOT expose a ghost child in session lists
              </?01M1MB3ZZEN0FGCJ1B5ZTE8588>
            )>
            <Case #surface-domain-result-equivalence (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE8589>
              TUI、headless helper或CLI请求相同current-head/message-level语义
              </?01M1MB3ZZEN0FGCJ1B5ZTE8589>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE858A>
              surface投影fork command并消费结果
              </?01M1MB3ZZEN0FGCJ1B5ZTE858A>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE858B>
              三种surface SHALL共享Conversation-owned port并保留相同typed receipt/rejection；MUST NOT各自实现cutoff或persistence逻辑
              </?01M1MB3ZZEN0FGCJ1B5ZTE858B>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #session-rewind-via-domain-capability (
      <Statement ?01M1MB3ZZEN0FGCJ1B5ZTE858C>
      TUI、CLI and headless surfaces SHALL request rewind through one Conversation-owned write port and hydrate only after committed publication；rendered messages、parts and indexes MUST NOT be write authority.
      </?01M1MB3ZZEN0FGCJ1B5ZTE858C>
      <Suites [
        <Suite #rewind-mediation { name = "Rewind surface mediation" } (
          <Cases [
            <Case #hydrate-after-commit (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE858D>
              a surface requests rewind through a canonical message id
              </?01M1MB3ZZEN0FGCJ1B5ZTE858D>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE858E>
              the domain returns committed or rejected
              </?01M1MB3ZZEN0FGCJ1B5ZTE858E>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE858F>
              the surface SHALL rehydrate only after committed，and rejection SHALL leave the active view unchanged
              </?01M1MB3ZZEN0FGCJ1B5ZTE858F>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #lightweight-session-catalog-projection (
      <Statement ?01M1MB3ZZEN0FGCJ1B5ZTE858G>
      会话目录 SHALL 由轻量、持久化且有界的 Session Summary 投影提供；列举、搜索和重命名会话 MUST NOT 为生成目录项加载完整 Conversation History，完整 history hydration 只发生在被选中的会话读取路径。
      </?01M1MB3ZZEN0FGCJ1B5ZTE858G>
      <Suites [
        <Suite #catalog-read-boundary { name = "Session catalog read boundary" } (
          <Cases [
            <Case #list-does-not-load-history (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE858H>
              工作区包含具有超大 history.xnl 的持久化会话，且该会话具有或缺少可选摘要字段
              </?01M1MB3ZZEN0FGCJ1B5ZTE858H>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE858J>
              surface 列举或搜索会话目录
              </?01M1MB3ZZEN0FGCJ1B5ZTE858J>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE858K>
              系统 SHALL 返回基础会话信息与可用摘要，MUST NOT 调用 history projection 或实例化该会话 runtime
              </?01M1MB3ZZEN0FGCJ1B5ZTE858K>
            )>
            <Case #rename-does-not-hydrate-history (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE858M>
              持久化长会话尚未在当前进程完成 history hydration
              </?01M1MB3ZZEN0FGCJ1B5ZTE858M>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE858N>
              用户只更新会话标题
              </?01M1MB3ZZEN0FGCJ1B5ZTE858N>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE858P>
              系统 SHALL 直接更新 live summary 与 sidecar，并发送 session.updated；MUST NOT 加载完整 history
              </?01M1MB3ZZEN0FGCJ1B5ZTE858P>
            )>
            <Case #legacy-summary-uses-bounded-edge-projection (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE858Q>
              旧会话的 sidecar 没有 preview 或时间摘要
              </?01M1MB3ZZEN0FGCJ1B5ZTE858Q>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE858R>
              surface 首次列举该会话
              </?01M1MB3ZZEN0FGCJ1B5ZTE858R>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE858S>
              系统 SHALL 通过只读投影端口有界读取 history.xnl 首尾的完整 XNL 消息记录并立即展示第一条和最近一条消息，MUST NOT 完整读取 history；该会话后续完成权威 hydration 时 SHALL 回填 sidecar
              </?01M1MB3ZZEN0FGCJ1B5ZTE858S>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #paginated-conversation-history-projection (
      <Statement ?01M1MB3ZZEN0FGCJ1B5ZTE858T>
      Conversation history hydration SHALL 提供只读、有界、cursor 化的分页投影；会话首屏读取 MUST NOT 先完整物化 history，cursor MUST 绑定 active actor 的可见 generation 快照，过期 cursor MUST NOT 泄漏 rewind、fork 或 compaction 后不可见的记录。
      </?01M1MB3ZZEN0FGCJ1B5ZTE858T>
      <Suites [
        <Suite #bounded-history-pages { name = "Bounded conversation history pages" } (
          <Cases [
            <Case #latest-page-is-bounded (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE858V>
              active actor 拥有远大于单页的持久化 XNL history
              </?01M1MB3ZZEN0FGCJ1B5ZTE858V>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE858W>
              surface 请求无 cursor 的 history page
              </?01M1MB3ZZEN0FGCJ1B5ZTE858W>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE858X>
              projection SHALL 只返回最新一页正序消息和 previous-page cursor，观察字节 SHALL 受单页窗口预算约束，MUST NOT 调用完整 history materializer
              </?01M1MB3ZZEN0FGCJ1B5ZTE858X>
            )>
            <Case #previous-page-preserves-visible-order (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE858Y>
              surface 持有上一页返回的 opaque cursor
              </?01M1MB3ZZEN0FGCJ1B5ZTE858Y>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE858Z>
              surface 请求更早一页
              </?01M1MB3ZZEN0FGCJ1B5ZTE858Z>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE8590>
              projection SHALL 返回无重复、正序且只属于 active actor visible generations 的消息，直至第一条时 hasPreviousPage=false
              </?01M1MB3ZZEN0FGCJ1B5ZTE8590>
            )>
            <Case #stale-cursor-rejected (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE8591>
              cursor 创建后发生 rewind、fork repair 或 compaction，使 visible generation snapshot 改变
              </?01M1MB3ZZEN0FGCJ1B5ZTE8591>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE8592>
              surface 使用旧 cursor 请求页面
              </?01M1MB3ZZEN0FGCJ1B5ZTE8592>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE8593>
              projection SHALL 返回 typed stale-cursor 结果，MUST NOT 混入旧分支尾部或静默拼接不同快照
              </?01M1MB3ZZEN0FGCJ1B5ZTE8593>
            )>
            <Case #auxiliary-user-input-history-is-bounded (
              <Given ?01M1MB3ZZEN0FGCJ1B5ZTE8594>
              TUI 恢复长会话并需要最近的 Composer 输入历史
              </?01M1MB3ZZEN0FGCJ1B5ZTE8594>
              <When ?01M1MB3ZZEN0FGCJ1B5ZTE8595>
              surface 加载 user-input history
              </?01M1MB3ZZEN0FGCJ1B5ZTE8595>
              <Then ?01M1MB3ZZEN0FGCJ1B5ZTE8596>
              surface SHALL 复用 snapshot cursor 分页投影并受条目数与观察字节预算约束，MUST NOT 为辅助输入历史完整物化 actor raw state
              </?01M1MB3ZZEN0FGCJ1B5ZTE8596>
            )>
          ]>
        )>
