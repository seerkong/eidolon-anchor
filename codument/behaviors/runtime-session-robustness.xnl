<Behavior #runtime-session-robustness apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #recovery-model-config-validation (
      <Statement ?01M18JQ3Q6102K4PNKE4E7YCKS>
      恢复一个 session 时，若其持久化的 actor modelConfig 选定的 model/provider 在当前配置（providers + presets）中**不可解析**（provider 被移除，或 provider 在但 model 已删），运行时 SHALL 回退到默认 preset 的 model，SHALL NOT 复用已失效的持久化 model/endpoint。持久化 model 仍可解析时 SHALL 原样保留。
      </?01M18JQ3Q6102K4PNKE4E7YCKS>
      <Suites [
        <Suite #model-validation { name = "Persisted model validation on recovery" } (
          <Cases [
            <Case #stale-model-falls-back-to-default (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCKT>
              恢复出的 actor 持久化 modelConfig 的 model/provider 在当前配置中不存在
              </?01M18JQ3Q6102K4PNKE4E7YCKT>
              <When ?01M18JQ3Q6102K4PNKE4E7YCKV>
              运行时解析该 turn 的 model
              </?01M18JQ3Q6102K4PNKE4E7YCKV>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCKW>
              SHALL 解析为默认 preset 的 model（不复用失效持久化配置）
              </?01M18JQ3Q6102K4PNKE4E7YCKW>
            )>
            <Case #valid-persisted-model-preserved (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCKX>
              恢复出的 actor 持久化 model 在当前配置中仍可解析
              </?01M18JQ3Q6102K4PNKE4E7YCKX>
              <When ?01M18JQ3Q6102K4PNKE4E7YCKY>
              运行时解析该 turn 的 model
              </?01M18JQ3Q6102K4PNKE4E7YCKY>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCKZ>
              SHALL 保留该持久化 model，SHALL NOT 覆盖为默认
              </?01M18JQ3Q6102K4PNKE4E7YCKZ>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #observability-journal-hygiene (
      <Statement ?01M18JQ3Q6102K4PNKE4E7YCM0>
      orchestration 观测 journal 的每次 append SHALL 为 O(1)（SHALL NOT 每次 append 全量读解析整个文件取序号）；journal SHALL 受体积上限/轮转约束（默认上限 + 保留近 N 段），SHALL NOT 无界增长；高频 idle no-op 事件 SHALL 可丢弃/采样。不破坏 observability 契约——有意义事件仍被记录。
      </?01M18JQ3Q6102K4PNKE4E7YCM0>
      <Suites [
        <Suite #journal-hygiene { name = "Observability journal hygiene" } (
          <Cases [
            <Case #append-is-constant-time (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCM1>
              orchestration journal 已较大
              </?01M18JQ3Q6102K4PNKE4E7YCM1>
              <When ?01M18JQ3Q6102K4PNKE4E7YCM2>
              追加一个事件
              </?01M18JQ3Q6102K4PNKE4E7YCM2>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCM3>
              append SHALL NOT 全量读+解析整个 journal 文件取序号（用内存序号计数器）
              </?01M18JQ3Q6102K4PNKE4E7YCM3>
            )>
            <Case #journal-is-bounded (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCM4>
              journal 体积达到配置上限
              </?01M18JQ3Q6102K4PNKE4E7YCM4>
              <When ?01M18JQ3Q6102K4PNKE4E7YCM5>
              继续追加
              </?01M18JQ3Q6102K4PNKE4E7YCM5>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCM6>
              SHALL 轮转（保留近 N 段），journal SHALL NOT 无界增长到数百 MB
              </?01M18JQ3Q6102K4PNKE4E7YCM6>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #timed-out-turn-progress-persisted (
      <Statement ?01M18JQ3Q6102K4PNKE4E7YCM7>
      当一个 turn 在 mandatory_continuation 状态下超时（unsettled）时，运行时 SHALL seal 已完成的 conversation 进度（已 commit 进 conversation domain 的完成工具对/消息），SHALL NOT 因此快照不安全的工具执行中状态。后续 continuation 恢复该 session 时，model-visible history SHALL 包含 sealed completed progress，SHALL NOT 回到超时前的 checkpoint 从头重来。恢复门 SHALL 只容忍 conversation head 的 forward-only advancement；缺失、倒退、或非 conversation authoritative head mismatch 仍 SHALL 判 dirty。
      </?01M18JQ3Q6102K4PNKE4E7YCM7>
      <Suites [
        <Suite #timeout-progress { name = "Timed-out turn persists completed progress" } (
          <Cases [
            <Case #completed-progress-sealed-on-timeout [
              <Then ?01M18JQ3Q6102K4PNKE4E7YCM8>
              已完成的 conversation 进度 SHALL 被 seal 进持久化 history
              </?01M18JQ3Q6102K4PNKE4E7YCM8>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCM9>
              SHALL NOT 快照不安全的 in-flight VM/ToolCallDomain 状态
              </?01M18JQ3Q6102K4PNKE4E7YCM9>
            ] (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCMA>
              一个 turn 完成了若干工具对后在 mandatory_continuation 超时
              </?01M18JQ3Q6102K4PNKE4E7YCMA>
              <When ?01M18JQ3Q6102K4PNKE4E7YCMB>
              turn 返回 timeout_unsettled
              </?01M18JQ3Q6102K4PNKE4E7YCMB>
            )>
            <Case #continuation-resumes-not-restarts [
              <Then ?01M18JQ3Q6102K4PNKE4E7YCMC>
              恢复的 model-visible history SHALL 含 sealed completed progress
              </?01M18JQ3Q6102K4PNKE4E7YCMC>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCMD>
              恢复 SHALL 容忍 conversation head actual 大于 checkpoint expected
              </?01M18JQ3Q6102K4PNKE4E7YCMD>
            ] (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCME>
              一个 session 先 settle 落过 checkpoint，随后某轮 seal 了 completed conversation progress 但未保存 VM checkpoint
              </?01M18JQ3Q6102K4PNKE4E7YCME>
              <When ?01M18JQ3Q6102K4PNKE4E7YCMF>
              后续 continuation 恢复该 session
              </?01M18JQ3Q6102K4PNKE4E7YCMF>
            )>
            <Case #non-forward-mismatch-remains-dirty (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCMG>
              恢复时 durable head 缺失、倒退、或非 conversation authoritative head 与 checkpoint marker 不一致
              </?01M18JQ3Q6102K4PNKE4E7YCMG>
              <When ?01M18JQ3Q6102K4PNKE4E7YCMH>
              runtime-control recovery gate 分类该 session
              </?01M18JQ3Q6102K4PNKE4E7YCMH>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCMJ>
              恢复 SHALL 判 dirty 或 pending，SHALL NOT 把该 mismatch 当作 clean recovery
              </?01M18JQ3Q6102K4PNKE4E7YCMJ>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #historical-long-turn-smoke (
      <Statement ?01M18JQ3Q6102K4PNKE4E7YCMK>
      系统 SHALL provide a real CLI smoke path for historical long-running inputs that verifies resumable pause semantics without requiring unsafe checkpoint snapshots.
      </?01M18JQ3Q6102K4PNKE4E7YCMK>
      <Suites [
        <Suite #historical-smoke { name = "Historical long turn smoke" } (
          <Cases [
            <Case #sparrow-session-pauses-with-progress [
              <Then ?01M18JQ3Q6102K4PNKE4E7YCMM>
              headless result SHALL be `paused_with_progress`
              </?01M18JQ3Q6102K4PNKE4E7YCMM>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCMN>
              trace SHALL record `session_end.status=paused_with_progress`
              </?01M18JQ3Q6102K4PNKE4E7YCMN>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCMP>
              `--output-last-message` SHALL NOT be written
              </?01M18JQ3Q6102K4PNKE4E7YCMP>
            ] (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCMQ>
              the historical Sparrow session analysis prompt is executed through source CLI with a short timeout
              </?01M18JQ3Q6102K4PNKE4E7YCMQ>
              <When ?01M18JQ3Q6102K4PNKE4E7YCMR>
              the turn reaches mandatory continuation before safepoint
              </?01M18JQ3Q6102K4PNKE4E7YCMR>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #journal-head-accounting-and-rotation (
      <Statement ?01M18JQ3Q6102K4PNKE4E7YCMS>
      系统 SHALL 以持久化 head/计数（runtime-control/heads/）承载 ingress、diagnostics 观测日志与 effect-evidence 日志的计数与 last 信息；读取 head 或取 effect 序号 SHALL NOT 全量 readFile+parseXnl 整个日志文件；旧会话无 head 文件时 SHALL 以有界尾部窗口（从合法 XNL 节点起始行开始解析）回退。观测日志 SHALL 按大小轮转（默认 64MB/段，保留近 2 段），SHALL NOT 无界增长到数百 MB。
      </?01M18JQ3Q6102K4PNKE4E7YCMS>
      <Suites [
        <Suite #head-accounting { name = "Head accounting and rotation" } (
          <Cases [
            <Case #head-read-is-bounded (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCMT>
              session 存在 ingress/diagnostics/effect-evidence 的持久化 head
              </?01M18JQ3Q6102K4PNKE4E7YCMT>
              <When ?01M18JQ3Q6102K4PNKE4E7YCMV>
              读取 real session durable heads 或 effect 序号
              </?01M18JQ3Q6102K4PNKE4E7YCMV>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCMW>
              SHALL 只读 head 文件，SHALL NOT 读取整个日志正文
              </?01M18JQ3Q6102K4PNKE4E7YCMW>
            )>
            <Case #legacy-tail-fallback-correct (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCMX>
              旧 session 无 head 文件且日志很大
              </?01M18JQ3Q6102K4PNKE4E7YCMX>
              <When ?01M18JQ3Q6102K4PNKE4E7YCMY>
              读取 durable heads
              </?01M18JQ3Q6102K4PNKE4E7YCMY>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCMZ>
              SHALL 以有界尾部窗口（从合法 XNL 节点起始行起 parseXnl）得到 count 与 last 信息
              </?01M18JQ3Q6102K4PNKE4E7YCMZ>
            )>
            <Case #rotation-by-size (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCN0>
              观测日志超过 64MB
              </?01M18JQ3Q6102K4PNKE4E7YCN0>
              <When ?01M18JQ3Q6102K4PNKE4E7YCN1>
              继续 append
              </?01M18JQ3Q6102K4PNKE4E7YCN1>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCN2>
              SHALL 轮转切段并保留近 2 段，head 计数跨段保持正确
              </?01M18JQ3Q6102K4PNKE4E7YCN2>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #long-session-memory-bound (
      <Statement ?01M18JQ3Q6102K4PNKE4E7YCN3>
      长会话运行期的内存保留 SHALL 有界：ingress 时间线、语义事件图、消息历史图等过程性保留点 SHALL 按已完成回合/容量上限裁剪，进程内存 SHALL NOT 随会话运行天数无界线性增长。
      </?01M18JQ3Q6102K4PNKE4E7YCN3>
      <Suites [
        <Suite #memory-bound { name = "Bounded in-memory retention" } (
          <Cases [
            <Case #timeline-pruned (
              <Given ?01M18JQ3Q6102K4PNKE4E7YCN4>
              长会话已运行多天且产生大量 ingress/语义事件
              </?01M18JQ3Q6102K4PNKE4E7YCN4>
              <When ?01M18JQ3Q6102K4PNKE4E7YCN5>
              检查 ingress 时间线与语义事件图保留
              </?01M18JQ3Q6102K4PNKE4E7YCN5>
              <Then ?01M18JQ3Q6102K4PNKE4E7YCN6>
              SHALL 只保留有界窗口（已结算事件可裁剪）
              </?01M18JQ3Q6102K4PNKE4E7YCN6>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
