<Behavior #runtime.execution-closures apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #semantic-baseline (
      <Statement ?01M1SC5VXC49JN07RNYGB5PGWK>
      职责重构 SHALL 使用隔离回归矩阵，锁定消息排序、工具配对、恢复事实和任务 receipt。
      </?01M1SC5VXC49JN07RNYGB5PGWK>
      <Suites [
        <Suite #closure-baseline { name = "执行闭包" } (
          <Cases [
            <Case #isolated-matrix (
              <Given ?01M1SC5VXC49JN07RNYGB5PGWM>
              Conversation 与 Holon 已有真实文件和协议测试
              </?01M1SC5VXC49JN07RNYGB5PGWM>
              <When ?01M1SC5VXC49JN07RNYGB5PGWN>
              运行执行闭包回归入口
              </?01M1SC5VXC49JN07RNYGB5PGWN>
              <Then ?01M1SC5VXC49JN07RNYGB5PGWP>
              每文件 SHALL 新进程执行，任一失败使入口失败；不请求真实 provider、不修改用户现场、不跟踪 bun.lock。
              </?01M1SC5VXC49JN07RNYGB5PGWP>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #conversation-boundary (
      <Statement ?01M1SC5VXDTPDG6ZWSEFKGRM93>
      Conversation SHALL 通过显式 repository 契约恢复，以纯投影构造相同上下文；persistence 的选择 SHALL 属于实例 runtime 而非模块加载副作用。
      </?01M1SC5VXDTPDG6ZWSEFKGRM93>
      <Suites [
        <Suite #conversation { name = "Conversation 边界" } (
          <Cases [
            <Case #wire-equivalence (
              <Given ?01M1SC5VXDTPDG6ZWSEFKGRM94>
              同一 raw state 与 repository
              </?01M1SC5VXDTPDG6ZWSEFKGRM94>
              <When ?01M1SC5VXDTPDG6ZWSEFKGRM95>
              迁移后构造消息
              </?01M1SC5VXDTPDG6ZWSEFKGRM95>
              <Then ?01M1SC5VXDTPDG6ZWSEFKGRM96>
              Prompt、history、tool pairs、fact anchors SHALL 与原基线一致，domain 不导入具体 support。
              </?01M1SC5VXDTPDG6ZWSEFKGRM96>
            )>
            <Case #instance-isolation (
              <Given ?01M1SC5VXDTPDG6ZWSEFKGRM97>
              两个实例对同一 adapter ID 使用不同实现
              </?01M1SC5VXDTPDG6ZWSEFKGRM97>
              <When ?01M1SC5VXDTPDG6ZWSEFKGRM98>
              分别运行 capsule
              </?01M1SC5VXDTPDG6ZWSEFKGRM98>
              <Then ?01M1SC5VXDTPDG6ZWSEFKGRM99>
              每个 SHALL 使用自身注入实现；未知项报错；import 不注册全局实现。
              </?01M1SC5VXDTPDG6ZWSEFKGRM99>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #holon-explicit-effect-composition (
      <Statement ?01M1SC5VXDTPDG6ZWSEFKGRM9A>
      Holon SHALL 显式组装文件效果与路由规则，保持既有持久协议、单一 task authority，support 不依赖 organ logic。
      </?01M1SC5VXDTPDG6ZWSEFKGRM9A>
      <Suites [
        <Suite #holon-composition { name = "Holon 显式组合" } (
          <Cases [
            <Case #recovery-equivalence (
              <Given ?01M1SC5VXDTPDG6ZWSEFKGRM9B>
              已有 v1/v2 journal 与 TaskSpace 现场。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9B>
              <When ?01M1SC5VXDTPDG6ZWSEFKGRM9C>
              独立或 Workflow 宿主装配并恢复。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9C>
              <Then ?01M1SC5VXDTPDG6ZWSEFKGRM9D>
              身份、首次观测、结果重放及 shared/fresh SHALL 不变，篡改冲突仍拒绝。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9D>
            )>
            <Case #explicit-runtime (
              <Given ?01M1SC5VXDTPDG6ZWSEFKGRM9E>
              规则和文件效果分别导入。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9E>
              <When ?01M1SC5VXDTPDG6ZWSEFKGRM9F>
              通过显式 runtime 选择实现。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9F>
              <Then ?01M1SC5VXDTPDG6ZWSEFKGRM9G>
              导入 SHALL 不注册全局实例，纯规则可无文件系统验证。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9G>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #configuration-dependency-boundary (
      <Statement ?01M1SC5VXDTPDG6ZWSEFKGRM9H>
      共享配置和权限 SHALL 以同一纯规则实现支撑 logic/support，物理读取不反向依赖 organ logic，迁移不得改变默认行为。
      </?01M1SC5VXDTPDG6ZWSEFKGRM9H>
      <Suites [
        <Suite #configuration-boundary { name = "配置依赖闭包" } (
          <Cases [
            <Case #equivalent-configuration (
              <Given ?01M1SC5VXDTPDG6ZWSEFKGRM9J>
              相同模型和权限配置输入。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9J>
              <When ?01M1SC5VXDTPDG6ZWSEFKGRM9K>
              由默认宿主读取并解析。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9K>
              <Then ?01M1SC5VXDTPDG6ZWSEFKGRM9M>
              结果、错误、优先级和秘密处理 SHALL 与迁移前一致。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9M>
            )>
            <Case #reject-reverse-edge (
              <Given ?01M1SC5VXDTPDG6ZWSEFKGRM9N>
              源码或 manifest 引入 support 到 organ logic 的边。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9N>
              <When ?01M1SC5VXDTPDG6ZWSEFKGRM9P>
              运行边界检查。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9P>
              <Then ?01M1SC5VXDTPDG6ZWSEFKGRM9Q>
              检查 SHALL 失败，不能用兼容转出口隐藏。
              </?01M1SC5VXDTPDG6ZWSEFKGRM9Q>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
