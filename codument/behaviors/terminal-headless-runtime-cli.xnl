<Behavior #terminal-headless-runtime-cli apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #headless-terminal-command-entry (
      <Statement ?01M12YSSVB6WJE4CGTVRYQ6WQG>
      系统应当（SHALL）在 `terminal/packages/cli` 中提供无头命令入口，用于执行单轮或脚本式 terminal 调用，而不启动 OpenTUI。
      </?01M12YSSVB6WJE4CGTVRYQ6WQG>
      <Suites [
        <Suite { name = "headless-terminal-command-entry" } (
          <Cases [
            <Case #run-headless-terminal-turn-without-tui { name = "Run headless terminal turn without TUI" } [
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WQH>
              系统直接输出模型返回内容
              </?01M12YSSVB6WJE4CGTVRYQ6WQH>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WQJ>
              不进入 OpenTUI 界面
              </?01M12YSSVB6WJE4CGTVRYQ6WQJ>
            ] (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WQK>
              用户在项目根或其子目录调用 terminal 命令
              </?01M12YSSVB6WJE4CGTVRYQ6WQK>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WQM>
              用户执行无头命令并提供 prompt
              </?01M12YSSVB6WJE4CGTVRYQ6WQM>
            )>
            <Case #run-exec-from-workspace-root-with-stdin-prompt { name = "Run exec from workspace root with stdin prompt" } [
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WQN>
              系统使用 `&amp;amp;amp;lt;workspace&amp;amp;amp;gt;` 作为 headless runtime 的工作根
              </?01M12YSSVB6WJE4CGTVRYQ6WQN>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WQP>
              将 stdin 内容作为本轮初始输入执行
              </?01M12YSSVB6WJE4CGTVRYQ6WQP>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WQQ>
              不启动 OpenTUI
              </?01M12YSSVB6WJE4CGTVRYQ6WQQ>
            ] (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WQR>
              调用方以 `exec -C &amp;amp;amp;lt;workspace&amp;amp;amp;gt; --output-last-message &amp;amp;amp;lt;file&amp;amp;amp;gt; -` 形式启动命令
              </?01M12YSSVB6WJE4CGTVRYQ6WQR>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WQS>
              stdin 提供初始 prompt 内容
              </?01M12YSSVB6WJE4CGTVRYQ6WQS>
            )>
            <Case #accept-the-polybench-relevant-codex-exec-flag-subset { name = "Accept the PolyBench-relevant Codex exec flag subset" } [
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WQT>
              系统对受支持参数应用稳定且文档化的兼容语义
              </?01M12YSSVB6WJE4CGTVRYQ6WQT>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WQV>
              不要求实现 Codex 全量命令面
              </?01M12YSSVB6WJE4CGTVRYQ6WQV>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WQW>
              不允许对未支持参数产生静默误解析
              </?01M12YSSVB6WJE4CGTVRYQ6WQW>
            ] (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WQX>
              调用方传入 `--full-auto`、`--dangerously-bypass-approvals-and-sandbox`、`--ephemeral`、`--add-dir`、`-m`、`-p` 或 `-c mcp_servers={}`
              </?01M12YSSVB6WJE4CGTVRYQ6WQX>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WQY>
              系统解析 `exec` 命令
              </?01M12YSSVB6WJE4CGTVRYQ6WQY>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #execprotocolgraph-as-parallel-headless-protocol-truth (
      <Statement ?01M12YSSVB6WJE4CGTVRYQ6WQZ>
      系统应当（SHALL）新增并维护与 `PrototypeStateGraph` 并列的 `ExecProtocolGraph`，作为 headless `exec` 协议状态的正式真相源，而不是在 prototype graph 上叠加补丁式 reducer。
      </?01M12YSSVB6WJE4CGTVRYQ6WQZ>
      <Suites [
        <Suite { name = "execprotocolgraph-as-parallel-headless-protocol-truth" } (
          <Cases [
            <Case #exec-protocol-state-is-projected-from-runtime-events { name = "Exec protocol state is projected from runtime events" } [
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WR0>
              `ExecProtocolGraph` 应对这些输入进行 reducer projection
              </?01M12YSSVB6WJE4CGTVRYQ6WR0>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WR1>
              产出最终消息、可见输出、运行状态、warning 与 failure 摘要
              </?01M12YSSVB6WJE4CGTVRYQ6WR1>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WR2>
              这些 headless exec 协议状态不依赖 `PrototypeStateGraph`
              </?01M12YSSVB6WJE4CGTVRYQ6WR2>
            ] (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WR3>
              headless exec 运行期间持续产生 runtime event、history event、tool 状态与 warning/failure 信号
              </?01M12YSSVB6WJE4CGTVRYQ6WR3>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WR4>
              系统需要决定 stdout、最终消息和退出状态
              </?01M12YSSVB6WJE4CGTVRYQ6WR4>
            )>
            <Case #successful-turn-writes-the-final-assistant-message { name = "Successful turn writes the final assistant message" } [
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WR5>
              调用方传入 `--output-last-message &amp;amp;amp;lt;file&amp;amp;amp;gt;`
              </?01M12YSSVB6WJE4CGTVRYQ6WR5>
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WR6>
              本轮 headless exec 正常完成并产出最终 assistant 消息
              </?01M12YSSVB6WJE4CGTVRYQ6WR6>
            ] (
              <When ?01M12YSSVB6WJE4CGTVRYQ6WR7>
              命令进入最终输出阶段
              </?01M12YSSVB6WJE4CGTVRYQ6WR7>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WR8>
              系统将最后一条最终 assistant 消息写入该文件
              </?01M12YSSVB6WJE4CGTVRYQ6WR8>
            )>
            <Case #failed-turn-does-not-clobber-an-existing-last-message-file { name = "Failed turn does not clobber an existing last-message file" } [
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WR9>
              调用方传入 `--output-last-message &amp;amp;amp;lt;file&amp;amp;amp;gt;`
              </?01M12YSSVB6WJE4CGTVRYQ6WR9>
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WRA>
              该文件已存在旧内容
              </?01M12YSSVB6WJE4CGTVRYQ6WRA>
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WRB>
              当前 turn 失败或未形成有效最终 assistant 消息
              </?01M12YSSVB6WJE4CGTVRYQ6WRB>
            ] (
              <When ?01M12YSSVB6WJE4CGTVRYQ6WRC>
              命令结束
              </?01M12YSSVB6WJE4CGTVRYQ6WRC>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WRD>
              系统不应以失败 turn 的空结果覆盖该文件
              </?01M12YSSVB6WJE4CGTVRYQ6WRD>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #headless-exec-output-is-short-and-deterministic (
      <Statement ?01M12YSSVB6WJE4CGTVRYQ6WRE>
      系统应当（SHALL）让 `exec` 命令的用户可见输出保持简短、稳定且面向最终结果，而不是输出 TUI 专属界面状态或手工 patch 文本。
      </?01M12YSSVB6WJE4CGTVRYQ6WRE>
      <Suites [
        <Suite { name = "headless-exec-output-is-short-and-deterministic" } (
          <Cases [
            <Case #exec-emits-concise-visible-output { name = "Exec emits concise visible output" } [
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WRF>
              系统输出用户可见的 assistant 结果与必要 warning/failure 摘要
              </?01M12YSSVB6WJE4CGTVRYQ6WRF>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WRG>
              不打印手工 patch 文本
              </?01M12YSSVB6WJE4CGTVRYQ6WRG>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WRH>
              不要求调用方理解 TUI 卡片或 benchmark 专属状态结构
              </?01M12YSSVB6WJE4CGTVRYQ6WRH>
            ] (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WRJ>
              headless exec 正在运行
              </?01M12YSSVB6WJE4CGTVRYQ6WRJ>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WRK>
              调用方收集该命令的终端输出
              </?01M12YSSVB6WJE4CGTVRYQ6WRK>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #shared-runtime-for-tui-and-headless-commands (
      <Statement ?01M12YSSVB6WJE4CGTVRYQ6WRM>
      系统应当（SHALL）将 TUI、现有 headless `run` 命令与新的 `exec` 兼容命令共用同一套 runtime 初始化与 turn 执行基础能力，而不是让 `exec` 重新复制一条平行运行链。
      </?01M12YSSVB6WJE4CGTVRYQ6WRM>
      <Suites [
        <Suite { name = "shared-runtime-for-tui-and-headless-commands" } (
          <Cases [
            <Case #run-and-exec-reuse-the-same-runtime-foundation { name = "Run and exec reuse the same runtime foundation" } [
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WRN>
              它们复用同一套公共运行时逻辑
              </?01M12YSSVB6WJE4CGTVRYQ6WRN>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WRP>
              `exec` 只在协议投影、参数兼容和输出语义层面增加行为
              </?01M12YSSVB6WJE4CGTVRYQ6WRP>
            ] (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WRQ>
              `run` 与新的 `exec` 都需要创建 session runtime、执行单轮 turn 并消费流式结果
              </?01M12YSSVB6WJE4CGTVRYQ6WRQ>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WRR>
              两种无头入口初始化运行时
              </?01M12YSSVB6WJE4CGTVRYQ6WRR>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #project-root-resolution-for-headless-and-tui-entry (
      <Statement ?01M12YSSVB6WJE4CGTVRYQ6WRS>
      系统应当（SHALL）在未显式传入项目路径时，自动向上查找最近的 `.eidolon` 目录作为项目根。
      </?01M12YSSVB6WJE4CGTVRYQ6WRS>
      <Suites [
        <Suite { name = "project-root-resolution-for-headless-and-tui-entry" } (
          <Cases [
            <Case #resolve-project-root-from-nested-package-directory { name = "Resolve project root from nested package directory" } [
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WRT>
              系统向上查找最近的 `.eidolon` 所在目录
              </?01M12YSSVB6WJE4CGTVRYQ6WRT>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WRV>
              使用该目录作为 terminal runtime 的工作目录
              </?01M12YSSVB6WJE4CGTVRYQ6WRV>
            ] (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WRW>
              命令从 `terminal/packages/tui` 之类的嵌套目录启动
              </?01M12YSSVB6WJE4CGTVRYQ6WRW>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WRX>
              用户没有显式传入项目路径
              </?01M12YSSVB6WJE4CGTVRYQ6WRX>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #auto-resume-paused-progress (
      <Statement ?01M12YSSVB6WJE4CGTVRYQ6WRY>
      Headless exec SHALL provide an explicit bounded auto-resume mode for resumable `paused_with_progress` turns; internal continuations MUST NOT append new user input.
      </?01M12YSSVB6WJE4CGTVRYQ6WRY>
      <Suites [
        <Suite #auto-resume { name = "Headless auto-resume" } (
          <Cases [
            <Case #explicit-auto-resume-reaches-final [
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WRZ>
              the runtime SHALL be resumed without adding a new user message
              </?01M12YSSVB6WJE4CGTVRYQ6WRZ>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WS0>
              headless exec SHALL continue until final output, hard failure, no-progress pause, or the continuation limit
              </?01M12YSSVB6WJE4CGTVRYQ6WS0>
            ] (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WS1>
              a turn pauses with `runtime_turn_unsettled:*` after making progress
              </?01M12YSSVB6WJE4CGTVRYQ6WS1>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WS2>
              headless exec is run with auto-resume enabled
              </?01M12YSSVB6WJE4CGTVRYQ6WS2>
            )>
            <Case #default-paused-behavior-remains (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WS3>
              a turn pauses with `runtime_turn_unsettled:*` after making progress
              </?01M12YSSVB6WJE4CGTVRYQ6WS3>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WS4>
              headless exec is run without auto-resume
              </?01M12YSSVB6WJE4CGTVRYQ6WS4>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WS5>
              the result SHALL remain `paused_with_progress`
              </?01M12YSSVB6WJE4CGTVRYQ6WS5>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #provider-request-capture-option (
      <Statement ?01M12YSSVB6WJE4CGTVRYQ6WS6>
      `eidolon exec` SHALL 提供显式 provider request capture 选项，把当前 session 的完整请求现场写入独立 SQLite，而不改变 headless runtime 行为。
      </?01M12YSSVB6WJE4CGTVRYQ6WS6>
      <Suites [
        <Suite #capture-option { name = "Headless request capture option" } (
          <Cases [
            <Case #capture-disabled-by-default (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WS7>
              调用方未传 provider request capture 选项
              </?01M12YSSVB6WJE4CGTVRYQ6WS7>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WS8>
              系统执行 headless turn
              </?01M12YSSVB6WJE4CGTVRYQ6WS8>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WS9>
              系统 SHALL NOT 创建完整 provider request SQLite ledger
              </?01M12YSSVB6WJE4CGTVRYQ6WS9>
            )>
            <Case #capture-to-session-ledger [
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WSA>
              系统 SHALL 把账本写入该 session 的独立 observability SQLite 文件
              </?01M12YSSVB6WJE4CGTVRYQ6WSA>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WSB>
              terminal SHALL 只绑定 capability、session path 和 support port，SHALL NOT 读取或组装 provider messages
              </?01M12YSSVB6WJE4CGTVRYQ6WSB>
            ] (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WSC>
              调用方传入 `--capture-provider-requests` 和一个持久化 session
              </?01M12YSSVB6WJE4CGTVRYQ6WSC>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WSD>
              系统执行或恢复该 session
              </?01M12YSSVB6WJE4CGTVRYQ6WSD>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #paused-progress-exit (
      <Statement ?01M12YSSVB6WJE4CGTVRYQ6WSE>
      Headless exec SHALL distinguish a resumable `runtime_turn_unsettled:*` timeout from hard failures by returning `paused_with_progress`; it SHALL NOT write `--output-last-message` for paused results; trace `session_end` SHALL record `paused_with_progress`.
      </?01M12YSSVB6WJE4CGTVRYQ6WSE>
      <Suites [
        <Suite #headless-paused-progress { name = "Headless paused progress protocol" } (
          <Cases [
            <Case #runtime-unsettled-pauses [
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WSF>
              result status SHALL be `paused_with_progress`
              </?01M12YSSVB6WJE4CGTVRYQ6WSF>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WSG>
              trace session_end status SHALL be `paused_with_progress`
              </?01M12YSSVB6WJE4CGTVRYQ6WSG>
            ] (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WSH>
              runtime turn throws `runtime_turn_unsettled:mandatory_continuation`
              </?01M12YSSVB6WJE4CGTVRYQ6WSH>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WSJ>
              headless exec handles the turn result
              </?01M12YSSVB6WJE4CGTVRYQ6WSJ>
            )>
            <Case #paused-does-not-write-last-message (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WSK>
              an existing `--output-last-message` file exists
              </?01M12YSSVB6WJE4CGTVRYQ6WSK>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WSM>
              headless exec returns `paused_with_progress`
              </?01M12YSSVB6WJE4CGTVRYQ6WSM>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WSN>
              the file SHALL NOT be overwritten
              </?01M12YSSVB6WJE4CGTVRYQ6WSN>
            )>
            <Case #provider-failure-remains-failed (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WSP>
              provider initialization or stream fails
              </?01M12YSSVB6WJE4CGTVRYQ6WSP>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WSQ>
              headless exec handles the error
              </?01M12YSSVB6WJE4CGTVRYQ6WSQ>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WSR>
              result status SHALL remain `failed`
              </?01M12YSSVB6WJE4CGTVRYQ6WSR>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #reproducible-proposition-run-receipt (
      <Statement ?01M12YSSVB6WJE4CGTVRYQ6WSS>
      Headless Eidolon SHALL expose a bounded proposition-run harness that executes an immutable request in a fresh workspace and emits a redacted machine-readable receipt without replacing the runtime or verifier authorities.
      </?01M12YSSVB6WJE4CGTVRYQ6WSS>
      <Suites [
        <Suite #proposition-runner { name = "Reproducible proposition runner" } (
          <Cases [
            <Case #fresh-workspace-and-original-verifier (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WST>
              a content-addressed proposition manifest names a request composition and independent verifier
              </?01M12YSSVB6WJE4CGTVRYQ6WST>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WSV>
              the harness executes one mode cell
              </?01M12YSSVB6WJE4CGTVRYQ6WSV>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WSW>
              it SHALL create a fresh isolated Git workspace, preserve the exact request bytes, invoke the original verifier after the session and retain bounded raw logs plus a structured receipt
              </?01M12YSSVB6WJE4CGTVRYQ6WSW>
            )>
            <Case #provenance-and-redaction (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WSX>
              a proposition run uses installed Eidolon, Codument and a configured provider
              </?01M12YSSVB6WJE4CGTVRYQ6WSX>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WSY>
              the receipt is finalized
              </?01M12YSSVB6WJE4CGTVRYQ6WSY>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WSZ>
              it SHALL bind executable/source/corpus/verifier digests, mode/session identity, completion and timing facts while excluding provider keys and raw credentials
              </?01M12YSSVB6WJE4CGTVRYQ6WSZ>
            )>
            <Case #timeout-and-resume-are-explicit (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WT0>
              a long-running session pauses, times out or is resumed
              </?01M12YSSVB6WJE4CGTVRYQ6WT0>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WT1>
              the harness reconciles process and session state
              </?01M12YSSVB6WJE4CGTVRYQ6WT1>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WT2>
              it SHALL preserve the workspace and durable session evidence, distinguish resumable progress from hard failure, and never claim verifier success from process exit alone
              </?01M12YSSVB6WJE4CGTVRYQ6WT2>
            )>
            <Case #environment-is-explicitly-projected (
              <Given ?01M12YSSVB6WJE4CGTVRYQ6WT3>
              a mode cell needs provider credentials and a bounded subprocess environment
              </?01M12YSSVB6WJE4CGTVRYQ6WT3>
              <When ?01M12YSSVB6WJE4CGTVRYQ6WT4>
              the execution effect is invoked
              </?01M12YSSVB6WJE4CGTVRYQ6WT4>
              <Then ?01M12YSSVB6WJE4CGTVRYQ6WT5>
              it SHALL receive an allowlisted environment projection and opaque configured-provider credential binding; undeclared ambient variables SHALL NOT be forwarded or serialized
              </?01M12YSSVB6WJE4CGTVRYQ6WT5>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
