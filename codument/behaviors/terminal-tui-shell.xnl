<Behavior #terminal-tui-shell apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #effective-model-priority (
      <Statement ?01M05F1P3Q7EGWBJS6CX3J9EQ2>
      系统 SHALL 在 terminal TUI 中以 source-aware 方式解析并展示当前有效模型，避免人工选择、启动参数、agent 默认、runtime 历史和配置默认之间互相拍平覆盖。
      </?01M05F1P3Q7EGWBJS6CX3J9EQ2>
      <Suites [
        <Suite #priority-resolution { name = "有效模型优先级" } (
          <Cases [
            <Case #manual-dialog-selection-wins [
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQ3>
              系统 SHALL 保持人工选择作为当前有效模型
              </?01M05F1P3Q7EGWBJS6CX3J9EQ3>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQ4>
              系统 SHALL 在状态条展示该人工选择后的 provider/model
              </?01M05F1P3Q7EGWBJS6CX3J9EQ4>
            ] (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9EQ5>
              用户在 TUI 模型 dialog 中人工选择 provider/model
              </?01M05F1P3Q7EGWBJS6CX3J9EQ5>
              <When ?01M05F1P3Q7EGWBJS6CX3J9EQ6>
              agent 默认模型同步、runtime 历史投影或 recent model 随后产生不同模型候选
              </?01M05F1P3Q7EGWBJS6CX3J9EQ6>
            )>
            <Case #cli-model-wins-over-config [
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQ7>
              系统 SHALL 使用启动参数模型作为有效模型
              </?01M05F1P3Q7EGWBJS6CX3J9EQ7>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQ8>
              该模型 SHALL 低于后续人工 dialog 选择的优先级
              </?01M05F1P3Q7EGWBJS6CX3J9EQ8>
            ] (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9EQ9>
              启动参数指定了 provider/model，且配置默认或 recent model 指向另一个模型
              </?01M05F1P3Q7EGWBJS6CX3J9EQ9>
              <When ?01M05F1P3Q7EGWBJS6CX3J9EQA>
              TUI 初始化当前会话选择状态
              </?01M05F1P3Q7EGWBJS6CX3J9EQA>
            )>
            <Case #agent-memory-wins-over-agent-default [
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQB>
              系统 SHALL 优先使用 agent 用户记忆中的模型覆盖值
              </?01M05F1P3Q7EGWBJS6CX3J9EQB>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQC>
              agent definition 默认模型 SHALL 只在缺少更高优先级来源时生效
              </?01M05F1P3Q7EGWBJS6CX3J9EQC>
            ] (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9EQD>
              当前 agent 具有用户记忆中的 provider/model 覆盖值，且 agent definition 也声明默认模型
              </?01M05F1P3Q7EGWBJS6CX3J9EQD>
              <When ?01M05F1P3Q7EGWBJS6CX3J9EQE>
              系统解析当前有效模型
              </?01M05F1P3Q7EGWBJS6CX3J9EQE>
            )>
            <Case #priority-order-is-stable (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9EQF>
              多个模型来源同时存在
              </?01M05F1P3Q7EGWBJS6CX3J9EQF>
              <When ?01M05F1P3Q7EGWBJS6CX3J9EQG>
              系统解析当前有效模型
              </?01M05F1P3Q7EGWBJS6CX3J9EQG>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQH>
              系统 SHALL 按 user-explicit、cli-arg、agent-memory、agent-default、runtime-config、recent、provider-default 的顺序选择第一个有效模型
              </?01M05F1P3Q7EGWBJS6CX3J9EQH>
            )>
          ]>
        )>
        <Suite #projection-and-display { name = "投影与展示" } (
          <Cases [
            <Case #runtime-history-does-not-overwrite-explicit-source [
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQJ>
              系统 SHALL 只记录或使用 runtime 历史作为低优先级候选
              </?01M05F1P3Q7EGWBJS6CX3J9EQJ>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQK>
              系统 SHALL NOT 用 runtime 历史覆盖更高优先级的有效模型
              </?01M05F1P3Q7EGWBJS6CX3J9EQK>
            ] (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9EQM>
              runtime 历史消息中包含 provider/model 信息
              </?01M05F1P3Q7EGWBJS6CX3J9EQM>
              <When ?01M05F1P3Q7EGWBJS6CX3J9EQN>
              当前 selection 已有更高优先级来源
              </?01M05F1P3Q7EGWBJS6CX3J9EQN>
            )>
            <Case #status-line-shows-effective-model [
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQP>
              系统 SHALL 展示 effective model resolver 的输出
              </?01M05F1P3Q7EGWBJS6CX3J9EQP>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQQ>
              系统 SHALL NOT 直接展示未解析的拍平 selection 值
              </?01M05F1P3Q7EGWBJS6CX3J9EQQ>
            ] (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9EQR>
              当前 TUI 有多个模型候选来源
              </?01M05F1P3Q7EGWBJS6CX3J9EQR>
              <When ?01M05F1P3Q7EGWBJS6CX3J9EQS>
              composer/input 底部状态条渲染 provider/model
              </?01M05F1P3Q7EGWBJS6CX3J9EQS>
            )>
            <Case #agent-switch-recomputes-without-model-only-overwrite-loop [
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQT>
              系统 SHALL 响应 agent identity 变化重新解析候选模型
              </?01M05F1P3Q7EGWBJS6CX3J9EQT>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQV>
              系统 SHALL NOT 因 provider/model-only 变化误触发 agent 默认模型覆盖人工选择
              </?01M05F1P3Q7EGWBJS6CX3J9EQV>
            ] (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9EQW>
              用户切换当前 agent
              </?01M05F1P3Q7EGWBJS6CX3J9EQW>
              <When ?01M05F1P3Q7EGWBJS6CX3J9EQX>
              系统根据新 agent 重新计算有效模型
              </?01M05F1P3Q7EGWBJS6CX3J9EQX>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #composer-attachment-blocks (
      <Statement ?01M05F1P3Q7EGWBJS6CX3J9EQY>
      Terminal TUI Composer SHALL 以显式用户选择区分路径文本、文件引用与附件；当 bracketed-paste 完整解析为一个或多个存在的文件路径时，Composer SHALL 弹出“附件 / 引用 / 路径文本”三选一，且在用户选择前 MUST NOT 创建 structured part 或读取文件内容。普通非路径文本直接插入；带二进制图片 MIME 的剪贴板输入直接创建图片附件。
      </?01M05F1P3Q7EGWBJS6CX3J9EQY>
      <Suites [
        <Suite #attachment-ingress { name = "附件输入" } (
          <Cases [
            <Case #path-candidate-requires-explicit-choice [
              <Then ?01M05F1P3Q7EGWBJS6CX3J9EQZ>
              Composer SHALL 弹出简短的“附件 / 引用 / 路径文本”选择器，并将一次选择应用到本次路径集合
              </?01M05F1P3Q7EGWBJS6CX3J9EQZ>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ER0>
              选择完成前 MUST NOT 读取文件内容或创建 canonical part
              </?01M05F1P3Q7EGWBJS6CX3J9ER0>
            ] (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9ER1>
              bracketed-paste payload 完整解析为一个或多个存在的 Windows drive/UNC、POSIX 或 file URI 文件路径
              </?01M05F1P3Q7EGWBJS6CX3J9ER1>
              <When ?01M05F1P3Q7EGWBJS6CX3J9ER2>
              Composer 接收该路径集合
              </?01M05F1P3Q7EGWBJS6CX3J9ER2>
            )>
            <Case #attachment-choice-imports-value [
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ER3>
              每个文件 SHALL 按值导入 session asset store 并建立附件块；图片 SHALL 依文件头识别为 image attachment
              </?01M05F1P3Q7EGWBJS6CX3J9ER3>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ER4>
              源文件之后移动、删除或变化 MUST NOT 影响已导入附件的恢复
              </?01M05F1P3Q7EGWBJS6CX3J9ER4>
            ] (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9ER5>
              路径候选选择器正在显示且用户选择“附件”
              </?01M05F1P3Q7EGWBJS6CX3J9ER5>
              <When ?01M05F1P3Q7EGWBJS6CX3J9ER6>
              Composer 应用选择
              </?01M05F1P3Q7EGWBJS6CX3J9ER6>
            )>
            <Case #reference-choice-keeps-local-reference (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9ER7>
              路径候选选择器正在显示且用户选择“引用”
              </?01M05F1P3Q7EGWBJS6CX3J9ER7>
              <When ?01M05F1P3Q7EGWBJS6CX3J9ER8>
              Composer 应用选择
              </?01M05F1P3Q7EGWBJS6CX3J9ER8>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ER9>
              每个文件 SHALL 建立 file-reference part，发送时从原路径解析，因此源文件变化或移动 SHALL 影响后续读取
              </?01M05F1P3Q7EGWBJS6CX3J9ER9>
            )>
            <Case #path-text-choice-preserves-text (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9ERA>
              路径候选选择器正在显示且用户选择“路径文本”
              </?01M05F1P3Q7EGWBJS6CX3J9ERA>
              <When ?01M05F1P3Q7EGWBJS6CX3J9ERB>
              Composer 应用选择
              </?01M05F1P3Q7EGWBJS6CX3J9ERB>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ERC>
              原始 paste payload SHALL 作为普通文本插入且 MUST NOT 读取文件内容或创建 structured part
              </?01M05F1P3Q7EGWBJS6CX3J9ERC>
            )>
            <Case #ordinary-non-path-paste-remains-text (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9ERD>
              文本 paste payload 不能完整解析为存在的文件路径集合
              </?01M05F1P3Q7EGWBJS6CX3J9ERD>
              <When ?01M05F1P3Q7EGWBJS6CX3J9ERE>
              Composer 处理 paste
              </?01M05F1P3Q7EGWBJS6CX3J9ERE>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ERF>
              payload SHALL 按普通文本原样插入且不弹出文件意图选择器
              </?01M05F1P3Q7EGWBJS6CX3J9ERF>
            )>
            <Case #explicit-file-reference-becomes-part (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9ERG>
              用户通过 Ctrl+O 或 `@fs:` 显式选择一个或多个文件引用
              </?01M05F1P3Q7EGWBJS6CX3J9ERG>
              <When ?01M05F1P3Q7EGWBJS6CX3J9ERH>
              Composer 接收该显式引用入口
              </?01M05F1P3Q7EGWBJS6CX3J9ERH>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ERJ>
              每个有效文件 SHALL 直接成为独立 file-reference part 和可见引用块，无需再次弹出意图选择器
              </?01M05F1P3Q7EGWBJS6CX3J9ERJ>
            )>
            <Case #clipboard-image-becomes-image-attachment (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9ERK>
              剪贴板输入显式携带受支持的 image MIME 与二进制内容
              </?01M05F1P3Q7EGWBJS6CX3J9ERK>
              <When ?01M05F1P3Q7EGWBJS6CX3J9ERM>
              Composer 处理 paste 命令
              </?01M05F1P3Q7EGWBJS6CX3J9ERM>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ERN>
              图片 SHALL 成为 image attachment part，而不是路径文本或 file reference
              </?01M05F1P3Q7EGWBJS6CX3J9ERN>
            )>
            <Case #all-entry-points-share-part-shape (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9ERP>
              同一附件分别由文件选择、显式引用或剪贴板图片加入
              </?01M05F1P3Q7EGWBJS6CX3J9ERP>
              <When ?01M05F1P3Q7EGWBJS6CX3J9ERQ>
              Composer 建立附件
              </?01M05F1P3Q7EGWBJS6CX3J9ERQ>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ERR>
              附件 SHALL 使用相同的 file part identity、MIME、source range 与 extmark lifecycle
              </?01M05F1P3Q7EGWBJS6CX3J9ERR>
            )>
          ]>
        )>
        <Suite #atomic-editing { name = "附件块编辑与计数" } (
          <Cases [
            <Case #backspace-deletes-whole-block [
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ERS>
              Composer SHALL 一次删除完整虚拟范围、extmark 与对应 structured part
              </?01M05F1P3Q7EGWBJS6CX3J9ERS>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ERT>
              相邻普通文本和其他附件 SHALL 保持不变
              </?01M05F1P3Q7EGWBJS6CX3J9ERT>
            ] (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9ERV>
              光标位于附件虚拟块之后
              </?01M05F1P3Q7EGWBJS6CX3J9ERV>
              <When ?01M05F1P3Q7EGWBJS6CX3J9ERW>
              用户按 Backspace
              </?01M05F1P3Q7EGWBJS6CX3J9ERW>
            )>
            <Case #delete-deletes-whole-block (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9ERX>
              光标位于附件虚拟块之前或 selection 覆盖附件块
              </?01M05F1P3Q7EGWBJS6CX3J9ERX>
              <When ?01M05F1P3Q7EGWBJS6CX3J9ERY>
              用户按 Delete 或删除 selection
              </?01M05F1P3Q7EGWBJS6CX3J9ERY>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ERZ>
              Composer SHALL 一次删除整个附件块而不留下部分文件名或孤立 part
              </?01M05F1P3Q7EGWBJS6CX3J9ERZ>
            )>
            <Case #part-count-is-canonical [
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ES0>
              数量 SHALL 与 reconciliation 后的 canonical structured parts 数量一致
              </?01M05F1P3Q7EGWBJS6CX3J9ES0>
              <Then ?01M05F1P3Q7EGWBJS6CX3J9ES1>
              同一 UI transaction 完成后 SHALL 不显示旧计数
              </?01M05F1P3Q7EGWBJS6CX3J9ES1>
            ] (
              <Given ?01M05F1P3Q7EGWBJS6CX3J9ES2>
              附件被批量插入、原子删除、历史恢复或草稿清空
              </?01M05F1P3Q7EGWBJS6CX3J9ES2>
              <When ?01M05F1P3Q7EGWBJS6CX3J9ES3>
              Composer 右下角渲染 parts 数量
              </?01M05F1P3Q7EGWBJS6CX3J9ES3>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
