<Behavior #vendor-actor-runtime-foundations apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #vendor-actor-shall-provide-completion-signal-and-waiter-foundations (
      <Statement ?01M05F1P3ZPN9HRWGBV7M2ESXN>
      系统应当在 `vendor/depa-actor` 中提供 keyed completion signal 与 waiter foundation，用于表达 fiber 完成等待、异步完成绑定和结果回流，而不要求业务层反复手写等待表与轮询逻辑。
      </?01M05F1P3ZPN9HRWGBV7M2ESXN>
      <Suites [
        <Suite { name = "vendor-actor-shall-provide-completion-signal-and-waiter-foundations" } (
          <Cases [
            <Case #parent-flow-waits-for-keyed-completion { name = "Parent flow waits for keyed completion" } [
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESXP>
              应当能够通过 vendor 提供的 completion signal / waiter foundation 完成等待与唤醒
              </?01M05F1P3ZPN9HRWGBV7M2ESXP>
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESXQ>
              不需要在业务层长期维护平行的 waiter store 机制
              </?01M05F1P3ZPN9HRWGBV7M2ESXQ>
            ] (
              <Given ?01M05F1P3ZPN9HRWGBV7M2ESXR>
              某个 runtime 需要等待一个 child workload 或异步步骤以 key 形式回传完成结果
              </?01M05F1P3ZPN9HRWGBV7M2ESXR>
              <When ?01M05F1P3ZPN9HRWGBV7M2ESXS>
              该 runtime 使用 `vendor/depa-actor` 的 orchestration foundation
              </?01M05F1P3ZPN9HRWGBV7M2ESXS>
            )>
            <Case #child-completion-binding-routes-detached-or-nested-results { name = "Child completion binding routes detached or nested results" } [
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESXT>
              vendor 应提供 child completion binding 或等价 foundation 表达该关系
              </?01M05F1P3ZPN9HRWGBV7M2ESXT>
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESXV>
              业务层不应继续手工维护一套平行的 completion routing helper
              </?01M05F1P3ZPN9HRWGBV7M2ESXV>
            ] (
              <Given ?01M05F1P3ZPN9HRWGBV7M2ESXW>
              某个 runtime 需要把 child actor / fiber 的完成事件路由回 parent 或 detached watcher
              </?01M05F1P3ZPN9HRWGBV7M2ESXW>
              <When ?01M05F1P3ZPN9HRWGBV7M2ESXX>
              该 runtime 依赖 `vendor/depa-actor`
              </?01M05F1P3ZPN9HRWGBV7M2ESXX>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #vendor-actor-shall-separate-persistence-protocol-from-persistence-implementation (
      <Statement ?01M05F1P3ZPN9HRWGBV7M2ESXY>
      系统应当在 `vendor/depa-actor` 中将 actor / fiber / orchestrator 的持久化与恢复能力表达为 protocol、codec hook 和 effect port，而不是内置具体的 save/load 实现。
      </?01M05F1P3ZPN9HRWGBV7M2ESXY>
      <Suites [
        <Suite { name = "vendor-actor-shall-separate-persistence-protocol-from-persistence-implementation" } (
          <Cases [
            <Case #runtime-wants-actor-persistence-without-fixed-storage-medium { name = "Runtime wants actor persistence without fixed storage medium" } [
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESXZ>
              vendor 应只要求上层注入 state codec、hydrate / recover hook 与 persistence effect adapter
              </?01M05F1P3ZPN9HRWGBV7M2ESXZ>
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESY0>
              vendor 不应假定文件系统、数据库或其他具体存储介质
              </?01M05F1P3ZPN9HRWGBV7M2ESY0>
            ] (
              <Given ?01M05F1P3ZPN9HRWGBV7M2ESY1>
              上层 runtime 需要对 actor 状态进行保存与恢复
              </?01M05F1P3ZPN9HRWGBV7M2ESY1>
              <When ?01M05F1P3ZPN9HRWGBV7M2ESY2>
              该 runtime 依赖 `vendor/depa-actor`
              </?01M05F1P3ZPN9HRWGBV7M2ESY2>
            )>
            <Case #snapshot-contract-does-not-embed-product-specific-fields { name = "Snapshot contract does not embed product-specific fields" } [
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESY3>
              vendor snapshot contract 应只表达通用 actor / fiber / orchestrator 基础结构
              </?01M05F1P3ZPN9HRWGBV7M2ESY3>
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESY4>
              产品字段应通过外层 codec / facet hook 注入，而不是写死在 vendor snapshot schema 中
              </?01M05F1P3ZPN9HRWGBV7M2ESY4>
            ] (
              <Given ?01M05F1P3ZPN9HRWGBV7M2ESY5>
              某个产品 runtime 为 actor 挂载了 domain-specific state
              </?01M05F1P3ZPN9HRWGBV7M2ESY5>
              <When ?01M05F1P3ZPN9HRWGBV7M2ESY6>
              它基于 vendor snapshot protocol 构建保存与恢复
              </?01M05F1P3ZPN9HRWGBV7M2ESY6>
            )>
            <Case #vendor-snapshot-base-contract-is-the-structural-source-of-truth { name = "Vendor snapshot base contract is the structural source of truth" } [
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESY7>
              其通用基础结构应建立在 `vendor/depa-actor` 导出的 snapshot base contract 之上
              </?01M05F1P3ZPN9HRWGBV7M2ESY7>
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESY8>
              项目侧不应继续独立维护一套与 vendor 平行的基础 snapshot 结构定义
              </?01M05F1P3ZPN9HRWGBV7M2ESY8>
            ] (
              <Given ?01M05F1P3ZPN9HRWGBV7M2ESY9>
              项目侧 runtime 需要定义 actor、vm、fiber 或 manifest 的 snapshot shape
              </?01M05F1P3ZPN9HRWGBV7M2ESY9>
              <When ?01M05F1P3ZPN9HRWGBV7M2ESYA>
              它声明这些 snapshot 类型
              </?01M05F1P3ZPN9HRWGBV7M2ESYA>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #vendor-actor-shall-expose-actor-runtime-extension-points-for-product-facets (
      <Statement ?01M05F1P3ZPN9HRWGBV7M2ESYB>
      系统应当在 `vendor/depa-actor` 中提供正式的 runtime / plugin / facet extension point，使上层能够为 actor / vm 挂载额外状态与索引，而不必把全部产品态字段内嵌进 vendor actor shell。
      </?01M05F1P3ZPN9HRWGBV7M2ESYB>
      <Suites [
        <Suite { name = "vendor-actor-shall-expose-actor-runtime-extension-points-for-product-facets" } (
          <Cases [
            <Case #product-runtime-adds-domain-specific-actor-state { name = "Product runtime adds domain-specific actor state" } [
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESYC>
              它应当能够通过 facet、plugin 或等价扩展点挂载这些状态
              </?01M05F1P3ZPN9HRWGBV7M2ESYC>
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESYD>
              不应要求 `vendor/depa-actor` 直接认识这些产品字段
              </?01M05F1P3ZPN9HRWGBV7M2ESYD>
            ] (
              <Given ?01M05F1P3ZPN9HRWGBV7M2ESYE>
              某个产品 runtime 需要为 actor 挂载额外 domain-specific state
              </?01M05F1P3ZPN9HRWGBV7M2ESYE>
              <When ?01M05F1P3ZPN9HRWGBV7M2ESYF>
              该产品 runtime 构建在 `vendor/depa-actor` 之上
              </?01M05F1P3ZPN9HRWGBV7M2ESYF>
            )>
            <Case #product-runtime-installs-indexes-without-forking-vendor-actor-shell { name = "Product runtime installs indexes without forking vendor actor shell" } [
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESYG>
              它应当能够通过正式扩展点安装这些索引
              </?01M05F1P3ZPN9HRWGBV7M2ESYG>
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESYH>
              不应继续通过复制 vendor actor shell 的方式承载这些索引
              </?01M05F1P3ZPN9HRWGBV7M2ESYH>
            ] (
              <Given ?01M05F1P3ZPN9HRWGBV7M2ESYJ>
              某个产品 runtime 需要维护 actor / fiber 的额外索引或派生视图
              </?01M05F1P3ZPN9HRWGBV7M2ESYJ>
              <When ?01M05F1P3ZPN9HRWGBV7M2ESYK>
              该 runtime 使用 `vendor/depa-actor`
              </?01M05F1P3ZPN9HRWGBV7M2ESYK>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #ai-specific-organization-and-coordination-semantics-shall-remain-outside-vendor-actor-core (
      <Statement ?01M05F1P3ZPN9HRWGBV7M2ESYM>
      系统应当明确 holon 治理语义、TaskTree、plan approval、shutdown coordination、questionnaire wait policy 等 AI-specific 业务逻辑不直接沉淀到 `vendor/depa-actor`。
      </?01M05F1P3ZPN9HRWGBV7M2ESYM>
      <Suites [
        <Suite { name = "ai-specific-organization-and-coordination-semantics-shall-remain-outside-vendor-actor-core" } (
          <Cases [
            <Case #ai-specific-actor-behavior-is-reviewed-for-vendorization { name = "AI-specific actor behavior is reviewed for vendorization" } [
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESYN>
              该能力应优先保留在 `symbiont-*` 或更高层
              </?01M05F1P3ZPN9HRWGBV7M2ESYN>
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESYP>
              vendor 只沉淀其底层可复用机制
              </?01M05F1P3ZPN9HRWGBV7M2ESYP>
            ] (
              <Given ?01M05F1P3ZPN9HRWGBV7M2ESYQ>
              某项 actor behavior 依赖 autonomous / leader_led holon、questionnaire、TaskTree 或 coordination 业务语义
              </?01M05F1P3ZPN9HRWGBV7M2ESYQ>
              <When ?01M05F1P3ZPN9HRWGBV7M2ESYR>
              评估该能力是否进入 `vendor/depa-actor`
              </?01M05F1P3ZPN9HRWGBV7M2ESYR>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #first-iteration-shall-be-verified-through-real-adoption-targets (
      <Statement ?01M05F1P3ZPN9HRWGBV7M2ESYS>
      系统应当在本 capability 第一轮中使用真实仓库调用方验证新的 vendor foundation，而不是只在 vendor 内部抽象层停留。
      </?01M05F1P3ZPN9HRWGBV7M2ESYS>
      <Suites [
        <Suite { name = "first-iteration-shall-be-verified-through-real-adoption-targets" } (
          <Cases [
            <Case #orchestrator-driver-adopts-vendor-waiter-foundation { name = "Orchestrator driver adopts vendor waiter foundation" } [
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESYT>
              它应开始建立在 `vendor/depa-actor` 的 completion signal / waiter foundation 之上
              </?01M05F1P3ZPN9HRWGBV7M2ESYT>
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESYV>
              原项目内通用 waiter helper 不应继续作为正式来源
              </?01M05F1P3ZPN9HRWGBV7M2ESYV>
            ] (
              <Given ?01M05F1P3ZPN9HRWGBV7M2ESYW>
              `OrchestratorDriver` 当前仍持有项目内等待、完成绑定与 settle helper
              </?01M05F1P3ZPN9HRWGBV7M2ESYW>
              <When ?01M05F1P3ZPN9HRWGBV7M2ESYX>
              第一轮实现完成
              </?01M05F1P3ZPN9HRWGBV7M2ESYX>
            )>
            <Case #runtime-snapshot-adopts-vendor-persistence-protocol { name = "Runtime snapshot adopts vendor persistence protocol" } [
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESYY>
              actor / fiber / orchestrator 的通用 persistence protocol 应收口到 vendor
              </?01M05F1P3ZPN9HRWGBV7M2ESYY>
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESYZ>
              项目侧只保留 AI-specific product-state codec 与 effect adapter
              </?01M05F1P3ZPN9HRWGBV7M2ESYZ>
            ] (
              <Given ?01M05F1P3ZPN9HRWGBV7M2ESZ0>
              runtime snapshot / recovery 当前仍主要由项目侧 schema 与 helper 驱动
              </?01M05F1P3ZPN9HRWGBV7M2ESZ0>
              <When ?01M05F1P3ZPN9HRWGBV7M2ESZ1>
              第一轮实现完成
              </?01M05F1P3ZPN9HRWGBV7M2ESZ1>
            )>
            <Case #runtime-state-mounting-adopts-vendor-facet-foundation { name = "Runtime state mounting adopts vendor facet foundation" } [
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESZ2>
              至少应有一类产品态挂载改为建立在 vendor facet / plugin foundation 之上
              </?01M05F1P3ZPN9HRWGBV7M2ESZ2>
              <Then ?01M05F1P3ZPN9HRWGBV7M2ESZ3>
              迁移结果应通过 focused tests 或现有回归测试证明无行为回归
              </?01M05F1P3ZPN9HRWGBV7M2ESZ3>
            ] (
              <Given ?01M05F1P3ZPN9HRWGBV7M2ESZ4>
              `AiAgentActor` 或 `AiAgentVm` 当前直接内嵌大量产品态字段
              </?01M05F1P3ZPN9HRWGBV7M2ESZ4>
              <When ?01M05F1P3ZPN9HRWGBV7M2ESZ5>
              第一轮实现完成
              </?01M05F1P3ZPN9HRWGBV7M2ESZ5>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
