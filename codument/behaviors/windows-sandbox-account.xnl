<Behavior #windows-sandbox-account apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #isolated-account (
      <Statement ?01M05F1P4CRYK1D45JJ3C7X306>
      Windows 沙箱 SHALL 由独立受限本地账号（eidolon-sandbox，USER_PRIV_USER）提供进程级隔离：setup（elevated）SHALL 用 NetUserAdd 创建账号、DPAPI 加密存储密码并写 setup marker；runner SHALL 以 LogonUserW 获取账号 token 并用 CreateProcessAsUserW 启动命令；workspace SHALL 对该账号 SID 授权写（保留继承）；network_access=disabled 时 SHALL 由 WFP 过滤拦截该账号出站连接。SandboxBackendRuntime SHALL 在 setup 完成且 runner 存在时默认 elevated（账号沙箱），否则降级 disabled。Cygwin/MSYS 工具与 Bun SHALL 在账号下正常运行（账号是全新普通用户，非特权令牌降级）。
      </?01M05F1P4CRYK1D45JJ3C7X306>
      <Suites [
        <Suite #isolated-account { name = "Isolated account sandbox" } (
          <Cases [
            <Case #account-created [
              <Then ?01M05F1P4CRYK1D45JJ3C7X307>
              SHALL 用 NetUserAdd 创建 eidolon-sandbox（USER_PRIV_USER）
              </?01M05F1P4CRYK1D45JJ3C7X307>
              <Then ?01M05F1P4CRYK1D45JJ3C7X308>
              SHALL DPAPI 加密存储密码并写 setup marker
              </?01M05F1P4CRYK1D45JJ3C7X308>
            ] (
              <Given ?01M05F1P4CRYK1D45JJ3C7X309>
              setup 以 elevated 运行
              </?01M05F1P4CRYK1D45JJ3C7X309>
              <When ?01M05F1P4CRYK1D45JJ3C7X30A>
              创建沙箱账号
              </?01M05F1P4CRYK1D45JJ3C7X30A>
            )>
            <Case #command-runs-under-account [
              <Then ?01M05F1P4CRYK1D45JJ3C7X30B>
              SHALL 用 LogonUserW + CreateProcessAsUserW 以账号 token 启动
              </?01M05F1P4CRYK1D45JJ3C7X30B>
              <Then ?01M05F1P4CRYK1D45JJ3C7X30C>
              SHALL Cygwin/MSYS 工具（find/ls/grep）与 Bun 正常运行
              </?01M05F1P4CRYK1D45JJ3C7X30C>
            ] (
              <Given ?01M05F1P4CRYK1D45JJ3C7X30D>
              runner 启动命令
              </?01M05F1P4CRYK1D45JJ3C7X30D>
              <When ?01M05F1P4CRYK1D45JJ3C7X30E>
              以沙箱账号执行
              </?01M05F1P4CRYK1D45JJ3C7X30E>
            )>
            <Case #account-cannot-write-outside (
              <Given ?01M05F1P4CRYK1D45JJ3C7X30F>
              受限进程（账号下）尝试写 workspace 外
              </?01M05F1P4CRYK1D45JJ3C7X30F>
              <When ?01M05F1P4CRYK1D45JJ3C7X30G>
              写入受限进程
              </?01M05F1P4CRYK1D45JJ3C7X30G>
              <Then ?01M05F1P4CRYK1D45JJ3C7X30H>
              SHALL 因账号无权限失败
              </?01M05F1P4CRYK1D45JJ3C7X30H>
            )>
            <Case #network-disabled-blocks-account (
              <Given ?01M05F1P4CRYK1D45JJ3C7X30J>
              network_access=disabled 且 setup 完成
              </?01M05F1P4CRYK1D45JJ3C7X30J>
              <When ?01M05F1P4CRYK1D45JJ3C7X30K>
              账号进程发起出站连接
              </?01M05F1P4CRYK1D45JJ3C7X30K>
              <Then ?01M05F1P4CRYK1D45JJ3C7X30M>
              SHALL 被 WFP 过滤拦截
              </?01M05F1P4CRYK1D45JJ3C7X30M>
            )>
            <Case #default-elevated-when-ready (
              <Given ?01M05F1P4CRYK1D45JJ3C7X30N>
              setup 完成且 runner 存在
              </?01M05F1P4CRYK1D45JJ3C7X30N>
              <When ?01M05F1P4CRYK1D45JJ3C7X30P>
              解析 Windows sandbox level
              </?01M05F1P4CRYK1D45JJ3C7X30P>
              <Then ?01M05F1P4CRYK1D45JJ3C7X30Q>
              SHALL 为 elevated（账号沙箱）
              </?01M05F1P4CRYK1D45JJ3C7X30Q>
            )>
            <Case #fallback-disabled-when-not-ready (
              <Given ?01M05F1P4CRYK1D45JJ3C7X30R>
              setup 未完成或 runner 缺失
              </?01M05F1P4CRYK1D45JJ3C7X30R>
              <When ?01M05F1P4CRYK1D45JJ3C7X30S>
              解析 Windows sandbox level
              </?01M05F1P4CRYK1D45JJ3C7X30S>
              <Then ?01M05F1P4CRYK1D45JJ3C7X30T>
              SHALL 为 disabled（直接执行 + 文件校验）
              </?01M05F1P4CRYK1D45JJ3C7X30T>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
