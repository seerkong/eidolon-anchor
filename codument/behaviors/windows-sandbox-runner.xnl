<Behavior #windows-sandbox-runner apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #restricted-token-isolation (
      <Statement ?01M05F1P4HGJFT741YQ8JR52G4>
      Windows 沙箱 SHALL 由原生 Zig runner（eidolon-windows-sandbox-runner.exe）实现：以 CreateRestrictedToken（DISABLE_MAX_PRIVILEGE|LUA_TOKEN|WRITE_RESTRICTED）+ capability SIDs 派生受限令牌，并用 CreateProcessAsUserW 以受限令牌启动命令；workspace root 的 ACL SHALL 只对 capability SID 授权写，.git/.eidolon 等受保护目录 SHALL 加 deny-write ACE；network_access=disabled 时 SHALL 由 elevated setup 安装的 WFP 过滤器拦截出站连接。SandboxBackendRuntime 的 restricted-token 分支 SHALL 真正 spawn runner（而非返回 not-implemented error）。
      </?01M05F1P4HGJFT741YQ8JR52G4>
      <Suites [
        <Suite #restricted-token-isolation { name = "Restricted-token isolation" } (
          <Cases [
            <Case #restricted-token-created [
              <Then ?01M05F1P4HGJFT741YQ8JR52G5>
              SHALL 用 CreateRestrictedToken + capability SIDs 创建受限令牌
              </?01M05F1P4HGJFT741YQ8JR52G5>
              <Then ?01M05F1P4HGJFT741YQ8JR52G6>
              SHALL 用 CreateProcessAsUserW 以受限令牌启动命令
              </?01M05F1P4HGJFT741YQ8JR52G6>
            ] (
              <Given ?01M05F1P4HGJFT741YQ8JR52G7>
              runner 以 workspace-write 模式启动
              </?01M05F1P4HGJFT741YQ8JR52G7>
              <When ?01M05F1P4HGJFT741YQ8JR52G8>
              构造受限令牌
              </?01M05F1P4HGJFT741YQ8JR52G8>
            )>
            <Case #write-outside-workspace-denied (
              <Given ?01M05F1P4HGJFT741YQ8JR52G9>
              受限进程尝试写 workspace 外路径
              </?01M05F1P4HGJFT741YQ8JR52G9>
              <When ?01M05F1P4HGJFT741YQ8JR52GA>
              写入受限进程
              </?01M05F1P4HGJFT741YQ8JR52GA>
              <Then ?01M05F1P4HGJFT741YQ8JR52GB>
              SHALL 因 ACL 失败（workspace 外无写权限）
              </?01M05F1P4HGJFT741YQ8JR52GB>
            )>
            <Case #protected-dir-deny-write (
              <Given ?01M05F1P4HGJFT741YQ8JR52GC>
              workspace 内含 .git/.eidolon
              </?01M05F1P4HGJFT741YQ8JR52GC>
              <When ?01M05F1P4HGJFT741YQ8JR52GD>
              受限进程尝试写这些目录
              </?01M05F1P4HGJFT741YQ8JR52GD>
              <Then ?01M05F1P4HGJFT741YQ8JR52GE>
              SHALL 被 deny-write ACE 拒绝
              </?01M05F1P4HGJFT741YQ8JR52GE>
            )>
            <Case #network-disabled-blocks (
              <Given ?01M05F1P4HGJFT741YQ8JR52GF>
              network_access=disabled 且 elevated setup 已完成
              </?01M05F1P4HGJFT741YQ8JR52GF>
              <When ?01M05F1P4HGJFT741YQ8JR52GG>
              受限进程发起出站连接
              </?01M05F1P4HGJFT741YQ8JR52GG>
              <Then ?01M05F1P4HGJFT741YQ8JR52GH>
              SHALL 被 WFP 过滤器拦截
              </?01M05F1P4HGJFT741YQ8JR52GH>
            )>
            <Case #restricted-token-branch-spawns-runner (
              <Given ?01M05F1P4HGJFT741YQ8JR52GJ>
              SandboxBackendRuntime 的 windowsSandboxLevel=restricted-token
              </?01M05F1P4HGJFT741YQ8JR52GJ>
              <When ?01M05F1P4HGJFT741YQ8JR52GK>
              bash 执行
              </?01M05F1P4HGJFT741YQ8JR52GK>
              <Then ?01M05F1P4HGJFT741YQ8JR52GM>
              SHALL spawn eidolon-windows-sandbox-runner（而非返回 not-implemented error）
              </?01M05F1P4HGJFT741YQ8JR52GM>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
