<Mission #upgrade-depa-data-graph-unified-api version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "将 host workspace 的 depa-data-graph 升级到上游 966f26bac5a8cfebb4b3f30e7ff24f7407aee12c 对应的 unified 1.0.1 API，并迁移 Cell 的 graph foundations、投影与 framework consumer。" description = "先建立版本与 API 基线，再分别迁移 Cell runtime/stream、observability、历史和 terminal 投影，最后验证所有受影响的 core 与 Solid consumer。" question_mode = "decision-tree" question_severity = "auto" revision = 11 created_at = "2026-07-26T14:25:16Z" updated_at = "2026-07-26T16:55:00Z" } (
