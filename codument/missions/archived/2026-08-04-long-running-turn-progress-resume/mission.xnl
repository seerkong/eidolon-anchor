        </?01M05F1P6B6PWJHK089A7NH42K>
        <SubNodes [
          <Task #G3-T1 { name = "Create and execute headless paused progress exit track" status = "DONE" order = 0 } (
            <TrackLink #headless-paused-progress-exit { state = "bound" project_ref = "host" }>
