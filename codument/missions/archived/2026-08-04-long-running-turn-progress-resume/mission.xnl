        ]>
      )>
      <TaskGroup #G7 { name = "TUI sealed-progress hydration incident" status = "DONE" order = 6 } (
        <Description ?01M05F1P6B6PWJHK089A7NH42Q>
        Determine why loading a historical session through the TUI selector shows only the last user input even though later closed conversation facts exist on disk.
        </?01M05F1P6B6PWJHK089A7NH42Q>
        <SubNodes [
          <Task #G7-T1 { name = "Compare durable conversation heads with restored TUI projection" status = "DONE" order = 0 }>
          <Task #G7-T2 { name = "Propose a bounded repair track and await user confirmation" status = "DONE" order = 1 }>
          <Task #G7-T3 { name = "Create, execute, and verify the canonical generation replay repair" status = "DONE" order = 2 } (
            <TrackLink #fix-conversation-generation-sequence-replay { state = "bound" project_ref = "host" }>
          )>
        ]>
      )>
    ]>
  )>
  <Schedule [
    <Dag { for = "space_long-running-turn-progress-resume" } [
      <Node #G2 [
        <After { ref = "G1" }>
      ]>
      <Node #G3 [
        <After { ref = "G2" }>
      ]>
      <Node #G4 [
        <After { ref = "G3" }>
