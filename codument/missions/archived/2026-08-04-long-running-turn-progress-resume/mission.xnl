<Mission #long-running-turn-progress-resume version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "Make long-running mandatory-continuation turns pause with sealed progress and resume safely, and optionally continue headless execution to final output without weakening checkpoint transactionality." description = "Separate full safepoint checkpoints from resumable completed-progress sealing, paused outcome semantics, bounded headless auto-resume, and correct TUI hydration of sealed progress." question_mode = "decision-tree" question_severity = "light" revision = 18 created_at = "2026-06-29T07:58:23Z" updated_at = "2026-08-02T04:47:00Z" } (
  <Ports { scope = "mission" } [
    <MaterialBundle { role = "state" name = "analysis" domain = "mission" path = "vfs://./analysis/" }>
    <MaterialBundle { role = "state" name = "reports" domain = "mission" path = "vfs://./reports/" }>
    <MaterialBundle { role = "output" name = "tracks" domain = "codument" path = "vfs://@/codument/tracks/" }>
  ]>
  <ProjectRefs [
    <ProjectRef #host { kind = "host" }>
  ]>
  <ActorSets { default = "runtime-resume-loop" } [
    <ActorSet #runtime-resume-loop [
      <Actor { role = "MissionPlanner" project_ref = "host" } (
        <Description ?01M05F1P6B6PWJHK089A7NH42C>
        Refine the long-running resume mission into evidence-backed persistence, recovery, and TUI hydration tracks.
        </?01M05F1P6B6PWJHK089A7NH42C>
      )>
      <Actor { role = "MissionObserver" project_ref = "host" } (
        <Description ?01M05F1P6B6PWJHK089A7NH42D>
        Compare durable conversation generations, runtime-control checkpoints, restored VM state, TUI history projection, and historical track evidence.
        </?01M05F1P6B6PWJHK089A7NH42D>
      )>
      <Actor { role = "MissionReconciler" project_ref = "host" } (
        <Description ?01M05F1P6B6PWJHK089A7NH42E>
        Classify whether missing post-input messages come from sealing, recovery head selection, projection hydration, or corruption handling before authorizing a repair track.
        </?01M05F1P6B6PWJHK089A7NH42E>
      )>
      <Actor { role = "MissionApplier" project_ref = "host" } (
        <Description ?01M05F1P6B6PWJHK089A7NH42F>
        Record incident evidence and, only after user confirmation, create and execute a bounded repair track without weakening safepoint transactionality.
        </?01M05F1P6B6PWJHK089A7NH42F>
      )>
    ]>
  ]>
  <TaskSpace #space_long-running-turn-progress-resume { name = "long-running-turn-progress-resume" child_mode = "dag" } (
    <Description ?01M05F1P6B6PWJHK089A7NH42G>
    Long-running turn pause/resume mission.
    </?01M05F1P6B6PWJHK089A7NH42G>
    <SubNodes [
      <TaskGroup #G1 { name = "Evidence inventory" status = "DONE" order = 0 } (
        <Description ?01M05F1P6B6PWJHK089A7NH42H>
        Pin current behavior, code seams, deferred mechanisms, and historical CLI evidence.
        </?01M05F1P6B6PWJHK089A7NH42H>
        <SubNodes [
          <Task #G1-T1 { name = "Inventory checkpoint, seal, recovery, and CLI timeout evidence" status = "DONE" order = 0 }>
          <Task #G1-T2 { name = "Write implementation slicing report" status = "DONE" order = 1 }>
        ]>
      )>
      <TaskGroup #G2 { name = "Runtime progress seal and recovery" status = "DONE" order = 1 } (
        <Description ?01M05F1P6B6PWJHK089A7NH42J>
        Implement production-safe completed-progress seal and recovery relay without unsafe snapshots.
        </?01M05F1P6B6PWJHK089A7NH42J>
        <SubNodes [
          <Task #G2-T1 { name = "Create and execute runtime progress seal recovery track" status = "DONE" order = 0 } (
            <TrackLink #runtime-progress-seal-recovery { state = "bound" project_ref = "host" }>
          )>
          <Task #G2-T2 { name = "Verify recovery resumes from sealed progress" status = "DONE" order = 1 }>
        ]>
      )>
      <TaskGroup #G3 { name = "Headless paused progress protocol" status = "DONE" order = 2 } (
        <Description ?01M05F1P6B6PWJHK089A7NH42K>
