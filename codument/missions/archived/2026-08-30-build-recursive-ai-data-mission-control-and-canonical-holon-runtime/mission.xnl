<Mission #build-recursive-ai-data-mission-control-and-canonical-holon-runtime apiVersion="codument.tech/v1alpha1" version="1" { status = "archived" goal = "以递归 AIDataWorkflow/SubFlow、Halfcode AIAgentDefinition 自主 authoring/selection 和 canonical TaskSpace Holon actor pump，建立可恢复、可审计且无旧 VM 双 authority 的 Mission execution runtime。" description = "取消 GoalGraph 方向，让唯一 Data RunGraph 自描述主子目标与 child workflow；恢复 AI 自主创建和选择 Halfcode AgentDefinition；把旧 VM AutonomousHolonTaskRunner 的有效自治行为迁入 TaskSpace/HolonCoordinator/MemberRuntime actor，并在 Ctrl/Data 多任务、失败恢复、组织 replan E2E 后删除旧路径。" question_mode = "decision-tree" question_severity = "auto" revision = 45 created_at = "2026-08-30T05:32:11.653Z" updated_at = "2026-08-30T19:12:56.197Z" } (
