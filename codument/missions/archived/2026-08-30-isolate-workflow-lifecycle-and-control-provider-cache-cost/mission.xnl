<Mission #isolate-workflow-lifecycle-and-control-provider-cache-cost apiVersion="codument.tech/v1alpha1" version="1" { status = "archived" goal = "Isolate Workflow lifecycle semantics from ordinary and node Agent runtimes, then make DeepSeek cache coverage and normalized provider-token cost enforceable product properties for both ordinary and Workflow actors." description = "Coordinate measurement, Actor/capability boundary correction, cache-stable context projection, provider-surface optimization, product E2E and repeated fresh reconciliation through a dependency-ordered Mission rather than one oversized Track." question_mode = "decision-tree" question_severity = "auto" revision = 36 created_at = "2026-08-25T04:06:41.279Z" updated_at = "2026-08-30T05:37:44.413Z" } (
