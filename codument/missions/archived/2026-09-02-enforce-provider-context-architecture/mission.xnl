<Mission #enforce-provider-context-architecture apiVersion="codument.tech/v1alpha1" version="1" { status = "archived" goal = "Make provider context construction structurally safe: canonical Conversation remains authoritative, Chat and Responses projections are isolated, replay is complete, checkpoint is optional, rewind cannot reuse stale optimization state, and ToolDefs receive provider-bound compatibility coverage before request effects." description = "Coordinate evidence, canonical Responses replay repair, typed provider projection boundaries, coverage proof/send gates, rewind context epochs, checkpoint equivalence, historical verification, and provider-specific tool-schema request admission through real Tracks." question_mode = "decision-tree" question_severity = "auto" revision = 40 created_at = "2026-08-19T18:48:54.465Z" updated_at = "2026-09-02T13:52:05.534Z" } (
