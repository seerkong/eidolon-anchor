<Mission #establish-overlay-materialized-eidolon-vfs-and-halfcode-runtime apiVersion="codument.tech/v1alpha1" version="1" { status = "archived" goal = "Establish one overlay-materialized, revisioned Effective Eidolon VFS as the runtime authority for embedded defaults, .eidolon customization and Halfcode-backed Agent resources." description = "Coordinate XNL VFS primitives, a storage-neutral Halfcode loader, BunFS builtin resources, atomic home/workspace overlays, resource-authoring migration and cross-mode product verification without retaining FQN-layer composition as the overlay authority." question_mode = "decision-tree" question_severity = "auto" revision = 40 created_at = "2026-08-31T09:28:58.620Z" updated_at = "2026-09-02T13:52:57.216Z" gap_round = 4 } (
  <Ports { scope = "mission" } [
