        <After { ref = "G2" }>
      ]>
      <Node #G6 [
        <After { ref = "G5" }>
      ]>
      <Node #G6D [
        <After { ref = "G5" }>
      ]>
      <Node #G7 [
        <After { ref = "G5" }>
        <After { ref = "G6" }>
        <After { ref = "G6D" }>
