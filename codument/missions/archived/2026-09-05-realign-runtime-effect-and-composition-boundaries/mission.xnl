<Mission #realign-runtime-effect-and-composition-boundaries apiVersion="codument.tech/v1alpha1" version="1" { status = "archived" goal = "每次归位一个真实执行闭包，分离纯逻辑、effect 实现与显式组装，消除已证实源码依赖环并保持现有运行语义" description = "独立承接用户第4项；聚焦 Conversation 与 Holon 本地闭包，保留成熟实现、既有 authority 与本地依赖开发形态，不全库重写或改名" question_mode = "decision-tree" question_severity = "auto" revision = 35 created_at = "2026-09-05T11:24:52.377Z" updated_at = "2026-09-05T18:09:57.686Z" } (
  <Ports { scope = "mission" } [
    <MaterialBundle { role = "state" name = "reports" domain = "mission" path = "vfs://./reports/" }>
  ]>
  <ProjectRefs [
    <ProjectRef #host { kind = "host" }>
  ]>
  <ActorSets { default = "default-control-loop" } [
    <ActorSet #default-control-loop [
      <Actor { role = "MissionPlanner" project_ref = "host" } (
        <Description ?01M1RX2G3APC4C5Y5NZ8R1HC41>
        按实际 import/effect/authority 路径将 Conversation、Holon 和剩余组合边界切为可单独验证的真实 Tracks；不按包名机械拆分。
        </?01M1RX2G3APC4C5Y5NZ8R1HC41>
      )>
      <Actor { role = "MissionObserver" project_ref = "host" } (
        <Description ?01M1RX2G3APC4C5Y5NZ8R1HC42>
        读取源码导入图、manifest、注册时机、Prompt/receipt goldens、冷启动与替换 port 测试；识别同一闭包在另一 Mission 中的在途修改。
        </?01M1RX2G3APC4C5Y5NZ8R1HC42>
      )>
      <Actor { role = "MissionReconciler" project_ref = "host" } (
        <Description ?01M1RX2G3APC4C5Y5NZ8R1HC43>
        比较语义基线与迁移后结果，检查反向边是否真正删除而非用延迟 import 或 service locator 隐藏；一个闭包验证完成再迁移下一个。
        </?01M1RX2G3APC4C5Y5NZ8R1HC43>
      )>
      <Actor { role = "MissionApplier" project_ref = "host" } (
        <Description ?01M1RX2G3APC4C5Y5NZ8R1HC44>
        创建绑定并实现 ready Track，把规则、IO、装配分别归既有正确 owner；保持 public behavior 和物理持久格式，运行专项与冷启动验证，不改 bun.lock 跟踪策略。
        </?01M1RX2G3APC4C5Y5NZ8R1HC44>
      )>
    ]>
  ]>
  <TaskSpace #space_realign-runtime-effect-and-composition-boundaries { name = "realign-runtime-effect-and-composition-boundaries" version = "1" child_mode = "dag" } (
    <SubNodes [
      <TaskGroup #G1 { name = "真实闭包清单与迁移协议" status = "DONE" order = 0 } (
        <SubNodes [
          <Task #G1-T1 { name = "核对已确认依赖环与全部受影响入口" status = "DONE" order = 0 } (
            <Description ?01M1RX2G3APC4C5Y5NZ8R1HC45>
            定位 domainRuntime 到 ai-support、support 加载时注册、File journal、bootstrap、公开 exports 的实际边；建立旧位置到目标位置映射及另一 Mission 的交接点。
            </?01M1RX2G3APC4C5Y5NZ8R1HC45>
          )>
          <Task #G1-T2 { name = "完成 DEPA 定向处置与验收设计" status = "DONE" order = 1 } (
            <Description ?01M1RX2G3APC4C5Y5NZ8R1HC46>
            为每个闭包写 authority/ports/logic/support/composition 与禁止依赖；优先现有包和显式宿主，只有确有复用闭包才 replan 新 capsule；不引入跨 Mission 整体完成依赖。
            </?01M1RX2G3APC4C5Y5NZ8R1HC46>
          )>
        ]>
      )>
      <TaskGroup #G2 { name = "固定可执行语义基线" status = "DONE" order = 1 } (
