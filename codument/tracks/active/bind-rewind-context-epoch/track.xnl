<Track #bind-rewind-context-epoch apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "Bind Responses replay optimization to an explicit Session-owned context epoch invalidated by history movement." description = "Advance and persist provider context epochs on rewind, fork, rollback, and reset; remove stale replay assets and reject old provider results." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-19T19:17:33.191Z" updated_at = "2026-08-19T19:36:12.496Z" modeling_base_commit = "da0f0691b7782ecc6585702c2036a86ad9b59aa0" engineering_base_commit = "da0f0691b7782ecc6585702c2036a86ad9b59aa0" } (
