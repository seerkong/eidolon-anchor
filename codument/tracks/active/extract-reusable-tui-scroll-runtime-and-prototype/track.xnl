<Track #extract-reusable-tui-scroll-runtime-and-prototype apiVersion="codument.tech/v1alpha1" version="1" { status = "in_progress" goal = "用DEPA沉淀可复用滚动包，以独立原型先验收后接入，修复历史及实时消息的分页/视口一致性" description = "复现基线、单owner核心、真实OpenTUI原型、Eidolon接入与现场回归；manual、每阶段GapLoop验证轮及最终架构审查" question_mode = "decision-tree" question_severity = "light" commit_mode = "manual" created_at = "2026-09-06T02:48:28.398Z" updated_at = "2026-09-06T16:13:39.207Z" modeling_base_commit = "5c8554c5a431b796c5496d670e0f1eaddfbbeab6" engineering_base_commit = "5c8554c5a431b796c5496d670e0f1eaddfbbeab6" gap_round = 2 } (
