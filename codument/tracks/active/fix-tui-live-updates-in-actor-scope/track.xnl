<Track #fix-tui-live-updates-in-actor-scope apiVersion="codument.tech/v1alpha1" version="1" { status = "in_progress" goal = "让 actor 作用域视图恢复实时增量（按 actor 身份过滤而非无条件丢弃事件），同时保住切换查看不同 actor 的既有功能，且切换后同样获得实时增量" description = "TUI 层事件准入修正：actor 作用域按 agentActorId 过滤 + id 空间对齐验证 + 切换 actor 不回归；session 作用域语义不变" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-09-17T09:20:00.000Z" updated_at = "2026-09-17T07:45:31.918Z" modeling_base_commit = "72cf1326a38bd6086d03e61c50db19ce2d35c767" engineering_base_commit = "72cf1326a38bd6086d03e61c50db19ce2d35c767" } (
  <Ports { scope = "track" } [
