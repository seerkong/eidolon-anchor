    <MaterialBundle #tui_client { role = "input" name = "tui-client" domain = "code" path = "vfs://@/terminal/packages/tui/src/runtime/client/" }>
    <MaterialBundle #tui_tests { role = "input" name = "tui-tests" domain = "test" path = "vfs://@/terminal/packages/tui/tests/" }>
  ]>
  <TaskSpace #space_fix-tui-live-updates-in-actor-scope { name = "fix-tui-live-updates-in-actor-scope" version = "1" child_mode = "dag" } (
    <SubNodes [
      <TaskGroup #P1 { name = "确认事件侧 actor 身份与 id 空间" status = "DONE" priority = "P0" order = 0 } (
        <Description ?01M2PZ0000000000000000000R>
        用代码事实确认 `message.updated` / `message.part.updated` 路径能否读出 canonical actor 身份，以及 actor 投影与 session 投影的 message id 是否同源。这一步决定实现是否需要补字段。
        </?01M2PZ0000000000000000000R>
        <SubNodes [
          <Task #P1-T1 { name = "确认事件属性上的 actor 身份可获得性" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P1-T1-AC1 { checked = true } ?01M2PZ0000000000000000000S>
              已用代码事实确认 `message.updated` / `message.part.updated` 的 `properties` 是否能读出 canonical actor id（与 `ActorRuntimeLaneData.actorId` 同空间），并记录结论。
              </?01M2PZ0000000000000000000S>
              <Criterion #P1-T1-AC2 { checked = true } ?01M2PZ0000000000000000000T>
              若不可读，已确定要在发射处补充的字段名（语义明确表示 actor 身份，不复用语义模糊的 `agent`）。
              </?01M2PZ0000000000000000000T>
            ]>
          )>
          <Task #P1-T2 { name = "确认两侧 message id 同源" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P1-T2-AC1 { checked = true } ?01M2PZ0000000000000000000V>
              已确认 actor 投影（`actor.messages`）与 session 投影对同一逻辑消息派生出相同 id（`buildHistorySessionMessage` 的 `actorIdentity` 取值一致），或已定位差异及修正点。
              </?01M2PZ0000000000000000000V>
              <Criterion #P1-T2-AC2 { checked = true } ?01M2PZ0000000000000000000W>
              该结论有可执行的断言方式（供 P3 测试使用），而非仅靠阅读推断。
              </?01M2PZ0000000000000000000W>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "实现按 actor 作用域的实时准入" status = "DONE" priority = "P0" order = 1 } (
        <Description ?01M2PZ0000000000000000000X>
        把 actor 作用域的无条件丢弃改为按当前作用域 actor 身份过滤；session 作用域保持既有无条件接纳。
        </?01M2PZ0000000000000000000X>
        <SubNodes [
