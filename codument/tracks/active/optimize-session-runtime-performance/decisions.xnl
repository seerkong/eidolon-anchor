<decisions #optimize-session-runtime-performance {
  track = "optimize-session-runtime-performance"
}
(
  <decision #optimize-session-runtime-performance.scope {
    status = "accepted"
    priority = "P0"
  }
  (
    <question ?>优化项的范围与 track 组织？</?>
    <answer { }
    (
      <raw-answer ?>一个 track 收编 P0-1（方案A）~P1-3 全部，id 建议 optimize-session-runtime-performance -- 同意</?>
      <decision-text ?>单 track 收编 P0-1（方案A）、P0-2、P1-1、P1-2、P1-3 全部；track id 为 optimize-session-runtime-performance。</?>
      <rationale ?>各项同属一个性能根因链（checkpoint 全量解析日志 + 无界日志/快照/内存），拆分反而增加协调成本。</?>
      <evidence ?>现场 session 实测：checkpoint 30~189s、日志 863MB、vm.json 9.7MB、进程 12.3GB。</?>
    )>
  )>
  <decision #optimize-session-runtime-performance.commit-mode {
    status = "accepted"
    priority = "P0"
  }
  (
    <question ?>提交模式？</?>
    <answer { }
    (
      <raw-answer ?>提交模式 manual</?>
      <decision-text ?>CommitMode 使用 manual：每步由用户确认后提交。</?>
      <rationale ?>与既有 track 一致，避免隐式提交。</?>
      <evidence ?>用户明确选择 manual。</?>
    )>
  )>
  <decision #optimize-session-runtime-performance.validation-mode {
    status = "accepted"
    priority = "P0"
  }
  (
    <question ?>校验模式？</?>
    <answer { }
    (
      <raw-answer ?>校验模式 终态 phase 挂 <cdt:GapLoop max-rounds="5" on-exhausted="block"> 自动修复循环</?>
      <decision-text ?>仅最后一个第一层 TaskGroup 挂 <Hook on="phase:after"><cdt:GapLoop max-rounds="5" on-exhausted="block" verify-round="false"/></Hook>；verify-round 取全局默认 false。</?>
      <rationale ?>性能优化 track 以可验证指标收口，gap-loop 自动修复比人工确认更贴合。</?>
      <evidence ?>用户选择 GapLoop 自动修复循环。</?>
    )>
  )>
  <decision #optimize-session-runtime-performance.attractor-check {
    status = "accepted"
    priority = "P1"
  }
  (
    <question ?>方向审查（AttractorCheck）范围？</?>
    <answer { }
    (
      <raw-answer ?>Q4 方向审查（AttractorCheck） -- A. 仅终态 phase 挂 <cdt:AttractorCheck use="coding"/></?>
      <decision-text ?>仅最后一个第一层 TaskGroup 挂 <Hook on="phase:after"><cdt:AttractorCheck use="coding"/></Hook>。</?>
      <rationale ?>本 track 涉架构与数据一致性，属中高风险，终态审查足够。</?>
      <evidence ?>用户选择仅终态 phase。</?>
    )>
  )>
  <decision #optimize-session-runtime-performance.p0-1-head-fallback {
    status = "accepted"
    priority = "P0"
  }
  (
    <question ?>P0-1 方案A 落点与旧会话回退？</?>
    <answer { }
    (
      <raw-answer ?>Q5 P0-1 方案A 落点与旧会话回退 -- A. head/计数器文件放 runtime-control/heads/；旧会话无 head 文件时回退"尾部窗口 \n< 解析"（推荐）</?>
      <decision-text ?>head/计数器文件放 runtime-control/heads/；旧会话无 head 文件时回退有界尾部窗口解析（从合法 XNL 节点起始行开始 parseXnl）。</?>
      <rationale ?>避免整读数百 MB 日志；尾部窗口解析已实测正确且约 180ms。</?>
      <evidence ?>10MB 切片从 \n< 解析 10,822 节点与真实记录数一致。</?>
    )>
  )>
  <decision #optimize-session-runtime-performance.p0-2-rotation {
    status = "accepted"
    priority = "P0"
  }
  (
    <question ?>P0-2 轮转策略？</?>
    <answer { }
    (
      <raw-answer ?>Q6 P0-2 轮转策略 -- A. 按大小轮转（如 64MB/段，保留近 2 段）（推荐）</?>
      <decision-text ?>ingress.xnl/diagnostics.xnl 按大小轮转：64MB/段，保留近 2 段。</?>
      <rationale ?>按大小轮转比按天更能稳定上界。</?>
      <evidence ?>现场日志活跃日约 0.5GB/天。</?>
    )>
  )>
  <decision #optimize-session-runtime-performance.p1-1-frequency {
    status = "accepted"
    priority = "P1"
  }
  (
    <question ?>P1-1 快照频率语义？</?>
    <answer { }
    (
      <raw-answer ?>Q7 P1-1 快照频率语义确认 -- B. 保持现频率，仅做增量写</?>
      <decision-text ?>保持 enqueue 后 saveSnapshotAfterProgress 的频率不变；仅将快照写改为增量写（未变化的 actor/fiber 不重写）。</?>
      <rationale ?>P0-1 消除日志解析后单次快照已足够便宜，保持频率可保留当前崩溃恢复粒度。</?>
      <evidence ?>用户选择保持现频率仅增量写。</?>
    )>
  )>
  <decision #optimize-session-runtime-performance.effect-sequence-o1 {
    status = "accepted"
    priority = "P0"
  }
  (
    <question ?>effect-evidence 序号读取是否纳入 P0-1？</?>
    <answer { }
    (
      <raw-answer ?>规划期发现 appendRuntimeControlEffectEvidenceEnvelope 每次 append 前全量解析 effects.xnl 取序号（O(n)），建议并入 P0-1。</?>
      <decision-text ?>将 readRuntimeControlEffectEvidenceSequence 改为读 effect_evidence head（O(1)），纳入 P0-1 范围。</?>
      <rationale ?>与 journal hygiene（append O(1)）行为要求一致，同属"head 读取不再全量解析日志"。</?>
      <evidence ?>ai-file-store-logic/src/index.ts:1363 每次 append 调用 readRuntimeControlEffectEvidenceSequence；effects.xnl 14MB。</?>
    )>
  )>
)>