              </?01M05F1P86JYW01E84NXT06Y2W>
              <Criterion { id = "T5.1-AC2" checked = true } ?01M05F1P86JYW01E84NXT06Y2X>
              脏文件正确写入且 manifest 一致。
              </?01M05F1P86JYW01E84NXT06Y2X>
            ]>
          )>
          <Task { id = "T5.2" name = "增量写回归测试" status = "DONE" order = 1 priority = "P1" } (
            <Description ?01M05F1P86JYW01E84NXT06Y2Y>
