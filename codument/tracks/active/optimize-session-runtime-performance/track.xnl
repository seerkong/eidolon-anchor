          </?01M05F1P86JYW01E84NXT06Y32>
        ]>
        <SubNodes [
          <Task { id = "T6.1" name = "审计内存保留点" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1P86JYW01E84NXT06Y33>
            用堆快照/计数定位 ingress timeline、semantic event graph、message history graph 等保留点，量化各点占用。
            </?01M05F1P86JYW01E84NXT06Y33>
            <Acceptance [
