            <Acceptance [
              <Criterion { id = "T6.2-AC1" checked = true } ?01M05F1P86JYW01E84NXT06Y36>
              裁剪后长会话内存增长有界或显著下降。
              </?01M05F1P86JYW01E84NXT06Y36>
              <Criterion { id = "T6.2-AC2" checked = true } ?01M05F1P86JYW01E84NXT06Y37>
              验证结果与运维建议写入 analysis/findings.md。
              </?01M05F1P86JYW01E84NXT06Y37>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P7 { name = "收口验证" status = "DONE" order = 6 } (
        <Description ?01M05F1P86JYW01E84NXT06Y38>
        跑全量相关测试、strict codument validate、用真实 session 数据做优化前后基准对比；运行 GapLoop 与 AttractorCheck。
        </?01M05F1P86JYW01E84NXT06Y38>
        <Gate [
          <Criterion ?01M05F1P86JYW01E84NXT06Y39>
