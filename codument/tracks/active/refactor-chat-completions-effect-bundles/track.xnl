              <Criterion { id = "T2.1-AC5" checked = true } ?01M05F1P8AZMENP50Y7HM1ESRX>
              symbiont-logic no longer owns or exports code that interprets provider reasoning or tool-call fields.
              </?01M05F1P8AZMENP50Y7HM1ESRX>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "Official effect bundle composition" status = "DONE" order = 2 } (
        <Description ?01M05F1P8AZMENP50Y7HM1ESRY>
