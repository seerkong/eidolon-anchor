<Track #refactor-chat-completions-effect-bundles version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "Compose OpenAI official Chat and DeepSeek official Chat from one pure Chat Completions core through two explicit effect bundles." description = "Replace provider heuristics and mutable mixed-responsibility stream logic with explicit official bundles, a pure reducer, and an effect shell." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-04T16:53:10Z" updated_at = "2026-08-04T19:20:36Z" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
    <MaterialBundle { role = "state" name = "analysis" domain = "track" path = "vfs://./analysis/" }>
