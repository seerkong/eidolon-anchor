        </?01M05F1P8AZMENP50Y7HM1ESRB>
        <Gate [
          <Criterion ?01M05F1P8AZMENP50Y7HM1ESRC>
          Characterization tests cover explicit OpenAI/DeepSeek selection and current common stream semantics.
          </?01M05F1P8AZMENP50Y7HM1ESRC>
          <Criterion ?01M05F1P8AZMENP50Y7HM1ESRD>
          Tests fail for URL/model heuristic dependence or missing effect bundle contracts before production integration.
          </?01M05F1P8AZMENP50Y7HM1ESRD>
        ]>
        <SubNodes [
          <Task { id = "T1.1" name = "Add effect bundle and pure-core characterization tests" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1P8AZMENP50Y7HM1ESRE>
            Add focused tests for explicit end-to-end driver bundle selection, OpenAI isolation, DeepSeek continuation, Responses normalized-stream isolation, pure reducer determinism, event ordering and AI-domain package ownership.
            </?01M05F1P8AZMENP50Y7HM1ESRE>
            <Acceptance [
              <Criterion { id = "T1.1-AC1" checked = true } ?01M05F1P8AZMENP50Y7HM1ESRF>
              Tests require OpenAI and DeepSeek drivers to expose distinct explicit official bundles.
              </?01M05F1P8AZMENP50Y7HM1ESRF>
              <Criterion { id = "T1.1-AC2" checked = true } ?01M05F1P8AZMENP50Y7HM1ESRG>
              Tests freeze common content/tool-call/think event ordering and final message behavior.
              </?01M05F1P8AZMENP50Y7HM1ESRG>
              <Criterion { id = "T1.1-AC3" checked = true } ?01M05F1P8AZMENP50Y7HM1ESRH>
              Tests require adapter selection to remain stable when model or Base URL strings are misleading.
              </?01M05F1P8AZMENP50Y7HM1ESRH>
              <Criterion { id = "T1.1-AC4" checked = true } ?01M05F1P8AZMENP50Y7HM1ESRJ>
              Existing DeepSeek reasoning roundtrip regressions remain in the focused suite.
              </?01M05F1P8AZMENP50Y7HM1ESRJ>
              <Criterion { id = "T1.1-AC5" checked = true } ?01M05F1P8AZMENP50Y7HM1ESRK>
              Tests prove the selected driver binding reaches ingress for main/child actor and provider-switch paths without stream-side adapter-type selection.
              </?01M05F1P8AZMENP50Y7HM1ESRK>
              <Criterion { id = "T1.1-AC6" checked = true } ?01M05F1P8AZMENP50Y7HM1ESRM>
              Package-boundary tests reject provider, reasoning and tool-call protocol ownership in symbiont-logic.
              </?01M05F1P8AZMENP50Y7HM1ESRM>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "Pure Chat Completions core" status = "DONE" order = 1 } (
        <Description ?01M05F1P8AZMENP50Y7HM1ESRN>
        Extract deterministic stream projection and reduction into the AI domain, leaving symbiont with provider-neutral stream/runtime primitives.
        </?01M05F1P8AZMENP50Y7HM1ESRN>
        <Gate [
          <Criterion ?01M05F1P8AZMENP50Y7HM1ESRP>
          Reducer tests pass without OutputStream or network dependencies.
          </?01M05F1P8AZMENP50Y7HM1ESRP>
          <Criterion ?01M05F1P8AZMENP50Y7HM1ESRQ>
          The compatibility facade produces the same ingress events and assistant messages.
          </?01M05F1P8AZMENP50Y7HM1ESRQ>
        ]>
        <SubNodes [
          <Task { id = "T2.1" name = "Extract pure stream reducer and effect descriptions" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1P8AZMENP50Y7HM1ESRR>
            Introduce AI-domain stream state and pure functions for chunk projection, fingerprinting, reasoning/content segmentation, tool-call reduction and message finalization; move the existing class facade/export into ai-organ-logic and migrate workspace imports without creating a symbiont reverse dependency.
            </?01M05F1P8AZMENP50Y7HM1ESRR>
            <Acceptance [
              <Criterion { id = "T2.1-AC1" checked = true } ?01M05F1P8AZMENP50Y7HM1ESRS>
              Repeated input state/chunk values produce structurally equal reducer results.
              </?01M05F1P8AZMENP50Y7HM1ESRS>
              <Criterion { id = "T2.1-AC2" checked = true } ?01M05F1P8AZMENP50Y7HM1ESRT>
