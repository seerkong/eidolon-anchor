<Track #replace-workflow-context-mutation-with-typed-facts apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "Replace mutable provider-prefix overlays with closed append-only context facts and make every non-append source change an explicit immutable provider context epoch." description = "Migrate work context, mutable projections and Workflow stage context onto the existing Conversation authority; make provider-epoch receipts immutable and reason-bound across compaction, rewind, provider/resource changes and fresh recovery." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-25T14:11:21.921Z" updated_at = "2026-08-25T19:40:23.501Z" modeling_base_commit = "42a5b58f37723752164b5c6759b500c0c09881be" engineering_base_commit = "42a5b58f37723752164b5c6759b500c0c09881be" } (
  <Ports { scope = "track" }>
  <TaskSpace #space_replace-workflow-context-mutation-with-typed-facts { name = "replace-workflow-context-mutation-with-typed-facts" version = "1" child_mode = "dag" } (
    <SubNodes [
      <TaskGroup #P1 { name = "Closed context facts, epoch receipts and RED baselines" status = "DONE" priority = "P0" order = 0 } (
        <SubNodes [
          <Task #P1-T1 { name = "Add closed append-only context-fact contract and owner ports" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P1-T1-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB2>
              Context facts are immutable closed own-data with exact Actor/session identity, Actor-global sequence, namespace revision, both predecessor digests, chronological history anchor, canonical payload digest and deterministic bytes.
              </?01M0WNC1M5FJ6DF472EH3NARB2>
              <Criterion #P1-T1-AC2 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB3>
              One runtime-first projector and Conversation CAS append own immutable asset plus Actor fact-chain head admission; duplicate/conflicting/gapped/accessor/sparse/orphaned facts fail before prompt mutation, and interleaved namespaces fresh-recover one exact total order.
              </?01M0WNC1M5FJ6DF472EH3NARB3>
            ]>
          )>
          <Task #P1-T2 { name = "Define immutable provider epoch receipt and legacy import protocol" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P1-T2-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB4>
              The immutable v2 epoch receipt binds exact predecessor, provider/model/profile, epoch-baseline history/prompt/fact heads, source frontier, pending delivery, handoff, resource/surface digests, retention policy and one closed reason; ordinary successful requests append admission receipts binding current descendant heads and final wire without mutating the epoch receipt.
              </?01M0WNC1M5FJ6DF472EH3NARB4>
              <Criterion #P1-T2-AC2 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB5>
              Legacy late-status overlays and receipt v1 enter through a CAS-marked one-way importer with exact reason mapping; six interruption boundaries, ambiguity, tamper and dual-write recover to the exact staged target or fail closed.
              </?01M0WNC1M5FJ6DF472EH3NARB5>
            ]>
          )>
        ]>
        <Gate [
          <Criterion #P1-G1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB6>
          RED proves changed work context and same-epoch receipt reconciliation currently rewrite earlier final-wire units; GREEN contracts reject structural escape and preserve deterministic identity.
          </?01M0WNC1M5FJ6DF472EH3NARB6>
        ]>
      )>
      <TaskGroup #P2 { name = "Append-only work, projection and Workflow stage facts" status = "DONE" priority = "P0" order = 1 } (
        <SubNodes [
          <Task #P2-T1 { name = "Replace late-status work context and mutable projection replacement" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P2-T1-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB7>
              Changed work context or provider projection appends exactly one predecessor-bound fact; unchanged projection is idempotent and estimation-only builds perform no write.
              </?01M0WNC1M5FJ6DF472EH3NARB7>
              <Criterion #P2-T1-AC2 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB8>
              Materialization follows exact history anchors and Actor-global sequence, never inserts ahead of retained history or splits a pending tool pair; revision-before-delivery, parallel pairs, retry and recovery preserve complete pair ownership, and removal requires epoch-advancing compaction.
              </?01M0WNC1M5FJ6DF472EH3NARB8>
            ]>
          )>
          <Task #P2-T2 { name = "Project Workflow stage context without progress prompt mutation" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P2-T2-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB9>
              Stage context is loaded from the Actor-owned frozen package and appended as a closed fact bound to package and facet revision.
              </?01M0WNC1M5FJ6DF472EH3NARB9>
              <Criterion #P2-T2-AC2 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARBA>
              Stage/progress/deadline changes do not mutate system roots; provider tool schema stays at the G2 stable exact surface while execution follows the current allowlist.
              </?01M0WNC1M5FJ6DF472EH3NARBA>
            ]>
          )>
        ]>
        <Gate [
          <Criterion #P2-G1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARBB>
          Ordinary, lifecycle and Ctrl/Data node journeys preserve exact prior same-epoch bytes while ordinary/node paths remain Workflow-stage-free.
          </?01M0WNC1M5FJ6DF472EH3NARBB>
        ]>
      )>
      <TaskGroup #P3 { name = "Reason-bound provider epoch transitions" status = "DONE" priority = "P0" order = 2 } (
        <SubNodes [
          <Task #P3-T1 { name = "Make reconcile validation-only and add monotonic transition Processor" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P3-T1-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARBC>
              Append-only turns reuse an exact immutable baseline receipt and append a predecessor-bound request-admission proof; current heads must descend from baseline/latest admission, while same-epoch receipt mutation and unexplained divergence fail before transport.
              </?01M0WNC1M5FJ6DF472EH3NARBC>
              <Criterion #P3-T1-AC2 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARBD>
              The Conversation-owned transition Processor admits only epoch n+1 with exact predecessor digest and one supported reason; one CAS batch atomically binds prior/next history, prompt and fact heads, delivery deltas and successor receipt.
              </?01M0WNC1M5FJ6DF472EH3NARBD>
            ]>
          )>
          <Task #P3-T2 { name = "Wire compaction, rewind, provider and frozen revision boundaries" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P3-T2-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARBE>
              Compaction, rewind/fork, provider/model/profile switch and accepted resource/surface revision each create exactly one persisted atomic epoch transition before changed bytes are sent.
              </?01M0WNC1M5FJ6DF472EH3NARBE>
              <Criterion #P3-T2-AC2 { checked = true } ?01M0WNC1M68S9V7YBKZ5NTV193>
              Stage/write/fsync/publish/head-CAS fault injection, retry and fresh recovery converge to exact old or new heads/receipt/facts without mixed authority; compaction proof reconstructs retained facts and first-delivery provenance after pair removal without live reread, duplicate transition or fabricated observation.
              </?01M0WNC1M68S9V7YBKZ5NTV193>
            ]>
          )>
        ]>
        <Gate [
          <Criterion #P3-G1 { checked = true } ?01M0WNC1M68S9V7YBKZ5NTV194>
          Every non-extension final-wire change maps to one persisted supported epoch reason; an unreasoned change fails the product gate.
          </?01M0WNC1M68S9V7YBKZ5NTV194>
        ]>
      )>
      <TaskGroup #P4 { name = "Cross-provider cost, recovery and fresh verification" status = "DONE" priority = "P0" order = 3 } (
        <SubNodes [
          <Task #P4-T1 { name = "Run cross-profile final-wire and fresh recovery matrix" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P4-T1-AC1 { checked = true } ?01M0WNC1M68S9V7YBKZ5NTV195>
              DeepSeek official/compatible, OpenAI Chat, OpenAI Responses, Anthropic Messages and Claude Code final-body fixtures use the exact versioned role/container/cache-unit table, preserve typed-fact ordering and reject system hoisting, framing drift or illegal pair adjacency.
              </?01M0WNC1M68S9V7YBKZ5NTV195>
              <Criterion #P4-T1-AC2 { checked = true } ?01M0WNC1M68S9V7YBKZ5NTV196>
              Fresh filesystem recovery, retry, compaction, rewind and resource-revision tests preserve one Conversation authority and exact receipts.
              </?01M0WNC1M68S9V7YBKZ5NTV196>
            ]>
          )>
          <Task #P4-T2 { name = "Run G1 cost gates and fresh coding AttractorCheck" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P4-T2-AC1 { checked = true } ?01M0WNC1M68S9V7YBKZ5NTV197>
              Ordinary, lifecycle, Ctrl and Data production journeys plus alternating namespace updates across 32-revision/65,536-byte retention thresholds retain prefix integrity 1.0 within each epoch, emit one compaction transition at the threshold and remain at or below all ratified G1 ceilings.
              </?01M0WNC1M68S9V7YBKZ5NTV197>
              <Criterion #P4-T2-AC2 { checked = true } ?01M0WNC1M68S9V7YBKZ5NTV198>
