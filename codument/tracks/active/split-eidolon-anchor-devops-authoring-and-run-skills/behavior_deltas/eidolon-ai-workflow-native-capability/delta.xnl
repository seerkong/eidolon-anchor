<BehaviorPatch #track.split-eidolon-anchor-devops-authoring-and-run-skills.behavior_patch.eidolon-ai-workflow-native-capability apiVersion="codument.tech/v1alpha1" version="1" { capability = "eidolon-ai-workflow-native-capability" } (
  <Mutations [
    <Upsert { selector = "behavior://eidolon-ai-workflow-native-capability/requirements/natural-language-authoring" } (
      <Requirement #natural-language-authoring (
        <Statement ?01M05F1P8DRHBDR4VN19E9R3GD>
        The system SHALL let humans author and run resource-native AI workflows in ordinary language through a dedicated Eidolon workflow actor governed by composable DevOps, Authoring, Run and Resource DSL system Skills, while deterministic code validates and applies only explicit structured operations.
        </?01M05F1P8DRHBDR4VN19E9R3GD>
        <Suites [
          <Suite #skill-authority { name = "Composable system Skill authority" } (
            <Cases [
              <Case #global-four-skill-location [
                <Then ?01M05F1P8DRHBDR4VN19E9R3GE>
                the managed global Skill root SHALL contain the four exact system identities declared by the canonical distribution plan
                </?01M05F1P8DRHBDR4VN19E9R3GE>
                <Then ?01M05F1P8DRHBDR4VN19E9R3GF>
                the old sys-ai-workflow identity SHALL NOT remain installed or accepted as runtime authority
                </?01M05F1P8DRHBDR4VN19E9R3GF>
              ] (
                <Given ?01M05F1P8DRHBDR4VN19E9R3GG>
                an Eidolon installation resolves its global directory
                </?01M05F1P8DRHBDR4VN19E9R3GG>
                <When ?01M05F1P8DRHBDR4VN19E9R3GH>
                the user runs eidolon global init and workflow capability is composed
                </?01M05F1P8DRHBDR4VN19E9R3GH>
              )>
              <Case #model-owned-semantics [
                <Then ?01M05F1P8DRHBDR4VN19E9R3GJ>
                the dedicated actor SHALL interpret installed Skill and reference content and submit explicit native tool arguments
                </?01M05F1P8DRHBDR4VN19E9R3GJ>
                <Then ?01M05F1P8DRHBDR4VN19E9R3GK>
                host code MUST NOT use regex, keyword, substring, ordered heuristic or alias rules to make those semantic choices
                </?01M05F1P8DRHBDR4VN19E9R3GK>
              ] (
                <Given ?01M05F1P8DRHBDR4VN19E9R3GM>
                a user supplies an ordinary-language workflow goal
                </?01M05F1P8DRHBDR4VN19E9R3GM>
                <When ?01M05F1P8DRHBDR4VN19E9R3GN>
                the system chooses lifecycle stage, resource Kind, workflow form, topology, operation or reference
                </?01M05F1P8DRHBDR4VN19E9R3GN>
              )>
              <Case #structured-component-boundary (
                <Given ?01M05F1P8DRHBDR4VN19E9R3GP>
                the workflow actor calls a native tool with explicit structured arguments
                </?01M05F1P8DRHBDR4VN19E9R3GP>
                <When ?01M05F1P8DRHBDR4VN19E9R3GQ>
                the WorkflowComponent handles the call
                </?01M05F1P8DRHBDR4VN19E9R3GQ>
                <Then ?01M05F1P8DRHBDR4VN19E9R3GR>
                the component SHALL validate schemas, resource refs, paths, revisions, proofs and authorization without reinterpreting original natural language
                </?01M05F1P8DRHBDR4VN19E9R3GR>
              )>
            ]>
          )>
          <Suite #devops-routing { name = "DevOps lifecycle and sibling delegation" } (
            <Cases [
              <Case #devops-directory-structure (
                <Given ?01M05F1P8DRHBDR4VN19E9R3GS>
                sys-eidolon-anchor-devops is installed
                </?01M05F1P8DRHBDR4VN19E9R3GS>
                <When ?01M05F1P8DRHBDR4VN19E9R3GT>
                its lifecycle resources are inspected
                </?01M05F1P8DRHBDR4VN19E9R3GT>
                <Then ?01M05F1P8DRHBDR4VN19E9R3GV>
                it SHALL expose planning, coding, building, testing, releasing, deploying, operating, monitoring and improving stage directories
                </?01M05F1P8DRHBDR4VN19E9R3GV>
              )>
              <Case #authoring-delegation (
                <Given ?01M05F1P8DRHBDR4VN19E9R3GW>
                the explicit coding stage is active
                </?01M05F1P8DRHBDR4VN19E9R3GW>
                <When ?01M05F1P8DRHBDR4VN19E9R3GX>
                definition authoring is required
                </?01M05F1P8DRHBDR4VN19E9R3GX>
                <Then ?01M05F1P8DRHBDR4VN19E9R3GY>
                the stage protocol SHALL delegate to sys-eidolon-anchor-authoring through the generic Skill tool
                </?01M05F1P8DRHBDR4VN19E9R3GY>
              )>
              <Case #run-delegation (
                <Given ?01M05F1P8DRHBDR4VN19E9R3GZ>
                deploying, operating or monitoring is explicitly active
                </?01M05F1P8DRHBDR4VN19E9R3GZ>
                <When ?01M05F1P8DRHBDR4VN19E9R3H0>
                an instance or run operation is required
                </?01M05F1P8DRHBDR4VN19E9R3H0>
                <Then ?01M05F1P8DRHBDR4VN19E9R3H1>
                the stage protocol SHALL delegate to sys-eidolon-anchor-run without loading authoring grammar
                </?01M05F1P8DRHBDR4VN19E9R3H1>
              )>
              <Case #stage-prompt-owned-by-skill [
                <Then ?01M05F1P8DRHBDR4VN19E9R3H2>
                prompt prose and next-step semantics SHALL come from exact installed DevOps files
                </?01M05F1P8DRHBDR4VN19E9R3H2>
                <Then ?01M05F1P8DRHBDR4VN19E9R3H3>
                host code SHALL NOT contain a stage-to-natural-language next-action map
                </?01M05F1P8DRHBDR4VN19E9R3H3>
              ] (
                <Given ?01M05F1P8DRHBDR4VN19E9R3H4>
                WorkflowLoadStageContext receives an explicit stage enum
                </?01M05F1P8DRHBDR4VN19E9R3H4>
                <When ?01M05F1P8DRHBDR4VN19E9R3H5>
                it updates actor context and tool policy
                </?01M05F1P8DRHBDR4VN19E9R3H5>
              )>
            ]>
          )>
          <Suite #separated-products { name = "Authoring and Run responsibilities" } (
            <Cases [
              <Case #authoring-operations (
                <Given ?01M05F1P8DRHBDR4VN19E9R3H6>
                sys-eidolon-anchor-authoring is selected
                </?01M05F1P8DRHBDR4VN19E9R3H6>
                <When ?01M05F1P8DRHBDR4VN19E9R3H7>
                the actor creates or edits resource source
                </?01M05F1P8DRHBDR4VN19E9R3H7>
                <Then ?01M05F1P8DRHBDR4VN19E9R3H8>
                it SHALL load exact operations resources, use native batch/CAS/proof/publication tools, and keep parser/digest/build algorithms in deterministic owners
                </?01M05F1P8DRHBDR4VN19E9R3H8>
              )>
              <Case #generated-flow-dsl-knowledge [
                <Then ?01M05F1P8DRHBDR4VN19E9R3H9>
                the references SHALL come from the generated depa Flow DSL tree with source/version/digest provenance
                </?01M05F1P8DRHBDR4VN19E9R3H9>
                <Then ?01M05F1P8DRHBDR4VN19E9R3HA>
                coding context SHALL NOT eagerly inject the full reference tree
                </?01M05F1P8DRHBDR4VN19E9R3HA>
              ] (
                <Given ?01M05F1P8DRHBDR4VN19E9R3HB>
                the actor needs workflow structure or profile semantics
                </?01M05F1P8DRHBDR4VN19E9R3HB>
                <When ?01M05F1P8DRHBDR4VN19E9R3HC>
                it progressively loads Authoring references
                </?01M05F1P8DRHBDR4VN19E9R3HC>
              )>
              <Case #resource-dsl-dependency (
                <Given ?01M05F1P8DRHBDR4VN19E9R3HD>
                the actor needs generic ResourcePackage, Catalog, KindDefinition, XNL channel or containment rules
                </?01M05F1P8DRHBDR4VN19E9R3HD>
                <When ?01M05F1P8DRHBDR4VN19E9R3HE>
                it loads the authoring standard
                </?01M05F1P8DRHBDR4VN19E9R3HE>
                <Then ?01M05F1P8DRHBDR4VN19E9R3HF>
                it SHALL use the exact sibling sys-halfcode-resource-dsl Skill rather than an Eidolon copy
                </?01M05F1P8DRHBDR4VN19E9R3HF>
              )>
              <Case #run-operations (
                <Given ?01M05F1P8DRHBDR4VN19E9R3HG>
                a published resource entrypoint exists
                </?01M05F1P8DRHBDR4VN19E9R3HG>
                <When ?01M05F1P8DRHBDR4VN19E9R3HH>
                sys-eidolon-anchor-run handles deploy, start, resume, resolve, reject, inspect, replay or evidence through existing structured operations
                </?01M05F1P8DRHBDR4VN19E9R3HH>
                <Then ?01M05F1P8DRHBDR4VN19E9R3HJ>
                it SHALL use exact run operations and MUST NOT claim a general cancellation contract, edit the published definition or load authoring grammar; a Cancelled outcome is only valid where the typed wait-resume protocol explicitly accepts it
                </?01M05F1P8DRHBDR4VN19E9R3HJ>
              )>
              <Case #operations-directory (
                <Given ?01M05F1P8DRHBDR4VN19E9R3HK>
                Authoring and Run payloads are inspected
                </?01M05F1P8DRHBDR4VN19E9R3HK>
                <When ?01M05F1P8DRHBDR4VN19E9R3HM>
                their operation protocols are enumerated
                </?01M05F1P8DRHBDR4VN19E9R3HM>
                <Then ?01M05F1P8DRHBDR4VN19E9R3HN>
                they SHALL use operations directories and SHALL NOT contain an actions directory
                </?01M05F1P8DRHBDR4VN19E9R3HN>
              )>
            ]>
          )>
          <Suite #cross-surface { name = "Conversation and CLI consistency" } (
            <Cases [
              <Case #shared-dedicated-actor (
                <Given ?01M05F1P8DRHBDR4VN19E9R3HP>
                the same business goal enters Eidolon conversation or workflow CLI
                </?01M05F1P8DRHBDR4VN19E9R3HP>
                <When ?01M05F1P8DRHBDR4VN19E9R3HQ>
                the workflow product handles it
                </?01M05F1P8DRHBDR4VN19E9R3HQ>
                <Then ?01M05F1P8DRHBDR4VN19E9R3HR>
                both surfaces SHALL use the same dedicated actor, new DevOps authority and native component tools
                </?01M05F1P8DRHBDR4VN19E9R3HR>
              )>
              <Case #independent-authorizations (
                <Given ?01M05F1P8DRHBDR4VN19E9R3HS>
                authoring proof succeeds
                </?01M05F1P8DRHBDR4VN19E9R3HS>
                <When ?01M05F1P8DRHBDR4VN19E9R3HT>
                publication or execution was not independently authorized
                </?01M05F1P8DRHBDR4VN19E9R3HT>
                <Then ?01M05F1P8DRHBDR4VN19E9R3HV>
                the system SHALL preserve recoverable state at the corresponding gate and SHALL NOT infer missing authorization
                </?01M05F1P8DRHBDR4VN19E9R3HV>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
