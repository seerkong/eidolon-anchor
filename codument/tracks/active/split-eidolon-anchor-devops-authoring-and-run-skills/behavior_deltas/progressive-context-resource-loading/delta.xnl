<BehaviorPatch #track.split-eidolon-anchor-devops-authoring-and-run-skills.behavior_patch.progressive-context-resource-loading apiVersion="codument.tech/v1alpha1" version="1" { capability = "progressive-context-resource-loading" } (
  <Mutations [
    <Upsert { selector = "behavior://progressive-context-resource-loading/requirements/skill-resource-fragments" } (
      <Requirement #skill-resource-fragments (
        <Statement ?01M05F1P8GJDN90ZQ8ZAYWFEWR>
        The generic Skill resolver SHALL load an exact declared Skill resource and optional line fragment through the shared context-resource revision and visibility mechanism; product-specific Skills SHALL NOT create private loaded-state or resource-loader authority.
        </?01M05F1P8GJDN90ZQ8ZAYWFEWR>
        <Suites [
          <Suite #exact-resource-selection { name = "Exact declared Skill resources" } (
            <Cases [
              <Case #root-default (
                <Given ?01M05F1P8GJDN90ZQ8ZAYWFEWS>
                a caller supplies an exact Skill identity without a resource
                </?01M05F1P8GJDN90ZQ8ZAYWFEWS>
                <When ?01M05F1P8GJDN90ZQ8ZAYWFEWT>
                the Skill tool runs
                </?01M05F1P8GJDN90ZQ8ZAYWFEWT>
                <Then ?01M05F1P8GJDN90ZQ8ZAYWFEWV>
                it SHALL load SKILL.md through LocalTextResourceLoader with the shared default offset and limit
                </?01M05F1P8GJDN90ZQ8ZAYWFEWV>
              )>
              <Case #declared-resource-fragment (
                <Given ?01M05F1P8GJDN90ZQ8ZAYWFEWW>
                a caller supplies an exact resource, offset and limit
                </?01M05F1P8GJDN90ZQ8ZAYWFEWW>
                <When ?01M05F1P8GJDN90ZQ8ZAYWFEWX>
                the resource is declared by the selected Skill catalog entry
                </?01M05F1P8GJDN90ZQ8ZAYWFEWX>
                <Then ?01M05F1P8GJDN90ZQ8ZAYWFEWY>
                the tool SHALL deliver that line fragment with stable line numbers, resource revision and visible-coverage behavior
                </?01M05F1P8GJDN90ZQ8ZAYWFEWY>
              )>
              <Case #undeclared-or-unsafe-resource (
                <Given ?01M05F1P8GJDN90ZQ8ZAYWFEWZ>
                a resource is unknown, absolute, traversal-shaped, a symbolic-link escape or not declared by the selected Skill
                </?01M05F1P8GJDN90ZQ8ZAYWFEWZ>
                <When ?01M05F1P8GJDN90ZQ8ZAYWFEX0>
                the Skill tool resolves it
                </?01M05F1P8GJDN90ZQ8ZAYWFEX0>
                <Then ?01M05F1P8GJDN90ZQ8ZAYWFEX1>
                the resolver SHALL fail closed before returning content and SHALL NOT search for a similar path
                </?01M05F1P8GJDN90ZQ8ZAYWFEX1>
              )>
            ]>
          )>
          <Suite #authority-specific-readback { name = "Managed and ordinary read boundaries" } (
            <Cases [
              <Case #managed-system-resource (
                <Given ?01M05F1P8GJDN90ZQ8ZAYWFEX2>
                the selected Skill is a managed global sys-* identity
                </?01M05F1P8GJDN90ZQ8ZAYWFEX2>
                <When ?01M05F1P8GJDN90ZQ8ZAYWFEX3>
                the requested resource is read
                </?01M05F1P8GJDN90ZQ8ZAYWFEX3>
                <Then ?01M05F1P8GJDN90ZQ8ZAYWFEX4>
                the resolver SHALL require exact .system-skills.xnl identity/path evidence and verify the recorded digest
                </?01M05F1P8GJDN90ZQ8ZAYWFEX4>
              )>
              <Case #ordinary-skill-resource (
                <Given ?01M05F1P8GJDN90ZQ8ZAYWFEX5>
                the selected Skill is an ordinary global or workspace Skill
                </?01M05F1P8GJDN90ZQ8ZAYWFEX5>
                <When ?01M05F1P8GJDN90ZQ8ZAYWFEX6>
                the requested declared resource is read
                </?01M05F1P8GJDN90ZQ8ZAYWFEX6>
                <Then ?01M05F1P8GJDN90ZQ8ZAYWFEX7>
                the resolver SHALL require a physical file within the real Skill root and SHALL preserve workspace/global catalog precedence
                </?01M05F1P8GJDN90ZQ8ZAYWFEX7>
              )>
              <Case #shared-resource-facts (
                <Given ?01M05F1P8GJDN90ZQ8ZAYWFEX8>
                either managed or ordinary Skill content is accepted
                </?01M05F1P8GJDN90ZQ8ZAYWFEX8>
                <When ?01M05F1P8GJDN90ZQ8ZAYWFEX9>
                the tool delivers it
                </?01M05F1P8GJDN90ZQ8ZAYWFEX9>
                <Then ?01M05F1P8GJDN90ZQ8ZAYWFEXA>
                the delivery SHALL use the same tool-independent context resource facts, persistence and surface projection as other local text reads
                </?01M05F1P8GJDN90ZQ8ZAYWFEXA>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
