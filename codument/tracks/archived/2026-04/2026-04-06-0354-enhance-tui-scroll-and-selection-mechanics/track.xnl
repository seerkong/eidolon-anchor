<Track #enhance-tui-scroll-and-selection-mechanics version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "在现有 prototype scroll 主链上增强滚动稳定性、边界导航、选择态与流式更新之间的协调" commit_mode = "manual" created_at = "2026-04-05T19:06:45Z" updated_at = "2026-04-06T03:54:02Z" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
    <MaterialBundle { role = "output" name = "docs" domain = "doc" path = "vfs://@/docs/" }>
    <MaterialBundle { role = "output" name = "behavior" domain = "codument" path = "vfs://@/codument/behaviors/" }>
  ]>
  <TaskSpace #space_enhance-tui-scroll-and-selection-mechanics { name = "enhance-tui-scroll-and-selection-mechanics" } (
    <Description ?01M05F1PABXTF0MCAGEEPTMDV4>
    增强 TUI 滚动与选择机制
    </?01M05F1PABXTF0MCAGEEPTMDV4>
    <SubNodes [
      <TaskGroup #P1 { name = "Rule Freeze" status = "DONE" order = 0 } (
        <Description ?01M05F1PABXTF0MCAGEEPTMDV5>
        冻结滚动、自动跟底和选择态协调规则
        </?01M05F1PABXTF0MCAGEEPTMDV5>
        <SubNodes [
          <Task { id = "T1.1" name = "冻结自动跟底与手动浏览切换规则" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PABXTF0MCAGEEPTMDV6>
            明确何时自动跟底、何时尊重用户手动浏览，以及何时恢复自动跟随。
            </?01M05F1PABXTF0MCAGEEPTMDV6>
            <Acceptance [
              <Criterion { id = "T1.1-AC1" checked = true } ?01M05F1PABXTF0MCAGEEPTMDV7>
              手动浏览期间不会被无条件强制跳底
              </?01M05F1PABXTF0MCAGEEPTMDV7>
              <Criterion { id = "T1.1-AC2" checked = true } ?01M05F1PABXTF0MCAGEEPTMDV8>
              用户明确回到底部后可恢复自动跟底
              </?01M05F1PABXTF0MCAGEEPTMDV8>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "Scroll Behavior Hardening" status = "DONE" order = 1 } (
        <Description ?01M05F1PABXTF0MCAGEEPTMDV9>
        在现有 scroll helpers 和 PrototypeView 接线中增强交互稳定性
        </?01M05F1PABXTF0MCAGEEPTMDV9>
        <SubNodes [
          <Task { id = "T2.1" name = "增强边界导航与手动浏览逻辑" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PABXTF0MCAGEEPTMDVA>
            在不重做主链的前提下，增强 PageUp/PageDown/Home/End 与手动历史浏览表现。
            </?01M05F1PABXTF0MCAGEEPTMDVA>
            <Acceptance [
              <Criterion { id = "T2.1-AC1" checked = true } ?01M05F1PABXTF0MCAGEEPTMDVB>
              PageUp/PageDown/Home/End 表现稳定
              </?01M05F1PABXTF0MCAGEEPTMDVB>
              <Criterion { id = "T2.1-AC2" checked = true } ?01M05F1PABXTF0MCAGEEPTMDVC>
              手动浏览不会因流式更新被频繁打断
              </?01M05F1PABXTF0MCAGEEPTMDVC>
            ]>
          )>
          <Task { id = "T2.2" name = "协调选择态与滚动副作用" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PABXTF0MCAGEEPTMDVD>
            在选择文本或其他交互过程中，避免滚动和点击副作用破坏选择体验。
            </?01M05F1PABXTF0MCAGEEPTMDVD>
            <Acceptance [
              <Criterion { id = "T2.2-AC1" checked = true } ?01M05F1PABXTF0MCAGEEPTMDVE>
              选择存在时不会因无关副作用被明显打断
              </?01M05F1PABXTF0MCAGEEPTMDVE>
              <Criterion { id = "T2.2-AC2" checked = true } ?01M05F1PABXTF0MCAGEEPTMDVF>
              基础 wheel/arrow scroll 行为无回归
              </?01M05F1PABXTF0MCAGEEPTMDVF>
            ]>
          )>
          <Task { id = "T2.3" name = "修正历史区焦点恢复与可视反馈" status = "DONE" order = 2 priority = "P0" } (
            <Description ?01M05F1PABXTF0MCAGEEPTMDVG>
            允许历史区在 composer 保留草稿时重新获得活跃焦点并滚动，补齐触摸板 / 滚轮 / 键盘一致性，并将 bottom bar 焦点切换正式化。
            </?01M05F1PABXTF0MCAGEEPTMDVG>
            <Acceptance [
              <Criterion { id = "T2.3-AC1" checked = true } ?01M05F1PABXTF0MCAGEEPTMDVH>
              composer 有内容时，点击历史区后仍可继续滚动历史
              </?01M05F1PABXTF0MCAGEEPTMDVH>
              <Criterion { id = "T2.3-AC2" checked = true } ?01M05F1PABXTF0MCAGEEPTMDVJ>
              输入区与历史区能通过颜色变化区分当前焦点
              </?01M05F1PABXTF0MCAGEEPTMDVJ>
              <Criterion { id = "T2.3-AC3" checked = true } ?01M05F1PABXTF0MCAGEEPTMDVK>
              bottom bar `History` / `Composer` 与区域真实焦点保持一致
              </?01M05F1PABXTF0MCAGEEPTMDVK>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "Verification" status = "DONE" order = 2 } (
        <Description ?01M05F1PABXTF0MCAGEEPTMDVM>
        通过自动化测试和手工点验验证滚动与选择机制
        </?01M05F1PABXTF0MCAGEEPTMDVM>
        <SubNodes [
          <Task { id = "T3.1" name = "补滚动相关自动化测试" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PABXTF0MCAGEEPTMDVN>
            新增或更新测试，覆盖边界跳转、手动浏览期间的流式更新和选择态相关场景。
            </?01M05F1PABXTF0MCAGEEPTMDVN>
            <Acceptance [
              <Criterion { id = "T3.1-AC1" checked = true } ?01M05F1PABXTF0MCAGEEPTMDVP>
              存在 PageUp/PageDown/Home/End 的自动化测试
              </?01M05F1PABXTF0MCAGEEPTMDVP>
              <Criterion { id = "T3.1-AC2" checked = true } ?01M05F1PABXTF0MCAGEEPTMDVQ>
              存在手动浏览与流式更新协调的自动化测试
              </?01M05F1PABXTF0MCAGEEPTMDVQ>
            ]>
          )>
          <Task { id = "T3.2" name = "运行 terminal TUI 测试并手工点验" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PABXTF0MCAGEEPTMDVR>
            执行 terminal TUI 测试，并手工验证滚动、选择、边界跳转、触摸板与 bottom bar 焦点切换表现。
            </?01M05F1PABXTF0MCAGEEPTMDVR>
            <Acceptance [
              <Criterion { id = "T3.2-AC1" checked = true } ?01M05F1PABXTF0MCAGEEPTMDVS>
              至少运行一次 terminal TUI 相关测试命令
              </?01M05F1PABXTF0MCAGEEPTMDVS>
              <Criterion { id = "T3.2-AC2" checked = true } ?01M05F1PABXTF0MCAGEEPTMDVT>
              手工点验覆盖 wheel、touchpad、arrow、page、edge、selection 和焦点切换场景
              </?01M05F1PABXTF0MCAGEEPTMDVT>
            ]>
          )>
        ]>
        <Hooks [
          <Hook { on = "phase:after" } (
            <GapLoop { max_rounds = 5 on_exhausted = "block" }>
          )>
        ]>
      )>
    ]>
  )>
  <Schedule>
)>
