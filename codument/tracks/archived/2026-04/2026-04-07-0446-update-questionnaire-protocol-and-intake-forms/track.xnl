<Track #update-questionnaire-protocol-and-intake-forms version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "让 questionnaire 在 text view 与 TUI 中都具备稳定的编号协议、自由填写分支、可解析的文本回答格式，以及更合理的推荐类 intake 表单" commit_mode = "manual" created_at = "2026-04-06T11:17:39Z" updated_at = "2026-04-07T04:46:00Z" } (
