<Track #add-tui-input-and-material-state-foundations version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "为 prototype TUI 建立可持续的结构化 composer、graph 化 shared state 与 file picker/frecency 输入底座" commit_mode = "manual" created_at = "2026-04-06T16:02:18Z" updated_at = "2026-04-07T22:00:00Z" } (
