              </?01M05F1PCG392E67NEG7JDJWB1>
            ]>
          )>
          <Task { id = "T2.2" name = "设计目标包结构与兼容过渡策略" status = "DONE" order = 1 priority = "P1" } (
            <Description ?01M05F1PCG392E67NEG7JDJWB2>
            给出从现有 cell/core/organ/mod 结构迁移到目标微内核结构的包级过渡方案。
            </?01M05F1PCG392E67NEG7JDJWB2>
            <Acceptance [
              <Criterion { id = "T2.2-AC1" checked = true } ?01M05F1PCG392E67NEG7JDJWB3>
              目标包结构、命名与兼容阶段明确
              </?01M05F1PCG392E67NEG7JDJWB3>
              <Criterion { id = "T2.2-AC2" checked = true } ?01M05F1PCG392E67NEG7JDJWB4>
              不要求单轮重构完成全部 rename/cutover
              </?01M05F1PCG392E67NEG7JDJWB4>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "Profile And Runtime Adoption Design" status = "DONE" order = 2 } (
        <Description ?01M05F1PCG392E67NEG7JDJWB5>
        设计 profile 叠加模型与 shell/runtime entry 的消费边界。
        </?01M05F1PCG392E67NEG7JDJWB5>
        <SubNodes [
          <Task { id = "T3.1" name = "定义 platform-only -> ai-kernel -> ai-app profile 叠加模型" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PCG392E67NEG7JDJWB6>
