  ]>
  <TaskSpace #space_refactor-platform-kernel-and-ai-domain-kernel { name = "refactor-platform-kernel-and-ai-domain-kernel" } (
    <Description ?01M05F1PCG392E67NEG7JDJWAP>
    将当前 AI 运行时演进为平台微内核与 AI 领域微内核
    </?01M05F1PCG392E67NEG7JDJWAP>
    <SubNodes [
      <TaskGroup #P1 { name = "Architecture Boundary Freeze" status = "DONE" order = 0 } (
        <Description ?01M05F1PCG392E67NEG7JDJWAQ>
        冻结平台内核、AI 领域内核与 app overlay 的正式边界。
        </?01M05F1PCG392E67NEG7JDJWAQ>
        <SubNodes [
          <Task { id = "T1.1" name = "定义平台微内核能力边界" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PCG392E67NEG7JDJWAR>
            锁定哪些能力属于跨领域平台内核，哪些能力必须留在 AI 领域层。
            </?01M05F1PCG392E67NEG7JDJWAR>
            <Acceptance [
              <Criterion { id = "T1.1-AC1" checked = true } ?01M05F1PCG392E67NEG7JDJWAS>
              平台微内核能力清单明确且不包含 AI 专属语义
              </?01M05F1PCG392E67NEG7JDJWAS>
              <Criterion { id = "T1.1-AC2" checked = true } ?01M05F1PCG392E67NEG7JDJWAT>
              AI 领域微内核能力清单明确且不被错误抽空
              </?01M05F1PCG392E67NEG7JDJWAT>
            ]>
          )>
          <Task { id = "T1.2" name = "冻结 vendor 原语复用策略与禁止事项" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PCG392E67NEG7JDJWAV>
            明确 vendor 复用原则、禁止重复造轮子、禁止空泛抽象等反模式。
            </?01M05F1PCG392E67NEG7JDJWAV>
            <Acceptance [
              <Criterion { id = "T1.2-AC1" checked = true } ?01M05F1PCG392E67NEG7JDJWAW>
              vendor actor/processor/data-graph 的职责归位明确
              </?01M05F1PCG392E67NEG7JDJWAW>
              <Criterion { id = "T1.2-AC2" checked = true } ?01M05F1PCG392E67NEG7JDJWAX>
              反模式与非目标被正式记录
              </?01M05F1PCG392E67NEG7JDJWAX>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "Contract And Package Design" status = "DONE" order = 1 } (
        <Description ?01M05F1PCG392E67NEG7JDJWAY>
        设计新的 contract / logic / support / mod / profile 边界。
        </?01M05F1PCG392E67NEG7JDJWAY>
        <SubNodes [
          <Task { id = "T2.1" name = "设计平台内核 contract 与 runtime facet" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PCG392E67NEG7JDJWAZ>
            定义平台级 runtime contract、capability ports、assembly contract 和 state facet。
            </?01M05F1PCG392E67NEG7JDJWAZ>
            <Acceptance [
              <Criterion { id = "T2.1-AC1" checked = true } ?01M05F1PCG392E67NEG7JDJWB0>
