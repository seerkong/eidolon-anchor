<Track #refactor-platform-kernel-and-ai-domain-kernel version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "形成平台微内核 + AI 领域微内核的正式分层设计，并制定可执行的增量迁移路径。" commit_mode = "manual" created_at = "2026-04-10T19:17:54Z" updated_at = "2026-04-11T12:48:00Z" } (
  <Ports { scope = "track" } [
