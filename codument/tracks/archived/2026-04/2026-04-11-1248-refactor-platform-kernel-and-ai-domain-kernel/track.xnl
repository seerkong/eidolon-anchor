              <Criterion { id = "T3.2-AC2" checked = true } ?01M05F1PCG392E67NEG7JDJWBB>
              support adoption 边界与缺失语义明确
              </?01M05F1PCG392E67NEG7JDJWBB>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P4 { name = "Migration And Verification Plan" status = "DONE" order = 3 } (
        <Description ?01M05F1PCG392E67NEG7JDJWBC>
