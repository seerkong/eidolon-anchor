<Track #add-ai-runtime-observability-rx-sinks version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "从 public RxData 派生可观测数据面并提供隔离的 sinks" commit_mode = "manual" created_at = "2026-04-26T14:17:03Z" updated_at = "2026-04-26T19:04:38Z" } (
