<Track #add-detached-actor-observability version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" description = "Add scoped running-time observability and terminal result queries for detached bash and detached delegate actor tasks." commit_mode = "manual" created_at = "2026-05-26T00:00:00Z" updated_at = "2026-05-26T06:22:48Z" } (
