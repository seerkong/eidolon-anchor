<BehaviorPatch #track.r_2_0_2_6_-_0_6_-_0_2_-_0_9_2_9_-_a_d_d_-_r_u_n_t_i_m_e_-_h_o_o_k_s_-_g_o_a_l_-_c_o_n_t_i_n_u_a_t_i_o_n.behavior_patch.ai-runtime-lifecycle-hooks apiVersion="codument.tech/v1alpha1" version="1" { capability = "ai-runtime-lifecycle-hooks" } (
  <Mutations [
    <Upsert { selector = "behavior://ai-runtime-lifecycle-hooks/requirements/lifecycle-hook-contract" } (
      <Requirement #lifecycle-hook-contract (
        <Statement ?01M05F1PEZFT1T1NB6VPKTTP2X>
        系统 SHALL 定义 AI runtime hook contract，用于通过现有 module extension/manifest 的 `hooks` 字段声明 Sparrow-aligned hook point、mode、matcher、priority、timeout、failure policy、标准组件 handler 与 result action。
        </?01M05F1PEZFT1T1NB6VPKTTP2X>
        <Suites [
          <Suite #contract-shape { name = "Contract shape" } (
            <Cases [
              <Case #descriptor-is-data [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP2Y>
                hook SHALL 写入现有 module extension/manifest 的 `hooks` 字段
                </?01M05F1PEZFT1T1NB6VPKTTP2Y>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP2Z>
                hook point SHALL be a string using `domain.action.phase` naming such as `actor.idle.before` or `tool.execute.after`
                </?01M05F1PEZFT1T1NB6VPKTTP2Z>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP30>
                hook SHALL 以数据 definition 表达 point、mode、name、extensionId、priority、matcher、timeoutMs、failOpen 与 handler component reference
                </?01M05F1PEZFT1T1NB6VPKTTP30>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP31>
                hook descriptor SHALL 能被 composer/runtime assembly 收集
                </?01M05F1PEZFT1T1NB6VPKTTP31>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP32>
                某个 module 需要扩展 runtime 生命周期
                </?01M05F1PEZFT1T1NB6VPKTTP32>
                <When ?01M05F1PEZFT1T1NB6VPKTTP33>
                它声明 lifecycle hook
                </?01M05F1PEZFT1T1NB6VPKTTP33>
              )>
              <Case #mode-and-action [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP34>
                mode SHALL be one of `observe`、`transform`、`decision`、`around`
                </?01M05F1PEZFT1T1NB6VPKTTP34>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP35>
                result action SHALL be one of `continue`、`replace`、`deny`、`ask`、`retry`、`stop`
                </?01M05F1PEZFT1T1NB6VPKTTP35>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP36>
                系统 SHALL NOT introduce a parallel enum-only lifecycle event model for hook points
                </?01M05F1PEZFT1T1NB6VPKTTP36>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP37>
                某个 hook definition 被声明
                </?01M05F1PEZFT1T1NB6VPKTTP37>
                <When ?01M05F1PEZFT1T1NB6VPKTTP38>
                runtime 校验该 hook definition
                </?01M05F1PEZFT1T1NB6VPKTTP38>
              )>
              <Case #result-is-effect-oriented [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP39>
                结果 SHALL 使用标准 action、payload/output/message/metadata 与可选 structured effects 表达需要 runtime 应用的副作用
                </?01M05F1PEZFT1T1NB6VPKTTP39>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP3A>
                hook handler SHALL NOT 直接绕过 actor mailbox 修改其他 actor 的内部状态
                </?01M05F1PEZFT1T1NB6VPKTTP3A>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP3B>
                hook handler 完成决策
                </?01M05F1PEZFT1T1NB6VPKTTP3B>
                <When ?01M05F1PEZFT1T1NB6VPKTTP3C>
                它返回结果
                </?01M05F1PEZFT1T1NB6VPKTTP3C>
              )>
              <Case #diagnostic-report-shape [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP3D>
                dispatcher SHALL emit a diagnostic report with event type `hook_dispatch_report`
                </?01M05F1PEZFT1T1NB6VPKTTP3D>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP3E>
                report SHALL include point、trace/session/actor context、final action、elapsed time、steps、payload 与 output
                </?01M05F1PEZFT1T1NB6VPKTTP3E>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP3F>
                dispatcher 完成一次 hook dispatch
                </?01M05F1PEZFT1T1NB6VPKTTP3F>
                <When ?01M05F1PEZFT1T1NB6VPKTTP3G>
                至少一个 hook 被 matched、failed、timed out 或 skipped by reentrancy
                </?01M05F1PEZFT1T1NB6VPKTTP3G>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://ai-runtime-lifecycle-hooks/requirements/organ-hook-dispatcher" } (
      <Requirement #organ-hook-dispatcher (
        <Statement ?01M05F1PEZFT1T1NB6VPKTTP3H>
        系统 SHALL 在 `ai-organ-logic` 中提供 hook dispatcher，负责匹配、排序、reentrancy guard、预算、timeout、错误策略、`hook_dispatch_report` diagnostics、标准组件 handler 调用与 result/effect 归一化。
        </?01M05F1PEZFT1T1NB6VPKTTP3H>
        <Suites [
          <Suite #dispatch-semantics { name = "Dispatch semantics" } (
            <Cases [
              <Case #matches-and-sorts [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP3J>
                dispatcher SHALL 只执行 point 与 matcher 匹配的 hooks
                </?01M05F1PEZFT1T1NB6VPKTTP3J>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP3K>
                dispatcher SHALL 按 phase、priority desc、extensionId、name 形成稳定顺序
                </?01M05F1PEZFT1T1NB6VPKTTP3K>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP3M>
                runtime assembly 中存在多个 enabled hook descriptors
                </?01M05F1PEZFT1T1NB6VPKTTP3M>
                <When ?01M05F1PEZFT1T1NB6VPKTTP3N>
                dispatcher 收到某个 lifecycle invocation
                </?01M05F1PEZFT1T1NB6VPKTTP3N>
              )>
              <Case #reentrant-skip [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP3P>
                dispatcher SHALL 跳过 reentrant invocation
                </?01M05F1PEZFT1T1NB6VPKTTP3P>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP3Q>
                dispatcher SHALL 记录 reentrant skipped diagnostic
                </?01M05F1PEZFT1T1NB6VPKTTP3Q>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP3R>
                某个 hook 正在同一 point 上执行
                </?01M05F1PEZFT1T1NB6VPKTTP3R>
                <When ?01M05F1PEZFT1T1NB6VPKTTP3S>
                hook 执行过程中再次触发相同 guard key 的 hook dispatch
                </?01M05F1PEZFT1T1NB6VPKTTP3S>
              )>
              <Case #timeout-and-failure-policy [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP3T>
                dispatcher SHALL 记录 failed 或 timed_out diagnostic
                </?01M05F1PEZFT1T1NB6VPKTTP3T>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP3V>
                dispatcher SHALL 根据 hook 的 failOpen 策略决定继续或停止本轮 dispatch
                </?01M05F1PEZFT1T1NB6VPKTTP3V>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP3W>
                hook 超时或抛错
                </?01M05F1PEZFT1T1NB6VPKTTP3W>
                <When ?01M05F1PEZFT1T1NB6VPKTTP3X>
                dispatcher 处理失败
                </?01M05F1PEZFT1T1NB6VPKTTP3X>
              )>
              <Case #handler-invoked-by-func-style-adapter [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP3Y>
                dispatcher SHALL use `depa-processor` `runByFuncStyleAdapter` to execute the hook handler component
                </?01M05F1PEZFT1T1NB6VPKTTP3Y>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP3Z>
                hook handler SHALL express outer input、derived、inner runtime、inner input、inner config、core logic 与 outer output through the standard component flow
                </?01M05F1PEZFT1T1NB6VPKTTP3Z>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP40>
                dispatcher 准备执行某个 matched hook handler
                </?01M05F1PEZFT1T1NB6VPKTTP40>
                <When ?01M05F1PEZFT1T1NB6VPKTTP41>
                dispatcher 调用该 handler
                </?01M05F1PEZFT1T1NB6VPKTTP41>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://ai-runtime-lifecycle-hooks/requirements/organ-hook-producer" } (
      <Requirement #organ-hook-producer (
        <Statement ?01M05F1PEZFT1T1NB6VPKTTP42>
        系统 SHALL 在 `ai-organ-logic` 中生产 lifecycle hook invocation，调用同包 lifecycle hook dispatcher，并在 runtime 串行 mutation 边界应用 hook effects。
        </?01M05F1PEZFT1T1NB6VPKTTP42>
        <Suites [
          <Suite #producer-boundaries { name = "Producer boundaries" } (
            <Cases [
              <Case #interactive-turn-finished-produces-idle-check (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP43>
                interactive turn 完成并清理 runtime active turn 标记
                </?01M05F1PEZFT1T1NB6VPKTTP43>
                <When ?01M05F1PEZFT1T1NB6VPKTTP44>
                runtime 进入可继续调度状态
                </?01M05F1PEZFT1T1NB6VPKTTP44>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP45>
                organ runtime SHALL 生产 lifecycle invocation 用于检查 runtime idle
                </?01M05F1PEZFT1T1NB6VPKTTP45>
              )>
              <Case #background-watchdog-produces-idle-check [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP46>
                organ runtime MAY 生产 runtime idle lifecycle invocation
                </?01M05F1PEZFT1T1NB6VPKTTP46>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP47>
                watchdog SHALL NOT 直接调用具体 goal continuation 逻辑
                </?01M05F1PEZFT1T1NB6VPKTTP47>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP48>
                没有前台 turn 正在运行
                </?01M05F1PEZFT1T1NB6VPKTTP48>
                <When ?01M05F1PEZFT1T1NB6VPKTTP49>
                background watchdog tick 发生
                </?01M05F1PEZFT1T1NB6VPKTTP49>
              )>
              <Case #effects-apply-through-driver [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP4A>
                effects SHALL 通过 orchestrator driver 和 actor mailbox 机制应用
                </?01M05F1PEZFT1T1NB6VPKTTP4A>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP4B>
                effect application SHALL 发生在 coordinator 串行 enqueue 边界内
                </?01M05F1PEZFT1T1NB6VPKTTP4B>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP4C>
                hook dispatcher 返回 mailbox enqueue 或 resume fiber effect
                </?01M05F1PEZFT1T1NB6VPKTTP4C>
                <When ?01M05F1PEZFT1T1NB6VPKTTP4D>
                organ runtime 应用 effects
                </?01M05F1PEZFT1T1NB6VPKTTP4D>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://ai-runtime-lifecycle-hooks/requirements/high-frequency-idle-orchestration" } (
      <Requirement #high-frequency-idle-orchestration (
        <Statement ?01M05F1PEZFT1T1NB6VPKTTP4E>
        系统 SHALL 对高频 `actor.idle.before` hook point 使用确定性、受预算约束、可重检状态的编排方式，避免多个 hooks 同时基于过期 idle 状态产生冲突 effects。
        </?01M05F1PEZFT1T1NB6VPKTTP4E>
        <Suites [
          <Suite #idle-cycle { name = "Idle cycle orchestration" } (
            <Cases [
              <Case #sequential-with-state-recheck [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP4F>
                dispatcher 或 producer SHALL 基于最新 VM/driver state 重建 idle snapshot
                </?01M05F1PEZFT1T1NB6VPKTTP4F>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP4G>
                如果 runtime 已不再 idle，本轮 idle dispatch SHALL 停止
                </?01M05F1PEZFT1T1NB6VPKTTP4G>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP4H>
                同一 idle cycle 中有多个 `actor.idle.before` hooks 匹配
                </?01M05F1PEZFT1T1NB6VPKTTP4H>
                <When ?01M05F1PEZFT1T1NB6VPKTTP4J>
                dispatcher 准备执行下一个 idle hook
                </?01M05F1PEZFT1T1NB6VPKTTP4J>
              )>
              <Case #stop-action-stops-current-idle-dispatch [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP4K>
                dispatcher SHALL stop subsequent hooks in the current `actor.idle.before` dispatch
                </?01M05F1PEZFT1T1NB6VPKTTP4K>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP4M>
                如果 hook 返回 `continue` 或 `replace`，dispatcher SHALL 按标准结果合并规则继续或应用 payload/output/effect
                </?01M05F1PEZFT1T1NB6VPKTTP4M>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP4N>
                某个 idle hook 返回 `stop` action
                </?01M05F1PEZFT1T1NB6VPKTTP4N>
                <When ?01M05F1PEZFT1T1NB6VPKTTP4P>
                dispatcher 处理该 hook result
                </?01M05F1PEZFT1T1NB6VPKTTP4P>
              )>
              <Case #budgeted-idle-cycle [
                <Then ?01M05F1PEZFT1T1NB6VPKTTP4Q>
                dispatcher SHALL 停止本轮 dispatch
                </?01M05F1PEZFT1T1NB6VPKTTP4Q>
                <Then ?01M05F1PEZFT1T1NB6VPKTTP4R>
                dispatcher SHALL 发出 budget exhausted diagnostic
                </?01M05F1PEZFT1T1NB6VPKTTP4R>
              ] (
                <Given ?01M05F1PEZFT1T1NB6VPKTTP4S>
                idle hook list 很长或某些 hook 执行较慢
                </?01M05F1PEZFT1T1NB6VPKTTP4S>
                <When ?01M05F1PEZFT1T1NB6VPKTTP4T>
                本轮 idle dispatch 达到最大 hook 数或总耗时预算
                </?01M05F1PEZFT1T1NB6VPKTTP4T>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
