<Track #add-runtime-hooks-goal-continuation version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "添加 Runtime Lifecycle Hook 并改造 Goal Continuation" description = "添加 module manifest/profile hook extension type，在 ai-organ-logic 实现 Sparrow-aligned hook producer 与 dispatcher，让 mod-ai-kernel/mod-ai-coding 通过 hooks 字段贡献 hook，并基于 actor.idle.before hook 改造 goal 自动续接。" commit_mode = "manual" created_at = "2026-06-01T17:21:15Z" updated_at = "2026-06-02T01:29:52Z" } (
