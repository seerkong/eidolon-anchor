<Track #add-runtime-snapshot-safepoints version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" description = "为 runtime 快照保存引入 safepoint 语义，确保保存完成后进程可立即崩溃并恢复到可用状态；同时消费 tool-call 协议关键 continuation。" commit_mode = "manual" created_at = "2026-06-04T16:00:00Z" updated_at = "2026-06-05T04:30:00Z" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
    <MaterialBundle { role = "output" name = "docs" domain = "doc" path = "vfs://@/docs/" }>
    <MaterialBundle { role = "output" name = "behavior" domain = "codument" path = "vfs://@/codument/behaviors/" }>
  ]>
  <TaskSpace #space_add-runtime-snapshot-safepoints { name = "add-runtime-snapshot-safepoints" } (
    <SubNodes [
      <TaskGroup #P1 { name = "复现与规格化 Safepoint 判定" status = "DONE" order = 0 } (
        <SubNodes [
          <Task { id = "T1.1" name = "编写非 safepoint tool-call 快照回归测试" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PFR055V1X4CHYTE30CX>
            构造 assistant tool call 已入 history 但 `start_tool` 尚未创建 durable tool operation 的状态，验证它不能作为 latest recoverable snapshot。
            </?01M05F1PFR055V1X4CHYTE30CX>
            <Acceptance [
              <Criterion #AC-start-tool-fixture { checked = true } ?01M05F1PFR055V1X4CHYTE30CY>
              测试 fixture 覆盖 `ready + start_tool + unmatched assistant tool call + no durable tool op`
              </?01M05F1PFR055V1X4CHYTE30CY>
              <Criterion #AC-current-fails { checked = true } ?01M05F1PFR055V1X4CHYTE30CZ>
              在实现前测试能暴露当前行为缺口
              </?01M05F1PFR055V1X4CHYTE30CZ>
            ]>
          )>
          <Task { id = "T1.2" name = "实现 snapshot safepoint checker" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PFR055V1X4CHYTE30D0>
            新增可测试的 safepoint 判定逻辑，报告 blocking fiber、phase、reason 和协议一致性问题。
            </?01M05F1PFR055V1X4CHYTE30D0>
            <Acceptance [
              <Criterion #AC-checker-detects-start-tool { checked = true } ?01M05F1PFR055V1X4CHYTE30D1>
              checker 能识别 `start_tool` 半步状态为非 safepoint
              </?01M05F1PFR055V1X4CHYTE30D1>
              <Criterion #AC-checker-allows-durable-tool-wait { checked = true } ?01M05F1PFR055V1X4CHYTE30D2>
              checker 允许已有 durable tool operation 或 typed wait 的 tool-call 状态
              </?01M05F1PFR055V1X4CHYTE30D2>
              <Criterion #AC-diagnostics-bounded { checked = true } ?01M05F1PFR055V1X4CHYTE30D3>
              safepoint blocker 不包含 provider-private content 或大 payload
              </?01M05F1PFR055V1X4CHYTE30D3>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "保存路径与调度边界改造" status = "DONE" order = 1 } (
        <SubNodes [
          <Task { id = "T2.1" name = "接入 safepoint-aware snapshot save" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PFR055V1X4CHYTE30D4>
            修改 snapshot save 流程：保存前校验 safepoint，非 safepoint 时受限推进，仍不安全则跳过保存并保留 previous known-good snapshot。
            </?01M05F1PFR055V1X4CHYTE30D4>
            <Acceptance [
              <Criterion #AC-save-guards-latest { checked = true } ?01M05F1PFR055V1X4CHYTE30D5>
              非 safepoint 状态不会覆盖 latest recoverable snapshot
              </?01M05F1PFR055V1X4CHYTE30D5>
              <Criterion #AC-progress-or-skip { checked = true } ?01M05F1PFR055V1X4CHYTE30D6>
              保存路径会受限推进或跳过保存，不会无限等待
              </?01M05F1PFR055V1X4CHYTE30D6>
              <Criterion #AC-diagnostic-emitted { checked = true } ?01M05F1PFR055V1X4CHYTE30D7>
              跳过或延迟保存时返回明确 safepoint blocker
              </?01M05F1PFR055V1X4CHYTE30D7>
            ]>
          )>
          <Task { id = "T2.2" name = "调整 mandatory continuation settling" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PFR055V1X4CHYTE30D8>
            让 foreground/all-lane settle 在 snapshot 语义下消费 `start_tool` 等 mandatory continuation，直到 durable operation 或 typed wait。
            </?01M05F1PFR055V1X4CHYTE30D8>
            <Acceptance [
              <Criterion #AC-ready-start-tool-not-settled { checked = true } ?01M05F1PFR055V1X4CHYTE30D9>
              `ready + start_tool` 不再被视为 snapshot-safe settled
              </?01M05F1PFR055V1X4CHYTE30D9>
              <Criterion #AC-agent-step-consumed { checked = true } ?01M05F1PFR055V1X4CHYTE30DA>
