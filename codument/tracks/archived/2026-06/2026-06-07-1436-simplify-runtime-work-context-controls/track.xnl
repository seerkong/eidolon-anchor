              </?01M05F1PGE5D1BQX71BFS1WMMC>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "model controlled task phase" status = "DONE" order = 2 } (
        <SubNodes [
          <Task { id = "T3.1" name = "添加 task phase control tool tests" status = "DONE" order = 0 priority = "P0" } (
