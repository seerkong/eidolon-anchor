<Track #simplify-runtime-work-context-controls version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "将 AI runtime work context 收敛为手动 work mode 和模型 tool-call task phase，删除旧自动推断和调用次数逻辑。" description = "WorkMode 收敛为 build/plan，默认 build 并通过 /work-mode 手动切换；TaskPhase 收敛为 normal/answer，并通过模型内部 tool call 切换。" commit_mode = "manual" created_at = "2026-06-07T04:11:10Z" updated_at = "2026-06-07T06:36:00Z" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
    <MaterialBundle { role = "output" name = "docs" domain = "doc" path = "vfs://@/docs/" }>
    <MaterialBundle { role = "output" name = "behavior" domain = "codument" path = "vfs://@/codument/behaviors/" }>
  ]>
  <TaskSpace #space_simplify-runtime-work-context-controls { name = "simplify-runtime-work-context-controls" } (
    <Description ?01M05F1PGE5D1BQX71BFS1WMKV>
