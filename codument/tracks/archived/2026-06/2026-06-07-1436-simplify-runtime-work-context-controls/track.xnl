              </?01M05F1PGE5D1BQX71BFS1WMKY>
              <Criterion #AC-default-state-test { checked = true } ?01M05F1PGE5D1BQX71BFS1WMKZ>
              测试覆盖新 actor 或迁移 actor 默认 build/normal
              </?01M05F1PGE5D1BQX71BFS1WMKZ>
            ]>
          )>
          <Task { id = "T1.2" name = "收敛 ContextControl contract 类型" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PGE5D1BQX71BFS1WMM0>
            修改 runtime context control 类型定义，删除旧枚举并更新相关 snapshot/recovery normalization。
            </?01M05F1PGE5D1BQX71BFS1WMM0>
            <Acceptance [
              <Criterion #AC-contract-types-simplified { checked = true } ?01M05F1PGE5D1BQX71BFS1WMM1>
              WorkMode 与 TaskPhase 类型只包含目标枚举
              </?01M05F1PGE5D1BQX71BFS1WMM1>
              <Criterion #AC-old-values-normalized { checked = true } ?01M05F1PGE5D1BQX71BFS1WMM2>
              恢复或升级旧值时归一化为 build/normal
              </?01M05F1PGE5D1BQX71BFS1WMM2>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "manual work mode control" status = "DONE" order = 1 } (
        <SubNodes [
          <Task { id = "T2.1" name = "添加 /work-mode slash command tests" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PGE5D1BQX71BFS1WMM3>
