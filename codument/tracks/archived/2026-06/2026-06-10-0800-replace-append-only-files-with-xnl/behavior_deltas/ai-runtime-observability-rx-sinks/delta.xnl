<BehaviorPatch #track.r_2_0_2_6_-_0_6_-_1_0_-_0_8_0_0_-_r_e_p_l_a_c_e_-_a_p_p_e_n_d_-_o_n_l_y_-_f_i_l_e_s_-_w_i_t_h_-_x_n_l.behavior_patch.ai-runtime-observability-rx-sinks apiVersion="codument.tech/v1alpha1" version="1" { capability = "ai-runtime-observability-rx-sinks" } (
  <Mutations [
    <Upsert { selector = "behavior://ai-runtime-observability-rx-sinks/requirements/xnl-file-sink-record-streams" } (
      <Requirement #xnl-file-sink-record-streams (
        <Statement ?01M05F1PGPKZKFS8W81HZWGDPY>
        系统 SHALL persist observability XNL file sinks according to the same append-only versus replace-state classification used by session persistence.
        </?01M05F1PGPKZKFS8W81HZWGDPY>
        <KnowledgeHint { target = "docs" href = "knowledge://docs/ai-runtime-observability-rx-sinks/xnl-file-sink-record-streams" strength = "hint" }>
        <Suites [
          <Suite #trace-xnl { name = "Trace XNL sinks" } (
            <Cases [
              <Case #session-trace-xnl-append-only [
                <Then ?01M05F1PGPKZKFS8W81HZWGDPZ>
                The sink SHALL append one complete top-level `TraceEntry` XNL trace record per event
                </?01M05F1PGPKZKFS8W81HZWGDPZ>
                <Then ?01M05F1PGPKZKFS8W81HZWGDQ0>
                The sink SHALL NOT rewrite a growing root wrapper for trace history
                </?01M05F1PGPKZKFS8W81HZWGDQ0>
                <Then ?01M05F1PGPKZKFS8W81HZWGDQ1>
                `TraceEntry` SHALL include `traceKind` metadata to distinguish observability trace from graph trace when both producers share the tag
                </?01M05F1PGPKZKFS8W81HZWGDQ1>
                <Then ?01M05F1PGPKZKFS8W81HZWGDQ2>
                Single typed children such as `Payload`, `Error`, or `Value` SHALL use `()`; multiple typed children SHALL use `[]`
                </?01M05F1PGPKZKFS8W81HZWGDQ2>
              ] (
                <Given ?01M05F1PGPKZKFS8W81HZWGDQ3>
                An observability trace sink writes records to `sessions/&lt;sessionId&gt;/trace.xnl` or a caller-provided `trace.xnl` path
                </?01M05F1PGPKZKFS8W81HZWGDQ3>
                <When ?01M05F1PGPKZKFS8W81HZWGDQ4>
                A trace record is flushed
                </?01M05F1PGPKZKFS8W81HZWGDQ4>
              )>
            ]>
          )>
          <Suite #scene-xnl { name = "Scene XNL sinks" } (
            <Cases [
              <Case #scene-store-location [
                <Then ?01M05F1PGPKZKFS8W81HZWGDQ5>
                The files SHALL be placed under `.eidolon/scenes/&lt;sessionId&gt;/`
                </?01M05F1PGPKZKFS8W81HZWGDQ5>
                <Then ?01M05F1PGPKZKFS8W81HZWGDQ6>
                The store SHALL NOT create workspace-root `scenes/` data directories as normal project output
                </?01M05F1PGPKZKFS8W81HZWGDQ6>
              ] (
                <Given ?01M05F1PGPKZKFS8W81HZWGDQ7>
                A SceneStore persists replay or observability XNL files in a project workspace
                </?01M05F1PGPKZKFS8W81HZWGDQ7>
                <When ?01M05F1PGPKZKFS8W81HZWGDQ8>
                The store resolves its root directory
                </?01M05F1PGPKZKFS8W81HZWGDQ8>
              )>
              <Case #scene-events-xnl-append-only [
                <Then ?01M05F1PGPKZKFS8W81HZWGDQ9>
                The event SHALL be appended as one complete top-level `SceneMessage` XNL element
                </?01M05F1PGPKZKFS8W81HZWGDQ9>
                <Then ?01M05F1PGPKZKFS8W81HZWGDQA>
                `SceneMessage` SHALL include `version`, `sequence`, `id`, `sessionId`, and `role` metadata
                </?01M05F1PGPKZKFS8W81HZWGDQA>
                <Then ?01M05F1PGPKZKFS8W81HZWGDQB>
                Ordered `TextPart` and `ToolCall` children SHALL use `[]` even when a message currently has one text part
                </?01M05F1PGPKZKFS8W81HZWGDQB>
              ] (
                <Given ?01M05F1PGPKZKFS8W81HZWGDQC>
                A scene store records turn or scene events
                </?01M05F1PGPKZKFS8W81HZWGDQC>
                <When ?01M05F1PGPKZKFS8W81HZWGDQD>
                An event is persisted to `.eidolon/scenes/&lt;sessionId&gt;/events.xnl`
                </?01M05F1PGPKZKFS8W81HZWGDQD>
              )>
              <Case #scene-manifest-xnl-replace-state [
                <Then ?01M05F1PGPKZKFS8W81HZWGDQE>
                The manifest MAY be replace-written as a `SceneManifest` because it is bounded scene state rather than event history
                </?01M05F1PGPKZKFS8W81HZWGDQE>
                <Then ?01M05F1PGPKZKFS8W81HZWGDQF>
                The manifest SHALL NOT contain the growing event log
                </?01M05F1PGPKZKFS8W81HZWGDQF>
                <Then ?01M05F1PGPKZKFS8W81HZWGDQG>
                `SceneManifest` SHALL contain typed children such as `SystemPrompt` and `ToolDefs` using `[]`
                </?01M05F1PGPKZKFS8W81HZWGDQG>
              ] (
                <Given ?01M05F1PGPKZKFS8W81HZWGDQH>
                A scene store persists `.eidolon/scenes/&lt;sessionId&gt;/manifest.xnl`
                </?01M05F1PGPKZKFS8W81HZWGDQH>
                <When ?01M05F1PGPKZKFS8W81HZWGDQJ>
                The manifest is saved
                </?01M05F1PGPKZKFS8W81HZWGDQJ>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
