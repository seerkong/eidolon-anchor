<BehaviorPatch #track.r_2_0_2_6_-_0_6_-_1_1_-_1_0_0_0_-_r_e_f_a_c_t_o_r_-_r_u_n_t_i_m_e_-_p_r_o_f_i_l_e_-_c_a_p_a_b_i_l_i_t_y_-_b_o_u_n_d_a_r_y.behavior_patch.runtime-profile-capability-boundary apiVersion="codument.tech/v1alpha1" version="1" { capability = "runtime-profile-capability-boundary" } (
  <Mutations [
    <Upsert { selector = "behavior://runtime-profile-capability-boundary/requirements/single-profile-composition-entry" } (
      <Requirement #single-profile-composition-entry (
        <Statement ?01M05F1PH0ZTHNG9P5QJ6RZRZ1>
        系统 SHALL 通过单一 profile composition path 创建 CLI、TUI 和 headless runtime。
        </?01M05F1PH0ZTHNG9P5QJ6RZRZ1>
        <Suites [
          <Suite #entry-composition { name = "Entry composition" } (
            <Cases [
              <Case #same-profile-same-binding (
                <Given ?01M05F1PH0ZTHNG9P5QJ6RZRZ2>
                CLI、TUI 和 headless 使用同一个 runtime profile
                </?01M05F1PH0ZTHNG9P5QJ6RZRZ2>
                <When ?01M05F1PH0ZTHNG9P5QJ6RZRZ3>
                系统创建 runtime binding descriptor
                </?01M05F1PH0ZTHNG9P5QJ6RZRZ3>
                <Then ?01M05F1PH0ZTHNG9P5QJ6RZRZ4>
                三个入口 SHALL 生成兼容的 profile、capability 和 storage binding 描述
                </?01M05F1PH0ZTHNG9P5QJ6RZRZ4>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://runtime-profile-capability-boundary/requirements/surface-entry-no-domain-truth" } (
      <Requirement #surface-entry-no-domain-truth (
        <Statement ?01M05F1PH0ZTHNG9P5QJ6RZRZ5>
        Product surface SHALL NOT 直接定义 AI domain truth、provider/tool/conversation 默认语义或 domain fact writer。
        </?01M05F1PH0ZTHNG9P5QJ6RZRZ5>
        <Suites [
          <Suite #surface-boundary { name = "Surface boundary" } (
            <Cases [
              <Case #surface-selects-profile-only [
                <Then ?01M05F1PH0ZTHNG9P5QJ6RZRZ6>
                entry SHALL 只选择 profile 并提供 surface adapter
                </?01M05F1PH0ZTHNG9P5QJ6RZRZ6>
                <Then ?01M05F1PH0ZTHNG9P5QJ6RZRZ7>
                entry SHALL NOT 私有创建 provider、tool、conversation 或 history owner
                </?01M05F1PH0ZTHNG9P5QJ6RZRZ7>
              ] (
                <Given ?01M05F1PH0ZTHNG9P5QJ6RZRZ8>
                一个 product surface entry 需要启动 AI runtime
                </?01M05F1PH0ZTHNG9P5QJ6RZRZ8>
                <When ?01M05F1PH0ZTHNG9P5QJ6RZRZ9>
                entry 初始化 runtime
                </?01M05F1PH0ZTHNG9P5QJ6RZRZ9>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://runtime-profile-capability-boundary/requirements/runtime-storage-capability-flags" } (
      <Requirement #runtime-storage-capability-flags (
        <Statement ?01M05F1PH0ZTHNG9P5QJ6RZRZA>
        Runtime storage capabilities SHALL 显式表达 logs/files 开关，关闭持久化文件写入不得阻止 memory-only AI loop。
        </?01M05F1PH0ZTHNG9P5QJ6RZRZA>
        <Suites [
          <Suite #storage-capability { name = "Storage capability" } (
            <Cases [
              <Case #memory-only-loop [
                <Then ?01M05F1PH0ZTHNG9P5QJ6RZRZB>
                AI loop SHALL 可以在 memory-only profile 下完成
                </?01M05F1PH0ZTHNG9P5QJ6RZRZB>
                <Then ?01M05F1PH0ZTHNG9P5QJ6RZRZC>
                系统 SHALL NOT 因 session 文件写入关闭而停止主流程
                </?01M05F1PH0ZTHNG9P5QJ6RZRZC>
              ] (
                <Given ?01M05F1PH0ZTHNG9P5QJ6RZRZD>
                runtime profile 禁用 logs 和 files storage capabilities
                </?01M05F1PH0ZTHNG9P5QJ6RZRZD>
                <When ?01M05F1PH0ZTHNG9P5QJ6RZRZE>
                用户发起普通对话
                </?01M05F1PH0ZTHNG9P5QJ6RZRZE>
              )>
              <Case #shared-upgrade-capability [
                <Then ?01M05F1PH0ZTHNG9P5QJ6RZRZF>
                TUI SHALL 调用共享 upgrade capability
                </?01M05F1PH0ZTHNG9P5QJ6RZRZF>
                <Then ?01M05F1PH0ZTHNG9P5QJ6RZRZG>
                TUI SHALL NOT 实现私有 session migration 语义
                </?01M05F1PH0ZTHNG9P5QJ6RZRZG>
              ] (
                <Given ?01M05F1PH0ZTHNG9P5QJ6RZRZH>
                TUI session picker 加载需要升级的旧 session
                </?01M05F1PH0ZTHNG9P5QJ6RZRZH>
                <When ?01M05F1PH0ZTHNG9P5QJ6RZRZJ>
                用户确认升级
                </?01M05F1PH0ZTHNG9P5QJ6RZRZJ>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
