<decision #track.refactor-runtime-profile-capability-boundary.d1 apiVersion="codument.tech/v1alpha1" { status = "accepted" priority = "P0" durable_candidate = false } (
  <question ?>
profile/capability contract 的宿主与组合路径
  </?>
  <options { } [
    <option { key = "A" recommended = true } (
      <title ?>
profile/capability contract 与组合实现收敛到现有 `mod-profiles` + `ai-composer`，必要时在其上扩展
      </?>
      <description ?>
profile/capability contract 与组合实现收敛到现有 `mod-profiles` + `ai-composer`，必要时在其上扩展
      </?>
    )>
    <option { key = "B" recommended = false } (
      <title ?>
新建独立的 profile/capability 包
      </?>
      <description ?>
新建独立的 profile/capability 包
      </?>
