<BehaviorPatch #track.r_2_0_2_6_-_0_6_-_1_2_-_0_2_3_0_-_r_e_s_t_r_u_c_t_u_r_e_-_c_o_n_t_r_o_l_-_p_l_a_n_e_-_l_o_g_i_c_-_c_a_p_s_u_l_e_s.behavior_patch.control-plane-logic-capsules apiVersion="codument.tech/v1alpha1" version="1" { capability = "control-plane-logic-capsules" } (
  <Mutations [
    <Upsert { selector = "behavior://control-plane-logic-capsules/requirements/capsule-structure" } (
      <Requirement #capsule-structure (
        <Statement ?01M05F1PHC3W1A1WFSSBHVDGH0>
        每个控制面 logic 集群 SHALL 以 capsule 形态组织：一个稳定的 core logic 入口（output = fn(runtime, input, config) 或 fn(input, config)）、对每个存在的适配轴一个以枚举 id 布线 adapter 的 adapter registry（adapter 实现 MAY 由 support/composer 包在组装时注册，与类型留在 contract 包同理按包级分离落位；当前无适配轴的集群 MAY 省略 registry）、以及不可被外部 import 的 internals。capsule config SHALL 为强类型且只携带 adapter 枚举 id 与少量静态策略，SHALL NOT 携带函数对象或重复 runtime 已有字段。类型 SHALL 只定义在对应 contract 包中，logic 包 SHALL NOT 复制类型定义。
        </?01M05F1PHC3W1A1WFSSBHVDGH0>
        <Suites [
          <Suite #capsule-shape { name = "Capsule structure" } (
            <Cases [
              <Case #stable-core-logic-entry [
                <Then ?01M05F1PHC3W1A1WFSSBHVDGH1>
                调用方 SHALL 只通过 core logic 入口传入 (runtime, input, config)
                </?01M05F1PHC3W1A1WFSSBHVDGH1>
                <Then ?01M05F1PHC3W1A1WFSSBHVDGH2>
                调用方 SHALL NOT 通过 config 传入函数对象、controller 或 runtime
                </?01M05F1PHC3W1A1WFSSBHVDGH2>
              ] (
                <Given ?01M05F1PHC3W1A1WFSSBHVDGH3>
                一个控制面集群已重构为 capsule
                </?01M05F1PHC3W1A1WFSSBHVDGH3>
                <When ?01M05F1PHC3W1A1WFSSBHVDGH4>
                调用方使用该集群能力
                </?01M05F1PHC3W1A1WFSSBHVDGH4>
              )>
              <Case #adapters-wired-by-enum (
                <Given ?01M05F1PHC3W1A1WFSSBHVDGH5>
                capsule 需要选择某个适配轴的实现
                </?01M05F1PHC3W1A1WFSSBHVDGH5>
                <When ?01M05F1PHC3W1A1WFSSBHVDGH6>
                core logic 解析 config
                </?01M05F1PHC3W1A1WFSSBHVDGH6>
                <Then ?01M05F1PHC3W1A1WFSSBHVDGH7>
                adapter SHALL 经 adapter registry 按枚举 id 解析
                </?01M05F1PHC3W1A1WFSSBHVDGH7>
              )>
              <Case #internals-not-imported (
                <Given ?01M05F1PHC3W1A1WFSSBHVDGH8>
                capsule 的 internals 目录存在私有 helper
                </?01M05F1PHC3W1A1WFSSBHVDGH8>
                <When ?01M05F1PHC3W1A1WFSSBHVDGH9>
                检查 capsule 外部的 import
                </?01M05F1PHC3W1A1WFSSBHVDGH9>
                <Then ?01M05F1PHC3W1A1WFSSBHVDGHA>
                SHALL NOT 存在来自 capsule 外部对 internals 的 import
                </?01M05F1PHC3W1A1WFSSBHVDGHA>
              )>
              <Case #types-stay-in-contract [
                <Then ?01M05F1PHC3W1A1WFSSBHVDGHB>
                类型 SHALL 定义于对应 contract 包并被 logic 包 import
                </?01M05F1PHC3W1A1WFSSBHVDGHB>
                <Then ?01M05F1PHC3W1A1WFSSBHVDGHC>
                logic 包 SHALL NOT 重新定义同名类型
                </?01M05F1PHC3W1A1WFSSBHVDGHC>
              ] (
                <Given ?01M05F1PHC3W1A1WFSSBHVDGHD>
                capsule 需要 input/output/config/state 类型
                </?01M05F1PHC3W1A1WFSSBHVDGHD>
                <When ?01M05F1PHC3W1A1WFSSBHVDGHE>
                检查类型定义位置
                </?01M05F1PHC3W1A1WFSSBHVDGHE>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://control-plane-logic-capsules/requirements/derivation-contract" } (
      <Requirement #derivation-contract (
        <Statement ?01M05F1PHC3W1A1WFSSBHVDGHF>
        三个控制面集群的 reducer/projection 加工定义 SHALL 提升为 contract 包中的类型化 derivation contract：声明 initialize/reduce/project/decide 等必需方法集合，并提供运行时断言 helper。流转布线 SHALL 复用既有 vendor/platform 原语并注入 derivation 实现；SHALL NOT 新建平行的 store、scheduler 或 dispatch 框架。
        </?01M05F1PHC3W1A1WFSSBHVDGHF>
        <Suites [
          <Suite #derivation { name = "Derivation contract" } (
            <Cases [
              <Case #derivation-methods-asserted (
                <Given ?01M05F1PHC3W1A1WFSSBHVDGHG>
                一个 derivation 实现缺少必需方法
                </?01M05F1PHC3W1A1WFSSBHVDGHG>
                <When ?01M05F1PHC3W1A1WFSSBHVDGHH>
                实现被注入流转布线
                </?01M05F1PHC3W1A1WFSSBHVDGHH>
                <Then ?01M05F1PHC3W1A1WFSSBHVDGHJ>
                运行时断言 SHALL 以明确错误失败，指出缺失方法名
                </?01M05F1PHC3W1A1WFSSBHVDGHJ>
              )>
              <Case #derivation-is-pure (
                <Given ?01M05F1PHC3W1A1WFSSBHVDGHK>
                derivation contract 声明的 reduce/project 方法
                </?01M05F1PHC3W1A1WFSSBHVDGHK>
                <When ?01M05F1PHC3W1A1WFSSBHVDGHM>
                检查其实现源码
                </?01M05F1PHC3W1A1WFSSBHVDGHM>
                <Then ?01M05F1PHC3W1A1WFSSBHVDGHN>
                实现 SHALL 是显式 state 上的纯函数，SHALL NOT 直接执行 IO
                </?01M05F1PHC3W1A1WFSSBHVDGHN>
              )>
              <Case #flow-wiring-reuses-primitives [
                <Then ?01M05F1PHC3W1A1WFSSBHVDGHP>
                布线 SHALL 复用既有 vendor/platform 原语
                </?01M05F1PHC3W1A1WFSSBHVDGHP>
                <Then ?01M05F1PHC3W1A1WFSSBHVDGHQ>
                SHALL NOT 在控制面本地定义平行的 store/scheduler/dispatch 框架
                </?01M05F1PHC3W1A1WFSSBHVDGHQ>
              ] (
                <Given ?01M05F1PHC3W1A1WFSSBHVDGHR>
                derivation 需要事件流、信号或投影布线
                </?01M05F1PHC3W1A1WFSSBHVDGHR>
                <When ?01M05F1PHC3W1A1WFSSBHVDGHS>
                检查布线实现
                </?01M05F1PHC3W1A1WFSSBHVDGHS>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://control-plane-logic-capsules/requirements/behavior-preservation" } (
      <Requirement #behavior-preservation (
        <Statement ?01M05F1PHC3W1A1WFSSBHVDGHT>
        本重构 SHALL 行为保持：runtime-control-component-boundaries 能力的全部 conformance SHALL 持续通过；既有失败基线 SHALL NOT 增长；调用方表面 SHALL 经兼容导出继续工作；boundary declaration 与 conformance 的源码映射 SHALL 随文件移动同步更新。
        </?01M05F1PHC3W1A1WFSSBHVDGHT>
        <Suites [
          <Suite #preservation { name = "Behavior preservation" } (
            <Cases [
              <Case #predecessor-conformance-stays-green (
                <Given ?01M05F1PHC3W1A1WFSSBHVDGHV>
                任一集群完成 capsule 重构
                </?01M05F1PHC3W1A1WFSSBHVDGHV>
                <When ?01M05F1PHC3W1A1WFSSBHVDGHW>
                运行 runtime-control-component-boundaries 的全部 conformance
                </?01M05F1PHC3W1A1WFSSBHVDGHW>
                <Then ?01M05F1PHC3W1A1WFSSBHVDGHX>
                conformance SHALL 全部通过
                </?01M05F1PHC3W1A1WFSSBHVDGHX>
              )>
              <Case #failure-baseline-does-not-grow (
                <Given ?01M05F1PHC3W1A1WFSSBHVDGHY>
                重构前已记录既有失败基线
                </?01M05F1PHC3W1A1WFSSBHVDGHY>
                <When ?01M05F1PHC3W1A1WFSSBHVDGHZ>
                重构后运行同一测试集
                </?01M05F1PHC3W1A1WFSSBHVDGHZ>
                <Then ?01M05F1PHC3W1A1WFSSBHVDGJ0>
                失败集合 SHALL 是基线的子集
                </?01M05F1PHC3W1A1WFSSBHVDGJ0>
              )>
              <Case #boundary-maps-updated (
                <Given ?01M05F1PHC3W1A1WFSSBHVDGJ1>
                集群源码文件因 capsule 化而移动
                </?01M05F1PHC3W1A1WFSSBHVDGJ1>
                <When ?01M05F1PHC3W1A1WFSSBHVDGJ2>
                检查 boundary declaration 与 encapsulation conformance 的源码映射
                </?01M05F1PHC3W1A1WFSSBHVDGJ2>
                <Then ?01M05F1PHC3W1A1WFSSBHVDGJ3>
                映射 SHALL 指向移动后的真实文件与符号
                </?01M05F1PHC3W1A1WFSSBHVDGJ3>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://control-plane-logic-capsules/requirements/guardrail-disposition-recorded" } (
      <Requirement #guardrail-disposition-recorded (
        <Statement ?01M05F1PHC3W1A1WFSSBHVDGJ4>
        AiRuntimeTurnSupervisor 在实施中被证实已接线进 live turn 主路径（hint 注入与强制 continuation），其移除属于行为变更，SHALL NOT 在本能力（纯结构重构）内执行；其移除 SHALL 作为 turn/tool/provider lifecycle 能力的显式输入记录，且本能力期间 SHALL NOT 扩展该 guardrail。
        </?01M05F1PHC3W1A1WFSSBHVDGJ4>
        <Suites [
          <Suite #disposition { name = "Guardrail disposition" } (
            <Cases [
              <Case #supervisor-kept-but-frozen [
                <Then ?01M05F1PHC3W1A1WFSSBHVDGJ5>
                supervisor 行为 SHALL 与重构前一致（不删除、不扩展）
                </?01M05F1PHC3W1A1WFSSBHVDGJ5>
                <Then ?01M05F1PHC3W1A1WFSSBHVDGJ6>
                其移除计划 SHALL 记录于 track 决策与后续 lifecycle track 输入
                </?01M05F1PHC3W1A1WFSSBHVDGJ6>
              ] (
                <Given ?01M05F1PHC3W1A1WFSSBHVDGJ7>
                driver 集群完成 capsule 重构
                </?01M05F1PHC3W1A1WFSSBHVDGJ7>
                <When ?01M05F1PHC3W1A1WFSSBHVDGJ8>
                检查 supervisor 相关源码与本 track 改动
                </?01M05F1PHC3W1A1WFSSBHVDGJ8>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
