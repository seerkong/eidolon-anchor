<Track #restructure-control-plane-logic-capsules version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "Fully restructure the three control-plane clusters into capsule form with contract-hosted derivation contracts, behavior-preserved under the predecessor conformance." description = "在 runtime-control-component-boundaries 的契约与 conformance 保护下，把 engine、coordinator、driver 三集群重构为 capsule（coreLogic/adapterRegistry/adapters/internals，类型留在 contract 包），reducer/projection 提升为 derivation contract；AiRuntimeTurnSupervisor 经前提修正后保留并冻结（移除归入 refactor-ai-turn-tool-provider-lifecycle，见决策 3）。" commit_mode = "manual" created_at = "2026-06-11T16:00:00Z" updated_at = "2026-06-11T18:30:00Z" } (
