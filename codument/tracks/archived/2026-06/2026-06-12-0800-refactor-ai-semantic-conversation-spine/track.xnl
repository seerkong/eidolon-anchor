<Track #refactor-ai-semantic-conversation-spine version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "Make the Conversation three domains the single in-memory truth with a three-stage provider materialization, one-way recovery handoff, and complete transcript removal." description = "三域升格为会话期内存唯一真源：所有会话输入以 semantic 事件入流（唯一写入者为消费流的 Reducer/MessageAssembly）、providerMessages 改为三阶段 materialize 纯投影、恢复单向交接、conversation runtime 全量 capsule 化、transcript 彻底删除（含 upgrade 读取）。流式 pipeline 不动，提交边界形式化为 MessageAssembly。" commit_mode = "manual" created_at = "2026-06-12T00:00:00Z" updated_at = "2026-06-12T00:00:00Z" } (
