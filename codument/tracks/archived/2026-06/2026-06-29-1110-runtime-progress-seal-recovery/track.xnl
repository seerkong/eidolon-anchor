<Track #runtime-progress-seal-recovery version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "Enable production-safe completed-progress seal and forward-only conversation recovery for long mandatory-continuation turns." description = "Persist sealed conversation progress on unsettled timeout and resume from it without unsafe VM snapshots." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-06-29T08:04:06Z" updated_at = "2026-06-29T08:10:55Z" } (
