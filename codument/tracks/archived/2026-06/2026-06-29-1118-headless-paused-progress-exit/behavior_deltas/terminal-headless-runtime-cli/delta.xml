<behavior-patch capability="terminal-headless-runtime-cli" version="1">
  <upsert selector="behavior://terminal-headless-runtime-cli/requirements/paused-progress-exit">
    <requirement id="paused-progress-exit">
      <statement>Headless exec SHALL distinguish a resumable `runtime_turn_unsettled:*` timeout from hard failures by returning `paused_with_progress`; it SHALL NOT write `--output-last-message` for paused results; trace `session_end` SHALL record `paused_with_progress`.</statement>
      <suite id="headless-paused-progress" name="Headless paused progress protocol">
        <case id="runtime-unsettled-pauses">
          <given>runtime turn throws `runtime_turn_unsettled:mandatory_continuation`</given>
          <when>headless exec handles the turn result</when>
          <then>result status SHALL be `paused_with_progress`</then>
          <then>trace session_end status SHALL be `paused_with_progress`</then>
        </case>
        <case id="paused-does-not-write-last-message">
          <given>an existing `--output-last-message` file exists</given>
          <when>headless exec returns `paused_with_progress`</when>
          <then>the file SHALL NOT be overwritten</then>
        </case>
        <case id="provider-failure-remains-failed">
          <given>provider initialization or stream fails</given>
          <when>headless exec handles the error</when>
          <then>result status SHALL remain `failed`</then>
        </case>
      </suite>
    </requirement>
  </upsert>
</behavior-patch>
