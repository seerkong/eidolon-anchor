<Track #headless-paused-progress-exit version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "Add explicit paused_with_progress semantics to headless exec projection." description = "Distinguish resumable long-turn timeout from hard failures while preserving last-message safety." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-06-29T08:13:49Z" updated_at = "2026-06-29T08:18:29Z" } (
