<BehaviorPatch #track.r_2_0_2_6_-_0_7_-_1_7_-_2_1_3_2_-_r_e_f_a_c_t_o_r_-_p_r_o_g_r_e_s_s_i_v_e_-_c_o_n_t_e_x_t_-_r_e_s_o_u_r_c_e_-_l_o_a_d_i_n_g.behavior_patch.progressive-context-resource-loading apiVersion="codument.tech/v1alpha1" version="1" { capability = "progressive-context-resource-loading" } (
  <Mutations [
    <Upsert { selector = "behavior://progressive-context-resource-loading/requirements/content-addressed-resource-facts" } (
      <Requirement #content-addressed-resource-facts (
        <Statement ?01M05F1PKDWSQG2C23WVMRBP63>
        系统 SHALL 用工具无关的 canonical resource id、完整内容摘要 revision、fragment selection 与 delivery reference 表达渐进式文本加载；Skill SHALL NOT 拥有独立的 loaded 状态真源。
        </?01M05F1PKDWSQG2C23WVMRBP63>
        <Suites [
          <Suite #resource-facts { name = "资源事实" } (
            <Cases [
              <Case #read-and-skill-share-resource-model [
                <Then ?01M05F1PKDWSQG2C23WVMRBP64>
                两者 SHALL 写入同一 context resource 数据形态
                </?01M05F1PKDWSQG2C23WVMRBP64>
                <Then ?01M05F1PKDWSQG2C23WVMRBP65>
                事实身份 SHALL 不依赖工具名称
                </?01M05F1PKDWSQG2C23WVMRBP65>
              ] (
                <Given ?01M05F1PKDWSQG2C23WVMRBP66>
                普通 read 与 Skill resolver 最终指向本地文本内容
                </?01M05F1PKDWSQG2C23WVMRBP66>
                <When ?01M05F1PKDWSQG2C23WVMRBP67>
                运行时记录加载事实
                </?01M05F1PKDWSQG2C23WVMRBP67>
              )>
              <Case #facts-survive-recovery (
                <Given ?01M05F1PKDWSQG2C23WVMRBP68>
                资源 revision、fragment 和 delivery 已随 Session context asset 持久化
                </?01M05F1PKDWSQG2C23WVMRBP68>
                <When ?01M05F1PKDWSQG2C23WVMRBP69>
                session 恢复
                </?01M05F1PKDWSQG2C23WVMRBP69>
                <Then ?01M05F1PKDWSQG2C23WVMRBP6A>
                运行时 SHALL 恢复这些资源事实而不创建第二份 Skill 状态
                </?01M05F1PKDWSQG2C23WVMRBP6A>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://progressive-context-resource-loading/requirements/revision-and-visible-coverage" } (
      <Requirement #revision-and-visible-coverage (
        <Statement ?01M05F1PKDWSQG2C23WVMRBP6B>
        系统 SHALL 仅在 resource revision 未变化、requested fragment 被 visible deliveries 完全覆盖且对应结果仍完整存在于 materialized provider context 时复用已加载内容；否则 SHALL 重新交付变化或缺失的内容。
        </?01M05F1PKDWSQG2C23WVMRBP6B>
        <Suites [
          <Suite #load-decision { name = "加载决策" } (
            <Cases [
              <Case #same-revision-visible-range-reused (
                <Given ?01M05F1PKDWSQG2C23WVMRBP6C>
                同一 revision 的 delivery 覆盖 requested line range 且完整 tool result 仍在 provider context
                </?01M05F1PKDWSQG2C23WVMRBP6C>
                <When ?01M05F1PKDWSQG2C23WVMRBP6D>
                任一 resolver 再次请求该范围
                </?01M05F1PKDWSQG2C23WVMRBP6D>
                <Then ?01M05F1PKDWSQG2C23WVMRBP6E>
                系统 SHALL 返回通用 already-visible 引用而不重复正文
                </?01M05F1PKDWSQG2C23WVMRBP6E>
              )>
              <Case #changed-resource-reloaded [
                <Then ?01M05F1PKDWSQG2C23WVMRBP6F>
                系统 SHALL 创建新 revision 并交付新 revision 的所需内容
                </?01M05F1PKDWSQG2C23WVMRBP6F>
                <Then ?01M05F1PKDWSQG2C23WVMRBP6G>
                旧 revision coverage SHALL NOT 被当作新 revision coverage
                </?01M05F1PKDWSQG2C23WVMRBP6G>
              ] (
                <Given ?01M05F1PKDWSQG2C23WVMRBP6H>
                canonical resource id 相同但完整内容摘要已变化
                </?01M05F1PKDWSQG2C23WVMRBP6H>
                <When ?01M05F1PKDWSQG2C23WVMRBP6J>
                再次请求任一范围
                </?01M05F1PKDWSQG2C23WVMRBP6J>
              )>
              <Case #compacted-delivery-reloaded [
                <Then ?01M05F1PKDWSQG2C23WVMRBP6K>
                该 delivery SHALL NOT 贡献 visible coverage
                </?01M05F1PKDWSQG2C23WVMRBP6K>
                <Then ?01M05F1PKDWSQG2C23WVMRBP6M>
                系统 SHALL 重新交付所需正文
                </?01M05F1PKDWSQG2C23WVMRBP6M>
              ] (
                <Given ?01M05F1PKDWSQG2C23WVMRBP6N>
                资源事实仍持久存在但对应 tool result 已被 compacted 或 persisted wrapper 替换，或者已从当前 materialization 移除
                </?01M05F1PKDWSQG2C23WVMRBP6N>
                <When ?01M05F1PKDWSQG2C23WVMRBP6P>
                再次请求该范围
                </?01M05F1PKDWSQG2C23WVMRBP6P>
              )>
              <Case #progressive-range-delivery [
                <Then ?01M05F1PKDWSQG2C23WVMRBP6Q>
                系统 SHALL 仅交付未被 visible coverage 覆盖的行范围
                </?01M05F1PKDWSQG2C23WVMRBP6Q>
                <Then ?01M05F1PKDWSQG2C23WVMRBP6R>
                输出 SHALL 保留稳定原始行号
                </?01M05F1PKDWSQG2C23WVMRBP6R>
              ] (
                <Given ?01M05F1PKDWSQG2C23WVMRBP6S>
                同一 revision 只有 requested range 的一部分仍可见
                </?01M05F1PKDWSQG2C23WVMRBP6S>
                <When ?01M05F1PKDWSQG2C23WVMRBP6T>
                请求更大的 line range
                </?01M05F1PKDWSQG2C23WVMRBP6T>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://progressive-context-resource-loading/requirements/prompt-and-entry-ownership" } (
      <Requirement #prompt-and-entry-ownership (
        <Statement ?01M05F1PKDWSQG2C23WVMRBP6V>
        AI kernel SHALL 描述工具无关的资源复用与重载语义；terminal entry SHALL NOT 注入 Skill 或其他产品级资源加载提示词，实时 catalog 描述 SHALL 由对应工具 schema owner 提供。
        </?01M05F1PKDWSQG2C23WVMRBP6V>
        <Suites [
          <Suite #prompt-ownership { name = "提示词所有权" } (
            <Cases [
              <Case #terminal-does-not-inject-skill-semantics (
                <Given ?01M05F1PKDWSQG2C23WVMRBP6W>
                terminal 组装 ai-kernel 或 ai-coding profile
                </?01M05F1PKDWSQG2C23WVMRBP6W>
                <When ?01M05F1PKDWSQG2C23WVMRBP6X>
                检查 system prompt 与 assembly context
                </?01M05F1PKDWSQG2C23WVMRBP6X>
                <Then ?01M05F1PKDWSQG2C23WVMRBP6Y>
                terminal SHALL NOT 提供“每轮重新读取 Skill”或同类产品语义
                </?01M05F1PKDWSQG2C23WVMRBP6Y>
              )>
              <Case #no-skill-specific-idempotence-protocol [
                <Then ?01M05F1PKDWSQG2C23WVMRBP6Z>
                规则 SHALL 基于 resource revision、fragment 与 visibility
                </?01M05F1PKDWSQG2C23WVMRBP6Z>
                <Then ?01M05F1PKDWSQG2C23WVMRBP70>
                规则 SHALL NOT 把 Skill 名称或 Skill call count 作为幂等事实
                </?01M05F1PKDWSQG2C23WVMRBP70>
              ] (
                <Given ?01M05F1PKDWSQG2C23WVMRBP71>
                kernel 与 tool schema 描述渐进资源加载
                </?01M05F1PKDWSQG2C23WVMRBP71>
                <When ?01M05F1PKDWSQG2C23WVMRBP72>
                检查规则文本
                </?01M05F1PKDWSQG2C23WVMRBP72>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://progressive-context-resource-loading/requirements/no-generic-loop-guard" } (
      <Requirement #no-generic-loop-guard (
        <Statement ?01M05F1PKDWSQG2C23WVMRBP73>
        本能力 SHALL NOT 基于重复工具次数、迭代次数或通用无进展推断拒绝工具调用；复用决策 SHALL 仅来自资源 revision、fragment coverage 与 provider visibility 事实。
        </?01M05F1PKDWSQG2C23WVMRBP73>
        <Suites [
          <Suite #scope-boundary { name = "范围边界" } (
            <Cases [
              <Case #unrelated-repeated-tools-not-blocked (
                <Given ?01M05F1PKDWSQG2C23WVMRBP74>
                工具调用不产生可识别的文本资源事实
                </?01M05F1PKDWSQG2C23WVMRBP74>
                <When ?01M05F1PKDWSQG2C23WVMRBP75>
                同类工具被重复调用
                </?01M05F1PKDWSQG2C23WVMRBP75>
                <Then ?01M05F1PKDWSQG2C23WVMRBP76>
                本能力 SHALL NOT 对其增加循环检测或调用次数限制
                </?01M05F1PKDWSQG2C23WVMRBP76>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
