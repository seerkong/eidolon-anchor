<Track #refactor-provider-context-state-projections version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "让可变工具状态以当前 projection 进入 provider context，并让恢复 session 使用当前 profile prompt 后可靠续跑" description = "建立工具无关的 projection/delivery 生命周期、owner-aware profile prompt recovery，并用真实 session 验证 mission 归档收敛。" question_mode = "decision-tree" question_severity = "light" commit_mode = "manual" created_at = "2026-07-18T00:00:00Z" updated_at = "2026-07-18T08:39:52Z" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
    <MaterialBundle { role = "output" name = "behavior" domain = "codument" path = "vfs://@/codument/behaviors/" }>
  ]>
  <TaskSpace #space_refactor-provider-context-state-projections { name = "refactor-provider-context-state-projections" } (
    <Description ?01M05F1PKK714E3Y93TBRZKPC5>
    实现 provider-only 动态状态投影和 source pair delivery 生命周期。
    </?01M05F1PKK714E3Y93TBRZKPC5>
    <SubNodes [
      <TaskGroup #P1 { name = "Projection contract 与纯物化" status = "DONE" order = 0 } (
        <Description ?01M05F1PKK714E3Y93TBRZKPC6>
        先用失败测试定义 projection fact、持久化、成对消隐和 late placement，再实现 Conversation 纯投影。
        </?01M05F1PKK714E3Y93TBRZKPC6>
        <Gate [
          <Criterion ?01M05F1PKK714E3Y93TBRZKPC7>
          materializer 不含具体工具名分支
          </?01M05F1PKK714E3Y93TBRZKPC7>
          <Criterion ?01M05F1PKK714E3Y93TBRZKPC8>
          History-visible view 与持久化 History 保持不变
          </?01M05F1PKK714E3Y93TBRZKPC8>
          <Criterion ?01M05F1PKK714E3Y93TBRZKPC9>
          pair elision、mixed calls、revision replacement 和 recovery 测试通过
          </?01M05F1PKK714E3Y93TBRZKPC9>
        ]>
        <SubNodes [
          <Task { id = "T1.1" name = "定义 projection fact 与 provider materialization" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PKK714E3Y93TBRZKPCA>
            增加通用 tool context-effect/projection contract、Session context asset persistence、provider-only tool pair elision 和 current projection late placement；按 TDD 覆盖首次未交付、已交付、混合 calls、revision 与恢复。
            </?01M05F1PKK714E3Y93TBRZKPCA>
            <Acceptance [
              <Criterion { id = "T1.1-AC1" checked = true } ?01M05F1PKK714E3Y93TBRZKPCB>
              projection contract 仅含 logical key/revision/source delivery，不含具体工具名称状态机
              </?01M05F1PKK714E3Y93TBRZKPCB>
              <Criterion { id = "T1.1-AC2" checked = true } ?01M05F1PKK714E3Y93TBRZKPCC>
              已交付 source call/result 在 provider view 成对消隐，History view 不变
              </?01M05F1PKK714E3Y93TBRZKPCC>
              <Criterion { id = "T1.1-AC3" checked = true } ?01M05F1PKK714E3Y93TBRZKPCD>
              同 key 只投影当前 revision，并位于最后 user 前的 late boundary
              </?01M05F1PKK714E3Y93TBRZKPCD>
              <Criterion { id = "T1.1-AC4" checked = true } ?01M05F1PKK714E3Y93TBRZKPCE>
              projection fact 经 conversation persistence/recovery round-trip 保持
              </?01M05F1PKK714E3Y93TBRZKPCE>
            ]>
          )>
        ]>
        <Hooks [
          <Hook { on = "phase:after" } (
            <AttractorCheck { use = "coding" }>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "执行生命周期与 TaskTree adoption" status = "DONE" order = 1 } (
        <Description ?01M05F1PKK714E3Y93TBRZKPCF>
        接入 shared executor first-delivery 生命周期和 TaskTree generic producer，验证两条执行路径与真实重复场景。
        </?01M05F1PKK714E3Y93TBRZKPCF>
        <Gate [
          <Criterion ?01M05F1PKK714E3Y93TBRZKPCG>
          provider 成功才确认 delivery，失败和中止不确认
          </?01M05F1PKK714E3Y93TBRZKPCG>
          <Criterion ?01M05F1PKK714E3Y93TBRZKPCH>
          streaming 与 cooperative 使用同一通用 helper
          </?01M05F1PKK714E3Y93TBRZKPCH>
          <Criterion ?01M05F1PKK714E3Y93TBRZKPCJ>
          连续 TaskTree 更新只保留当前 state projection
          </?01M05F1PKK714E3Y93TBRZKPCJ>
        ]>
        <SubNodes [
          <Task { id = "T2.1" name = "接入 first-delivery 与 TaskTree producer" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PKK714E3Y93TBRZKPCK>
            让 shared tool leaf 注册 context effects，让 provider completion 确认 request 中的 source delivery；TaskTreeWrite 返回 compact acknowledgement 并发布当前 task-tree projection，补 streaming/cooperative 和重复写回归。
            </?01M05F1PKK714E3Y93TBRZKPCK>
            <Acceptance [
              <Criterion { id = "T2.1-AC1" checked = true } ?01M05F1PKK714E3Y93TBRZKPCM>
              首次 provider request 包含新 pair，成功后后续 request 消隐该 pair
              </?01M05F1PKK714E3Y93TBRZKPCM>
              <Criterion { id = "T2.1-AC2" checked = true } ?01M05F1PKK714E3Y93TBRZKPCN>
              provider failure 后 pair 仍保留
              </?01M05F1PKK714E3Y93TBRZKPCN>
              <Criterion { id = "T2.1-AC3" checked = true } ?01M05F1PKK714E3Y93TBRZKPCP>
              TaskTreeWrite 结果为 compact acknowledgement，完整当前树由 projection 提供
              </?01M05F1PKK714E3Y93TBRZKPCP>
              <Criterion { id = "T2.1-AC4" checked = true } ?01M05F1PKK714E3Y93TBRZKPCQ>
              实现源码和测试证明 materializer/executor 没有 TaskTreeWrite、Skill、Read 名称特例
              </?01M05F1PKK714E3Y93TBRZKPCQ>
              <Criterion { id = "T2.1-AC5" checked = true } ?01M05F1PKK714E3Y93TBRZKPCR>
              受影响包测试与 typecheck 通过，或记录明确基线失败
              </?01M05F1PKK714E3Y93TBRZKPCR>
            ]>
          )>
        ]>
        <Hooks [
          <Hook { on = "phase:after" } (
            <AttractorCheck { use = "coding" }>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "恢复提示词协调与真实 session 验证" status = "DONE" order = 2 } (
        <Description ?01M05F1PKK714E3Y93TBRZKPCS>
        增加 profile-owned prompt provenance 与保守 legacy migration，再恢复目标 session 完成 mission 归档或保存重复现场并诊断。
        </?01M05F1PKK714E3Y93TBRZKPCS>
        <Gate [
          <Criterion ?01M05F1PKK714E3Y93TBRZKPCT>
          恢复只刷新 profile-owned slot，并保持自定义 prompt 与 actor/runtime/conversation 状态
          </?01M05F1PKK714E3Y93TBRZKPCT>
          <Criterion ?01M05F1PKK714E3Y93TBRZKPCV>
          legacy 空/单 prompt 可迁移，多 prompt 无 provenance 时保守跳过并可观测
          </?01M05F1PKK714E3Y93TBRZKPCV>
          <Criterion ?01M05F1PKK714E3Y93TBRZKPCW>
          使用当前源码和精确 workspace/session 完成真实验证，或形成新的证据化根因与改造建议
          </?01M05F1PKK714E3Y93TBRZKPCW>
        ]>
        <SubNodes [
          <Task { id = "T3.1" name = "实现 owner-aware profile prompt recovery" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PKK714E3Y93TBRZKPCX>
            先补恢复 contract/snapshot/bootstrap/CLI 测试，再加入 profile prompt slot/provenance、digest 校验、legacy 空/单条迁移和多条歧义诊断；terminal 只传 profile assembly 结果。
            </?01M05F1PKK714E3Y93TBRZKPCX>
            <Acceptance [
              <Criterion { id = "T3.1-AC1" checked = true } ?01M05F1PKK714E3Y93TBRZKPCY>
              owned slot 恢复为当前 profile prompt，自定义 prompts 与 actor key/id/model/work/task/mailbox/history 保持
              </?01M05F1PKK714E3Y93TBRZKPCY>
              <Criterion { id = "T3.1-AC2" checked = true } ?01M05F1PKK714E3Y93TBRZKPCZ>
