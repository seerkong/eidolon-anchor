<Track #harden-responses-hybrid-continuation version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "让 Responses stateful continuation 成为可失效优化，并以完整 system instructions、provider-native stateless replay 和稳定缓存前缀保证正确性" description = "删除模块级 continuation 真源，增加 native replay checkpoint、context digest、固定动态锚点、Responses system-instructions 物化和稳定 prompt cache key，并以原 session 真正完成 mission 归档作为现场验收。" question_mode = "decision-tree" question_severity = "light" commit_mode = "manual" created_at = "2026-07-18T00:00:00Z" updated_at = "2026-07-19T20:10:14+03:00" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
    <MaterialBundle { role = "output" name = "behavior" domain = "codument" path = "vfs://@/codument/behaviors/" }>
  ]>
  <TaskSpace #space_harden-responses-hybrid-continuation { name = "harden-responses-hybrid-continuation" } (
    <Description ?01M05F1PM6VD0CHEB428764M5D>
    实现 local-authoritative Responses hybrid continuation 与 native replay。
    </?01M05F1PM6VD0CHEB428764M5D>
    <SubNodes [
      <TaskGroup #P1 { name = "请求计划与 replay 数据契约" status = "DONE" order = 0 } (
        <Description ?01M05F1PM6VD0CHEB428764M5E>
        先以纯逻辑和失败测试定义 continuation eligibility、native window、message frontier、context digest 与 stable cache key。
        </?01M05F1PM6VD0CHEB428764M5E>
        <Gate [
          <Criterion ?01M05F1PM6VD0CHEB428764M5F>
          request plan 是显式数据并覆盖 stateful/stateless 两个分支
          </?01M05F1PM6VD0CHEB428764M5F>
          <Criterion ?01M05F1PM6VD0CHEB428764M5G>
          provider replay checkpoint 被分类为非权威、可失效 snapshot
          </?01M05F1PM6VD0CHEB428764M5G>
        ]>
        <SubNodes [
          <Task { id = "T1.1" name = "定义 hybrid request plan 与 native replay contract" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PM6VD0CHEB428764M5H>
            补失败测试并实现 ResponsesRequestPlan、provider output snapshot/replay checkpoint、message fingerprint/context digest 与 stable prompt cache key 的纯 helper；保持非 Responses provider 兼容。
            </?01M05F1PM6VD0CHEB428764M5H>
            <Acceptance [
              <Criterion { id = "T1.1-AC1" checked = true } ?01M05F1PM6VD0CHEB428764M5J>
              纯测试覆盖 valid stateful、epoch/digest/frontier mismatch、stateless native window 与 canonical rebuild
              </?01M05F1PM6VD0CHEB428764M5J>
              <Criterion { id = "T1.1-AC2" checked = true } ?01M05F1PM6VD0CHEB428764M5K>
              相同稳定 prefix 产生相同 cache key，model/instructions/tools 变化产生不同 key
              </?01M05F1PM6VD0CHEB428764M5K>
              <Criterion { id = "T1.1-AC3" checked = true } ?01M05F1PM6VD0CHEB428764M5M>
              contract 不把 provider checkpoint 定义为 History 或 recovery canonical fact
              </?01M05F1PM6VD0CHEB428764M5M>
              <Criterion { id = "T1.1-AC4" checked = true } ?01M05F1PM6VD0CHEB428764M5N>
              既有 provider option/driver tests 保持通过
              </?01M05F1PM6VD0CHEB428764M5N>
            ]>
          )>
        ]>
        <Hooks [
          <Hook { on = "phase:after" } (
            <AttractorCheck { use = "coding" }>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "Responses transport 原生输出与显式 continuation" status = "DONE" order = 1 } (
        <Description ?01M05F1PM6VD0CHEB428764M5P>
        复用纯 request plan 改造 live Responses adapter，捕获完整 output items，删除模块 Map/随机 cache key，并让 fallback 始终 full replay。
        </?01M05F1PM6VD0CHEB428764M5P>
        <Gate [
          <Criterion ?01M05F1PM6VD0CHEB428764M5Q>
          stream 成功后可取得完整有序 response.output snapshot
          </?01M05F1PM6VD0CHEB428764M5Q>
          <Criterion ?01M05F1PM6VD0CHEB428764M5R>
          previous id 仅来自显式 continuation input
          </?01M05F1PM6VD0CHEB428764M5R>
          <Criterion ?01M05F1PM6VD0CHEB428764M5S>
          WS fallback body 永不使用截断 incremental input
          </?01M05F1PM6VD0CHEB428764M5S>
          <Criterion ?01M05F1PM6VD0CHEB428764M5T>
          无模块级或进程级 continuation 可变 Map
          </?01M05F1PM6VD0CHEB428764M5T>
        ]>
        <SubNodes [
          <Task { id = "T2.1" name = "改造 Responses adapter 与 driver" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PM6VD0CHEB428764M5V>
            以 TDD 接入 request plan/native output side-channel；统一 live adapter 与 ResponsesInputItems/Continuation helper，移除 module response-id Map、per-request UUID 和 transport 内隐式跨 turn 状态，覆盖 SSE/WS/fallback/tool/user 增量。
            </?01M05F1PM6VD0CHEB428764M5V>
            <Acceptance [
              <Criterion { id = "T2.1-AC1" checked = true } ?01M05F1PM6VD0CHEB428764M5W>
              completed.output 或 output_item.done 中的 reasoning/message/function items 原样有序进入 provider output snapshot
              </?01M05F1PM6VD0CHEB428764M5W>
              <Criterion { id = "T2.1-AC2" checked = true } ?01M05F1PM6VD0CHEB428764M5X>
              stateful body 仅在 eligibility 全满足时带 previous id 与 delta input
              </?01M05F1PM6VD0CHEB428764M5X>
              <Criterion { id = "T2.1-AC3" checked = true } ?01M05F1PM6VD0CHEB428764M5Y>
              stateless body 优先 native window，缺失/失配时 canonical full replay
              </?01M05F1PM6VD0CHEB428764M5Y>
              <Criterion { id = "T2.1-AC4" checked = true } ?01M05F1PM6VD0CHEB428764M5Z>
              WS→HTTP fallback 的 observation/body 是完整 stateless request
              </?01M05F1PM6VD0CHEB428764M5Z>
              <Criterion { id = "T2.1-AC5" checked = true } ?01M05F1PM6VD0CHEB428764M60>
              源码不存在 responsesPreviousResponseIdBySession 或随机 prompt_cache_key
              </?01M05F1PM6VD0CHEB428764M60>
            ]>
          )>
        ]>
        <Hooks [
          <Hook { on = "phase:after" } (
            <AttractorCheck { use = "coding" }>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "Conversation checkpoint、固定锚点与恢复验证" status = "DONE" order = 2 } (
        <Description ?01M05F1PM6VD0CHEB428764M61>
        把 native replay checkpoint 接入 Conversation context owner，推进 actor baseline，固定 dynamic anchor，把所有物化 system messages 编译进 Responses wire instructions，并跑原 session request ledger 验证。
        </?01M05F1PM6VD0CHEB428764M61>
        <Gate [
          <Criterion ?01M05F1PM6VD0CHEB428764M62>
          Conversation/History 仍是唯一 canonical context
          </?01M05F1PM6VD0CHEB428764M62>
          <Criterion ?01M05F1PM6VD0CHEB428764M63>
          checkpoint/recovery/baseline mismatch 自动 full replay
          </?01M05F1PM6VD0CHEB428764M63>
          <Criterion ?01M05F1PM6VD0CHEB428764M64>
          动态 overlay 固定在 system 与 conversation history 边界
          </?01M05F1PM6VD0CHEB428764M64>
          <Criterion ?01M05F1PM6VD0CHEB428764M65>
          Responses wire instructions 与物化 system context 同源且不重复
          </?01M05F1PM6VD0CHEB428764M65>
          <Criterion ?01M05F1PM6VD0CHEB428764M66>
          定向测试、类型检查与目标 session 现场验证有客观证据
          </?01M05F1PM6VD0CHEB428764M66>
        ]>
        <SubNodes [
          <Task { id = "T3.1" name = "接入 replay checkpoint 与 continuation baseline" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PM6VD0CHEB428764M67>
            增加 context asset replay fact/upsert/recovery，executor 读取 matching checkpoint、计算 provider-visible digest、成功后推进 actor baseline 并写 current checkpoint；固定 materializer dynamic boundary，覆盖 persistence 与两条 executor 路径。
            </?01M05F1PM6VD0CHEB428764M67>
            <Acceptance [
              <Criterion { id = "T3.1-AC1" checked = true } ?01M05F1PM6VD0CHEB428764M68>
              replay checkpoint 随 Conversation persistence round-trip，且不进入 provider-visible ChatMessage/History
              </?01M05F1PM6VD0CHEB428764M68>
              <Criterion { id = "T3.1-AC2" checked = true } ?01M05F1PM6VD0CHEB428764M69>
              成功 response 推进 id/digest/checkpoint；失败/中止不推进
              </?01M05F1PM6VD0CHEB428764M69>
              <Criterion { id = "T3.1-AC3" checked = true } ?01M05F1PM6VD0CHEB428764M6A>
              projection/compaction/system/model/tools mismatch 导致 full replay
              </?01M05F1PM6VD0CHEB428764M6A>
              <Criterion { id = "T3.1-AC4" checked = true } ?01M05F1PM6VD0CHEB428764M6B>
              新增 user/tool 不移动未变化 dynamic overlay 的固定锚点
              </?01M05F1PM6VD0CHEB428764M6B>
              <Criterion { id = "T3.1-AC5" checked = true } ?01M05F1PM6VD0CHEB428764M6C>
              实现不包含 Skill/TaskTree/Read/mission 名称特例
              </?01M05F1PM6VD0CHEB428764M6C>
            ]>
          )>
          <Task { id = "T3.3" name = "加固 native output completeness 与 call lineage" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PM6VD0CHEB428764M6D>
            以 typed evidence/decision contract 和 pure logic 重建 Responses native output、比较 completed/done/added+deltas 完整性，并在 previous checkpoint/current request 的完整 lineage 上校验 call-id 闭包；旧或无 proof checkpoint 失效，不完整 outcome 不推进 baseline，canonical 仍无效则 send-before fail-closed。
            </?01M05F1PM6VD0CHEB428764M6D>
            <Acceptance [
              <Criterion { id = "T3.3-AC1" checked = true } ?01M05F1PM6VD0CHEB428764M6E>
              transport 只收集原始 event evidence，单一 pure logic 产出 completeness/lineage decision
              </?01M05F1PM6VD0CHEB428764M6E>
              <Criterion { id = "T3.3-AC2" checked = true } ?01M05F1PM6VD0CHEB428764M6F>
              completed.output 为空或冲突时不丢弃已观测 function call，无法证明完整则不写 checkpoint/不推进 baseline
              </?01M05F1PM6VD0CHEB428764M6F>
              <Criterion { id = "T3.3-AC3" checked = true } ?01M05F1PM6VD0CHEB428764M6G>
              stateful 增量按 previous lineage 闭包校验，旧/无 proof checkpoint 自动 canonical rebuild
              </?01M05F1PM6VD0CHEB428764M6G>
              <Criterion { id = "T3.3-AC4" checked = true } ?01M05F1PM6VD0CHEB428764M6H>
              native 无效先 canonical rebuild，canonical 仍 orphan/duplicate/乱序/空 call id 时在 observation/I/O 前本地失败
              </?01M05F1PM6VD0CHEB428764M6H>
              <Criterion { id = "T3.3-AC5" checked = true } ?01M05F1PM6VD0CHEB428764M6J>
              实现无 Skill/TaskTree/Read/mission 名称特例
              </?01M05F1PM6VD0CHEB428764M6J>
            ]>
          )>
          <Task { id = "T3.4" name = "关联 request plan 与 provider outcome ledger" status = "DONE" order = 2 priority = "P0" } (
            <Description ?01M05F1PM6VD0CHEB428764M6K>
            扩展 typed observation port 与 app 顶层 support SQLite schema：send-before request row 保存 plan/replay/previous-id decision，response-after append-only outcome 保存 actual fallback、terminal state 与 completeness；按 attempt identity 关联并覆盖迁移、脱敏、fail-open、WS→HTTP。
            </?01M05F1PM6VD0CHEB428764M6K>
            <Acceptance [
              <Criterion { id = "T3.4-AC1" checked = true } ?01M05F1PM6VD0CHEB428764M6M>
              ledger 可直接查询 plan kind、可空 replay source、previous-id 采用/拒绝及 reason，无需从 body 推断
              </?01M05F1PM6VD0CHEB428764M6M>
              <Criterion { id = "T3.4-AC2" checked = true } ?01M05F1PM6VD0CHEB428764M6N>
              append-only outcome 按 attempt identity 关联 request，记录真实 fallback、terminal state 与 completeness
              </?01M05F1PM6VD0CHEB428764M6N>
              <Criterion { id = "T3.4-AC3" checked = true } ?01M05F1PM6VD0CHEB428764M6P>
              SQLite effect 仅在 terminal/organ-support，schema 非破坏迁移、脱敏与 fail-open 保持
              </?01M05F1PM6VD0CHEB428764M6P>
              <Criterion { id = "T3.4-AC4" checked = true } ?01M05F1PM6VD0CHEB428764M6Q>
              HTTP、WS 与 WS→HTTP fallback 测试证明 observation、wire body、outcome 同源且不改变调用
              </?01M05F1PM6VD0CHEB428764M6Q>
            ]>
          )>
          <Task { id = "T3.5" name = "物化 Responses system instructions" status = "DONE" order = 3 priority = "P0" } (
            <Description ?01M05F1PM6VD0CHEB428764M6R>
            从同一次 provider message materialization 中提取全部 system messages，以确定顺序与固定 transport instructions、sandbox instructions 及 provider-configured instructions 合并；同一 assembly 产出完整 wire instructions 与 stable instructions，分别驱动动态失效/wire 和 cache routing。
            </?01M05F1PM6VD0CHEB428764M6R>
            <Acceptance [
              <Criterion { id = "T3.5-AC1" checked = true } ?01M05F1PM6VD0CHEB428764M6S>
              kernel/system prompt、runtime work context、动态 TaskTree overlay 与 actor system prompt 都按物化顺序进入 Responses wire instructions
              </?01M05F1PM6VD0CHEB428764M6S>
              <Criterion { id = "T3.5-AC2" checked = true } ?01M05F1PM6VD0CHEB428764M6T>
              固定 transport instructions、sandbox、provider-configured instructions 与物化 system messages 的合并顺序确定，配置不被静默覆盖，同一内容不重复
              </?01M05F1PM6VD0CHEB428764M6T>
              <Criterion { id = "T3.5-AC3" checked = true } ?01M05F1PM6VD0CHEB428764M6V>
              request observation.instructions 与实际 wire instructions 同源；动态 system 变化同时改变 context digest 与 wire，但不改变 prompt cache key
              </?01M05F1PM6VD0CHEB428764M6V>
              <Criterion { id = "T3.5-AC4" checked = true } ?01M05F1PM6VD0CHEB428764M6W>
              Responses input 不再静默丢失 system 语义，且非 Responses provider 行为不受影响
              </?01M05F1PM6VD0CHEB428764M6W>
              <Criterion { id = "T3.5-AC5" checked = true } ?01M05F1PM6VD0CHEB428764M6X>
              实现对任意 system-role 文本统一处理，不包含 Skill/TaskTree/Read/mission 名称分支
              </?01M05F1PM6VD0CHEB428764M6X>
              <Criterion { id = "T3.5-AC6" checked = true } ?01M05F1PM6VD0CHEB428764M6Y>
              stable instructions 是完整 wire instructions 的精确前缀，且不包含 work-context 或 mutable provider projections
              </?01M05F1PM6VD0CHEB428764M6Y>
            ]>
          )>
          <Task { id = "T3.6" name = "严格兼容空 terminal output 事件流" status = "DONE" order = 4 priority = "P0" } (
            <Description ?01M05F1PM6VD0CHEB428764M6Z>
            在上游 `response.completed.output=[]` 时，仅当 indexed added/done/delta evidence 自身证明完整有序 output 且 call lineage 闭合时，允许 pure completeness logic 产出 reconstructed_event_items；否则继续 fail-closed。
            </?01M05F1PM6VD0CHEB428764M6Z>
            <Acceptance [
              <Criterion { id = "T3.6-AC1" checked = true } ?01M05F1PM6VD0CHEB428764M70>
              空 completed.output 本身不构成 complete 证据，缺 index/done/id/order 或 lineage 任一证明时仍为 incomplete
              </?01M05F1PM6VD0CHEB428764M70>
              <Criterion { id = "T3.6-AC2" checked = true } ?01M05F1PM6VD0CHEB428764M71>
              完整 indexed event evidence 与闭合 lineage 可产出 reconstructed_event_items proof，保留 reasoning/message/function-call 顺序与字段
              </?01M05F1PM6VD0CHEB428764M71>
              <Criterion { id = "T3.6-AC3" checked = true } ?01M05F1PM6VD0CHEB428764M72>
              只有 reconstructed proof 完整时才可推进 checkpoint/baseline，且 request/outcome ledger 记录实际 completeness source/reason
              </?01M05F1PM6VD0CHEB428764M72>
              <Criterion { id = "T3.6-AC4" checked = true } ?01M05F1PM6VD0CHEB428764M73>
              旧 WS fixture 补齐 proof 后全部回归通过，无任何工具、文本资源或业务名称特例
              </?01M05F1PM6VD0CHEB428764M73>
            ]>
          )>
          <Task { id = "T3.2" name = "运行回归与目标 session 现场验证" status = "DONE" order = 5 priority = "P0" } (
            <Description ?01M05F1PM6VD0CHEB428764M74>
            运行 Responses/Conversation/executor/persistence/ledger 定向测试和包 typecheck；用 capture flag 有界恢复既有问题 session，比较连续 request body/plan/instructions/outcome，确认模型能看到完整 system context 并真正完成 mission 归档。
            </?01M05F1PM6VD0CHEB428764M74>
            <Acceptance [
              <Criterion { id = "T3.2-AC1" checked = true } ?01M05F1PM6VD0CHEB428764M75>
              相关定向测试与 typecheck 通过，或基线/环境失败被独立归因
              </?01M05F1PM6VD0CHEB428764M75>
              <Criterion { id = "T3.2-AC2" checked = true } ?01M05F1PM6VD0CHEB428764M76>
              provider request/outcome ledger 直接证明 plan、instructions、previous-id decision、fallback、completeness 与实际 send body 一致
              </?01M05F1PM6VD0CHEB428764M76>
              <Criterion { id = "T3.2-AC3" checked = true } ?01M05F1PM6VD0CHEB428764M77>
              目标 session 成功继续，completed mission 从 active 移入当日 archived 目录，且归档校验通过
              </?01M05F1PM6VD0CHEB428764M77>
              <Criterion { id = "T3.2-AC4" checked = true } ?01M05F1PM6VD0CHEB428764M78>
              验证未 reset/clean/stash 或覆盖两个 workspace 的用户改动
              </?01M05F1PM6VD0CHEB428764M78>
            ]>
          )>
        ]>
        <Hooks [
          <Hook { on = "phase:after" } (
            <AttractorCheck { use = "coding" }>
          )>
        ]>
      )>
    ]>
  )>
)>
