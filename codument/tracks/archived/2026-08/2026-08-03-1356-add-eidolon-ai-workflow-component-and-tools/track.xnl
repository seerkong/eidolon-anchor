          </?01M05F1PNKSVW9ZQDBYJM6DV1P>
        ]>
        <SubNodes [
          <Task { id = "T2.1" name = "新增 WorkflowCreateBundle tool" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PNKSVW9ZQDBYJM6DV1Q>
            工具接受 form、name、fqn、description，返回受控 XNL bundle draft JSON。
            </?01M05F1PNKSVW9ZQDBYJM6DV1Q>
            <Acceptance [
              <Criterion { id = "T2.1-AC1" checked = true } ?01M05F1PNKSVW9ZQDBYJM6DV1R>
              AIDataWorkflow 与 AICtrlWorkflow bundle draft 都能生成 manifest、catalog、workflow definition、ports 与 flow-code 文件计划
              </?01M05F1PNKSVW9ZQDBYJM6DV1R>
              <Criterion { id = "T2.1-AC2" checked = true } ?01M05F1PNKSVW9ZQDBYJM6DV1S>
              生成结果包含 validation diagnostics 和 resource refs
              </?01M05F1PNKSVW9ZQDBYJM6DV1S>
            ]>
          )>
          <Task { id = "T2.2" name = "新增 WorkflowPatchBundle tool" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PNKSVW9ZQDBYJM6DV1T>
            工具接受 manifest ref 与 patch intent/content，验证目标 ref 并返回结构化 patch evidence。
            </?01M05F1PNKSVW9ZQDBYJM6DV1T>
            <Acceptance [
              <Criterion { id = "T2.2-AC1" checked = true } ?01M05F1PNKSVW9ZQDBYJM6DV1V>
              manifest ref validation 复用 workflow component/service
              </?01M05F1PNKSVW9ZQDBYJM6DV1V>
              <Criterion { id = "T2.2-AC2" checked = true } ?01M05F1PNKSVW9ZQDBYJM6DV1W>
              返回 JSON 明确说明第一阶段不直接写宿主文件
              </?01M05F1PNKSVW9ZQDBYJM6DV1W>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "验证与收口" status = "DONE" order = 2 } (
        <Description ?01M05F1PNKSVW9ZQDBYJM6DV1X>
