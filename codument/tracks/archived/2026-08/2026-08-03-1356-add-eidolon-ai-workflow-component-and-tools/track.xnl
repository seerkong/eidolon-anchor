<Track #add-eidolon-ai-workflow-component-and-tools version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "建立 Eidolon AI Workflow 共享 component/service，并新增对话内 workflow authoring tools。" description = "将现有 workflow inspect/validate tools 收敛到共享 service，并新增 create/patch bundle native tools；不实现 CLI 和 MCP。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-03T10:47:43Z" updated_at = "2026-08-03T10:56:54Z" } (
