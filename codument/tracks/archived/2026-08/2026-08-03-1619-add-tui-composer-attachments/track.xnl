<Track #add-tui-composer-attachments version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "让 TUI Composer 以显式用户意图区分路径文本、文件引用与图片附件，并让附件和 provider 凭据安全持久化。" description = "补齐 Composer 附件交互、canonical multimodal runtime ingress、引用式附件持久化、actor snapshot 凭据脱敏、OpenAI 图片 projection 与 DeepSeek V4 Flash 的真实能力边界。" question_mode = "decision-tree" question_severity = "light" commit_mode = "manual" gap_round = 2 created_at = "2026-08-02T02:11:28+08:00" updated_at = "2026-08-03T16:19:30+08:00" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
    <MaterialBundle { role = "state" name = "analysis" domain = "track" path = "vfs://./analysis/" }>
    <MaterialBundle { role = "output" name = "behavior" domain = "codument" path = "vfs://@/codument/behaviors/" }>
  ]>
  <TaskSpace #space_add-tui-composer-attachments { name = "add-tui-composer-attachments" } (
    <Description ?01M05F1PP0PR6C5E0WPGZ0HXS8>
    以 TDD 分阶段完成附件交互、结构化输入、能力门控、provider projection 和端到端验证。
    </?01M05F1PP0PR6C5E0WPGZ0HXS8>
    <SubNodes [
      <TaskGroup #P1 { name = "Composer 附件块交互" status = "DONE" order = 0 } (
        <Description ?01M05F1PP0PR6C5E0WPGZ0HXS9>
        锁定路径粘贴、统一插入、原子删除和 parts 计数行为。
        </?01M05F1PP0PR6C5E0WPGZ0HXS9>
        <Gate [
          <Criterion ?01M05F1PP0PR6C5E0WPGZ0HXSA>
          路径 paste 只有完整解析为存在文件集合时才转附件
          </?01M05F1PP0PR6C5E0WPGZ0HXSA>
          <Criterion ?01M05F1PP0PR6C5E0WPGZ0HXSB>
          Backspace/Delete 原子删除附件且 canonical parts 计数立即一致
          </?01M05F1PP0PR6C5E0WPGZ0HXSB>
        ]>
        <SubNodes [
          <Task { id = "T1.1" name = "编写附件入口与编辑失败测试" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PP0PR6C5E0WPGZ0HXSC>
            覆盖 Windows drive/UNC/引号、POSIX/file URI、多文件、普通文本 fallback、块首尾删除、selection 删除、计数与历史恢复。
            </?01M05F1PP0PR6C5E0WPGZ0HXSC>
            <Acceptance [
              <Criterion { id = "T1.1-AC1" checked = true } ?01M05F1PP0PR6C5E0WPGZ0HXSD>
              新增测试在缺少路径识别和原子删除实现时稳定 RED
              </?01M05F1PP0PR6C5E0WPGZ0HXSD>
            ]>
          )>
          <Task { id = "T1.2" name = "实现统一附件块生命周期" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PP0PR6C5E0WPGZ0HXSE>
            实现纯 paste path parser、共享 insertAttachmentParts、extmark 命中删除与单 transaction reconciliation；文件 I/O 仅通过注入式 resolver contract。
            </?01M05F1PP0PR6C5E0WPGZ0HXSE>
            <Acceptance [
              <Criterion { id = "T1.2-AC1" checked = true } ?01M05F1PP0PR6C5E0WPGZ0HXSF>
              Ctrl+O、路径 paste、剪贴板图片生成一致 file part/extmark
              </?01M05F1PP0PR6C5E0WPGZ0HXSF>
              <Criterion { id = "T1.2-AC2" checked = true } ?01M05F1PP0PR6C5E0WPGZ0HXSG>
              附件删除无残片且右下角 count 与 canonical parts 同步
              </?01M05F1PP0PR6C5E0WPGZ0HXSG>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "Canonical structured input ingress" status = "DONE" order = 1 } (
        <Description ?01M05F1PP0PR6C5E0WPGZ0HXSH>
        消除 TUI client 的附件丢弃边界，让 structured parts 进入 actor 与 Conversation。
        </?01M05F1PP0PR6C5E0WPGZ0HXSH>
        <Gate [
          <Criterion ?01M05F1PP0PR6C5E0WPGZ0HXSJ>
          TUI→bridge→mailbox→Conversation 保留 part 顺序与内容
          </?01M05F1PP0PR6C5E0WPGZ0HXSJ>
          <Criterion ?01M05F1PP0PR6C5E0WPGZ0HXSK>
          旧 string caller/session 保持兼容
          </?01M05F1PP0PR6C5E0WPGZ0HXSK>
        ]>
        <SubNodes [
          <Task { id = "T2.1" name = "定义 structured input contract 与失败测试" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PP0PR6C5E0WPGZ0HXSM>
            先为 canonical content union、AttachmentResolverPort、mailbox payload、runtime event、persistence/recovery、路径脱敏和 text projection helper 建立 contract tests。
            </?01M05F1PP0PR6C5E0WPGZ0HXSM>
            <Acceptance [
              <Criterion { id = "T2.1-AC1" checked = true } ?01M05F1PP0PR6C5E0WPGZ0HXSN>
              测试能复现 extractPromptContent 丢附件和 ChatMessage string-only 限制
              </?01M05F1PP0PR6C5E0WPGZ0HXSN>
            ]>
          )>
          <Task { id = "T2.2" name = "迁移 runtime 与 Conversation 链路" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PP0PR6C5E0WPGZ0HXSP>
            实现 canonical text/image/file-reference parts与注入式 terminal-support resolver effect，迁移 TuiRuntimeClient、TuiRuntimeBridge、actor mailbox、conversation materialization 与文本消费者。
            </?01M05F1PP0PR6C5E0WPGZ0HXSP>
            <Acceptance [
              <Criterion { id = "T2.2-AC1" checked = true } ?01M05F1PP0PR6C5E0WPGZ0HXSQ>
              user message events 与 Conversation round-trip 保留全部附件
              </?01M05F1PP0PR6C5E0WPGZ0HXSQ>
              <Criterion { id = "T2.2-AC2" checked = true } ?01M05F1PP0PR6C5E0WPGZ0HXSR>
              slash/questionnaire/headless 的纯文本行为无回归
              </?01M05F1PP0PR6C5E0WPGZ0HXSR>
              <Criterion { id = "T2.2-AC3" checked = true } ?01M05F1PP0PR6C5E0WPGZ0HXSS>
              普通文本/图片 snapshot 可恢复，绝对路径不进入 provider message/observation/log
              </?01M05F1PP0PR6C5E0WPGZ0HXSS>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "Modalities propagation 与 fail-closed gate" status = "DONE" order = 2 } (
        <Description ?01M05F1PP0PR6C5E0WPGZ0HXST>
        让配置成为模型输入能力真源，并在任何 provider I/O 前拒绝不支持的附件。
        </?01M05F1PP0PR6C5E0WPGZ0HXST>
        <Gate [
          <Criterion ?01M05F1PP0PR6C5E0WPGZ0HXSV>
