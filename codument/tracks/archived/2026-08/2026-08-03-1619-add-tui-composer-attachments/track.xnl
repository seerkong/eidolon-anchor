              </?01M05F1PP0PR6C5E0WPGZ0HXT2>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P4 { name = "OpenAI 图片 projection" status = "DONE" order = 3 } (
        <Description ?01M05F1PP0PR6C5E0WPGZ0HXT3>
