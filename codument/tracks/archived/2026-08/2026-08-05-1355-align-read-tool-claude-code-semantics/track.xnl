<Track #align-read-tool-claude-code-semantics version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "read 工具行为对齐 Claude Code Read 语义并补齐文件大小/总行数元信息。" description = "默认 limit 2000、offset 1 起始、超过 2000 行截断到前 2000 行、context-resource header 带 total-lines；统一目录与文件默认，消除 200 vs 2000 双默认；提供文件 size/行数元信息供模型决定读取范围。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-05T10:34:57Z" updated_at = "2026-08-05T10:55:00Z" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
