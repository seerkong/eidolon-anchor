<decision #track.bind-eidolon-ai-workflow-to-depa-flows-core.contract-boundary {
  status = "accepted"
  priority = "P0"
}
(
  <question ?>Which workflow semantics may remain locally defined in Eidolon?</?>
  <answer { }
  (
    <raw-answer ?>Only Eidolon-owned additive facts and compatibility projections.</?>
    <decision-text ?>Kinds, substrates, definition bindings, reuse policies and resource-ref semantics come from depa-flows; Eidolon owns its data-subgraph declaration, roots and runtime fact references.</?>
    <rationale ?>This preserves fact authority without erasing host-specific integration contracts.</?>
    <evidence ?>Mission depa-flows-authority and runtime-reuse decisions.</?>
  )>
)>

<decision #track.bind-eidolon-ai-workflow-to-depa-flows-core.source-only-loader {
  status = "accepted"
  priority = "P0"
}
(
  <question ?>Should the core binding loader read host files?</?>
  <answer { }
  (
    <raw-answer ?>No.</?>
    <decision-text ?>The core binding exposes a named-source loader; filesystem and resource-store effects are injected by the later authoring workspace track.</?>
    <rationale ?>This keeps parsing deterministic and avoids giving CLI or TUI a private filesystem authority.</?>
    <evidence ?>Mission shared-authoring-adapter decision and depa-flows source-loader API.</?>
  )>
)>
