<decision #track.execute-ai-ctrl-workflow-through-eidolon-runtime.fact-boundary apiVersion="codument.tech/v1alpha1" { status = "accepted" priority = "P0" } (
  <question ?01M05F1PPTX777H61RYQ54YFJC>
  Which runtime facts may workflow persist?
  </?01M05F1PPTX777H61RYQ54YFJC>
  <answer {  } (
    <raw-answer ?01M05F1PPTX777H61RYQ54YFJD>
    Definition ref, WorkCtrlFlow snapshot/projection and workflow event references.
    </?01M05F1PPTX777H61RYQ54YFJD>
    <decision-text ?01M05F1PPTX777H61RYQ54YFJE>
    Actor, provider, tool, conversation and effect lifecycle details remain in Eidolon authorities and are referenced by IDs only.
    </?01M05F1PPTX777H61RYQ54YFJE>
    <rationale ?01M05F1PPTX777H61RYQ54YFJF>
    Avoid parallel session/runtime truth.
    </?01M05F1PPTX777H61RYQ54YFJF>
  )>
)>
