<Track #establish-eidolon-workflow-authoring-workspace version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "让 TUI 与 CLI 通过同一 native component authoring workspace 安全写入 workflow resources。" description = "建立 runtime-bound store、authoring transitions 和跨 surface 统一写入 authority。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-07T16:42:00Z" updated_at = "2026-08-07T17:18:00Z" } (
  <Ports { scope = "track" } [
