              <Criterion { id = "T2.2-AC2" checked = true } ?01M05F1PQ1F5S92BM68Y5S4YWV>
              CLI init uses the component transition and preserves dry-run behavior
              </?01M05F1PQ1F5S92BM68Y5S4YWV>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "Cross-surface verification" status = "DONE" order = 2 } (
        <Description ?01M05F1PQ1F5S92BM68Y5S4YWW>
