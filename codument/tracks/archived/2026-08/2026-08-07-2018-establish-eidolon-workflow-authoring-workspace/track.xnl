          </?01M05F1PQ1F5S92BM68Y5S4YWY>
        ]>
        <SubNodes [
          <Task { id = "T3.1" name = "Run authoring acceptance verification" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PQ1F5S92BM68Y5S4YWZ>
            Run tool/CLI/store tests, build entry points and scan for duplicated writes.
            </?01M05F1PQ1F5S92BM68Y5S4YWZ>
            <Acceptance [
              <Criterion { id = "T3.1-AC1" checked = true } ?01M05F1PQ1F5S92BM68Y5S4YX0>
