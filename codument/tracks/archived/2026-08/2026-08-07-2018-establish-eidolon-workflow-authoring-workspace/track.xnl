          </?01M05F1PQ1F5S92BM68Y5S4YWM>
          <Criterion ?01M05F1PQ1F5S92BM68Y5S4YWN>
          CLI contains no workflow-specific filesystem write loop
          </?01M05F1PQ1F5S92BM68Y5S4YWN>
        ]>
        <SubNodes [
          <Task { id = "T2.1" name = "Add canonical publish and edit commands" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PQ1F5S92BM68Y5S4YWP>
            Validate draft sources, atomically publish, revalidate and expose patch/edit through the same workspace.
            </?01M05F1PQ1F5S92BM68Y5S4YWP>
            <Acceptance [
              <Criterion { id = "T2.1-AC1" checked = true } ?01M05F1PQ1F5S92BM68Y5S4YWQ>
              Publish returns physical write and canonical revision evidence
              </?01M05F1PQ1F5S92BM68Y5S4YWQ>
              <Criterion { id = "T2.1-AC2" checked = true } ?01M05F1PQ1F5S92BM68Y5S4YWR>
              Invalid replacement content is rejected before committed publication
              </?01M05F1PQ1F5S92BM68Y5S4YWR>
            ]>
          )>
          <Task { id = "T2.2" name = "Adopt component authoring in model tools and CLI" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PQ1F5S92BM68Y5S4YWS>
            Use runtime-bound component in tools and remove terminal-owned mkdir/write adapters.
            </?01M05F1PQ1F5S92BM68Y5S4YWS>
            <Acceptance [
              <Criterion { id = "T2.2-AC1" checked = true } ?01M05F1PQ1F5S92BM68Y5S4YWT>
