    <MaterialBundle { role = "output" name = "behavior" domain = "codument" path = "vfs://@/codument/behaviors/" }>
  ]>
  <TaskSpace #space_establish-eidolon-workflow-authoring-workspace { name = "establish-eidolon-workflow-authoring-workspace" } (
    <Description ?01M05F1PQ1F5S92BM68Y5S4YW9>
    Shared runtime-bound workflow authoring workspace and surface adapters.
    </?01M05F1PQ1F5S92BM68Y5S4YW9>
    <SubNodes [
      <TaskGroup #P1 { name = "Authoring store and component binding" status = "DONE" order = 0 } (
        <Description ?01M05F1PQ1F5S92BM68Y5S4YWA>
        Define the explicit store contract, safe filesystem implementation and runtime-rooted component factory.
        </?01M05F1PQ1F5S92BM68Y5S4YWA>
        <Gate [
          <Criterion ?01M05F1PQ1F5S92BM68Y5S4YWB>
          Containment tests reject absolute and traversal paths
          </?01M05F1PQ1F5S92BM68Y5S4YWB>
          <Criterion ?01M05F1PQ1F5S92BM68Y5S4YWC>
          Runtime and explicit factories produce the same component capability
          </?01M05F1PQ1F5S92BM68Y5S4YWC>
        ]>
        <SubNodes [
          <Task { id = "T1.1" name = "Add authoring store and workspace operations" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PQ1F5S92BM68Y5S4YWD>
            Implement safe read/tree/search/diff/write/delete and atomic publish primitives behind an injectable store contract.
            </?01M05F1PQ1F5S92BM68Y5S4YWD>
            <Acceptance [
              <Criterion { id = "T1.1-AC1" checked = true } ?01M05F1PQ1F5S92BM68Y5S4YWE>
              Store paths are containment-safe and writes use atomic replacement
              </?01M05F1PQ1F5S92BM68Y5S4YWE>
              <Criterion { id = "T1.1-AC2" checked = true } ?01M05F1PQ1F5S92BM68Y5S4YWF>
              Workspace exposes revisioned read/tree/search/diff/delete operations
              </?01M05F1PQ1F5S92BM68Y5S4YWF>
            ]>
          )>
          <Task { id = "T1.2" name = "Bind workspace into WorkflowComponent" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PQ1F5S92BM68Y5S4YWG>
            Add explicit and runtime-derived component factories with canonical loader and authoring workspace ports.
            </?01M05F1PQ1F5S92BM68Y5S4YWG>
            <Acceptance [
              <Criterion { id = "T1.2-AC1" checked = true } ?01M05F1PQ1F5S92BM68Y5S4YWH>
              Runtime metadata workflow root selects the physical authoring root
              </?01M05F1PQ1F5S92BM68Y5S4YWH>
              <Criterion { id = "T1.2-AC2" checked = true } ?01M05F1PQ1F5S92BM68Y5S4YWJ>
              Absent root uses a workDir-based conservative default and the binding is scoped to its runtime VM
              </?01M05F1PQ1F5S92BM68Y5S4YWJ>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "Shared publish commands and surface adoption" status = "DONE" order = 1 } (
        <Description ?01M05F1PQ1F5S92BM68Y5S4YWK>
        Move physical transitions into commands and make both surfaces call runtime-bound component instances.
        </?01M05F1PQ1F5S92BM68Y5S4YWK>
        <Gate [
          <Criterion ?01M05F1PQ1F5S92BM68Y5S4YWM>
