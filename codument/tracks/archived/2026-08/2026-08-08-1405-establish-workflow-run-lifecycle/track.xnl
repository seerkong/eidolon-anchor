<Track #establish-workflow-run-lifecycle version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "在 Eidolon native workflow component 中完整实现 workflow Type、Instance、Run 与 Material 产品生命周期。" description = "以 product contract 锁定两阶段运行、冻结 revision、等待恢复和 immutable Material receipt，再用 XNL/depa-flows 与 Eidolon actor/session authority 实现明确架构边界。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" modeling_base_commit = "f6068103550c3bada7c44ba13f4b00b030515d87" created_at = "2026-08-08T10:17:58Z" updated_at = "2026-08-08T11:05:00Z" } (
