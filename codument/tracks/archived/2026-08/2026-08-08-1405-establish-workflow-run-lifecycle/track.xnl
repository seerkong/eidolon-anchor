          </?01M05F1PR0VG54CV01QKW6BH6E>
          <Criterion ?01M05F1PR0VG54CV01QKW6BH6F>
          同一 idempotency key 相同请求重放、冲突请求拒绝
          </?01M05F1PR0VG54CV01QKW6BH6F>
        ]>
        <SubNodes [
          <Task #P2-T1 { name = "实现 Type 与 Instance durable facts" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PR0VG54CV01QKW6BH6G>
