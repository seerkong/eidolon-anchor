          </?01M05F1PR0VG54CV01QKW6BH6R>
        ]>
        <SubNodes [
          <Task #P3-T1 { name = "实现 Material revision、binding 与 containment" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PR0VG54CV01QKW6BH6S>
            实现 workspace-contained import/export、manifest/provenance、instance+node+port exact binding 和确认 gate。
            </?01M05F1PR0VG54CV01QKW6BH6S>
            <Acceptance [
              <Criterion #P3-T1-AC1 { checked = true } ?01M05F1PR0VG54CV01QKW6BH6T>
              相同内容去重，不同内容生成新 revision，逻辑 material ref 不可覆盖旧 revision
              </?01M05F1PR0VG54CV01QKW6BH6T>
              <Criterion #P3-T1-AC2 { checked = true } ?01M05F1PR0VG54CV01QKW6BH6V>
