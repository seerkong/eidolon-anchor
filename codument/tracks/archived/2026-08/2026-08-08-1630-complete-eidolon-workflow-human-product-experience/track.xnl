<Track #complete-eidolon-workflow-human-product-experience version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "让普通用户用一个业务目标完成 workflow 的选择、创建、推断、确认、执行与业务结果获取。" description = "增加业务场景 catalog、产品 journey coordinator、WorkflowFulfill native tool、共享 CLI agent 入口和 business-language E2E corpus。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-08T13:20:00Z" updated_at = "2026-08-08T13:30:00Z" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
