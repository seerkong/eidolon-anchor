<decisions #require-public-multi-source-tui-workflow-e2e apiVersion="codument.tech/v1alpha1" [
  <decision #track.require_public_multi_source.real_sources { priority = "P0" status = "accepted" durable_candidate = false } (
    <question ?01M05F1PRYZSSAC91JJG27WV4Z>
    真实公网多来源如何与自动测试稳定性并存？
    </?01M05F1PRYZSSAC91JJG27WV4Z>
    <answer (
      <raw-answer ?01M05F1PRYZSSAC91JJG27WV50>
      使用多个真实域名，不能是一个网站。
      </?01M05F1PRYZSSAC91JJG27WV50>
      <decision-text ?01M05F1PRYZSSAC91JJG27WV51>
      访问三个独立公网机器可读入口，并动态断言返回内容；只对模型决策使用脚本化 adapter。
      </?01M05F1PRYZSSAC91JJG27WV51>
      <rationale ?01M05F1PRYZSSAC91JJG27WV52>
      这既验证真实外部网络与多来源综合，也避免外部模型随机性决定 CI 结果。
      </?01M05F1PRYZSSAC91JJG27WV52>
      <evidence ?01M05F1PRYZSSAC91JJG27WV53>
      用户纠正 revision 40 的单一本地 fixture 命题；三个候选 URL 已实际返回 HTTP 200。
      </?01M05F1PRYZSSAC91JJG27WV53>
    )>
  )>
]>
