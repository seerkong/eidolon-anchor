<Track #establish-system-ai-workflow-skill version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "建立 global sys-ai-workflow 系统级 Skill，并把自然语言 workflow semantic authority 从 heuristic 代码迁回专属 Eidolon actor。" description = "删除代码级自然语言模糊匹配，通过 eidolon global init 安装 global-only 系统 Skills，建立 DevOps-stage workflow Skill/actor 和 canonical flow DSL lifecycle contract。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-09T16:48:55Z" updated_at = "2026-08-09T20:51:31+03:00" } (
  <Ports { scope = "track" } [
