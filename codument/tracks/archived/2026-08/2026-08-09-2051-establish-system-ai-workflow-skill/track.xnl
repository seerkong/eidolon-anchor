          <Task { id = "T1.4" name = "实现 global init staging、校验和逐目录原子替换" status = "DONE" order = 3 priority = "P0" }>
          <Task { id = "T1.5" name = "保护普通用户 skills 并拒绝 workspace shadow sys identity" status = "DONE" order = 4 priority = "P0" }>
          <Task { id = "T1.6" name = "实现 global system Skill resolution 与版本契约" status = "DONE" order = 5 priority = "P0" }>
          <Task { id = "T1.7" name = "注册专属 workflow actor 和分 stage 最小 native tool policy" status = "DONE" order = 6 priority = "P0" }>
        ]>
        <Acceptance [
          <Criterion #P1-AC1 { checked = true } ?01M05F1PSBVYZGHTCAGXJ3VMX8>
          global 默认目录下可解析唯一 canonical `sys-ai-workflow`
          </?01M05F1PSBVYZGHTCAGXJ3VMX8>
          <Criterion #P1-AC2 { checked = true } ?01M05F1PSBVYZGHTCAGXJ3VMX9>
