<Track #harden-ai-workflow-agent-runtime version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "让 AI Workflow actor 具备一致失败语义、可靠 child 输出、无损 tool-call identity 和有界进展。" description = "修复 provider failure 空成功、Conversation Domain 输出旁路、同名并行 tool-call 拼接、无进展长循环和 authoring VFS 诊断。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-09T16:48:55Z" updated_at = "2026-08-09T21:26:31+03:00" } (
