<BehaviorPatch #track.r_2_0_2_6_-_0_8_-_1_0_-_1_8_0_0_-_f_i_x_-_w_i_n_d_o_w_s_-_p_l_a_t_f_o_r_m_-_a_n_d_-_s_a_n_d_b_o_x_-_c_o_m_p_a_t.behavior_patch.bash-windows-commands apiVersion="codument.tech/v1alpha1" version="1" { capability = "bash-windows-commands" } (
  <Mutations [
    <Upsert { selector = "behavior://bash-windows-commands/requirements/windows-safe-commands" } (
      <Requirement #windows-safe-commands (
        <Statement ?01M05F1PSTKH2W4MXG1F6V1R50>
        bash 工具 SHALL 对 Windows 常用只读命令提供 workspace-safe 豁免（无 permissions.json 时不 deny），并 SHALL 在工具说明中补充 Windows 命令提示（用 dir/where/type 替代 ls/find/grep，用 cmd /c、powershell -Command 运行命令）。
        </?01M05F1PSTKH2W4MXG1F6V1R50>
        <Suites [
          <Suite #bash-windows-safe { name = "Bash Windows-safe commands" } (
            <Cases [
              <Case #windows-readonly-commands (
                <Given ?01M05F1PSTKH2W4MXG1F6V1R51>
                本地权限规则为空（无 permissions.json）
                </?01M05F1PSTKH2W4MXG1F6V1R51>
                <When ?01M05F1PSTKH2W4MXG1F6V1R52>
                执行 dir/where/type/findstr/git（只读形式）
                </?01M05F1PSTKH2W4MXG1F6V1R52>
                <Then ?01M05F1PSTKH2W4MXG1F6V1R53>
                SHALL NOT 被 local permission deny
                </?01M05F1PSTKH2W4MXG1F6V1R53>
              )>
              <Case #detail-prompt-windows-hint (
                <Given ?01M05F1PSTKH2W4MXG1F6V1R54>
                运行平台是 win32
                </?01M05F1PSTKH2W4MXG1F6V1R54>
                <When ?01M05F1PSTKH2W4MXG1F6V1R55>
                查看 bash 工具说明
                </?01M05F1PSTKH2W4MXG1F6V1R55>
                <Then ?01M05F1PSTKH2W4MXG1F6V1R56>
                SHALL 包含 Windows 命令替代提示
                </?01M05F1PSTKH2W4MXG1F6V1R56>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
