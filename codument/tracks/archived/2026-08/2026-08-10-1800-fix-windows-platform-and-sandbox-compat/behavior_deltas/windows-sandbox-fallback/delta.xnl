<BehaviorPatch #track.r_2_0_2_6_-_0_8_-_1_0_-_1_8_0_0_-_f_i_x_-_w_i_n_d_o_w_s_-_p_l_a_t_f_o_r_m_-_a_n_d_-_s_a_n_d_b_o_x_-_c_o_m_p_a_t.behavior_patch.windows-sandbox-fallback apiVersion="codument.tech/v1alpha1" version="1" { capability = "windows-sandbox-fallback" } (
  <Mutations [
    <Upsert { selector = "behavior://windows-sandbox-fallback/requirements/tiered-fallback" } (
      <Requirement #tiered-fallback (
        <Statement ?01M05F1PSX7H3BCZTESS7F3K28>
        Windows sandbox SHALL 采用分级模式（elevated/restricted-token/disabled）：runner 可用且 setup 完成时 SHALL 走 windows-elevated；runner 未安装或未 setup 时 SHALL 走普通执行 + 保留文件权限检查（不 ENOENT）。bash 报错 SHALL 显式可诊断（缺失 runner、EIDOLON_WINDOWS_SANDBOX_RUNNER、绕过选项）。
        </?01M05F1PSX7H3BCZTESS7F3K28>
        <Suites [
          <Suite #windows-sandbox-tiered { name = "Windows sandbox tiered fallback" } (
            <Cases [
              <Case #runner-missing-disabled [
                <Then ?01M05F1PSX7H3BCZTESS7F3K29>
                windowsSandboxLevel SHALL 为 disabled
                </?01M05F1PSX7H3BCZTESS7F3K29>
                <Then ?01M05F1PSX7H3BCZTESS7F3K2A>
                bash SHALL 走普通执行 + 保留文件权限检查，SHALL NOT 报 ENOENT
                </?01M05F1PSX7H3BCZTESS7F3K2A>
              ] (
                <Given ?01M05F1PSX7H3BCZTESS7F3K2B>
                运行平台是 win32 且 windows-sandbox-runner 不存在
                </?01M05F1PSX7H3BCZTESS7F3K2B>
                <When ?01M05F1PSX7H3BCZTESS7F3K2C>
                解析 sandbox backend selection
                </?01M05F1PSX7H3BCZTESS7F3K2C>
              )>
              <Case #runner-available-elevated [
                <Then ?01M05F1PSX7H3BCZTESS7F3K2D>
                windowsSandboxLevel SHALL 为 elevated
                </?01M05F1PSX7H3BCZTESS7F3K2D>
                <Then ?01M05F1PSX7H3BCZTESS7F3K2E>
                bash SHALL 走 eidolon-windows-sandbox-runner
                </?01M05F1PSX7H3BCZTESS7F3K2E>
              ] (
                <Given ?01M05F1PSX7H3BCZTESS7F3K2F>
                运行平台是 win32 且 runner 存在且 setup 完成
                </?01M05F1PSX7H3BCZTESS7F3K2F>
                <When ?01M05F1PSX7H3BCZTESS7F3K2G>
                解析 sandbox backend selection
                </?01M05F1PSX7H3BCZTESS7F3K2G>
              )>
              <Case #diagnosable-error (
                <Given ?01M05F1PSX7H3BCZTESS7F3K2H>
                配置显式要求 elevated 但 runner 缺失
                </?01M05F1PSX7H3BCZTESS7F3K2H>
                <When ?01M05F1PSX7H3BCZTESS7F3K2J>
                bash 执行
                </?01M05F1PSX7H3BCZTESS7F3K2J>
                <Then ?01M05F1PSX7H3BCZTESS7F3K2K>
                报错 SHALL 包含 EIDOLON_WINDOWS_SANDBOX_RUNNER 提示
                </?01M05F1PSX7H3BCZTESS7F3K2K>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
