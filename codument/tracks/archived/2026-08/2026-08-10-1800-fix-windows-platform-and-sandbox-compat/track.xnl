<Track #fix-windows-platform-and-sandbox-compat version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "修复 eidolon 在 Windows 上的环境感知与沙箱兼容：注入平台信息让 agent 感知 Windows，Windows sandbox 分级（runner 缺失时降级不 ENOENT），TUI 启动引导，扩宽 bash 豁免集。" description = "三个叠加问题：agent 无平台感知（只会用 POSIX 命令）、`uv_spawn 'eidolon-windows-sandbox-runner'` ENOENT（runner 缺失 + fail-closed 无降级）、bash 全被 deny（无 permissions.json + 豁免集太窄）。参考 Codex 的 Windows 方案（分级 sandbox、Disabled 降级、TUI 引导）实现修复。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-10T02:00:00Z" updated_at = "2026-08-10T10:00:00Z" gap_round = 1 } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
    <MaterialBundle { role = "state" name = "analysis" domain = "track" path = "vfs://./analysis/" }>
    <MaterialBundle { role = "output" name = "behavior" domain = "codument" path = "vfs://@/codument/behaviors/" }>
  ]>
  <TaskSpace #space_fix-windows-platform-and-sandbox-compat { name = "fix-windows-platform-and-sandbox-compat" } (
    <Description ?01M05F1PT01RV69RVW8Z8595SC>
    按 P1（平台注入 + bash 豁免）、P2（sandbox 分级降级）、P3（TUI 引导 + 显式报错）顺序实施；每 phase TDD（先失败测试后实现），终态 phase 跑 GapLoop 与 AttractorCheck。
    </?01M05F1PT01RV69RVW8Z8595SC>
    <SubNodes [
      <TaskGroup #P1 { name = "平台感知注入 + bash 豁免集" status = "DONE" order = 0 } (
        <Description ?01M05F1PT01RV69RVW8Z8595SD>
        让 agent 感知 Windows 并选用正确命令：systemPrompt 追加平台块，metadata 注入 platform/sandbox_permissions/exec_protocol，扩宽 workspace-safe bash 豁免集。
        </?01M05F1PT01RV69RVW8Z8595SD>
        <Gate [
          <Criterion ?01M05F1PT01RV69RVW8Z8595SE>
          buildSystemMessages 输出的系统提示词在 win32 上包含平台块。
          </?01M05F1PT01RV69RVW8Z8595SE>
          <Criterion ?01M05F1PT01RV69RVW8Z8595SF>
          normalizeTerminalRuntimeMetadata 注入 platform/sandbox_permissions/exec_protocol 默认值。
          </?01M05F1PT01RV69RVW8Z8595SF>
          <Criterion ?01M05F1PT01RV69RVW8Z8595SG>
          dir/where/type/findstr/git(只读) 等命令在无 permissions.json 时不 deny。
          </?01M05F1PT01RV69RVW8Z8595SG>
        ]>
        <SubNodes [
          <Task { id = "T1.1" name = "normalizeTerminalRuntimeMetadata 注入默认值" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PT01RV69RVW8Z8595SH>
            注入 platform=process.platform、sandbox_permissions（workspace-write/enabled/full-auto）、exec_protocol.mode=full-auto。写失败测试：win32 上 metadata 含 platform/sandbox_permissions/exec_protocol 默认。
            </?01M05F1PT01RV69RVW8Z8595SH>
            <Acceptance [
              <Criterion { id = "T1.1-AC1" checked = true } ?01M05F1PT01RV69RVW8Z8595SJ>
              win32 上 normalizeTerminalRuntimeMetadata 输出的 metadata 含 platform="win32"、sandbox_permissions.sandbox_mode="workspace-write"、exec_protocol.mode="full-auto"。
              </?01M05F1PT01RV69RVW8Z8595SJ>
            ]>
          )>
          <Task { id = "T1.2" name = "buildSystemMessages 追加平台块" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PT01RV69RVW8Z8595SK>
            系统提示词末尾追加平台块（platform/shell/路径分隔符/命令替代提示）。写失败测试：win32 上返回的 system messages 末尾含平台信息。
            </?01M05F1PT01RV69RVW8Z8595SK>
            <Acceptance [
              <Criterion { id = "T1.2-AC1" checked = true } ?01M05F1PT01RV69RVW8Z8595SM>
              win32 上 buildSystemMessages 返回的最后一条 system message 包含 "Windows"。
              </?01M05F1PT01RV69RVW8Z8595SM>
            ]>
          )>
          <Task { id = "T1.3" name = "扩宽 workspace-safe bash 豁免集" status = "DONE" order = 2 priority = "P0" } (
            <Description ?01M05F1PT01RV69RVW8Z8595SN>
            READ_ONLY_WORKSPACE_SAFE_BASH_COMMANDS 增加纯只读 Windows 命令：dir/where/type/tree/fc/more/findstr/ver。安全收敛：git 不加（子命令可写，如 reset/push），cmd/powershell/pwsh 不加（可执行任意命令）；此类命令在 full-auto 模式下走审批或权限规则，而非豁免。写失败测试：这些命令在空规则下不 deny。
            </?01M05F1PT01RV69RVW8Z8595SN>
            <Acceptance [
              <Criterion { id = "T1.3-AC1" checked = true } ?01M05F1PT01RV69RVW8Z8595SP>
              空权限规则下 dir/where/type/findstr 命令不被 deny。
              </?01M05F1PT01RV69RVW8Z8595SP>
              <Criterion { id = "T1.3-AC2" checked = true } ?01M05F1PT01RV69RVW8Z8595SQ>
              Bash/Tool.detail.xnl 含 Windows 命令提示。
              </?01M05F1PT01RV69RVW8Z8595SQ>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "Windows sandbox 分级 + Disabled 降级" status = "DONE" order = 1 } (
        <Description ?01M05F1PT01RV69RVW8Z8595SR>
        对齐 Codex exec.rs:516：Windows sandbox 三级（elevated/restricted-token/disabled），runner 缺失/未 setup 时走普通执行 + 权限检查，不再 ENOENT；bash 报错显式可诊断。
        </?01M05F1PT01RV69RVW8Z8595SR>
        <Gate [
          <Criterion ?01M05F1PT01RV69RVW8Z8595SS>
          runner 不存在时 resolveSandboxBackendSelection 返回 disabled 或显式 error（不 ENOENT）。
          </?01M05F1PT01RV69RVW8Z8595SS>
          <Criterion ?01M05F1PT01RV69RVW8Z8595ST>
          level=disabled 时 bash 走普通执行 + 保留文件权限检查。
          </?01M05F1PT01RV69RVW8Z8595ST>
          <Criterion ?01M05F1PT01RV69RVW8Z8595SV>
          runner 可用时仍走 windows-elevated。
          </?01M05F1PT01RV69RVW8Z8595SV>
        ]>
        <SubNodes [
          <Task { id = "T2.1" name = "SandboxSelection 增加 Windows level" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PT01RV69RVW8Z8595SW>
            SandboxBackendSelection 增加 windowsSandboxLevel（elevated/restricted-token/disabled）；resolveSandboxBackendSelection 按 runner 存在性/setup 状态解析。写失败测试。
            </?01M05F1PT01RV69RVW8Z8595SW>
            <Acceptance [
              <Criterion { id = "T2.1-AC1" checked = true } ?01M05F1PT01RV69RVW8Z8595SX>
              win32 + runner 缺失 → windowsSandboxLevel="disabled"。
              </?01M05F1PT01RV69RVW8Z8595SX>
              <Criterion { id = "T2.1-AC2" checked = true } ?01M05F1PT01RV69RVW8Z8595SY>
              win32 + runner 存在 + setup 完成 → "elevated"。
              </?01M05F1PT01RV69RVW8Z8595SY>
            ]>
          )>
          <Task { id = "T2.2" name = "buildSpawnSpec disabled 降级 + 显式报错" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PT01RV69RVW8Z8595SZ>
            windows-elevated 分支：runner 缺失返回显式 error（含安装/环境变量提示）；level=disabled 走 unsandboxed + 权限检查。写失败测试。
            </?01M05F1PT01RV69RVW8Z8595SZ>
            <Acceptance [
              <Criterion { id = "T2.2-AC1" checked = true } ?01M05F1PT01RV69RVW8Z8595T0>
              win32 + runner 缺失 + level=disabled → buildSpawnSpec 返回普通执行 spec（非 error）。
              </?01M05F1PT01RV69RVW8Z8595T0>
              <Criterion { id = "T2.2-AC2" checked = true } ?01M05F1PT01RV69RVW8Z8595T1>
              win32 + runner 缺失 + level=elevated（显式配置）→ 返回显式 error，含 EIDOLON_WINDOWS_SANDBOX_RUNNER 提示。
              </?01M05F1PT01RV69RVW8Z8595T1>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "TUI 启动引导 + 显式可诊断报错" status = "DONE" order = 2 } (
        <Description ?01M05F1PT01RV69RVW8Z8595T2>
        Windows 上 TUI 启动检测 sandbox 状态并引导（安装 runner / 非管理员 / 继续 unsandboxed）；bash 报错从 ENOENT 藏匿改为显式可诊断。
        </?01M05F1PT01RV69RVW8Z8595T2>
        <Gate [
          <Criterion ?01M05F1PT01RV69RVW8Z8595T3>
          TUI 在 Windows 检测 sandbox level 并触发引导（disabled/restricted 时）。
          </?01M05F1PT01RV69RVW8Z8595T3>
          <Criterion ?01M05F1PT01RV69RVW8Z8595T4>
          bash 报错包含缺失 runner 与安装/绕过提示。
          </?01M05F1PT01RV69RVW8Z8595T4>
          <Criterion ?01M05F1PT01RV69RVW8Z8595T5>
          非 Windows 平台行为不变。
          </?01M05F1PT01RV69RVW8Z8595T5>
        ]>
        <SubNodes [
          <Task { id = "T3.1" name = "WindowsSandbox 显式报错" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PT01RV69RVW8Z8595T6>
            WindowsSandbox.ts / SandboxBackendRuntime 的 error 消息改为显式可诊断（缺什么、EIDOLON_WINDOWS_SANDBOX_RUNNER、绕过选项）。写失败测试。
            </?01M05F1PT01RV69RVW8Z8595T6>
            <Acceptance [
              <Criterion { id = "T3.1-AC1" checked = true } ?01M05F1PT01RV69RVW8Z8595T7>
              runner 缺失的报错包含 "EIDOLON_WINDOWS_SANDBOX_RUNNER"。
              </?01M05F1PT01RV69RVW8Z8595T7>
            ]>
          )>
          <Task { id = "T3.2" name = "TUI 启动引导" status = "DONE" order = 1 priority = "P1" } (
            <Description ?01M05F1PT01RV69RVW8Z8595T8>
            生产 TUI 入口 thread.ts 的 handler 在 configureTuiRuntime 前调用 maybeWarnWindowsSandbox（win32 + runner 缺失时输出引导提示：安装 runner / 设 EIDOLON_WINDOWS_SANDBOX_RUNNER / 用 --dangerously-bypass-approvals-and-sandbox 抑制）。tui_a1-main.ts 是 dev-only 脚本入口（entry/index.ts 路由到 thread.ts），故生产路径已覆盖。
            </?01M05F1PT01RV69RVW8Z8595T8>
            <Acceptance [
              <Criterion { id = "T3.2-AC1" checked = true } ?01M05F1PT01RV69RVW8Z8595T9>
              win32 + level=disabled → 触发引导提示。
              </?01M05F1PT01RV69RVW8Z8595T9>
              <Criterion { id = "T3.2-AC2" checked = true } ?01M05F1PT01RV69RVW8Z8595TA>
              非 win32 → 不触发引导。
              </?01M05F1PT01RV69RVW8Z8595TA>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P4 { name = "收口验证" status = "DONE" order = 3 } (
        <Description ?01M05F1PT01RV69RVW8Z8595TB>
        全量相关测试、strict codument validate、Windows 行为验证（平台注入 + sandbox 降级 + bash 豁免）。
        </?01M05F1PT01RV69RVW8Z8595TB>
        <Gate [
          <Criterion ?01M05F1PT01RV69RVW8Z8595TC>
          相关单测与回归全绿。
          </?01M05F1PT01RV69RVW8Z8595TC>
          <Criterion ?01M05F1PT01RV69RVW8Z8595TD>
          strict codument validate 通过。
          </?01M05F1PT01RV69RVW8Z8595TD>
          <Criterion ?01M05F1PT01RV69RVW8Z8595TE>
          真实 Windows 会话上 bash 可执行（dir/where/findstr 可用），不再 ENOENT。
          </?01M05F1PT01RV69RVW8Z8595TE>
          <Criterion ?01M05F1PT01RV69RVW8Z8595TF>
          diff 审查确认无无关改动。
          </?01M05F1PT01RV69RVW8Z8595TF>
        ]>
        <SubNodes [
          <Task { id = "T4.1" name = "全量验证" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PT01RV69RVW8Z8595TG>
            运行测试套件、strict validate、Windows 上实机验证平台注入与 bash 豁免。
            </?01M05F1PT01RV69RVW8Z8595TG>
            <Acceptance [
              <Criterion { id = "T4.1-AC1" checked = true } ?01M05F1PT01RV69RVW8Z8595TH>
              测试与 validate 通过。
              </?01M05F1PT01RV69RVW8Z8595TH>
              <Criterion { id = "T4.1-AC2" checked = true } ?01M05F1PT01RV69RVW8Z8595TJ>
              Windows 实机验证结果记录在 analysis/findings.md。
              </?01M05F1PT01RV69RVW8Z8595TJ>
            ]>
          )>
        ]>
        <Hooks [
          <Hook { on = "phase:after" } (
            <GapLoop { max_rounds = 5 on_exhausted = "block" verify_round = false }>
          )>
          <Hook { on = "phase:after" } (
            <AttractorCheck { use = "coding" }>
          )>
        ]>
      )>
    ]>
  )>
)>
