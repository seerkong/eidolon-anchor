              </?01M05F1PT3GYZSYPPXDBCC2K95>
              <Criterion { id = "T2.1-AC2" checked = false } ?01M05F1PT3GYZSYPPXDBCC2K96>
              setup 完成后写 marker 文件。
              </?01M05F1PT3GYZSYPPXDBCC2K96>
            ]>
          )>
          <Task { id = "T2.2" name = "wfp.zig: WFP 网络过滤" status = "DONE" order = 1 priority = "P1" } (
            <Description ?01M05F1PT3GYZSYPPXDBCC2K97>
