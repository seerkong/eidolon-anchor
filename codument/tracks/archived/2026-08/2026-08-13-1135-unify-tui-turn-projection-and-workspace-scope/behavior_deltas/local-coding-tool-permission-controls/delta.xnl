<BehaviorPatch #track.r_2_0_2_6_-_0_8_-_1_3_-_1_1_3_5_-_u_n_i_f_y_-_t_u_i_-_t_u_r_n_-_p_r_o_j_e_c_t_i_o_n_-_a_n_d_-_w_o_r_k_s_p_a_c_e_-_s_c_o_p_e.behavior_patch.local-coding-tool-permission-controls apiVersion="codument.tech/v1alpha1" version="1" { capability = "local-coding-tool-permission-controls" } (
  <Mutations [
    <Upsert { selector = "behavior://local-coding-tool-permission-controls/requirements/explicit-file-tool-scope-intent" } (
      <Requirement #explicit-file-tool-scope-intent (
        <Statement ?01M05F1PT5GWTFKG5PVB5PRCW7>
        文件工具 SHALL 接受结构化 `scopeIntent=workspace|external`，默认值 SHALL 为 workspace；workspace intent 解析到 workspace 外路径时 SHALL fail closed 并返回可恢复诊断，MUST NOT 发起父级目录授权、静默重写路径或从路径文本猜测意图。只有 explicit external intent 才 SHALL 进入 workspace-access grant policy。
        </?01M05F1PT5GWTFKG5PVB5PRCW7>
        <Suites [
          <Suite #intent-gate { name = "访问意图门控" } (
            <Cases [
              <Case #workspace-ancestor-does-not-prompt [
                <Then ?01M05F1PT5GWTFKG5PVB5PRCW8>
                系统 SHALL 拒绝并建议使用 `.` 或 workspace-relative path
                </?01M05F1PT5GWTFKG5PVB5PRCW8>
                <Then ?01M05F1PT5GWTFKG5PVB5PRCW9>
                系统 MUST NOT 为父目录创建授权 questionnaire
                </?01M05F1PT5GWTFKG5PVB5PRCW9>
              ] (
                <Given ?01M05F1PT5GWTFKG5PVB5PRCWA>
                当前 workspace 为一个子目录，文件工具省略 scopeIntent 或指定 workspace
                </?01M05F1PT5GWTFKG5PVB5PRCWA>
                <When ?01M05F1PT5GWTFKG5PVB5PRCWB>
                调用请求该 workspace 的父目录
                </?01M05F1PT5GWTFKG5PVB5PRCWB>
              )>
              <Case #external-intent-enters-grant-policy (
                <Given ?01M05F1PT5GWTFKG5PVB5PRCWC>
                调用显式指定 scopeIntent=external 且目标位于 workspace 外
                </?01M05F1PT5GWTFKG5PVB5PRCWC>
                <When ?01M05F1PT5GWTFKG5PVB5PRCWD>
                目标尚未在 workspace-access map 授权
                </?01M05F1PT5GWTFKG5PVB5PRCWD>
                <Then ?01M05F1PT5GWTFKG5PVB5PRCWE>
                系统 SHALL 通过正式 grant policy/questionnaire 处理，不得自动允许
                </?01M05F1PT5GWTFKG5PVB5PRCWE>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://local-coding-tool-permission-controls/requirements/least-privilege-external-grant-modes" } (
      <Requirement #least-privilege-external-grant-modes (
        <Statement ?01M05F1PT5GWTFKG5PVB5PRCWF>
        外部目录授权 questionnaire SHALL 区分 one-time 与 persistent grant；read 型请求的推荐快捷选项 SHALL 是 one-time read 或 persistent read，persistent read-write SHALL 只作为显式高级选项。one-time grant MUST NOT 写入 `workspace-access.json`，persistent grant SHALL 继续由现有 workspace-access authority 持久化。
        </?01M05F1PT5GWTFKG5PVB5PRCWF>
        <Suites [
          <Suite #grant-modes { name = "最小权限授权" } (
            <Cases [
              <Case #one-time-read-replays-without-persisting [
                <Then ?01M05F1PT5GWTFKG5PVB5PRCWG>
                系统 SHALL 仅重放当前工具调用
                </?01M05F1PT5GWTFKG5PVB5PRCWG>
                <Then ?01M05F1PT5GWTFKG5PVB5PRCWH>
                系统 MUST NOT 修改 workspace-access.json
                </?01M05F1PT5GWTFKG5PVB5PRCWH>
              ] (
                <Given ?01M05F1PT5GWTFKG5PVB5PRCWJ>
                external read 请求进入授权问卷
                </?01M05F1PT5GWTFKG5PVB5PRCWJ>
                <When ?01M05F1PT5GWTFKG5PVB5PRCWK>
                用户选择 one-time read
                </?01M05F1PT5GWTFKG5PVB5PRCWK>
              )>
              <Case #persistent-read-write-is-advanced (
                <Given ?01M05F1PT5GWTFKG5PVB5PRCWM>
                read 型 external 请求进入授权问卷
                </?01M05F1PT5GWTFKG5PVB5PRCWM>
                <When ?01M05F1PT5GWTFKG5PVB5PRCWN>
                TUI 展示选项
                </?01M05F1PT5GWTFKG5PVB5PRCWN>
                <Then ?01M05F1PT5GWTFKG5PVB5PRCWP>
                persistent read-write MUST NOT 与推荐 read 选项等权并列
                </?01M05F1PT5GWTFKG5PVB5PRCWP>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
