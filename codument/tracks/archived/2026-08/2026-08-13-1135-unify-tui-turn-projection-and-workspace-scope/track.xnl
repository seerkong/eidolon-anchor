<Track #unify-tui-turn-projection-and-workspace-scope version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "统一 TUI 三入口的 typed turn 投影与 durable reconciliation，并用显式 scope intent 避免 workspace 父目录过宽授权" description = "修复 assistant/tool/context 重复或错卡，以及 workspace 文件操作误触发父级目录授权" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-13T07:47:24Z" updated_at = "2026-08-13T08:35:00Z" } (
