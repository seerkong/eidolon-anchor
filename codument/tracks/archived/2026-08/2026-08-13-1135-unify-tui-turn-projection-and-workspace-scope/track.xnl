            <Acceptance [
              <Criterion { id = "T2.2-AC1" checked = true } ?01M05F1PTBQS2R025B07RP956E>
              重复 hydrate/resync 不创建新随机 identity 或重复卡片
              </?01M05F1PTBQS2R025B07RP956E>
              <Criterion { id = "T2.2-AC2" checked = true } ?01M05F1PTBQS2R025B07RP956F>
              仅 user role 显示为 USER；tool 保留 toolCallId
              </?01M05F1PTBQS2R025B07RP956F>
              <Criterion { id = "T2.2-AC3" checked = true } ?01M05F1PTBQS2R025B07RP956G>
