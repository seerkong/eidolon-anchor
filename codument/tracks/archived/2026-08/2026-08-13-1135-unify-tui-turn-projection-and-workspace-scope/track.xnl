              </?01M05F1PTBQS2R025B07RP956G>
              <Criterion { id = "T2.2-AC4" checked = true } ?01M05F1PTBQS2R025B07RP956H>
              typed context metadata 经既有 conversation persistence/read port 在冷启动 hydration 后仍可恢复
              </?01M05F1PTBQS2R025B07RP956H>
            ]>
          )>
        ]>
        <Gate [
          <Criterion ?01M05F1PTBQS2R025B07RP956J>
          P2 所有任务 DONE，history/context projection 测试通过
          </?01M05F1PTBQS2R025B07RP956J>
        ]>
      )>
      <TaskGroup #P3 { name = "收紧 workspace 文件访问意图" status = "DONE" order = 2 } (
