              </?01M05F1PTBQS2R025B07RP9566>
              <Criterion { id = "T1.2-AC3" checked = true } ?01M05F1PTBQS2R025B07RP9567>
              同一 actorId+toolCallId 仅一个 ToolPart，live 与 durable 可合并
              </?01M05F1PTBQS2R025B07RP9567>
            ]>
          )>
        ]>
        <Gate [
          <Criterion ?01M05F1PTBQS2R025B07RP9568>
          P1 所有任务 DONE，三入口投影测试通过
          </?01M05F1PTBQS2R025B07RP9568>
        ]>
      )>
      <TaskGroup #P2 { name = "修复历史角色与 context resource 投影" status = "DONE" order = 1 } (
        <Description ?01M05F1PTBQS2R025B07RP9569>
        让 durable history 保持稳定 identity，并阻止 tool/system/context 被投为 USER
        </?01M05F1PTBQS2R025B07RP9569>
        <SubNodes [
          <Task { id = "T2.1" name = "编写 role、resync 与 context card 失败测试" status = "DONE" order = 0 priority = "P0" } (
