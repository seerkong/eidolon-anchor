    <MaterialBundle { role = "output" name = "implementation" domain = "code" path = "vfs://@/" }>
  ]>
  <TaskSpace #space_unify-tui-turn-projection-and-workspace-scope { name = "unify-tui-turn-projection-and-workspace-scope" } (
    <Description ?01M05F1PTBQS2R025B07RP955Z>
    以测试先行方式统一 surface 投影、历史角色/context resource 与 workspace scope 权限
    </?01M05F1PTBQS2R025B07RP955Z>
    <SubNodes [
      <TaskGroup #P1 { name = "冻结三入口投影契约" status = "DONE" order = 0 } (
        <Description ?01M05F1PTBQS2R025B07RP9560>
        建立 prompt、command、questionnaire continuation 的等价行为与重复问题回归测试
        </?01M05F1PTBQS2R025B07RP9560>
        <SubNodes [
          <Task { id = "T1.1" name = "编写三入口 category 与 identity 失败测试" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M05F1PTBQS2R025B07RP9561>
            参数化同一 semantic sequence，验证隐藏类别、thinking/assistant 分流、单一 tool identity 与 continuation onControl
            </?01M05F1PTBQS2R025B07RP9561>
            <Acceptance [
              <Criterion { id = "T1.1-AC1" checked = true } ?01M05F1PTBQS2R025B07RP9562>
              测试能复现 continuation 把 turn/tool/result 写入 assistant 的现状
              </?01M05F1PTBQS2R025B07RP9562>
              <Criterion { id = "T1.1-AC2" checked = true } ?01M05F1PTBQS2R025B07RP9563>
              测试覆盖 prompt、slash command、questionnaire continuation 三入口等价
              </?01M05F1PTBQS2R025B07RP9563>
            ]>
          )>
          <Task { id = "T1.2" name = "实现单一 turn surface projector" status = "DONE" order = 1 priority = "P0" } (
            <Description ?01M05F1PTBQS2R025B07RP9564>
            抽取 typed projector/state owner 并让三入口共同委托 control/chunk/history/final reconciliation，删除重复逻辑
            </?01M05F1PTBQS2R025B07RP9564>
            <Acceptance [
              <Criterion { id = "T1.2-AC1" checked = true } ?01M05F1PTBQS2R025B07RP9565>
              三入口共享同一个 projector factory/adapter，无三份 assistant/tool state machine
              </?01M05F1PTBQS2R025B07RP9565>
              <Criterion { id = "T1.2-AC2" checked = true } ?01M05F1PTBQS2R025B07RP9566>
