<BehaviorPatch #track.adopt-halfcode-system-skill-distribution.behavior_patch.eidolon-system-skill-distribution apiVersion="codument.tech/v1alpha1" version="1" { capability = "eidolon-system-skill-distribution" } (
  <Mutations [
    <Upsert { selector = "behavior://eidolon-system-skill-distribution/requirements/halfcode-backed-global-init" } (
      <Requirement #halfcode-backed-global-init (
        <Statement ?01M05F1P79K77E28H959Z0CV4F>
        Eidolon SHALL consume canonical Halfcode Skill distribution plans through one whole-root global Skill transaction, preserve non-managed user assets, and expose exact manifest-bound system Skill reads without duplicating capsule dependency or content authority.
        </?01M05F1P79K77E28H959Z0CV4F>
        <Suites [
          <Suite #plan-consumption { name = "Canonical generated Skill consumption" } (
            <Cases [
              <Case #resource-dsl-plan [
                <Then ?01M05F1P79K77E28H959Z0CV4G>
                Eidolon SHALL invoke the Halfcode plan/applier in an isolated output root and install the receipt-proven `sys-halfcode-resource-dsl` identity
                </?01M05F1P79K77E28H959Z0CV4G>
                <Then ?01M05F1P79K77E28H959Z0CV4H>
                Eidolon MUST NOT copy the Resource DSL source tree or reimplement dependency topology, collision, target or content validation
                </?01M05F1P79K77E28H959Z0CV4H>
              ] (
                <Given ?01M05F1P79K77E28H959Z0CV4J>
                Halfcode 0.2.2 provides the immutable Resource DSL system Skill distribution plan
                </?01M05F1P79K77E28H959Z0CV4J>
                <When ?01M05F1P79K77E28H959Z0CV4K>
                the user runs `eidolon global init`
                </?01M05F1P79K77E28H959Z0CV4K>
              )>
              <Case #transitional-eidolon-skill (
                <Given ?01M05F1P79K77E28H959Z0CV4M>
                the final Eidolon Anchor Skill split has not yet been applied
                </?01M05F1P79K77E28H959Z0CV4M>
                <When ?01M05F1P79K77E28H959Z0CV4N>
                the managed candidate set is assembled
                </?01M05F1P79K77E28H959Z0CV4N>
                <Then ?01M05F1P79K77E28H959Z0CV4P>
                `sys-ai-workflow` SHALL remain installed on the `1.0.x` line as a transitional host-owned source
                </?01M05F1P79K77E28H959Z0CV4P>
              )>
            ]>
          )>
          <Suite #whole-root-transaction { name = "Whole Skill tree transaction" } (
            <Cases [
              <Case #single-visible-swap [
                <Then ?01M05F1P79K77E28H959Z0CV4Q>
                Eidolon SHALL materialize and read back a complete same-parent candidate before replacing the live `skills` root once
                </?01M05F1P79K77E28H959Z0CV4Q>
                <Then ?01M05F1P79K77E28H959Z0CV4R>
                ordinary non-managed assets SHALL be preserved and previous managed versions SHALL not remain visible
                </?01M05F1P79K77E28H959Z0CV4R>
              ] (
                <Given ?01M05F1P79K77E28H959Z0CV4S>
                the live Skill root contains managed system Skills and ordinary user assets
                </?01M05F1P79K77E28H959Z0CV4S>
                <When ?01M05F1P79K77E28H959Z0CV4T>
                global init installs the candidate managed set
                </?01M05F1P79K77E28H959Z0CV4T>
              )>
              <Case #interrupted-reconciliation [
                <Then ?01M05F1P79K77E28H959Z0CV4V>
                the previous complete live tree SHALL remain byte-identical or be restored from a retained diagnosable backup
                </?01M05F1P79K77E28H959Z0CV4V>
                <Then ?01M05F1P79K77E28H959Z0CV4W>
                the installer MUST NOT report success with a mixed managed set or silently discard restoration evidence
                </?01M05F1P79K77E28H959Z0CV4W>
              ] (
                <Given ?01M05F1P79K77E28H959Z0CV4X>
                a controlled interruption occurs during plan application, candidate readback, live swap or final readback
                </?01M05F1P79K77E28H959Z0CV4X>
                <When ?01M05F1P79K77E28H959Z0CV4Y>
                the installer exits with an error
                </?01M05F1P79K77E28H959Z0CV4Y>
              )>
              <Case #repeat-idempotence (
                <Given ?01M05F1P79K77E28H959Z0CV4Z>
                the installed tree already equals the current managed plans
                </?01M05F1P79K77E28H959Z0CV4Z>
                <When ?01M05F1P79K77E28H959Z0CV50>
                global init runs again
                </?01M05F1P79K77E28H959Z0CV50>
                <Then ?01M05F1P79K77E28H959Z0CV51>
                the resulting managed files, manifest and preserved user assets SHALL be byte-equivalent
                </?01M05F1P79K77E28H959Z0CV51>
              )>
            ]>
          )>
          <Suite #manifest-authority { name = "Installed system Skill readback" } (
            <Cases [
              <Case #exact-manifest-bound-read [
                <Then ?01M05F1P79K77E28H959Z0CV52>
                the identity and path SHALL be present in `.system-skills.xnl` and the read bytes SHALL match its recorded digest
                </?01M05F1P79K77E28H959Z0CV52>
                <Then ?01M05F1P79K77E28H959Z0CV53>
                unknown identities, duplicate entries, unsafe paths and digest drift SHALL fail closed
                </?01M05F1P79K77E28H959Z0CV53>
              ] (
                <Given ?01M05F1P79K77E28H959Z0CV54>
                a caller requests a system Skill resource by exact identity and relative path
                </?01M05F1P79K77E28H959Z0CV54>
                <When ?01M05F1P79K77E28H959Z0CV55>
                the generic system Skill loader reads the resource
                </?01M05F1P79K77E28H959Z0CV55>
              )>
              <Case #compatibility-stage-wrapper (
                <Given ?01M05F1P79K77E28H959Z0CV56>
                the AI Workflow actor requests an explicit DevOps stage
                </?01M05F1P79K77E28H959Z0CV56>
                <When ?01M05F1P79K77E28H959Z0CV57>
                the compatibility stage wrapper composes context
                </?01M05F1P79K77E28H959Z0CV57>
                <Then ?01M05F1P79K77E28H959Z0CV58>
                it SHALL delegate exact file reads to the generic manifest-bound loader and preserve current stage isolation
                </?01M05F1P79K77E28H959Z0CV58>
              )>
              <Case #global-authority [
                <Then ?01M05F1P79K77E28H959Z0CV59>
                only exact identities declared by the installed global manifest SHALL enter the runtime Skill registry
                </?01M05F1P79K77E28H959Z0CV59>
                <Then ?01M05F1P79K77E28H959Z0CV5A>
                unlisted global identities and every workspace `sys-*` entry MUST NOT enter system authority
                </?01M05F1P79K77E28H959Z0CV5A>
              ] (
                <Given ?01M05F1P79K77E28H959Z0CV5B>
                global or workspace Skill roots contain a `sys-*` identity
                </?01M05F1P79K77E28H959Z0CV5B>
                <When ?01M05F1P79K77E28H959Z0CV5C>
                runtime loads Skill entries
                </?01M05F1P79K77E28H959Z0CV5C>
              )>
              <Case #physical-managed-root (
                <Given ?01M05F1P79K77E28H959Z0CV5D>
                a managed Skill root or declared file is replaced by a symbolic link or escapes the physical global Skill root
                </?01M05F1P79K77E28H959Z0CV5D>
                <When ?01M05F1P79K77E28H959Z0CV5E>
                runtime or the manifest-bound resource loader reads that Skill
                </?01M05F1P79K77E28H959Z0CV5E>
                <Then ?01M05F1P79K77E28H959Z0CV5F>
                the read SHALL fail closed before returning Skill content
                </?01M05F1P79K77E28H959Z0CV5F>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
