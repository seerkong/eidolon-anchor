<Track #adopt-halfcode-system-skill-distribution version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "让 `eidolon global init` 复用 Halfcode Skill distribution plan，并以整棵 global Skill 树 transaction 安装统一托管集合。" description = "安装过渡期 sys-ai-workflow 与 generated sys-halfcode-resource-dsl，建立 manifest-bound loader、ordinary Skill 保留和可恢复 whole-root swap。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-16T10:57:00Z" updated_at = "2026-08-16T13:30:00Z" } (
