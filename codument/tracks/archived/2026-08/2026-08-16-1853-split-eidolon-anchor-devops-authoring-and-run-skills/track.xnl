            ]>
          )>
          <Task { id = "T4.2" name = "验证单一 compiler、无旧 authority 与无模糊 host 语义" status = "DONE" order = 1 priority = "P0" } (
            <Acceptance [
              <Criterion { id = "T4.2-AC1" checked = true } ?01M05F1P8JHX8CQA4WWCTTTECG>
              production 无 BUNDLED_SYSTEM_SKILLS、旧 assets/sys-ai-workflow、system-skill.xnl、手工 Flow DSL 正文或第五个 Skill
              </?01M05F1P8JHX8CQA4WWCTTTECG>
              <Criterion { id = "T4.2-AC2" checked = true } ?01M05F1P8JHX8CQA4WWCTTTECH>
              production 不以 regex、keyword、substring、ordered heuristic 或别名决定 stage、Kind、topology、operation 或 authorization
              </?01M05F1P8JHX8CQA4WWCTTTECH>
              <Criterion { id = "T4.2-AC3" checked = true } ?01M05F1P8JHX8CQA4WWCTTTECJ>
              Halfcode 是 dependency/topology/content plan 唯一 authority；Eidolon 仅拥有 global binding、readback、whole-root transaction 和 context delivery
              </?01M05F1P8JHX8CQA4WWCTTTECJ>
            ]>
          )>
        ]>
        <Gate [
          <Criterion { checked = true } ?01M05F1P8JHX8CQA4WWCTTTECK>
          四 Skill 安装、渐进加载、旧 identity 退出和 compiled product evidence 完整
          </?01M05F1P8JHX8CQA4WWCTTTECK>
        ]>
        <Hooks [
          <Hook { on = "phase:after" } (
            <AttractorCheck { use = "coding" }>
          )>
        ]>
      )>
    ]>
  )>
  <Schedule [
    <Parallel { max_concurrent = 1 spot_check = true }>
  ]>
  <Hooks>
)>
