<Track #split-eidolon-anchor-devops-authoring-and-run-skills version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "以一个 Halfcode distribution closure 安装 sys-halfcode-resource-dsl 与三个职责分离的 Eidolon Anchor 系统 Skill，并退出旧 sys-ai-workflow authority。" description = "组合已发布的 Halfcode Resource DSL module、depa Flow DSL reference module 与 Eidolon-owned SkillCapsules，生成四 Skill 计划；迁移 global init、渐进资源加载和 workflow actor prompt authority。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-16T14:12:13Z" updated_at = "2026-08-16T15:53:52Z" } (
  <Ports { scope = "track" } [
