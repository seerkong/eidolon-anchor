<BehaviorPatch #track.verify-eidolon-resource-native-app-lifecycle.behavior_patch.eidolon-ai-workflow-native-capability apiVersion="codument.tech/v1alpha1" version="1" { capability = "eidolon-ai-workflow-native-capability" } (
  <Mutations [
    <Upsert { selector = "behavior://eidolon-ai-workflow-native-capability/requirements/resource-native-app-lifecycle-acceptance" } (
      <Requirement #resource-native-app-lifecycle-acceptance (
        <Statement ?01M05F2B000000000000000001>
        Eidolon SHALL let one ordinary-language workflow session create a resource-native App, stop at independent publication and execution gates, then run and recover through shared Halfcode, depa, native component and generic actor/session authorities without host semantic heuristics.
        </?01M05F2B000000000000000001>
        <Suites [
          <Suite #isolated-real-provider { name = "Isolated compiled-product journey" } (
            <Cases [
              <Case #fresh-current-provider (
                <Given ?01M05F2B000000000000000002>
                a current compiled Eidolon, current provider preset and new isolated HOME/global/workspace
                </?01M05F2B000000000000000002>
                <When ?01M05F2B000000000000000003>
                global init and the natural-language lifecycle run
                </?01M05F2B000000000000000003>
                <Then ?01M05F2B000000000000000004>
                exactly four managed Skills SHALL be used and no credential or real user asset SHALL enter durable acceptance evidence
                </?01M05F2B000000000000000004>
              )>
              <Case #lifecycle-independent-gates [
                <Then ?01M05F2B000000000000000005>
                create SHALL leave a recoverable un-published revision, publication authorization SHALL publish without execution, and execution authorization SHALL alone create the run
                </?01M05F2B000000000000000005>
              ] (
                <Given ?01M05F2B000000000000000006>
                one explicit durable workflow session
                </?01M05F2B000000000000000006>
                <When ?01M05F2B000000000000000007>
                three ordinary-language turns grant create, publication and execution authority in order
                </?01M05F2B000000000000000007>
              )>
            ]>
          )>
          <Suite #resource-runtime-closure { name = "Resource and runtime evidence closure" } (
            <Cases [
              <Case #typed-resource-freeze [
                <Then ?01M05F2B000000000000000008>
                the published App, Workflow, exact AIAgentDefinition, Material bindings and dependency snapshot SHALL resolve through Halfcode and depa typed projections
                </?01M05F2B000000000000000008>
                <Then ?01M05F2B000000000000000009>
                run facts SHALL remain separate from immutable source and publication facts
                </?01M05F2B000000000000000009>
              ] (
                <Given ?01M05F2B00000000000000000A>
                an exact prepared resource-native App revision
                </?01M05F2B00000000000000000A>
                <When ?01M05F2B00000000000000000B>
                it is published, instantiated and run
                </?01M05F2B00000000000000000B>
              )>
              <Case #shared-cross-surface-evidence (
                <Given ?01M05F2B00000000000000000C>
                a terminal session, publication receipt, instance and run exist
                </?01M05F2B00000000000000000C>
                <When ?01M05F2B00000000000000000D>
                CLI, TUI and native read paths inspect them
                </?01M05F2B00000000000000000D>
                <Then ?01M05F2B00000000000000000E>
                all surfaces SHALL observe the same registry revision, identities, result, events and replay evidence
                </?01M05F2B00000000000000000E>
              )>
            ]>
          )>
          <Suite #fact-driven-responsiveness { name = "Fact-driven recovery and responsiveness" } (
            <Cases [
              <Case #timing-authority (
                <Given ?01M05F2B00000000000000000F>
                a real provider turn completes or fails
                </?01M05F2B00000000000000000F>
                <When ?01M05F2B00000000000000000G>
                responsiveness is evaluated
                </?01M05F2B00000000000000000G>
                <Then ?01M05F2B00000000000000000H>
                wall, provider wait/generation, tool and product-owned durations SHALL be reported separately from existing domain timestamps
                </?01M05F2B00000000000000000H>
              )>
              <Case #no-semantic-fallback [
                <Then ?01M05F2B00000000000000000J>
                repairs MUST NOT add regex, keyword, substring, ordered, fuzzy or alias routing from natural language, node labels or App/workflow names
                </?01M05F2B00000000000000000J>
                <Then ?01M05F2B00000000000000000K>
                provider limitations SHALL remain explicit provider facts rather than fabricated workflow success
                </?01M05F2B00000000000000000K>
              ] (
                <Given ?01M05F2B00000000000000000M>
                the journey reports a stable provider, tool or runtime diagnostic
                </?01M05F2B00000000000000000M>
                <When ?01M05F2B00000000000000000N>
                the product is corrected or the run is classified
                </?01M05F2B00000000000000000N>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
