<Track #repair-responses-canonical-replay apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "Restore complete Responses canonical replay after rewind and tool rounds without reusing Chat adjacency repair." description = "Make Responses request construction replay every canonical assistant function call and tool output in order, keep frontier stable across tool completion, and invalidate stale optimization after history rewinds." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-19T19:03:00.933Z" updated_at = "2026-08-19T19:11:41.433Z" modeling_base_commit = "da0f0691b7782ecc6585702c2036a86ad9b59aa0" engineering_base_commit = "da0f0691b7782ecc6585702c2036a86ad9b59aa0" } (
