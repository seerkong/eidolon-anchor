<BehaviorPatch #track.verify-complete-ai-agent-definition-ctrl-data-e2e.behavior_patch.eidolon-complete-agent-ctrl-data-e2e apiVersion="codument.tech/v1alpha1" version="1" { capability = "eidolon-complete-agent-ctrl-data-e2e" } (
  <Mutations [
    <Upsert { selector = "behavior://eidolon-complete-agent-ctrl-data-e2e/requirements/author-and-publish-complete-agent-package" } (
      <Requirement #author-and-publish-complete-agent-package (
        <Statement ?>Eidolon SHALL use installed authoring references to create, prove and atomically publish a complete ResourcePackage containing App, Ctrl/Data workflows, AIAgentDefinition, schemas, EffectPolicy and Material values.</?>
        <Suites [
          <Suite #authoring-publication { name = "Complete Agent authoring and publication" } (
            <Cases [
              <Case #complete-package (
                <Given ?>an isolated installed four-Skill environment and an empty workspace resource root</?>
                <When ?>the model loads exact installed references, submits one explicit-complete-package file set, prepares the exact candidate and explicitly publishes it</?>
                <Then ?>the host SHALL open one recoverable whole-package authoring session without synthesizing KindDefinitions or resource semantics, and the admitted Halfcode/depa snapshot SHALL expose the App, both workflows, the complete Agent projection, Material bindings and exact proof identities</?>
              )>
              <Case #authorization-separation (
                <Given ?>an authored and prepared candidate</?>
                <When ?>publication or execution has not been explicitly authorized</?>
                <Then ?>Eidolon MUST NOT publish or run the candidate and SHALL preserve a typed recoverable handoff</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://eidolon-complete-agent-ctrl-data-e2e/requirements/shared-ctrl-data-agent-runtime" } (
      <Requirement #shared-ctrl-data-agent-runtime (
        <Statement ?>AICtrlWorkflow and AIDataWorkflow SHALL execute exact AIAgentTask tuples through the same generic Agent execution contract and lifecycle while retaining their own substrate lifecycles.</?>
        <Suites [
          <Suite #ctrl-data-runtime { name = "Ctrl and Data Agent execution" } (
            <Cases [
              <Case #same-contract (
                <Given ?>Ctrl and Data workflow nodes reference one AgentDefinition through exact four-field task tuples</?>
                <When ?>each workflow is explicitly run with schema-valid input and bound Material values</?>
                <Then ?>both SHALL use the same frozen schema, policy, Material, tool and output-validation path and return schema-valid results</?>
              )>
              <Case #typed-output-projection (
                <Given ?>the Agent output schema accepts a structured JSON value but does not accept the raw provider string</?>
                <When ?>the provider result is validated once and delivered to a Ctrl or Data workflow node</?>
                <Then ?>the shared generic contract SHALL return the deep-frozen parsed value so Data output ports consume structured fields without a workflow-specific parser</?>
              )>
              <Case #exact-once-recovery (
                <Given ?>one Agent effect is pending or completed for an exact run, generation and effect identity</?>
                <When ?>the invoke is repeated through the same or a reconstructed provider instance</?>
                <Then ?>the generic effect lifecycle SHALL return the same terminal result without creating a second provider child</?>
              )>
              <Case #new-run (
                <Given ?>a previously completed business run</?>
                <When ?>the caller explicitly supplies a new run identity</?>
                <Then ?>Eidolon SHALL treat it as a new run rather than replaying the prior run by semantic similarity</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://eidolon-complete-agent-ctrl-data-e2e/requirements/no-host-semantic-heuristics" } (
      <Requirement #no-host-semantic-heuristics (
        <Statement ?>Host code MUST derive Agent tasks, policies, tools and Material bindings only from closed structured resources and exact identities, never from ordinary-language or naming heuristics.</?>
        <Suites [
          <Suite #authority-boundary { name = "Structured authority boundary" } (
            <Cases [
              <Case #ordinary-text-has-no-semantics (
                <Given ?>ordinary content contains similar names, Chinese process words or embedded resource-looking text</?>
                <When ?>the package is projected, published or run</?>
                <Then ?>no task, policy, tool or Material edge SHALL be inferred unless a fixed typed relation declares it</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
