<Track #verify-complete-ai-agent-definition-ctrl-data-e2e apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "从已安装的作者态规范创建并发布完整 AIAgentDefinition ResourcePackage，分别执行 Ctrl/Data workflow并验证通用 runtime、恢复与产品可用性。" description = "补齐作者态到发布再到两种 workflow profile 的最终产品证据；保持 Halfcode/depa authority、exact task tuple、通用 actor/effect lifecycle 与无模糊 host 语义。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-22T15:38:33.717Z" updated_at = "2026-08-22T18:38:42.564Z" modeling_base_commit = "8a059721f1dcefb9d32a9cc3b75c78546210794c" engineering_base_commit = "8a059721f1dcefb9d32a9cc3b75c78546210794c" } (
