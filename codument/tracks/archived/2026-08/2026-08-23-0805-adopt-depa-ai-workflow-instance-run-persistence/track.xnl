<Track #adopt-depa-ai-workflow-instance-run-persistence apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "让 Eidolon 以 depa-flows 的 frozen Instance 与单一 FlowRunCheckpoint 作为 AI Workflow 持久化 authority。" description = "升级并接入已发布 depa runtime，迁移 WorkflowFactStore flat facts，统一 Ctrl/Data fresh-process recovery 与可检查 instance capsule。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-23T03:26:52.143Z" updated_at = "2026-08-23T05:05:41.987Z" modeling_base_commit = "8a059721f1dcefb9d32a9cc3b75c78546210794c" engineering_base_commit = "8a059721f1dcefb9d32a9cc3b75c78546210794c" } (
