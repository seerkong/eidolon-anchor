          )>
          <Task #P1-T2 { name = "Establish neutral boundary baselines" status = "DONE" order = 1 priority = "P0" } (
            <Acceptance [
              <Criterion #P1-T2-AC1 { checked = true } ?01M0PD7Q2KJTW26YHEA899XTZ5>
              Tests demonstrate that current flat Ctrl/Data/AI state paths are multiple writable authorities and that fresh recovery can depend on live definition bytes.
              </?01M0PD7Q2KJTW26YHEA899XTZ5>
              <Criterion #P1-T2-AC2 { checked = true } ?01M0PD7Q2KJTW26YHEA899XTZ6>
              Tests freeze the required no-dual-write, complete frozen bundle, v0-before-effect, path containment and opaque runtime-ref boundaries.
              </?01M0PD7Q2KJTW26YHEA899XTZ6>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "Canonical instance and checkpoint adapter" status = "DONE" order = 1 } (
        <SubNodes [
          <Task #P2-T1 { name = "Materialize and load frozen workflow instances" status = "DONE" order = 0 priority = "P0" } (
            <Acceptance [
              <Criterion #P2-T1-AC1 { checked = true } ?01M0PD7Q2KJTW26YHEA899XTZ7>
              A new resource or explicit-vfs definition is copied as a complete depa instance bundle with exact revision, digest and provenance before its first run.
              </?01M0PD7Q2KJTW26YHEA899XTZ7>
              <Criterion #P2-T1-AC2 { checked = true } ?01M0PD7Q2KJTW26YHEA899XTZ8>
              Existing instance and second-run paths load owner-first from frozen bytes after live definition modification, deletion or invalidation.
              </?01M0PD7Q2KJTW26YHEA899XTZ8>
            ]>
          )>
          <Task #P2-T2 { name = "Cut Ctrl and Data runtime to one checkpoint owner" status = "DONE" order = 1 priority = "P0" } (
            <Acceptance [
              <Criterion #P2-T2-AC1 { checked = true } ?01M0PD7Q2KJTW26YHEA899XTZ9>
              Ctrl and Data start, wait, resume, patch, terminal result and fresh reconstruction all use the same filesystem checkpoint store and satisfy closed profile/envelope projection.
              </?01M0PD7Q2KJTW26YHEA899XTZ9>
              <Criterion #P2-T2-AC2 { checked = true } ?01M0PD7Q2KJTW26YHEA899XTZA>
              Version 0 is committed before the first node effect; accepted completed Data nodes are not re-dispatched after fresh recovery, and every transition preserves the closed profile.ai carrier for the subsequent typed Agent facade track.
              </?01M0PD7Q2KJTW26YHEA899XTZA>
            ]>
          )>
        ]>
      )>
