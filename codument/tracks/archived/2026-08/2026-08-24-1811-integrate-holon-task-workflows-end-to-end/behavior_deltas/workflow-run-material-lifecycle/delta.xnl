<BehaviorPatch #track.integrate-holon-task-workflows-end-to-end.behavior_patch.workflow-run-material-lifecycle apiVersion="codument.tech/v1alpha1" version="1" { capability = "workflow-run-material-lifecycle" } (
  <Mutations [<Upsert { selector = "behavior://workflow-run-material-lifecycle/requirements/task-space-receipt-handoff" } (
    <Requirement #task-space-receipt-handoff (
      <Statement ?>TaskSpace SHALL admit settlement before FlowRunCheckpoint consumes its durable receipt in a separate CAS transition; repeated or interrupted handoff SHALL converge without duplicate task or run facts.</?>
      <Suites [<Suite #handoff-cases { name = "Cross-owner handoff" } (<Cases [
        <Case #interrupted-between-owners [<Given ?>Task settlement commits and the process stops before checkpoint update.</?><When ?>A fresh runtime resumes.</?><Then ?>It SHALL consume the same settlement receipt exactly once.</?>]>
      ]>)>]>
    )>
  )>]>
)>
