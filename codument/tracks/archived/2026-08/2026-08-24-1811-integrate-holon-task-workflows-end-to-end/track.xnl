<Track #integrate-holon-task-workflows-end-to-end apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "Complete a product-level local-file E2E in which AI Ctrl and AI Data workflows delegate complex nodes to TaskSpaces processed by frozen Holon MemberRuntime organizations." description = "Wire exact released dependencies, CLI/product surfaces and durable cross-owner receipts; verify shared runtime reuse, recovery and explicit organization replan." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-23T18:40:48.369Z" updated_at = "2026-08-24T15:11:50.334Z" modeling_base_commit = "94436d0e142762fdadeb6fad22502bfdaca6956b" engineering_base_commit = "94436d0e142762fdadeb6fad22502bfdaca6956b" gap_round = 2 } (
