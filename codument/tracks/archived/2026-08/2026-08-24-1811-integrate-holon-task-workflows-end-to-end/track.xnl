              </?01M0SSK5BEXC2A0MVH4ED8J3HH>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "AI Ctrl organization task journey" status = "DONE" order = 1 } (
        <SubNodes [
          <Task #P2-T1 { name = "create delegate wait resume settle and recover Ctrl task" status = "DONE" order = 0 } (
