<BehaviorPatch #track.add-inspectable-file-xnl-holon-e2e-resource.behavior_patch.eidolon-holon-e2e-resource apiVersion="codument.tech/v1alpha1" version="1" { capability = "eidolon-holon-e2e-resource" } (
  <Mutations [
    <Upsert { selector = "behavior://eidolon-holon-e2e-resource/requirements/inspectable-file-xnl-authority" } (
      <Requirement #inspectable-file-xnl-authority (
        <Statement ?>The repository SHALL provide one deterministic, human-inspectable Holon E2E resource generated by the real File-XNL capsule write, fresh reconstruction and snapshot issuance path without making that resource a product runtime authority.</?>
        <Suites [
          <Suite #resource-cases { name = "Inspectable E2E authority" } (
            <Cases [
              <Case #materialize-explicit-root [
                <Given ?>An empty explicit output root and the closed Review Team scenario.</?>
                <When ?>The runtime-first materializer runs.</?>
                <Then ?>It SHALL write the canonical authority layout and labelled issuer projections without returning or persisting the absolute root.</?>
              ]>
              <Case #regeneration-exact [
                <Given ?>The committed inspection resource and unchanged Holarchy packages.</?>
                <When ?>The check regenerates the scenario in an isolated root.</?>
                <Then ?>Every generator-owned relative path and byte SHALL match, and a fresh capsule SHALL reconstruct and issue the same snapshot and receipt.</?>
              ]>
              <Case #product-owner-independent [
                <Given ?>The committed inspection resource exists.</?>
                <When ?>The Ctrl/Data product E2E runs.</?>
                <Then ?>It SHALL still create and commit its own temporary writable File-XNL authority before ResourcePackage admission.</?>
              ]>
              <Case #privacy-boundary [
                <Given ?>The generated resource is reviewed or distributed with tests.</?>
                <When ?>Its paths and bytes are scanned.</?>
                <Then ?>It SHALL contain no host-local absolute path, prompt, reasoning, provider configuration, actor snapshot, mailbox or conversation history.</?>
              ]>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
