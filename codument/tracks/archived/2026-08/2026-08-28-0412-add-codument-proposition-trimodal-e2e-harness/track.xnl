            <Acceptance [
              <Criterion #P4-T1-AC1 { checked = true } ?01M11Y31WDB2FBSTMBKB54V5EP>
              Harness, headless, Workflow mode and provider-cache focused suites plus typecheck pass.
              </?01M11Y31WDB2FBSTMBKB54V5EP>
            ]>
          )>
          <Task #P4-T2 { name = "Run strict validation and inspect contract, effect and lifecycle dependency boundaries" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P4-T2-AC1 { checked = true } ?01M11Y31WDB2FBSTMBKB54V5EQ>
              Strict validation passes; contracts import no effects; adapters use registered surfaces; ordinary imports no Workflow implementation; Ctrl/Data do not read lifecycle internals or create parallel messaging.
              </?01M11Y31WDB2FBSTMBKB54V5EQ>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P5 { name = "Independent verification repair loop" status = "DONE" priority = "P0" order = 4 } (
        <Description ?01M11ZREPAIR0000000000001>
