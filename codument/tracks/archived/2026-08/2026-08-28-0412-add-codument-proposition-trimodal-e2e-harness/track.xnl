    <MaterialBundle #scripts { role = "output" name = "scripts" domain = "code" path = "vfs://@/cell/packages/ai-organ-logic/scripts/" }>
    <MaterialBundle #tests { role = "output" name = "tests" domain = "test" path = "vfs://@/cell/packages/ai-organ-logic/tests/" }>
  ]>
