        </?01M11ZREPAIR0000000000001>
        <SubNodes [
          <Task #P5-T1 { name = "Make the Codex-compatible shim portable outside the Eidolon repository" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P5-T1-AC1 { checked = true } ?01M11ZREPAIR0000000000002>
              The executable shim resolves all code from an arbitrary external cwd and a no-provider dry run reaches the Eidolon executable instead of failing module resolution.
              </?01M11ZREPAIR0000000000002>
            ]>
          )>
          <Task #P5-T2 { name = "Wire production matrix effects to the canonical coordinator and receipt store" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P5-T2-AC1 { checked = true } ?01M11ZREPAIR0000000000003>
