    <SubNodes [
      <TaskGroup #P1 { name = "Closed proposition and receipt contracts" status = "DONE" priority = "P0" order = 0 } (
        <Description ?01M11Y31WDB2FBSTMBKB54V5E9>
        Define the experiment authority boundary before adding process execution.
        </?01M11Y31WDB2FBSTMBKB54V5E9>
