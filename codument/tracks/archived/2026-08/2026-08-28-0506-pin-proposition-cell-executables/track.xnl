<Track #pin-proposition-cell-executables apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "Pin every Codument proposition matrix cell to one run-scoped Eidolon and Codument executable epoch so receipts identify the bytes actually executed." description = "Add content-addressed executable snapshots, bind the full matrix to those immutable paths, fail receipt persistence on drift, and independently verify the repair before restarting rejected live evidence." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-28T01:23:09.873Z" updated_at = "2026-08-28T02:06:08.317Z" modeling_base_commit = "34706c1c5d71b3b3592e8e0860af37ab147259fc" engineering_base_commit = "34706c1c5d71b3b3592e8e0860af37ab147259fc" } (
