            <Acceptance [
              <Criterion #P1-T1-AC1 { checked = true } ?01M13PINEXEC00000000000002>
              Tests prove one run and its resumes preserve the first executable binding after source replacement and reject unsafe identifiers, inconsistent manifests, or integrity drift.
              </?01M13PINEXEC00000000000002>
            ]>
