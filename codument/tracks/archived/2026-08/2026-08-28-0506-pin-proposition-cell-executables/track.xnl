            <Acceptance [
              <Criterion #P2-T1-AC1 { checked = true } ?01M13PINEXEC00000000000005>
              Snapshot creation reads each source once, writes executable content-addressed files exclusively, persists a first-writer run binding, and verifies all reused material.
              </?01M13PINEXEC00000000000005>
            ]>
          )>
          <Task #P2-T2 { name = "Bind the matrix and receipt authority to the pinned epoch" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P2-T2-AC1 { checked = true } ?01M13PINEXEC00000000000006>
              The root runner snapshots before planning the first cell, every cell receives the same frozen paths, and persistence rehashes them before a completed receipt is written.
              </?01M13PINEXEC00000000000006>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "Verification and live-run restart" status = "DONE" priority = "P0" order = 2 } (
        <Description ?01M13PINEXEC00000000000007>
        Prove the repair, install the exact build and restart only comparable evidence.
        </?01M13PINEXEC00000000000007>
        <SubNodes [
          <Task #P3-T1 { name = "Run focused tests, typecheck, build, local install and strict validation" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P3-T1-AC1 { checked = true } ?01M13PINEXEC00000000000008>
              Regression suites, locked TypeScript checks, TUI build, installed-versus-dist digest and strict Track validation all pass.
              </?01M13PINEXEC00000000000008>
