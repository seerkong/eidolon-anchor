    <SubNodes [
      <TaskGroup #P1 { name = "Executable epoch contract" status = "DONE" priority = "P0" order = 0 } (
        <Description ?01M13PINEXEC00000000000001>
        Lock observable failure semantics with tests before changing live execution.
        </?01M13PINEXEC00000000000001>
