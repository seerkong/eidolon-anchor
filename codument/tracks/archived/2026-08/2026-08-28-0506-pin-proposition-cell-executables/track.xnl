    <MaterialBundle #matrix_runner { role = "output" name = "matrix-runner" domain = "code" path = "vfs://@/scripts/run-codument-proposition-live.ts" }>
    <MaterialBundle #tests { role = "output" name = "tests" domain = "test" path = "vfs://@/terminal/packages/organ-support/tests/codument-proposition-support.test.ts" }>
  ]>
