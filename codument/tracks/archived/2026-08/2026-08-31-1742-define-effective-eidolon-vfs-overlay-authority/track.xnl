<Track #define-effective-eidolon-vfs-overlay-authority apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "定义唯一 Effective Eidolon VFS overlay authority、宿主 contract、迁移边界与 RED acceptance baseline" description = "以 behavior delta、storage-neutral contracts、invariant tests 和 authority report 固定后续 XNL/Halfcode/Agent runtime 的共同边界" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-31T14:22:51.705Z" updated_at = "2026-08-31T14:42:34.881Z" modeling_base_commit = "7ae52ab3c6d87e4dafedec9225bea50844c54b14" engineering_base_commit = "7ae52ab3c6d87e4dafedec9225bea50844c54b14" } (
