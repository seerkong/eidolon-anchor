    <MaterialBundle #builtin_runtime { role = "output" name = "builtin-vfs-runtime" domain = "code" path = "vfs://@/cell/packages/mod-ai-coding/src/builtin-vfs/" }>
    <MaterialBundle #build_boundary { role = "output" name = "bunfs-compile-boundary" domain = "code" path = "vfs://@/terminal/packages/tui/scripts/build.ts" }>
    <MaterialBundle #testkit { role = "output" name = "proposition-testkit" domain = "test" path = "vfs://@/testkit/codument-proposition/" }>
  ]>
  <TaskSpace #space_embed-eidolon-builtin-vfs-and-coding-agent { name = "embed-eidolon-builtin-vfs-and-coding-agent" version = "1" } (
    <SubNodes [
      <TaskGroup #P1 { name = "Formal resource ownership and stable snapshot" status = "DONE" priority = "P0" order = 0 } (
        <SubNodes [
          <Task #P1-T1 { name = "Create formal mature Coding Agent ResourcePackage" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P1-T1-AC1 { checked = true } ?01M1C8XHE66SMWPDZ5SWNFKZ3D>
              The package owns the mature MessagePrefix, WorkspaceAgents MessageSource, StandardContext pipeline, exact ToolRefs and complete Kind/resource closure under @cell/mod-ai-coding.
              </?01M1C8XHE66SMWPDZ5SWNFKZ3D>
              <Criterion #P1-T1-AC2 { checked = true } ?01M1C8XHE66SMWPDZ5SWNFKZ3E>
              The semantic Agent FQN contains no builtin transport vocabulary and prompt bytes map to the mature kernel/coding sources documented in design.md.
              </?01M1C8XHE66SMWPDZ5SWNFKZ3E>
            ]>
          )>
          <Task #P1-T2 { name = "Generate deterministic full XNL VFS snapshot" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P1-T2-AC1 { checked = true } ?01M1C8XHE66SMWPDZ5SWNFKZ3F>
              Repeated generation yields byte-identical full snapshots with stable path-derived directory and file node ids.
              </?01M1C8XHE66SMWPDZ5SWNFKZ3F>
              <Criterion #P1-T2-AC2 { checked = true } ?01M1C8XHE66SMWPDZ5SWNFKZ3G>
              Symlinks, unsafe paths, unsupported entries and stale committed output fail closed.
              </?01M1C8XHE66SMWPDZ5SWNFKZ3G>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "One source/compiled Builtin VFS runtime" status = "DONE" priority = "P0" order = 1 } (
        <SubNodes [
          <Task #P2-T1 { name = "Load one immutable Builtin base and read port" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P2-T1-AC1 { checked = true } ?01M1C8XHE66SMWPDZ5SWNFKZ3H>
              Source and embedded asset ports feed one deserializer/validator and expose identical snapshot proof and read behavior.
              </?01M1C8XHE66SMWPDZ5SWNFKZ3H>
              <Criterion #P2-T1-AC2 { checked = true } ?01M1C8XHE66SMWPDZ5SWNFKZ3J>
