<Track #embed-eidolon-builtin-vfs-and-coding-agent apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "把成熟 Coding Agent 迁入正式 Halfcode 资源树，并以同一稳定 XNL VFS snapshot 支撑 source 与 BunFS compiled runtime" description = "建立 mod-ai-coding 资源所有权、确定性 VFS projection、只读 Builtin source/read port、最终编译资产嵌入和 testkit 去生产副本" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-31T15:52:56.193Z" updated_at = "2026-08-31T16:43:06.586Z" modeling_base_commit = "7ae52ab3c6d87e4dafedec9225bea50844c54b14" engineering_base_commit = "7ae52ab3c6d87e4dafedec9225bea50844c54b14" } (
  <Ports { scope = "track" } [
