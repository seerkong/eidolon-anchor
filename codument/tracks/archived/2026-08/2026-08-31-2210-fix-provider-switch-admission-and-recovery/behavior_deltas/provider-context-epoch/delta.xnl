<BehaviorPatch #track.fix-provider-switch-admission-and-recovery.behavior_patch.provider-context-epoch apiVersion="codument.tech/v1alpha1" version="1" { capability = "provider-context-epoch" } (
  <Mutations [
    <Upsert { selector = "behavior://provider-context-epoch/requirements/atomic-provider-transition" } (
      <Requirement #atomic-provider-transition (
        <Statement ?>Provider/model control, target adapter resolution, protocol profile selection, epoch transition and snapshot reference SHALL form one ordered recoverable transition; no durable head may expose a partially committed provider generation.</?>
        <Suites [
          <Suite #switch-atomicity { name = "Provider switch atomicity" } (
            <Cases [
              <Case #target-adapter-before-profile (
                <Given ?>a recovered actor receives an explicit provider/model control fact.</?>
                <When ?>the runtime derives the target provider epoch.</?>
                <Then ?>it SHALL refresh the target adapter before reading its protocol profile and MUST NOT reuse the previous adapter semantics.</?>
              )>
              <Case #receipt-head-snapshot-one-generation (
                <Given ?>a provider transition or snapshot write fails at any commit step.</?>
                <When ?>the process continues or recovers.</?>
                <Then ?>receipt, transition head and session snapshot SHALL identify one last complete generation; a newer partial receipt MUST NOT become recovery authority.</?>
              )>
              <Case #legacy-divergence-repair (
                <Given ?>a legacy session has a session index epoch newer than its provider transition head.</?>
                <When ?>fresh recovery validates canonical receipts.</?>
                <Then ?>the runtime SHALL deterministically select or rebuild one complete generation and persist a typed repair receipt before provider transport.</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
