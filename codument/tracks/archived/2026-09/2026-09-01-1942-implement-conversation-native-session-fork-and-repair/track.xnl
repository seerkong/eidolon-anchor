<Track #implement-conversation-native-session-fork-and-repair apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "Replace TUI-only session cloning with a Conversation-native, atomic and recoverable fork capability for current-head and message-level forks, then repair the identified child session through the same authority path." description = "Define fork-point proofs, child History/Prompt/Session rebinding, independent provider epochs, XNL fork-init persistence, surface mediation, fresh-restart verification and idempotent incident repair." question_mode = "decision-tree" question_severity = "light" commit_mode = "manual" created_at = "2026-09-01T13:20:50.280Z" updated_at = "2026-09-01T16:42:36.604Z" gap_round = 2 } (
  <Ports { scope = "track" } [
    <MaterialBundle #behavior_deltas { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
    <MaterialBundle #conversation_code { role = "input" name = "conversation-code" domain = "code" path = "vfs://@/cell/packages/" }>
    <MaterialBundle #terminal_code { role = "input" name = "terminal-code" domain = "code" path = "vfs://@/terminal/packages/tui/" }>
    <MaterialBundle #tests { role = "output" name = "verification" domain = "test" path = "vfs://@/" }>
  ]>
  <TaskSpace #space_implement-conversation-native-session-fork-and-repair { name = "implement-conversation-native-session-fork-and-repair" version = "1" child_mode = "dag" } (
    <SubNodes [
      <TaskGroup #P1 { name = "锁定fork契约与RED证据" status = "DONE" priority = "P0" order = 0 } (
        <Description ?01M1ENNBWTHPWQZV462QR6HBWB>
        把历史三域设计映射到当前XNL authority，先用失败测试证明current-head、message-level、compaction拒绝、fresh restart和provider request缺口。
        </?01M1ENNBWTHPWQZV462QR6HBWB>
        <SubNodes [
          <Task #P1-T1 { name = "定义fork command proof result和typed rejection契约" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P1-T1-AC1 { checked = true } ?01M1ENNBWTHPWQZV462QR6HBWC>
              Contract可表达CurrentHead与ThroughCommittedMessage、source CAS、History frontier、Prompt basis、tool-pair proof和child lineage。
              </?01M1ENNBWTHPWQZV462QR6HBWC>
              <Criterion #P1-T1-AC2 { checked = true } ?01M1ENNBWTHPWQZV462QR6HBWD>
              Cross-session initial fork与same-session epoch successor在类型和校验上不可混淆。
              </?01M1ENNBWTHPWQZV462QR6HBWD>
            ]>
          )>
          <Task #P1-T2 { name = "增加current-head与fresh-restart RED E2E" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P1-T2-AC1 { checked = true } ?01M1ENNBWTHPWQZV462QR6HBWE>
              测试证明旧实现仅在同client内显示父消息，fresh process child History/Prompt为空。
              </?01M1ENNBWTHPWQZV462QR6HBWE>
              <Criterion #P1-T2-AC2 { checked = true } ?01M1ENNBWTHPWQZV462QR6HBWF>
              目标测试要求fresh recovery后的首次provider request包含父canonical上下文。
              </?01M1ENNBWTHPWQZV462QR6HBWF>
            ]>
          )>
          <Task #P1-T3 { name = "增加message-level与compaction proof RED矩阵" status = "DONE" priority = "P0" order = 2 } (
            <Acceptance [
              <Criterion #P1-T3-AC1 { checked = true } ?01M1ENNBWTHPWQZV462QR6HBWG>
              覆盖active-tail cutoff、完整tool pair、缺失message id以及compaction前后目标点。
              </?01M1ENNBWTHPWQZV462QR6HBWG>
              <Criterion #P1-T3-AC2 { checked = true } ?01M1ENNBWTHPWQZV462QR6HBWH>
              无法证明准确Prompt时测试要求typed rejection且无target authority。
              </?01M1ENNBWTHPWQZV462QR6HBWH>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P2 { name = "实现Conversation fork planner与child authority事务" status = "DONE" priority = "P0" order = 1 } (
        <Description ?01M1ENNBWTHPWQZV462QR6HBWJ>
        以纯Processor解析fork point和重绑定计划，通过显式Effect port原子提交child XNL History/Prompt、bounded heads、Session lineage与provider baseline。
        </?01M1ENNBWTHPWQZV462QR6HBWJ>
        <SubNodes [
          <Task #P2-T1 { name = "实现fork-point resolver与Prompt proof校验" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P2-T1-AC1 { checked = true } ?01M1ENNBWTHPWQZV462QR6HBWK>
              CurrentHead与canonical message selector均输出digest-bound proof，source revision变化时拒绝。
              </?01M1ENNBWTHPWQZV462QR6HBWK>
              <Criterion #P2-T1-AC2 { checked = true } ?01M1ENNBWTHPWQZV462QR6HBWM>
              Resolver不按surface数组下标fallback，不拆tool pair，不泄漏未来compaction summary。
              </?01M1ENNBWTHPWQZV462QR6HBWM>
            ]>
          )>
          <Task #P2-T2 { name = "实现History Prompt Session与asset重绑定planner" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P2-T2-AC1 { checked = true } ?01M1ENNBWTHPWQZV462QR6HBWN>
              Child-local ids、lineages、Prompt refs、selection和bindings一致，parent source只保留在cross-session proof。
              </?01M1ENNBWTHPWQZV462QR6HBWN>
              <Criterion #P2-T2-AC2 { checked = true } ?01M1ENNBWTHPWQZV462QR6HBWP>
              稳定assets按allowlist重绑定；provider optimization与transient runtime state全部清除或拒绝。
              </?01M1ENNBWTHPWQZV462QR6HBWP>
            ]>
          )>
          <Task #P2-T3 { name = "实现child独立provider epoch初始化" status = "DONE" priority = "P0" order = 2 } (
            <Acceptance [
              <Criterion #P2-T3-AC1 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKSJ>
              Child receipt绑定child identity/heads和history_rewind_or_fork reason，parent receipt仅作provenance。
              </?01M1ENNBWVV07GZCQ92SJ0TKSJ>
              <Criterion #P2-T3-AC2 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKSK>
              第一次child request从canonical authority重建且无parent continuation/admission/checkpoint。
              </?01M1ENNBWVV07GZCQ92SJ0TKSK>
            ]>
          )>
          <Task #P2-T4 { name = "实现XNL fork-init原子持久化与故障恢复" status = "DONE" priority = "P0" order = 3 } (
            <Acceptance [
              <Criterion #P2-T4-AC1 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKSM>
              History/Prompt正文写当前XNL authority，indexes bounded，child provider receipt/epoch baseline进入同一stage与publication，session/fork/provider heads最后共同生效。
              </?01M1ENNBWVV07GZCQ92SJ0TKSM>
              <Criterion #P2-T4-AC2 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKSN>
              每个stage/journal/fsync/publish/CAS故障点恢复为无child或History/Prompt/Session/provider epoch均完整的child；未完成provider epoch的child不可hydrate/运行，重复提交幂等。
              </?01M1ENNBWVV07GZCQ92SJ0TKSN>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "接通runtime与全部fork surfaces" status = "DONE" priority = "P0" order = 2 } (
        <Description ?01M1ENNBWVV07GZCQ92SJ0TKSP>
        将domain-owned fork capability装入runtime，替换TUI内存clone路径，并保证成功后hydrate、失败留在source。
        </?01M1ENNBWVV07GZCQ92SJ0TKSP>
        <SubNodes [
          <Task #P3-T1 { name = "装配Conversation fork write port与runtime capability" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P3-T1-AC1 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKSQ>
              Local/headless runtime均通过Conversation-owning Actor/capsule的同一command执行fork；跨Actor请求走既有mailbox，不直接调用Actor内部状态、不另建消息总线、不存在terminal-owned repository写入。
              </?01M1ENNBWVV07GZCQ92SJ0TKSQ>
              <Criterion #P3-T1-AC2 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKSR>
              Persistence、provider epoch、clock、id/digest和lock Effects通过typed runtime/manifest binding显式注入；Committed child可立即与fresh process一致地hydrate。
              </?01M1ENNBWVV07GZCQ92SJ0TKSR>
            ]>
          )>
          <Task #P3-T2 { name = "迁移session-list command-palette和message-list入口" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P3-T2-AC1 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKSS>
              Session action走CurrentHead，message action走ThroughCommittedMessage，成功后导航到durable child。
              </?01M1ENNBWVV07GZCQ92SJ0TKSS>
              <Criterion #P3-T2-AC2 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKST>
              `cloneSessionMessagesThrough`不再充当fork真相写入；missing message id不回退current head。
              </?01M1ENNBWVV07GZCQ92SJ0TKST>
            ]>
          )>
          <Task #P3-T3 { name = "实现typed rejection呈现与surface回归" status = "DONE" priority = "P1" order = 2 } (
            <Acceptance [
              <Criterion #P3-T3-AC1 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKSV>
              拒绝时保持source active、显示可操作原因、列表无ghost child。
              </?01M1ENNBWVV07GZCQ92SJ0TKSV>
              <Criterion #P3-T3-AC2 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKSW>
              TUI/CLI/headless的fork domain结果等价。
              </?01M1ENNBWVV07GZCQ92SJ0TKSW>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P4 { name = "实现幂等repair并修复事故副本" status = "DONE" priority = "P0" order = 3 } (
        <Description ?01M1ENNBWVV07GZCQ92SJ0TKSX>
        复用fork planner/transaction实现dry-run graft，保留child tail并在副本上修复用户指定的parent/child事故现场。
        </?01M1ENNBWVV07GZCQ92SJ0TKSX>
        <SubNodes [
          <Task #P4-T1 { name = "实现repair evidence与dry-run receipt" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P4-T1-AC1 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKSY>
              Repair只接受显式parent/child/fork point proof，输出planned heads、digests、tail mapping且不写现场。
              </?01M1ENNBWVV07GZCQ92SJ0TKSY>
              <Criterion #P4-T1-AC2 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKSZ>
              证据缺失或冲突时无写入并给出closed rejection。
              </?01M1ENNBWVV07GZCQ92SJ0TKSZ>
            ]>
          )>
          <Task #P4-T2 { name = "实现parent-base与existing-child-tail原子graft" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P4-T2-AC1 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKT0>
              Repair保留child committed tail并接在rebased parent base之后，清除旧provider optimization并推进reasoned epoch。
              </?01M1ENNBWVV07GZCQ92SJ0TKT0>
              <Criterion #P4-T2-AC2 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKT1>
              同一proof重试幂等，conflicting proof拒绝。
              </?01M1ENNBWVV07GZCQ92SJ0TKT1>
            ]>
          )>
          <Task #P4-T3 { name = "在备份事故副本上执行repair与fresh验证" status = "DONE" priority = "P0" order = 2 } (
            <Acceptance [
              <Criterion #P4-T3-AC1 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKT2>
              原始现场保持不变；副本先dry-run再commit，并记录fork/repair receipt。
              </?01M1ENNBWVV07GZCQ92SJ0TKT2>
              <Criterion #P4-T3-AC2 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKT3>
              Fresh process中child visible history与runtime prompt包含parent base和child tail，后续turn可继续。
              </?01M1ENNBWVV07GZCQ92SJ0TKT3>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P5 { name = "全链路验收与知识收口" status = "DONE" priority = "P0" order = 4 } (
        <Description ?01M1ENNBWVV07GZCQ92SJ0TKT4>
        运行fault、restart、provider-wire、compaction、parent immutability与incident regression矩阵，检查行为、设计和代码一致。
        </?01M1ENNBWVV07GZCQ92SJ0TKT4>
        <SubNodes [
          <Task #P5-T1 { name = "运行fork和repair focused test矩阵" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P5-T1-AC1 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKT5>
              Current-head、message-level、compaction拒绝、tool pair、fresh restart、fault injection与repair tests全绿。
              </?01M1ENNBWVV07GZCQ92SJ0TKT5>
              <Criterion #P5-T1-AC2 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKT6>
              Parent files/digests在fork和repair测试中保持不变。
              </?01M1ENNBWVV07GZCQ92SJ0TKT6>
            ]>
          )>
          <Task #P5-T2 { name = "验证首次provider wire与cache边界" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P5-T2-AC1 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKT7>
              Captured first child request包含预期parent canonical prefix且无parent continuation/checkpoint。
              </?01M1ENNBWVV07GZCQ92SJ0TKT7>
              <Criterion #P5-T2-AC2 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKT8>
              Fork作为显式new epoch可观测，不伪造same-epoch cache hit。
              </?01M1ENNBWVV07GZCQ92SJ0TKT8>
            ]>
          )>
          <Task #P5-T3 { name = "完成构建严格校验与diff审查" status = "DONE" priority = "P0" order = 2 } (
            <Acceptance [
              <Criterion #P5-T3-AC1 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKT9>
              受影响packages typecheck/build通过，`codument validate --strict`通过。
              </?01M1ENNBWVV07GZCQ92SJ0TKT9>
              <Criterion #P5-T3-AC2 { checked = true } ?01M1ENNBWVV07GZCQ92SJ0TKTA>
              无TUI fork truth、legacy transcript/generation JSON新写入、parallel conversation store或provider checkpoint复制残留。
              </?01M1ENNBWVV07GZCQ92SJ0TKTA>
            ]>
          )>
        ]>
        <Hooks [
          <Hook { on = "phase:after" } (
            <AttractorCheck { use = "coding" }>
            <GapLoop { max_rounds = 5 on_exhausted = "block" verify_round = true }>
          )>
        ]>
      )>
    ]>
  )>
