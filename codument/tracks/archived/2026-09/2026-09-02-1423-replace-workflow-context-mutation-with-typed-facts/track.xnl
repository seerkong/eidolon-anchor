              </?01M0WNC1M5FJ6DF472EH3NARBD>
            ]>
          )>
          <Task #P3-T2 { name = "Wire compaction, rewind, provider and frozen revision boundaries" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P3-T2-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARBE>
