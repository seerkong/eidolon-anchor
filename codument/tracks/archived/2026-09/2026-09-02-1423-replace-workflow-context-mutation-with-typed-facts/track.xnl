<Track #replace-workflow-context-mutation-with-typed-facts apiVersion="codument.tech/v1alpha1" version="2" { status = "completed" goal = "Keep provider-visible dynamic context append-only while separating runtime-only work context from model messages and making every non-append source change an explicit immutable provider context epoch." description = "Correct the provider-context projection boundary: Actor work mode/task phase stay runtime-only, while Workflow stage, recovery and explicit provider projections retain append-only typed facts and reason-bound epoch transitions." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-25T14:11:21.921Z" updated_at = "2026-09-02T11:23:56.283Z" modeling_base_commit = "42a5b58f37723752164b5c6759b500c0c09881be" engineering_base_commit = "42a5b58f37723752164b5c6759b500c0c09881be" } (
  <Ports { scope = "track" }>
  <TaskSpace #space_replace-workflow-context-mutation-with-typed-facts { name = "replace-workflow-context-mutation-with-typed-facts" version = "1" child_mode = "dag" } (
    <SubNodes [
      <TaskGroup #P1 { name = "Closed context facts, epoch receipts and RED baselines" status = "DONE" priority = "P0" order = 0 } (
        <SubNodes [
          <Task #P1-T1 { name = "Add closed append-only context-fact contract and owner ports" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P1-T1-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB2>
              Context facts are immutable closed own-data with exact Actor/session identity, Actor-global sequence, namespace revision, both predecessor digests, chronological history anchor, canonical payload digest and deterministic bytes.
              </?01M0WNC1M5FJ6DF472EH3NARB2>
              <Criterion #P1-T1-AC2 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB3>
              One runtime-first projector and Conversation CAS append own immutable asset plus Actor fact-chain head admission; duplicate/conflicting/gapped/accessor/sparse/orphaned facts fail before prompt mutation, and interleaved namespaces fresh-recover one exact total order.
              </?01M0WNC1M5FJ6DF472EH3NARB3>
            ]>
          )>
          <Task #P1-T2 { name = "Define immutable provider epoch receipt and legacy import protocol" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P1-T2-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB4>
              The immutable v2 epoch receipt binds exact predecessor, provider/model/profile, epoch-baseline history/prompt/fact heads, source frontier, pending delivery, handoff, resource/surface digests, retention policy and one closed reason; ordinary successful requests append admission receipts binding current descendant heads and final wire without mutating the epoch receipt.
              </?01M0WNC1M5FJ6DF472EH3NARB4>
              <Criterion #P1-T2-AC2 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB5>
              Legacy late-status overlays and receipt v1 enter through a CAS-marked one-way importer with exact reason mapping; six interruption boundaries, ambiguity, tamper and dual-write recover to the exact staged target or fail closed.
              </?01M0WNC1M5FJ6DF472EH3NARB5>
            ]>
          )>
        ]>
        <Gate [
          <Criterion #P1-G1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB6>
          RED proves the legacy work-context overlay and same-epoch receipt reconciliation rewrite earlier final-wire units; GREEN keeps work context control-only, appends only deliberately provider-visible dynamic facts, rejects structural escape and preserves deterministic identity.
          </?01M0WNC1M5FJ6DF472EH3NARB6>
        ]>
      )>
      <TaskGroup #P2 { name = "Append-only provider projection and Workflow stage facts" status = "DONE" priority = "P0" order = 1 } (
        <SubNodes [
          <Task #P2-T1 { name = "Retire late-status overlay and replace mutable provider projection" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P2-T1-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB7>
              Work context remains runtime-only; a changed deliberately provider-visible projection appends exactly one predecessor-bound fact, while unchanged projection is idempotent and estimation-only builds perform no write.
              </?01M0WNC1M5FJ6DF472EH3NARB7>
              <Criterion #P2-T1-AC2 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB8>
              Materialization follows exact history anchors and Actor-global sequence, never inserts ahead of retained history or splits a pending tool pair; revision-before-delivery, parallel pairs, retry and recovery preserve complete pair ownership, and removal requires epoch-advancing compaction.
              </?01M0WNC1M5FJ6DF472EH3NARB8>
            ]>
          )>
          <Task #P2-T2 { name = "Project Workflow stage context without progress prompt mutation" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P2-T2-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARB9>
