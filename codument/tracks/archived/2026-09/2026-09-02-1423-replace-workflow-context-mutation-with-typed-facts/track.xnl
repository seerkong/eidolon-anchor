              </?01M1F3AAS6D7APP31RYYRQ6F75>
            ]>
          )>
          <Task #P5-T3 { name = "Verify cross-profile projection and cache boundaries" status = "DONE" priority = "P0" order = 2 } (
            <Acceptance [
