              </?01M0WNC1M5FJ6DF472EH3NARB9>
              <Criterion #P2-T2-AC2 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARBA>
              Stage/progress/deadline changes do not mutate system roots; provider tool schema stays at the G2 stable exact surface while execution follows the current allowlist.
              </?01M0WNC1M5FJ6DF472EH3NARBA>
            ]>
          )>
        ]>
        <Gate [
          <Criterion #P2-G1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARBB>
          Ordinary, lifecycle and Ctrl/Data node journeys preserve exact prior same-epoch bytes while ordinary/node paths remain Workflow-stage-free.
          </?01M0WNC1M5FJ6DF472EH3NARBB>
        ]>
      )>
      <TaskGroup #P3 { name = "Reason-bound provider epoch transitions" status = "DONE" priority = "P0" order = 2 } (
        <SubNodes [
          <Task #P3-T1 { name = "Make reconcile validation-only and add monotonic transition Processor" status = "DONE" priority = "P0" order = 0 } (
            <Acceptance [
              <Criterion #P3-T1-AC1 { checked = true } ?01M0WNC1M5FJ6DF472EH3NARBC>
