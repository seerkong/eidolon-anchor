{
  "permission": {
    "*": "allow",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git fetch *": "deny",
      "git push *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git checkout *": "deny",
      "git rm *": "deny",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "sed *": "allow",
      "rm *": "deny"
    },
    "edit": {
      "*": "allow"
    }
  }
}
